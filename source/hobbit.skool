; Object index
;
; 3-byte entries: object number, then the address of that object's record in #R$C00B. Terminated by $FF. Searched by #R$9B25. Some numbers: 0 YOU (Bilbo), 5 the
; round green door, 12 the large trap door, 14 the short strong sword, 16 the golden ring, 18 the rope, 33 the cupboard, 62 Gandalf, 63 Thorin, 71 and 72 the
; trolls.
b$BF53 DEFB $00,$0B,$C0,$01,$60,$C0,$02,$9D
 $BF5B DEFB $C0,$03,$C1,$C0,$04,$AF,$C0,$05
 $BF63 DEFB $35,$C0,$06,$D6,$C0,$07,$F5,$C0
