; Unused
;
; Zero bytes up to the start of the code at #R$6C00.
u$6BEE DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $6BF6 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $6BFE DEFB $00,$00

; Game entry point (RANDOMIZE USR 27648)
;
; The BASIC loader 'hobbit' loads the loading screen to 40000, copies it onto the display, loads this 37,888-byte block at 24576 ($6000) and then does RANDOMIZE
; USR 27648, which arrives here.
; .
; The first job is to make pristine copies of everything that changes during play, so the game can be restarted after Bilbo dies without reloading the tape: the
; object table (#R$C00B, $614 bytes) and the room table (#R$B97A, $5D9 bytes) are copied up to $F400 onwards, the 28 bytes of game variables at #R$B5DC are
; copied to $5F00, and the timer and character tables at #R$C973 ($BF bytes) follow the room copy.
; .
; Execution then falls through into #R$6C27, which is also the restart point.
c$6C00 DI            ; Disable interrupts
 $6C01 LD DE,$F400   ; Back up the object table...
 $6C04 LD HL,$C00B   ; HL = the object table (Bilbo's record)
 $6C07 LD BC,$0614   ; BC = $0614
 $6C0A LDIR          ; Copy BC bytes from HL to DE
 $6C0C LD HL,$B97A   ; ...and the room table...
 $6C0F LD BC,$05D9   ; BC = $05D9
 $6C12 LDIR          ; Copy BC bytes from HL to DE
 $6C14 LD DE,$5F00   ; ...the game variables at B5DC...
 $6C17 LD HL,$B5DC   ; HL = the address of the saved variables
 $6C1A LD BC,$001C   ; BC = 28
 $6C1D LDIR          ; Copy BC bytes from HL to DE
 $6C1F LD HL,$C973   ; ...and the timer/character tables
 $6C22 LD BC,$00BF   ; BC = 191
 $6C25 LDIR          ; Copy BC bytes from HL to DE

; Start or restart a game
;
; This is where the game begins, and where it comes back to after 'you are dead' (see #R$903C). It is the reverse of #R$6C00: the backed-up copies of the object
; table, room table, variables and timer tables are copied back over the live ones, so every object, character, door and timer returns to its starting state.
; .
; It then sets the border to black, waits for a key press (the IN A,($FE) loop at $6C6E: keys read as 0 bits, so the loop continues while all five bits are 1),
; sets up the text window variables used by the printer (#R$75AD), clears a 200-byte work area at #R$B628, and seeds the random number generator from the Z80's
; R (refresh) register at $6C9E. Because R counts instructions, the seed depends on exactly how long the player took to press a key, which is why every game
; plays out differently.
; .
; The routine then clears the screen (#R$6FCA), draws the bar that separates the story window from the input window (a 5-line pattern from #R$6DC3, repeated
; across the screen at $5140), sets the line counter used by the story window's pause (#R$7694) to 17, and, if this is a fresh start (the frame count at $B5F7
; is $FF, as it always is after the variables are restored), makes the game's random choices (#R$970B), puts the first command, LOOK, into the input buffer
; (copied from $6FEB to $6FF0), and drops into the main loop at #R$6D0A.
c$6C27 DI            ; Disable interrupts
 $6C28 LD SP,$5EFF   ; SP = $5EFF
 $6C2B LD IX,$CC00   ; IX = the picture index
 $6C2F LD A,$05      ; A = 5
 $6C31 CALL $9D12    ; Call: Search a table of 3-byte entries (#R$9D12)
 $6C34 LD L,(IX+$01) ; L = the low byte of the address of the table entry
 $6C37 LD H,(IX+$02) ; H = the high byte of the address of the table entry
 $6C3A LD (HL),$00   ; Store $00 at (HL)
 $6C3C INC HL        ; Increment HL
 $6C3D LD (HL),$00   ; Store $00 at (HL)
 $6C3F LD HL,$F400   ; Restore objects, rooms, variables and timers from the backups
 $6C42 LD DE,$C00B   ; DE = the object table (Bilbo's record)
 $6C45 LD BC,$0614   ; BC = $0614
 $6C48 LDIR          ; Copy BC bytes from HL to DE
 $6C4A LD DE,$B97A   ; DE = the address of room 0's flags
 $6C4D LD BC,$05D9   ; BC = $05D9
 $6C50 LDIR          ; Copy BC bytes from HL to DE
 $6C52 LD HL,$5F00   ; HL = $5F00
 $6C55 LD DE,$B5DC   ; DE = the address of the saved variables
 $6C58 LD BC,$001C   ; BC = 28
 $6C5B LDIR          ; Copy BC bytes from HL to DE
 $6C5D LD DE,$C973   ; DE = the timer table
 $6C60 LD BC,$00BF   ; BC = 191
 $6C63 LDIR          ; Copy BC bytes from HL to DE
 $6C65 XOR A         ; A = 0
 $6C66 OUT ($FE),A   ; Write to the port (border colour, beeper or printer)
 $6C68 LD A,$38      ; A = 56
 $6C6A LD ($5C48),A  ; Store A at $5C48
*$6C6D XOR A         ; A = 0
 $6C6E IN A,($FE)    ; Wait until a key is pressed
 $6C70 AND $1F       ; Keep only the bits of $1F
 $6C72 CP $1F        ; Compare with 31
 $6C74 JR Z,$6C6D    ; If yes, go to #R$6C6D
 $6C76 LD HL,$50E0   ; HL = $50E0
 $6C79 LD ($75A9),HL ; Store HL in the lower window print position
 $6C7C LD A,$2B      ; A = 43
 $6C7E LD ($75AB),A  ; Store A at $75AB
 $6C81 LD HL,$5020   ; HL = $5020
 $6C84 LD ($768F),HL ; Store HL in the story window print position
 $6C87 LD A,$01      ; A = 1
 $6C89 LD ($7691),A  ; Store A in the pixel offset
 $6C8C LD A,$20      ; A = 32
 $6C8E LD ($75A8),A  ; Store A in the columns left in the lower window
 $6C91 LD A,$2A      ; A = 42
 $6C93 LD ($768E),A  ; Store A in the characters left on the line
 $6C96 LD B,$C8      ; B = 200
 $6C98 LD HL,$B628   ; HL = the orders buffer
 $6C9B CALL $70D9    ; Call: Clear a block of memory (#R$70D9)
 $6C9E LD A,R        ; Seed the random number generator from R
 $6CA0 LD ($B5FE),A  ; Store A in the random seed
 $6CA3 XOR A         ; A = 0
 $6CA4 LD ($7692),A  ; Store A in the indent
 $6CA7 LD ($7693),A  ; Store A at $7693
 $6CAA LD ($B60A),A  ; Store A in the "unfinished command" flag
 $6CAD LD ($B5F1),A  ; Store A in the drunkenness flag
 $6CB0 LD ($B5E3),A  ; Store A in the printer flag
 $6CB3 LD A,$01      ; A = 1
 $6CB5 LD ($B5F3),A  ; Store A in the "visible to Bilbo" output flag
 $6CB8 LD ($B5EB),A  ; Store A in the "really do it" flag
 $6CBB LD ($B5F5),A  ; Store A in the capitalisation flag
 $6CBE LD HL,$0000   ; HL = 0
 $6CC1 LD ($B5E8),HL ; Store HL in the score
 $6CC4 CALL $6FCA    ; Call: Clear the screen (#R$6FCA)
 $6CC7 LD HL,$5140   ; HL = $5140
 $6CCA LD DE,$6DC3   ; DE = Window separator pattern (#R$6DC3)
 $6CCD LD C,$05      ; C = 5
*$6CCF LD B,$10      ; B = 16
 $6CD1 PUSH HL       ; Save HL
*$6CD2 LD A,(DE)     ; A = (DE)
 $6CD3 LD (HL),A     ; Store A at (HL)
 $6CD4 INC HL        ; Increment HL
 $6CD5 INC DE        ; Increment DE
 $6CD6 LD A,(DE)     ; A = (DE)
 $6CD7 LD (HL),A     ; Store A at (HL)
 $6CD8 INC HL        ; Increment HL
 $6CD9 DEC DE        ; Decrement DE
 $6CDA DJNZ $6CD2    ; Loop back until B reaches 0
 $6CDC INC DE        ; Increment DE
 $6CDD INC DE        ; Increment DE
 $6CDE POP HL        ; Restore HL
 $6CDF INC H         ; Increment H
 $6CE0 DEC C         ; Decrement C
 $6CE1 JR NZ,$6CCF   ; If the routine returned with Z reset, go to #R$6CCF
 $6CE3 LD A,$11      ; A = 17
 $6CE5 LD ($B606),A  ; Store A in the lines left before pausing
 $6CE8 LD A,($B5F7)  ; A = the number of command frames
 $6CEB INC A         ; Increment A
 $6CEC JR NZ,$6D0A   ; If the routine returned with Z reset, go to Main command loop (#R$6D0A)
 $6CEE CALL $970B    ; Call: Choose the random features of a new game (#R$970B)
 $6CF1 LD HL,$6FE9   ; HL = Initial prompt and command (#R$6FE9)
*$6CF4 LD A,(HL)     ; A = (HL)
 $6CF5 CALL $75AD    ; Call: Print a character in the lower (input) window (#R$75AD)
 $6CF8 INC HL        ; Increment HL
 $6CF9 CP $0D        ; Compare with 13
 $6CFB JR NZ,$6CF4   ; If no, go to #R$6CF4
 $6CFD LD HL,$6FEB   ; Prime the input buffer with "LOOK"
 $6D00 LD DE,$6FF0   ; DE = Input buffer (#R$6FF0)
 $6D03 LD BC,$0005   ; BC = 5
 $6D06 LDIR          ; Copy BC bytes from HL to DE
 $6D08 JR $6D19      ; Continue at #R$6D19

; Main command loop
;
; This is the heart of the game. Each pass round the loop is one line of input from the player:
; .
; 1. #R$6DCD prints the '>' prompt and reads a line of text into the input buffer at #R$6FF0. If the player types nothing for a while, #R$7240 types WAIT on
; their behalf, so time passes in The Hobbit even if you do not.
; .
; 2. The token buffer at #R$7093 is cleared (#R$70D9), and then #R$6E8E is called repeatedly to turn the line into tokens, one per word. Each token is two
; bytes, stored high byte first: the high byte is the word's class (see #R$6040) in its top four bits plus the top four bits of the word's 12-bit dictionary
; offset; the low byte is the bottom eight bits of the offset.
; .
; 3. Double quotes get special treatment (from $6D2F). A quote comes back from #R$6E8E as class $90 with an offset of 0. The flag at $B60B records whether we
; are inside a quotation. At an opening quote the flag is set. At a closing quote the flag is cleared and, unless the previous token was already a comma ($A0)
; or full stop ($B0), a full-stop token is inserted before the quote token, so that whatever was said to a character ends like a complete sentence.
; .
; 4. Tokens are stored until the end-of-line token ($C0). A token of class $D0 means the word was not in the dictionary: the game jumps to $6D99, which prints a
; message saying it does not know the word and quotes the word back from the input line (up to the next space or quote, using the pointer at $B5CB). If the line
; ends with a quotation still open, #R$7FF9 is called to complain and the line is thrown away.
; .
; 5. #R$7C4F parses the tokens into an action, and #R$8351 executes it and lets the rest of the world take its turn. If the line contained more than one command
; (separated by AND, THEN, commas or full stops), the loop at $6D8D goes back into the parser for the next one while the flag at $B5F6 is set.
; .
; The main loop can also be entered at $6D17 with the Z flag set, from the '@' key (see #R$6E71), which re-parses the tokens left over from the previous line:
; in other words, it repeats the last command.
c$6D0A LD A,$01      ; A = 1
 $6D0C LD ($B5F6),A  ; Store A in the "more commands" flag
 $6D0F LD A,$09      ; A = 9
 $6D11 LD ($B606),A  ; Store A in the lines left before pausing
 $6D14 CALL $6DCD    ; Read a line of input
 $6D17 JR Z,$6D81    ; Z set: repeat the previous command
; This entry point is used by the routine at #R$6C27.
*$6D19 LD HL,$7093   ; HL = Token buffer (#R$7093)
 $6D1C LD B,$40      ; B = 64
 $6D1E CALL $70D9    ; Clear the token buffer
 $6D21 LD HL,$6FF0   ; HL = Input buffer (#R$6FF0)
 $6D24 LD IY,$7093   ; IY = Token buffer (#R$7093)
*$6D28 CALL $6E8E    ; Turn the next word into a token
 $6D2B CP $D0        ; End of line?
 $6D2D JR Z,$6D99    ; If yes, go to #R$6D99
 $6D2F CP $90        ; A quote?
 $6D31 JR NZ,$6D63   ; If no, go to #R$6D63
 $6D33 LD A,B        ; A = B
 $6D34 AND $0F       ; Keep only the bits of $0F
 $6D36 OR C          ; Combine with C
 $6D37 JR NZ,$6D63   ; If it is not zero, go to #R$6D63
 $6D39 LD A,($B60B)  ; Opening or closing quote?
 $6D3C AND A         ; Is A zero?
 $6D3D JR NZ,$6D45   ; If it is not zero, go to #R$6D45
 $6D3F INC A         ; Increment A
 $6D40 LD ($B60B),A  ; Store A in the quotation level
 $6D43 JR $6D63      ; Continue at #R$6D63
*$6D45 DEC A         ; Decrement A
 $6D46 LD ($B60B),A  ; Store A in the quotation level
 $6D49 LD A,(IY-$02) ; Closing quote: was the previous token a comma or full stop?
 $6D4C AND $F0       ; Keep only the bits of $F0
 $6D4E CP $B0        ; Compare with 176
 $6D50 JR Z,$6D63    ; If yes, go to #R$6D63
 $6D52 CP $A0        ; Compare with 160
 $6D54 JR Z,$6D63    ; If yes, go to #R$6D63
 $6D56 LD A,$B0      ; No: insert a full stop token
 $6D58 LD (IY+$00),A ; Store A at (IY+0)
 $6D5B XOR A         ; A = 0
 $6D5C LD (IY+$01),A ; Store A at (IY+1)
 $6D5F INC IY        ; Increment IY
 $6D61 INC IY        ; Increment IY
*$6D63 LD (IY+$00),B ; Store the token
 $6D66 LD (IY+$01),C ; Store C at (IY+1)
 $6D69 INC IY        ; Increment IY
 $6D6B INC IY        ; Increment IY
 $6D6D LD A,D        ; Loop until the end-of-line token ($C0)
 $6D6E CP $C0        ; Compare with 192
 $6D70 JR NZ,$6D28   ; If no, go to #R$6D28
 $6D72 LD A,($B60B)  ; Quote still open at the end of the line?
 $6D75 AND A         ; Is A zero?
 $6D76 JR Z,$6D81    ; If it is zero, go to #R$6D81
 $6D78 XOR A         ; A = 0
 $6D79 LD ($B60B),A  ; Store A in the quotation level
 $6D7C CALL $7FF9    ; Yes: complain and start again
 $6D7F JR $6D0A      ; Continue at Main command loop (#R$6D0A)
*$6D81 LD HL,$7093   ; Parse the tokens
 $6D84 LD ($B5CD),HL ; Store HL in the token pointer
*$6D87 CALL $7C4F    ; Call: Parse the command (#R$7C4F)
 $6D8A JP NZ,$6D0A   ; If the routine returned with Z reset, go to Main command loop (#R$6D0A)
 $6D8D CALL $8351    ; Execute the command and run the rest of the turn
 $6D90 LD A,($B5F6)  ; More commands on this line?
 $6D93 AND A         ; Is A zero?
 $6D94 JR NZ,$6D87   ; If it is not zero, go to #R$6D87
 $6D96 JP $6D0A      ; Finish by jumping to Main command loop (#R$6D0A)
*$6D99 LD HL,$AC87   ; Unknown word: complain and quote it
 $6D9C LD A,$01      ; A = 1
 $6D9E LD ($B5F2),A  ; Store A in the lower-window flag
 $6DA1 CALL $72D4    ; Print the message at HL
 $6DA4 LD HL,($B5CB) ; HL = the start of the current word
*$6DA7 LD A,(HL)     ; A = (HL)
 $6DA8 CP $0D        ; Compare with 13
 $6DAA JR Z,$6DB8    ; If yes, go to #R$6DB8
 $6DAC CP $22        ; Is it """?
 $6DAE JR Z,$6DB8    ; If yes, go to #R$6DB8
 $6DB0 CALL $7580    ; Print the character in A
 $6DB3 INC HL        ; Increment HL
 $6DB4 CP $20        ; Is it " "?
 $6DB6 JR NZ,$6DA7   ; If no, go to #R$6DA7
*$6DB8 LD A,$22      ; A = 34
 $6DBA CALL $7580    ; Print the character in A
 $6DBD CALL $7578    ; Print a new line
 $6DC0 JP $6D0A      ; Finish by jumping to Main command loop (#R$6D0A)

; Window separator pattern
;
; Five pairs of bytes, one pair for each of five pixel lines. At start-up (#R$6C27, from $6CC7) each pair is repeated 16 times across the screen at $5140,
; drawing the patterned bar that separates the story window from the input window below it.
b$6DC3 DEFB $C3,$C3,$2C,$34,$10,$08,$2C,$34,$C3,$C3

; Read a line of input from the keyboard
;
; This is The Hobbit's line editor. It starts by setting the idle timer at $B604 to 3000 (see #R$7240), and setting $B5F2 and $B5EB to 1, then prints the '>'
; prompt and a space.
; .
; Characters are collected into the input buffer at #R$6FF0. B counts the space left, starting at 128 ($80), so bit 7 of B being set means that nothing has been
; typed yet. C is 0 until the first key has been handled.
; .
; Keys are fetched by #R$7240, which also types WAIT for the player if they are idle for too long. Each key is then handled as follows:
; .
; #LIST
; { '@' ($40, SYMBOL SHIFT + 2) as the very first key: repeat the last command (#R$6E71). }
; { Any key that is the first key of the line: #R$6E46 checks for the cursor keys, which produce a one-letter movement command on their own. }
; { $18 (SYMBOL SHIFT + 0): delete the whole line (#R$6E82). }
; { $08 (CAPS SHIFT + 0 or 5, or 5 on its own): delete the last character, by printing a backspace, putting B back up by one and moving HL back, unless the line
; is empty. }
; { Letters (codes $40 and above), space, double quote, full stop, comma and ENTER are accepted. Everything else is ignored. }
; LIST#
; .
; An accepted character is stored in $B5F5 (the printer uses this to remember the last punctuation mark), echoed to the screen via #R$7580, and put in the
; buffer, as long as there is room (B not 0). ENTER ($0D) ends the line: it is stored like any other character, and the routine returns with the Z flag reset.
; .
; Note that letters are not converted to upper case here. They do not need to be: the tokeniser keeps only the low five bits of each letter (#R$6F3E), and that
; is the same for 'a' and 'A'.
;
; Output:F Z reset for a normal line; Z set if the previous command is to be repeated
c$6DCD LD HL,$0BB8   ; Allow 3000 key polls before WAIT is typed automatically
 $6DD0 LD ($B604),HL ; Store HL in the idle counter
 $6DD3 LD A,$01      ; A = 1
 $6DD5 LD ($B5F2),A  ; Store A in the lower-window flag
 $6DD8 LD ($B5EB),A  ; Store A in the "really do it" flag
 $6DDB LD A,$3E      ; Print the prompt "> "
 $6DDD CALL $7580    ; Print the character in A
 $6DE0 LD A,$20      ; A = 32
 $6DE2 CALL $7580    ; Print the character in A
 $6DE5 LD HL,$6FF0   ; HL = input buffer, B = 128 characters of space, C = 0 (no keys yet)
 $6DE8 LD B,$80      ; B = 128
*$6DEA LD C,$00      ; C = 0
; This entry point is used by the routine at #R$6E71.
*$6DEC CALL $7240    ; Wait for a key
 $6DEF BIT 7,B       ; First character of the line?
 $6DF1 JR Z,$6DF8    ; If the bit is clear, go to #R$6DF8
 $6DF3 CP $40        ; "@" as the first key: repeat the last command
 $6DF5 JP Z,$6E71    ; If yes, go to Repeat the last command (#R$6E71)
*$6DF8 BIT 0,C       ; First key of the line: check for cursor-key shortcuts
 $6DFA CALL Z,$6E46  ; If zero/equal: call: Cursor-key shortcuts (#R$6E46)
 $6DFD LD C,$01      ; C = 1
 $6DFF CP $18        ; SYMBOL SHIFT + 0: delete the whole line
 $6E01 JR NZ,$6E08   ; If no, go to #R$6E08
 $6E03 CALL $6E82    ; Call: Delete the whole input line (#R$6E82)
 $6E06 JR $6DEA      ; Continue at #R$6DEA
*$6E08 CP $08        ; Backspace?
 $6E0A JR NZ,$6E19   ; If no, go to #R$6E19
 $6E0C BIT 7,B       ; Ignore it if the line is empty
 $6E0E JR NZ,$6DEC   ; If the bit is set, go to #R$6DEC
 $6E10 LD A,$08      ; Otherwise rub out the last character
 $6E12 CALL $7580    ; Print the character in A
 $6E15 INC B         ; Increment B
 $6E16 DEC HL        ; Decrement HL
 $6E17 JR $6DEC      ; Continue at #R$6DEC
*$6E19 CP $40        ; Accept letters...
 $6E1B JR NC,$6E31   ; If A >= 64, go to #R$6E31
 $6E1D CP $22        ; ...double quote, space, ENTER, full stop and comma
 $6E1F JR Z,$6E31    ; If yes, go to #R$6E31
 $6E21 CP $20        ; Is it " "?
 $6E23 JR Z,$6E31    ; If yes, go to #R$6E31
 $6E25 CP $0D        ; Compare with 13
 $6E27 JR Z,$6E31    ; If yes, go to #R$6E31
 $6E29 CP $2E        ; Is it "."?
 $6E2B JR Z,$6E31    ; If yes, go to #R$6E31
 $6E2D CP $2C        ; Is it ","?
 $6E2F JR NZ,$6DEC   ; If no, go to #R$6DEC
*$6E31 LD ($B5F5),A  ; Remember the character for the printer
 $6E34 DEC B         ; Buffer full?
 $6E35 INC B         ; Increment B
 $6E36 JR Z,$6E3E    ; If Z is set, go to #R$6E3E
 $6E38 CALL $7580    ; Echo the character and store it
 $6E3B LD (HL),A     ; Store A at (HL)
 $6E3C INC HL        ; Increment HL
 $6E3D DEC B         ; Decrement B
*$6E3E CP $0D        ; Loop until ENTER
 $6E40 JP NZ,$6DEC   ; If no, go to #R$6DEC
 $6E43 OR $01        ; Return with Z reset
 $6E45 RET           ; Done

; Cursor-key shortcuts
;
; Called by #R$6DCD for the first key of a line only. If the key is one of the four cursor keys, this routine types a complete movement command on its own and
; ends the line, so that a single key press moves Bilbo. The key codes come from the keyboard tables at #R$7BEE and #R$7C16:
; .
; #TABLE(default)
; { =h Key | =h Code | =h Command }
; { 7 (up) | $5B | N }
; { 6 (down) | $0A | S }
; { 8 (right) | $09 | E }
; { 5 (left) | $08 | W }
; TABLE#
; .
; The key works with or without CAPS SHIFT. The letter is stored in the input buffer and echoed, an ENTER ($0D) is stored after it, and the routine returns with
; A=$0D. The line editor then carries on as if the player had pressed ENTER: it prints the new line, stores a second (harmless) ENTER and finishes the line. So
; one key press both types and enters the command.
; .
; For any other key the routine returns with A unchanged and the line editor deals with the key as usual. The code for the left cursor ($08) is also the
; backspace code; this is why cursor-left only means 'west' as the first key of a line, and means 'delete' afterwards. Cursor right and down later in a line are
; simply ignored.
;
;  Input:A Key code
;        HL Current position in the input buffer
;        B Space left in the buffer
; Output:A $0D if a movement command was typed, otherwise unchanged
c$6E46 CP $09        ; Cursor right?
 $6E48 JR Z,$6E69    ; If yes, go to #R$6E69
 $6E4A CP $08        ; Cursor left?
 $6E4C JR Z,$6E6D    ; If yes, go to #R$6E6D
 $6E4E CP $0A        ; Cursor down?
 $6E50 JR Z,$6E65    ; If yes, go to #R$6E65
 $6E52 CP $5B        ; Cursor up (code $5B)? If not, return with A unchanged
 $6E54 RET NZ        ; Return if no
 $6E55 LD A,$4E      ; Up: "N"
*$6E57 LD (HL),A     ; Store the letter...
 $6E58 INC HL        ; Increment HL
 $6E59 CALL $7580    ; ...and echo it
 $6E5C DEC B         ; Decrement B
 $6E5D LD A,$0D      ; Then store an ENTER
 $6E5F LD (HL),A     ; Store A at (HL)
 $6E60 INC HL        ; Increment HL
 $6E61 DEC B         ; Decrement B
 $6E62 OR $01        ; Return with A=$0D (ENTER)
 $6E64 RET           ; Done
*$6E65 LD A,$53      ; Down: "S"
 $6E67 JR $6E57      ; Continue at #R$6E57
*$6E69 LD A,$45      ; Right: "E"
 $6E6B JR $6E57      ; Continue at #R$6E57
*$6E6D LD A,$57      ; Left: "W"
 $6E6F JR $6E57      ; Continue at #R$6E57

; Repeat the last command
;
; Called by #R$6DCD when the first key of a line is '@' (SYMBOL SHIFT + 2).
; .
; If the game is waiting for the answer to a question such as 'which key?' (the flag at $B60A, set by #R$8765), the '@' is thrown away and the line editor goes
; back to waiting for a key.
; .
; Otherwise two backspaces are printed to rub out the '> ' prompt, and the routine returns with the Z flag set. (#R$6DCD jumps here rather than calling it, so
; this return goes straight back to the main loop.) The main loop (#R$6D0A) then skips tokenising and hands the old contents of the token buffer (#R$7093)
; straight back to the parser. The effect is that '@' repeats the previous command, without it appearing on the screen again.
;
; Output:F Z set to repeat the last command
c$6E71 LD A,($B60A)  ; Is a command still pending?
 $6E74 AND A         ; Is A zero?
 $6E75 JP NZ,$6DEC   ; Yes: ignore the key and carry on reading the line
 $6E78 LD A,$08      ; Rub out the "> " prompt
 $6E7A CALL $7580    ; Print the character in A
 $6E7D CALL $7580    ; Print the character in A
 $6E80 XOR A         ; Return with Z set: repeat the last command
 $6E81 RET           ; Done

; Delete the whole input line
;
; Rubs out everything typed so far. While B has bit 7 reset (i.e. at least one character has been typed; see #R$6DCD), it prints a backspace, puts B back up by
; one and moves HL back one character.
; .
; Called for SYMBOL SHIFT + 0 by the line editor, and by #R$7240 before it types WAIT for an idle player, so that anything half-typed is thrown away and
; replaced by WAIT.
;
; Input:HL Current position in the input buffer
;       B Space left in the buffer
c$6E82 BIT 7,B       ; Stop when the line is empty
 $6E84 RET NZ        ; Return if the bit is set
 $6E85 LD A,$08      ; Print a backspace
 $6E87 CALL $7580    ; Print the character in A
 $6E8A INC B         ; One more character of space; step back in the buffer
 $6E8B DEC HL        ; Decrement HL
 $6E8C JR $6E82      ; Continue at Delete the whole input line (#R$6E82)

; Turn the next word of the input into a token
;
; The tokeniser. Starting at HL in the input buffer, it skips spaces, finds the next word or punctuation mark, and returns its class in A and a two-byte token
; in B (high) and C (low). HL is left after the word, ready for the next call. The address of the start of the word is stored at $B5CB so that an 'I don't know
; the word' message can quote it.
; .
; #TABLE(default)
; { =h Input | =h A | =h BC }
; { End of line (ENTER) | $C0 | $C000 }
; { Full stop | $B0 | $B000 }
; { Comma | $A0 | $A000 }
; { Double quote | $90 | $9000 }
; { A dictionary word | its class | class in the top nibble of B, then the 12-bit offset of the word from #R$6000 }
; { An unknown word | $D0 | undefined }
; TABLE#
; .
; The search works like this:
; .
; 1. #R$6F3E copies the typed letters (keeping only their low five bits, so case does not matter) into the buffer at #R$7071 and their count into $7081. It then
; uses the letter index at #R$6000 to find the first dictionary word beginning with the same letter, and unpacks that word into the buffer at #R$7082 (count in
; $7092). If there are no words for that letter, the word is unknown.
; .
; 2. #R$6FB1 compares the typed letters with the dictionary word, over the length of the shorter of the two.
; .
; 3. If they differ, #R$6F69 unpacks the next word in the dictionary and the comparison is repeated. The search gives up (unknown word) as soon as it reaches a
; word with a different first letter.
; .
; 4. If they agree, the lengths decide ($6EB7). If the dictionary word is at least as long as what was typed, it is accepted. So any abbreviation matches the
; first word that starts with those letters: this is why N means NORTH, but also why EX finds EXAMINE and not EXCEPT. If the player typed MORE letters than the
; dictionary word has, and the dictionary word is 1-3 letters long, it is rejected and the search moves on (so typing EASTWARD does not match E). If the
; dictionary word is 4 letters or longer, the game looks at the following dictionary word (#R$6F6D, without moving the current position); if that one also
; matches the typed letters, the search moves on to it, otherwise the current word is accepted. So extra letters after a long enough word are ignored: SWORDS
; finds SWORD, and TROLLS finds TROLLS rather than TROLL.
; .
; 5. For the accepted word ($6EE2), the end of the word is found. If bit 6 of the last letter is set, the word is a synonym and the next two bytes give the
; offset of the real word; HL is switched to that word, so for example HIT is returned as ATTACK. The class is then assembled from bits 5 and 6 of the real
; word's first two bytes (see #R$6040), and $A000 is added to the word's address to turn it into an offset from $6000 (because $6000 + $A000 = $10000).
;
;  Input:HL Position in the input buffer
; Output:A Word class
;        BC Token
;        HL Position after the word
c$6E8E PUSH DE        ; Save DE
*$6E8F LD A,(HL)      ; Skip spaces
 $6E90 INC HL         ; Increment HL
 $6E91 CP $20         ; Is it " "?
 $6E93 JR Z,$6E8F     ; If yes, go to #R$6E8F
 $6E95 DEC HL         ; Decrement HL
 $6E96 LD ($B5CB),HL  ; Remember where the word starts
 $6E99 CP $0D         ; End of the line?
 $6E9B JR Z,$6ED5     ; If yes, go to #R$6ED5
 $6E9D CALL $6F27     ; Punctuation?
 $6EA0 JR Z,$6EDA     ; If the routine returned with Z set, go to #R$6EDA
 $6EA2 CALL $6F3E     ; Copy the typed word and find the first dictionary word with the same first letter
 $6EA5 JR NZ,$6EB3    ; No words start with this letter: unknown word
 $6EA7 PUSH HL        ; Save HL
*$6EA8 CALL $6FB1     ; Compare the typed word with the dictionary word
 $6EAB JR Z,$6EB7     ; If the routine returned with Z set, go to #R$6EB7
*$6EAD CALL $6F69     ; Different: try the next dictionary word
 $6EB0 JR Z,$6EA8     ; If the routine returned with Z set, go to #R$6EA8
 $6EB2 POP HL         ; Restore HL
*$6EB3 LD A,$D0       ; Class $D0: unknown word
 $6EB5 JR $6ED7       ; Continue at #R$6ED7
*$6EB7 LD A,($7081)   ; Letters agree. Is the dictionary word at least as long as the typed word?
 $6EBA LD B,A         ; B = A
 $6EBB LD A,($7092)   ; A = the dictionary word length
 $6EBE CP B           ; Compare with B
 $6EBF JR NC,$6EE2    ; If carry clear, go to #R$6EE2
 $6EC1 CP $04         ; No: reject dictionary words of 1-3 letters
 $6EC3 JR C,$6EAD     ; If A < 4, go to #R$6EAD
 $6EC5 PUSH IX        ; Save IX
 $6EC7 CALL $6F6D     ; Otherwise, does the next dictionary word also fit?
 $6ECA JR NZ,$6EE0    ; If the routine returned with Z reset, go to #R$6EE0
 $6ECC CALL $6FB1     ; Call: Compare the typed word with a dictionary word (#R$6FB1)
 $6ECF JR NZ,$6EE0    ; If the routine returned with Z reset, go to #R$6EE0
 $6ED1 POP IX         ; Restore IX
 $6ED3 JR $6EAD       ; Continue at #R$6EAD
*$6ED5 LD A,$C0       ; End of line: class $C0
*$6ED7 LD BC,$0000    ; BC = 0
*$6EDA POP DE         ; Put the class into the top of B and return it in A
 $6EDB LD D,A         ; D = A
 $6EDC ADD A,B        ; Add A,B
 $6EDD LD B,A         ; B = A
 $6EDE LD A,D         ; A = D
 $6EDF RET            ; Done
*$6EE0 POP IX         ; Restore IX
*$6EE2 LD IX,($B607)  ; Accept the dictionary word at (B607): find its last letter
 $6EE6 PUSH IX        ; Save IX
 $6EE8 XOR A          ; A = 0
*$6EE9 INC IX         ; Increment IX
 $6EEB INC A          ; Increment A
 $6EEC BIT 7,(IX-$01) ; Test bit 7 of (IX-$01)
 $6EF0 JR Z,$6EE9     ; If the bit is clear, go to #R$6EE9
 $6EF2 CP $02         ; Compare with 2
 $6EF4 JR Z,$6EE9     ; If yes, go to #R$6EE9
 $6EF6 CP $03         ; Compare with 3
 $6EF8 JR NZ,$6F00    ; If no, go to #R$6F00
 $6EFA BIT 7,(IX-$02) ; Test bit 7 of (IX-$02)
 $6EFE JR NZ,$6EE9    ; If the bit is set, go to #R$6EE9
*$6F00 BIT 6,(IX-$01) ; Is it a synonym?
 $6F04 JR Z,$6F11     ; If the bit is clear, go to #R$6F11
 $6F06 LD L,(IX+$00)  ; Yes: switch to the word it stands for
 $6F09 LD H,(IX+$01)  ; H = (IX+1)
 $6F0C LD DE,$6000    ; DE = Dictionary letter index (#R$6000)
 $6F0F ADD HL,DE      ; Add HL,DE
 $6F10 EX (SP),HL     ; Swap HL with the value on top of the stack
*$6F11 POP HL         ; Restore HL
 $6F12 LD A,(HL)      ; Build the class from bits 5-6 of the first two bytes
 $6F13 RLCA           ; Rotate A left
 $6F14 AND $C0        ; Keep only the bits of $C0
 $6F16 LD B,A         ; B = A
 $6F17 INC HL         ; Increment HL
 $6F18 LD A,(HL)      ; A = (HL)
 $6F19 RRCA           ; Rotate A right
 $6F1A AND $30        ; Keep only the bits of $30
 $6F1C ADD A,B        ; Add A,B
 $6F1D DEC HL         ; Decrement HL
 $6F1E LD DE,$A000    ; Turn the address into an offset from $6000
 $6F21 ADD HL,DE      ; Add HL,DE
 $6F22 PUSH HL        ; Save HL
 $6F23 POP BC         ; Restore BC
 $6F24 POP HL         ; Restore HL
 $6F25 JR $6EDA       ; Continue at #R$6EDA

; Recognise punctuation
;
; Checks whether the character in A is a full stop, comma or double quote. If it is, HL is moved past it, A is set to the corresponding token class ($B0 for a
; full stop, the same as THEN; $A0 for a comma, the same as AND; $90 for a quote) and BC is set to 0; the Z flag is left set from the successful comparison. If
; not, the routine returns with the Z flag reset.
;
;  Input:A Character
;        HL Its address
; Output:F Z set if it was punctuation
;        A Token class
;        BC 0
c$6F27 LD B,$B0      ; Full stop: class $B0 (like THEN)
 $6F29 CP $2E        ; Is it "."?
 $6F2B JR Z,$6F38    ; If yes, go to #R$6F38
 $6F2D LD B,$A0      ; Comma: class $A0 (like AND)
 $6F2F CP $2C        ; Is it ","?
 $6F31 JR Z,$6F38    ; If yes, go to #R$6F38
 $6F33 CP $22        ; Double quote: class $90
 $6F35 RET NZ        ; Return if no
 $6F36 LD B,$90      ; B = 144
*$6F38 INC HL        ; Step past the punctuation mark
 $6F39 LD A,B        ; A = B
 $6F3A LD BC,$0000   ; BC = 0
 $6F3D RET           ; Done

; Start a dictionary search for the typed word
;
; Copies the letters of the word at HL into the buffer at #R$7071, keeping only the low five bits of each (so 'a' and 'A' are both 1). Characters below $40
; (space, punctuation, ENTER) end the word. The number of letters is stored at $7081.
; .
; The first letter (1-26) is then used to index the letter table at #R$6000, and IX is set to the first dictionary word starting with that letter. Execution
; continues into #R$6F69 to unpack it.
;
;  Input:HL Start of the typed word
; Output:HL End of the typed word
;        IX Dictionary word
;        F Z set if the dictionary word starts with the right letter
c$6F3E LD DE,$7071    ; Copy letters into the typed-word buffer
 $6F41 LD B,$00       ; B = 0
*$6F43 LD A,(HL)      ; A = (HL)
 $6F44 CP $40         ; Is it "@"?
 $6F46 JR C,$6F50     ; If A < 64, go to #R$6F50
 $6F48 AND $1F        ; Keep only the bits of $1F
 $6F4A LD (DE),A      ; Store A at (DE)
 $6F4B INC DE         ; Increment DE
 $6F4C INC HL         ; Increment HL
 $6F4D INC B          ; Increment B
 $6F4E JR $6F43       ; Continue at #R$6F43
*$6F50 LD A,B         ; Save the length
 $6F51 LD ($7081),A   ; Store A in the typed word length
 $6F54 PUSH HL        ; Save HL
 $6F55 LD HL,($7071)  ; Look up the first letter in the letter index
 $6F58 LD H,$00       ; H = 0
 $6F5A LD DE,$6000    ; DE = Dictionary letter index (#R$6000)
 $6F5D ADD HL,HL      ; Add HL,HL
 $6F5E ADD HL,DE      ; Add HL,DE
 $6F5F LD E,(HL)      ; E = (HL)
 $6F60 INC HL         ; Increment HL
 $6F61 LD D,(HL)      ; D = (HL)
 $6F62 LD IX,$6000    ; IX = Dictionary letter index (#R$6000)
 $6F66 ADD IX,DE      ; Add IX,DE
 $6F68 POP HL         ; Restore HL
; This entry point is used by #R$6E8E to move on to the next dictionary word. It saves IX in $B607 as the current candidate and then unpacks it. Another entry
; point at $6F6D does the same without updating $B607; the tokeniser uses that one to peek at the following word.
*$6F69 LD ($B607),IX  ; Store IX in the current dictionary word
; Check that the dictionary word at IX starts with the same letter as the typed word. If not, return with Z reset: the search is over.
*$6F6D LD A,(IX+$00)  ; A = (IX+0)
 $6F70 AND $1F        ; Keep only the bits of $1F
 $6F72 LD B,A         ; B = A
 $6F73 LD A,($7071)   ; A = the contents of $7071
 $6F76 CP B           ; Compare with B
 $6F77 RET NZ         ; Return if no
; Unpack the dictionary word into #R$7082. The same end-of-word rule is used everywhere: bit 7 marks the last letter, except in the first two bytes. Letter
; codes of 0 (padding) are not copied.
 $6F78 PUSH HL        ; Save HL
 $6F79 LD HL,$7082    ; HL = $7082
 $6F7C LD BC,$0000    ; BC = 0
*$6F7F LD A,(IX+$00)  ; A = (IX+0)
 $6F82 AND $1F        ; Keep only the bits of $1F
 $6F84 JR Z,$6F89     ; If it is zero, go to #R$6F89
 $6F86 LD (HL),A      ; Store A at (HL)
 $6F87 INC HL         ; Increment HL
 $6F88 INC B          ; Increment B
*$6F89 INC IX         ; Increment IX
 $6F8B INC C          ; Increment C
 $6F8C BIT 7,(IX-$01) ; Test bit 7 of (IX-$01)
 $6F90 JR Z,$6F7F     ; If the bit is clear, go to #R$6F7F
 $6F92 LD A,C         ; A = C
 $6F93 CP $02         ; Compare with 2
 $6F95 JR Z,$6F7F     ; If yes, go to #R$6F7F
 $6F97 CP $03         ; Compare with 3
 $6F99 JR NZ,$6FA1    ; If no, go to #R$6FA1
 $6F9B BIT 7,(IX-$02) ; Test bit 7 of (IX-$02)
 $6F9F JR NZ,$6F7F    ; If the bit is set, go to #R$6F7F
*$6FA1 POP HL         ; Restore HL
 $6FA2 LD A,B         ; A = B
 $6FA3 LD ($7092),A   ; Store A in the dictionary word length
; If this word is a synonym, skip the two bytes that point to the real word, so IX is left pointing at the next word in the dictionary.
 $6FA6 BIT 6,(IX-$01) ; Test bit 6 of (IX-$01)
 $6FAA RET Z          ; Return if the bit is clear
 $6FAB INC IX         ; Increment IX
 $6FAD INC IX         ; Increment IX
 $6FAF XOR A          ; A = 0
 $6FB0 RET            ; Done

; Compare the typed word with a dictionary word
;
; Compares the letters in #R$7071 (the typed word) with those in #R$7082 (the dictionary word), over the length of whichever is shorter. Returns with the Z flag
; set if they agree. The lengths themselves are dealt with by the caller (#R$6E8E).
;
; Output:F Z set if the letters match
c$6FB1 LD A,($7081)  ; B = the shorter of the two lengths
 $6FB4 LD B,A        ; B = A
 $6FB5 LD A,($7092)  ; A = the dictionary word length
 $6FB8 CP B          ; Compare with B
 $6FB9 JR NC,$6FBC   ; If carry clear, go to #R$6FBC
 $6FBB LD B,A        ; B = A
*$6FBC LD HL,$7071   ; Compare letter by letter
 $6FBF LD DE,$7082   ; DE = $7082
*$6FC2 LD A,(DE)     ; A = (DE)
 $6FC3 CP (HL)       ; Compare with the byte at (HL)
 $6FC4 RET NZ        ; Return if no
 $6FC5 INC DE        ; Increment DE
 $6FC6 INC HL        ; Increment HL
 $6FC7 DJNZ $6FC2    ; Loop back until B reaches 0
 $6FC9 RET           ; Done

; Clear the screen
;
; Sets the border to white, clears the whole display file ($4000-$57FF) to 0 and sets all 768 attributes ($5800-$5AFF) to $38: black ink on white paper, the
; colours The Hobbit uses throughout. Called once at start-up (#R$6C27) before the frame and first text are drawn.
c$6FCA PUSH HL       ; Save HL
 $6FCB PUSH DE       ; Save DE
 $6FCC PUSH BC       ; Save BC
 $6FCD LD A,$07      ; White border
 $6FCF OUT ($FE),A   ; Write to the port (border colour, beeper or printer)
 $6FD1 LD HL,$4000   ; Clear the pixels
 $6FD4 LD DE,$4001   ; DE = $4001
 $6FD7 LD BC,$1800   ; BC = $1800
 $6FDA LD (HL),$00   ; Store $00 at (HL)
 $6FDC LDIR          ; Copy BC bytes from HL to DE
 $6FDE LD BC,$0300   ; Black on white attributes
 $6FE1 LD (HL),$38   ; Store $38 at (HL)
 $6FE3 LDIR          ; Copy BC bytes from HL to DE
 $6FE5 POP BC        ; Restore BC
 $6FE6 POP DE        ; Restore DE
 $6FE7 POP HL        ; Restore HL
 $6FE8 RET           ; Done

; Initial prompt and command
;
; '> LOOK' followed by ENTER. At the start of a game (#R$6C27) this is printed as though the player had typed it, and 'LOOK' plus ENTER are copied into the
; input buffer so that the first turn describes Bilbo's surroundings.
t$6FE9 DEFM ">"      ; {The prompt
 $6FEA DEFM " "      ; }
 $6FEB DEFM "L"      ; {The first command (with ENTER)
 $6FEC DEFM "O"      ;
 $6FED DEFM "O"      ;
 $6FEE DEFM "K"      ;
 $6FEF DEFM $0D      ; }

; Input buffer
;
; The line typed by the player, 128 characters, filled by #R$6DCD and read by #R$6E8E. It is followed by a permanent ENTER at $7070 so that the tokeniser always
; finds an end even on a completely full line.
t$6FF0 DEFM " "
 $6FF1 DEFM " "
 $6FF2 DEFM " "
 $6FF3 DEFM " "
 $6FF4 DEFM " "
 $6FF5 DEFM " "
 $6FF6 DEFM " "
 $6FF7 DEFM " "
 $6FF8 DEFM " "
 $6FF9 DEFM " "
 $6FFA DEFM " "
 $6FFB DEFM " "
 $6FFC DEFM " "
 $6FFD DEFM " "
 $6FFE DEFM " "
 $6FFF DEFM " "
 $7000 DEFM " "
 $7001 DEFM " "
 $7002 DEFM " "
 $7003 DEFM " "
 $7004 DEFM " "
 $7005 DEFM " "
 $7006 DEFM " "
 $7007 DEFM " "
 $7008 DEFM " "
 $7009 DEFM " "
 $700A DEFM " "
 $700B DEFM " "
 $700C DEFM " "
 $700D DEFM " "
 $700E DEFM " "
 $700F DEFM " "
 $7010 DEFM " "
 $7011 DEFM " "
 $7012 DEFM " "
 $7013 DEFM " "
 $7014 DEFM " "
 $7015 DEFM " "
 $7016 DEFM " "
 $7017 DEFM " "
 $7018 DEFM " "
 $7019 DEFM " "
 $701A DEFM " "
 $701B DEFM " "
 $701C DEFM " "
 $701D DEFM " "
 $701E DEFM " "
 $701F DEFM " "
 $7020 DEFM " "
 $7021 DEFM " "
 $7022 DEFM " "
 $7023 DEFM " "
 $7024 DEFM " "
 $7025 DEFM " "
 $7026 DEFM " "
 $7027 DEFM " "
 $7028 DEFM " "
 $7029 DEFM " "
 $702A DEFM " "
 $702B DEFM " "
 $702C DEFM " "
 $702D DEFM " "
 $702E DEFM " "
 $702F DEFM " "
 $7030 DEFM " "
 $7031 DEFM " "
 $7032 DEFM " "
 $7033 DEFM " "
 $7034 DEFM " "
 $7035 DEFM " "
 $7036 DEFM " "
 $7037 DEFM " "
 $7038 DEFM " "
 $7039 DEFM " "
 $703A DEFM " "
 $703B DEFM " "
 $703C DEFM " "
 $703D DEFM " "
 $703E DEFM " "
 $703F DEFM " "
 $7040 DEFM " "
 $7041 DEFM " "
 $7042 DEFM " "
 $7043 DEFM " "
 $7044 DEFM " "
 $7045 DEFM " "
 $7046 DEFM " "
 $7047 DEFM " "
 $7048 DEFM " "
 $7049 DEFM " "
 $704A DEFM " "
 $704B DEFM " "
 $704C DEFM " "
 $704D DEFM " "
 $704E DEFM " "
 $704F DEFM " "
 $7050 DEFM " "
 $7051 DEFM " "
