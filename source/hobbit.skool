 $C790 DEFB $00,$B1,$C7,$00,$BF,$C7,$00,$C3         ; {Reaction table for Gandalf: default $C7B1; default $C7BF; default $C7C3; default $C7C9; default $C7CD; on
 $C798 DEFB $C7,$00,$C9,$C7,$00,$CD,$C7,$1D         ; GIVE TO: $C96E; on CAPTURE: $C962; on ATTACK WITH: $C94D
 $C7A0 DEFB $6E,$C9,$30,$62,$C9,$0F,$4D,$C9         ;
