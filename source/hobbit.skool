 $706A DEFM " "
 $706B DEFM " "
 $706C DEFM " "
 $706D DEFM " "
 $706E DEFM " "
 $706F DEFM " "
 $7070 DEFB $0D      ; ENTER

; Tokeniser work areas
;
; #LIST
; { $7071-$7080: the letters of the word being looked up (#R$6F3E), as values 1-26 }
; { $7081: the number of letters typed }
; { $7082-$7091: the letters of the dictionary word being compared with it (#R$6F69) }
; { $7092: the number of letters in the dictionary word }
; LIST#
b$7071 DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00 ; Typed word
 $7081 DEFB $00                                                             ; Its length
 $7082 DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00 ; Dictionary word
 $7092 DEFB $01                                                             ; Its length

; Token buffer
;
; The tokens for the current input line, two bytes each, high byte first, as built by the main loop (#R$6D0A) from the results of #R$6E8E and read by the parser
; (#R$7C4F). Space for 32 tokens. Because it is only rebuilt when a new line is typed, the '@' key (#R$6E71) can repeat the previous command by parsing it
; again.
b$7093 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $709B DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $70A3 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $70AB DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $70B3 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $70BB DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $70C3 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $70CB DEFB $00,$00,$00,$00,$00,$00,$00,$00

; Registers saved by the message printer
;
; #R$72D4 saves A at $70D3, DE at $70D4 and IX at $70D7 (with an unused byte at $70D6) while it runs, and restores them at the end.
b$70D3 DEFB $00      ; A
 $70D4 DEFB $00,$00  ; DE
 $70D6 DEFB $00
 $70D7 DEFB $00,$00  ; IX

; Clear a block of memory
;
; Writes B zero bytes starting at HL. A tiny utility used to clear the token buffer and other work areas.
;
; Input:B Number of bytes to clear
;       HL Start address
c$70D9 XOR A         ; A = 0
*$70DA LD (HL),A     ; Clear this byte
 $70DB INC HL        ; Move on to the next one
 $70DC DJNZ $70DA    ; {Repeat for however many bytes were asked for
 $70DE RET           ; }

; Get the address of an action table entry
;
; Returns HL = $AA3F + 8 x A, the address of the 8-byte entry for action number A in the action table (#R$AA47 is action 1; there is no action 0). The action
; number of the command being carried out is kept at $B5D8.
;
;  Input:A Action number
; Output:HL Action table entry
c$70DF LD L,A        ; {HL = the action number...
 $70E0 LD H,$00      ; }
 $70E2 ADD HL,HL     ; {...times 8, since each entry in the action table is 8 bytes...
 $70E3 ADD HL,HL     ;
 $70E4 ADD HL,HL     ; }
 $70E5 LD DE,$AA3F   ; {...added to the start of the action table itself
 $70E8 ADD HL,DE     ;
 $70E9 RET           ; }

; Collect the flag nibbles of an action table entry
;
; Each action table entry (#R$AA47) is four word references, and the top nibble of each high byte is a set of flags rather than part of the word. This routine
; gathers the four flag nibbles of the entry at IX into two bytes:
; .
; #LIST
; { $B60D = (top nibble of byte 3) + (top nibble of byte 1) / 16. Bit 4 of this byte means 'do not report this action' (#R$7122), bit 3 'mention the target',
; bit 2 'mention the instrument', bit 5 'leave out the article'. }
; { $B60E = (top nibble of byte 7) + (top nibble of byte 5) / 16. Bit 7 of this byte controls how the target and instrument are introduced. }
; LIST#
; .
; The value of $B60D is also returned in A.
;
;  Input:IX Action table entry
; Output:A Flags (also at $B60D)
c$70EA LD A,(IX+$05) ; A = the third word of this action, whose top nibble carries flag bits rather than a word class
 $70ED RRCA          ; {Shift those flag bits down into the bottom four...
 $70EE RRCA          ;
 $70EF RRCA          ;
 $70F0 RRCA          ; }
 $70F1 AND $0F       ; ...keeping just them
 $70F3 LD C,A        ; C = them
 $70F4 LD A,(IX+$07) ; {A = the fourth word's own flags, already conveniently in the top nibble
 $70F7 AND $F0       ; }
 $70F9 ADD A,C       ; Combine the two nibbles into a single byte
 $70FA LD ($B60E),A  ; This becomes the action's second set of flags
 $70FD LD A,(IX+$01) ; {Now do exactly the same with the first and second words instead...
 $7100 RRCA          ;
 $7101 RRCA          ;
 $7102 RRCA          ;
 $7103 RRCA          ;
 $7104 AND $0F       ;
 $7106 LD C,A        ;
 $7107 LD A,(IX+$03) ;
 $710A AND $F0       ;
 $710C ADD A,C       ; }
 $710D LD ($B60D),A  ; {...giving the action's main set of flags
 $7110 RET           ; }

; Report the action (if not inside a quotation)
;
; Marks the command as really happening ($B5EC=0, $B5EB=1) and, unless the parser is in the middle of a quotation ($B60B), prints the report of the action with
; #R$7122. Returns with A=0.
c$7111 XOR A         ; {The action has not yet been shown to work...
 $7112 LD ($B5EC),A  ; }
 $7115 INC A         ; {...but it really is being carried out now, not just tried
 $7116 LD ($B5EB),A  ; }
 $7119 LD A,($B60B)  ; {Are we in the middle of a quotation (an order being given to a character)?
 $711C AND A         ; }
 $711D CALL Z,$7122  ; If not, report the action in words ("you attack thorin.")
 $7120 XOR A         ; {Clear A before returning
 $7121 RET           ; }

; Report the action ("you attack thorin with the sword.")
;
; Prints the sentence that describes what an actor has just done, for example 'you go east.', 'thorin attacks you.', 'gandalf opens the round green door.' or
; 'you attack thorin with the short strong sword.'. It is built from the entry for the current action (number in $B5D8) in the action table #R$AA47, whose four
; word slots hold the verb, a particle, a preposition and (for movement) GO.
; .
; The flags collected by #R$70EA decide what is printed. If bit 4 of them is set the action is silent and nothing is printed at all.
; .
; Otherwise the actor's name is printed (#R$739E: 'you', 'thorin', 'gandalf'...). If the action was only being tried and would have failed ($B5EC is 0) the word
; CANNOT is inserted, so the report reads 'you cannot open the door'. The verb follows (#R$74B1). For the ten movement actions a special case applies when the
; actor is a character and the move is not possible: the word SOMEWHERE is printed instead of the direction. Then, as the flags require, the particle, the
; target object (#R$73AB, with its article) and the preposition plus instrument (#R$73BE) are added. The sentence ends with a full stop and a new line.
; .
; The printing is done with $70D6 set to 1, which makes #R$7436 use 'the' rather than 'a' for articles. $B5F2 is set when the action is only being tried, which
; sends the text to the lower window instead (see #R$7580).
c$7122 LD A,$01      ; A = 1
 $7124 LD ($70D6),A  ; Store A in the "definite article" flag
 $7127 XOR A         ; A = 0
 $7128 LD ($B5F4),A  ; Store A in the "print an article" flag
 $712B PUSH IY       ; Save IY
 $712D PUSH BC       ; Save BC
 $712E LD A,($B5EC)  ; A = the "it would work" flag
 $7131 LD B,A        ; B = A
 $7132 AND A         ; Is A zero?
 $7133 LD A,$01      ; A = 1
 $7135 JR Z,$7138    ; If it is zero, go to #R$7138
 $7137 XOR A         ; A = 0
*$7138 LD ($B5F2),A  ; Store A in the lower-window flag
 $713B PUSH IX       ; Save IX
 $713D PUSH HL       ; Save HL
 $713E PUSH DE       ; Save DE
 $713F LD A,($B5D8)  ; IX = the action table entry
 $7142 CALL $70DF    ; Call: Get the address of an action table entry (#R$70DF)
 $7145 PUSH HL       ; Save HL
 $7146 POP IX        ; Restore IX
 $7148 XOR A         ; Only start a new line for the player when the action really happens
 $7149 CP B          ; Compare with B
 $714A JR Z,$7153    ; If yes, go to #R$7153
 $714C LD A,($B5DB)  ; A = the actor
 $714F AND A         ; Is A zero?
 $7150 CALL Z,$7578  ; If zero/equal: print a new line
*$7153 CALL $70EA    ; Get the flags; bit 4 set means say nothing
 $7156 BIT 4,A       ; Test bit 4 of A
 $7158 LD C,A        ; C = A
 $7159 JP NZ,$71C0   ; If the bit is set, go to #R$71C0
 $715C CALL $739E    ; Print the actor
 $715F LD DE,$00EE   ; "cannot" if the action would not work
 $7162 XOR A         ; A = 0
 $7163 CP B          ; Compare with B
 $7164 CALL Z,$74B8  ; If zero/equal: call: Print a dictionary word (#R$74B8)
 $7167 PUSH HL       ; Save HL
 $7168 LD DE,$0006   ; DE = 6
 $716B ADD HL,DE     ; Add HL,DE
 $716C CALL $74B1    ; Print the verb
 $716F CALL $954D    ; A character that cannot move goes "somewhere"
 $7172 POP HL        ; Restore HL
 $7173 JR NC,$7186   ; If the routine returned with carry reset, go to #R$7186
 $7175 LD A,($B5D8)  ; A = the action
 $7178 CP $0B        ; Is it action 11 (STRIKE WITH)?
 $717A JR NC,$7186   ; If A >= 11, go to #R$7186
 $717C LD DE,$0AEA   ; DE = $0AEA
 $717F INC HL        ; Increment HL
 $7180 INC HL        ; Increment HL
 $7181 CALL $74B8    ; Call: Print a dictionary word (#R$74B8)
 $7184 JR $7189      ; Continue at #R$7189
*$7186 CALL $74B1    ; Call: Print a word from a list (#R$74B1)
*$7189 BIT 3,C       ; Target wanted?
 $718B JR Z,$719D    ; If the bit is clear, go to #R$719D
 $718D BIT 5,C       ; Test bit 5 of C
 $718F CALL NZ,$74B1 ; If not zero/not equal: call: Print a word from a list (#R$74B1)
 $7192 LD A,($B60E)  ; A = the action's second flags
 $7195 BIT 7,A       ; Test bit 7 of A
 $7197 CALL NZ,$74B1 ; If not zero/not equal: call: Print a word from a list (#R$74B1)
 $719A CALL $73AB    ; Call: #R$73AB
*$719D LD A,($B5DA)  ; Instrument wanted?
 $71A0 CP $FF        ; Is it nobody ($FF)?
 $71A2 JR Z,$71B8    ; If yes, go to #R$71B8
 $71A4 BIT 2,C       ; Test bit 2 of C
 $71A6 JR Z,$71B8    ; If the bit is clear, go to #R$71B8
 $71A8 BIT 5,C       ; Test bit 5 of C
 $71AA CALL Z,$74B1  ; If zero/equal: call: Print a word from a list (#R$74B1)
 $71AD LD A,($B60E)  ; A = the action's second flags
 $71B0 BIT 7,A       ; Test bit 7 of A
 $71B2 CALL Z,$74B1  ; If zero/equal: call: Print a word from a list (#R$74B1)
 $71B5 CALL $73BE    ; Call: Print the instrument (#R$73BE)
*$71B8 LD A,$2E      ; End the sentence
 $71BA CALL $7580    ; Print the character in A
 $71BD CALL $7578    ; Print a new line
*$71C0 XOR A         ; A = 0
 $71C1 LD ($70D6),A  ; Store A in the "definite article" flag
 $71C4 POP DE        ; Restore DE
 $71C5 POP HL        ; Restore HL
 $71C6 POP IX        ; Restore IX
 $71C8 POP BC        ; Restore BC
 $71C9 POP IY        ; Restore IY
 $71CB RET           ; Done

; Get the address of a room's word list
;
; Returns HL pointing at the name words of room A (the record address from #R$9B0C plus 2). IX is preserved. Used when a message needs to name a room rather
; than an object.
;
;  Input:A Room number
; Output:HL Room name words
c$71CC PUSH IX       ; Save the caller's IX
 $71CE CALL $9B0C    ; IX = room A's own record
 $71D1 PUSH IX       ; {HL = that same address...
 $71D3 POP HL        ; }
 $71D4 INC HL        ; {...moved on 2 bytes, to the room's own name words
 $71D5 INC HL        ; }
 $71D6 POP IX        ; {Restore the caller's IX
 $71D8 RET           ; }

; Get the address of an object's word list
;
; Returns HL pointing at the four word slots of object A (its record address from #R$9B25 plus 8: the noun and adjectives). DE and IX are preserved.
;
;  Input:A Object number
; Output:HL Object's words
c$71D9 PUSH DE       ; Save the caller's DE
 $71DA PUSH IX       ; Save the caller's IX
 $71DC CALL $9B25    ; IX = object A's own record
 $71DF PUSH IX       ; {HL = that same address...
 $71E1 POP HL        ; }
 $71E2 LD DE,$0008   ; {...moved on 8 bytes, to the object's own word slots
 $71E5 ADD HL,DE     ; }
 $71E6 POP IX        ; Restore the caller's IX
 $71E8 POP DE        ; {Restore the caller's DE
 $71E9 RET           ; }

; Match a command against an action table entry
;
; Compares the verb, particle and preposition in an action table entry (at HL) with those of the parsed command (at IY) using #R$7225. The verb must match. The
; particle and preposition may match in the same order, or crossed over, so that for example both 'take off the ring' and 'take the ring off' find the TAKE OFF
; action.
; .
; Returns with Z set for a match; A is 0 if the words matched in order and 1 if they were crossed over, and $B5D0 is set to 1 once the verb alone has matched
; (so the caller can tell 'wrong verb' from 'right verb, wrong words').
;
;  Input:HL Action table entry
;        IY Parsed command
; Output:F Z set if they match
;        A 0 = in order, 1 = crossed over
c$71EA PUSH DE       ; {Save the caller's DE, HL and IY
 $71EB PUSH HL       ;
 $71EC PUSH IY       ; }
 $71EE CALL $7225    ; Do the verbs match? (this also moves both pointers on to their next word)
 $71F1 JR NZ,$7220   ; No: there is no match at all - give up straight away
 $71F3 LD A,$01      ; Record that at least the verb has matched...
 $71F5 LD ($B5D0),A  ; ...so a later failure can be blamed on "the wrong words", not "an unknown verb"
 $71F8 CALL $7225    ; Do the particles match, in the same order?
 $71FB JR NZ,$7204   ; No: they might just be the wrong way round - go and check that below
 $71FD CALL $7225    ; They do: now do the prepositions match too, in the same order?
 $7200 LD A,$00      ; If so, this is a plain, in-order match
 $7202 JR Z,$7220    ; ...so finish here, with A=0
*$7204 POP IY        ; Not a straightforward match: restore the command's own pointer...
 $7206 POP HL        ; ...and the action-entry's pointer, saved right at the very start...
 $7207 PUSH HL       ; {...pushing them straight back so they can be recovered again below
 $7208 PUSH IY       ; }
 $720A LD DE,$0004   ; {Move the command's pointer on 4 bytes, to its own preposition word...
 $720D ADD IY,DE     ; }
 $720F INC HL        ; {...and the action-entry's pointer on 2, to its particle word instead
 $7210 INC HL        ; }
 $7211 CALL $7225    ; Does the entry's PARTICLE match the command's own PREPOSITION?
 $7214 JR NZ,$7220   ; No: there is no match, in either order
 $7216 LD DE,$FFFC   ; {Move the command's pointer back 4, to its own particle word...
 $7219 ADD IY,DE     ; }
 $721B CALL $7225    ; ...and does THAT match the entry's PREPOSITION?
 $721E LD A,$01      ; Yes: it is a match, but with particle and preposition crossed over
*$7220 POP IY        ; {Restore the caller's IY, HL and DE
 $7222 POP HL        ;
 $7223 POP DE        ;
 $7224 RET           ; }

; Compare two word references
;
; Compares the word reference at HL with the one at IY (both stored low byte first) and then moves both pointers on by two bytes. Only the low 12 bits count
; (the offset from #R$6000), so the class or flag bits in the top nibble are ignored.
; .
; Returns with the Z flag set if the words are the same, or if the reference at HL is zero (an empty slot, which ends a list of words). Used five times by the
; routine at #R$71D9 when matching the words the player typed against the four word slots of an object record (#R$C00B).
;
;  Input:HL Word reference
;        IY Word reference
; Output:F Z set if they match (or HL points to 0)
c$7225 PUSH HL       ; Save HL
 $7226 LD A,(HL)     ; Is the word at HL empty?
 $7227 INC HL        ; Increment HL
 $7228 OR (HL)       ; Combine with (HL)
 $7229 JR Z,$7238    ; If it is zero, go to #R$7238
 $722B LD A,(IY+$01) ; Compare the top four bits of the offset...
 $722E XOR (HL)      ; Flip the bits in (HL)
 $722F AND $0F       ; Keep only the bits of $0F
 $7231 JR NZ,$7238   ; If it is not zero, go to #R$7238
 $7233 DEC HL        ; ...and the bottom eight
 $7234 LD A,(HL)     ; A = (HL)
 $7235 CP (IY+$00)   ; Compare with the byte at (IY+$00)
*$7238 POP HL        ; Move both pointers on
 $7239 INC HL        ; Increment HL
 $723A INC HL        ; Increment HL
 $723B INC IY        ; Increment IY
 $723D INC IY        ; Increment IY
 $723F RET           ; Done

; Wait for a key, typing WAIT if the player is idle
;
; Polls the keyboard (#R$7B86) until a key is pressed, counting the polls down from the value at $B604. Each poll includes the 1000-iteration delay in #R$7B6B,
; so it takes something like 8 ms, and the starting value of 3000 set by #R$6DCD gives the player roughly 20-25 seconds (my estimate from the instruction
; timings).
; .
; When a key is pressed, 500 is added to what is left of the count, up to a maximum of 3000, so steady typing keeps the time topped up.
; .
; If the count runs out, the game takes over: whatever has been typed is erased (#R$6E82), the four characters 'WAIT' from #R$7288 are put into the input buffer
; and printed, B is set to $7C (four characters used), the count is reset to 3000, and an ENTER is returned as if the player had pressed it. The line editor
; then finishes the line and the WAIT command is carried out. This is how time passes in The Hobbit even when the player does nothing, and why the other
; characters can go off and do things - or attack you - while you are thinking.
;
;  Input:HL Current position in the input buffer
; Output:A Key code
c$7240 PUSH HL       ; Save HL
 $7241 LD HL,($B604) ; HL = polls left before WAIT
*$7244 CALL $7B86    ; Is a key being pressed?
 $7247 AND A         ; Is A zero?
 $7248 JR NZ,$726A   ; If it is not zero, go to #R$726A
 $724A DEC HL        ; No: count down
 $724B LD A,H        ; A = H
 $724C OR L          ; Combine with L
 $724D JR NZ,$7244   ; If it is not zero, go to #R$7244
 $724F POP HL        ; Restore HL
 $7250 PUSH HL       ; Save HL
 $7251 CALL $6E82    ; Time up: rub out what has been typed
 $7254 LD DE,$7288   ; Put WAIT into the buffer and print it
 $7257 LD B,$04      ; B = 4
*$7259 LD A,(DE)     ; A = (DE)
 $725A LD (HL),A     ; Store A at (HL)
 $725B INC HL        ; Increment HL
 $725C INC DE        ; Increment DE
 $725D CALL $7580    ; Print the character in A
 $7260 DJNZ $7259    ; Loop back until B reaches 0
 $7262 EX (SP),HL    ; Swap HL with the value on top of the stack
 $7263 LD B,$7C      ; Four characters used; return ENTER
 $7265 LD A,$0D      ; A = 13
 $7267 LD HL,$FE0C   ; This makes the addition below overflow, so the count is reset to 3000
*$726A PUSH AF       ; Save AF
 $726B XOR A         ; A = 0
 $726C LD DE,$01F4   ; Add 500 to the polls left...
 $726F ADC HL,DE     ; Add HL,DE with carry
 $7271 LD DE,$0BB8   ; ...but no more than 3000
 $7274 JR C,$727B    ; If carry is set, go to #R$727B
 $7276 CALL $7282    ; Call: Compare HL with DE (#R$7282)
 $7279 JR C,$727C    ; If the routine returned with carry set, go to #R$727C
*$727B EX DE,HL      ; Swap DE and HL
*$727C LD ($B604),HL ; Save the new count
 $727F POP AF        ; Restore AF
 $7280 POP HL        ; Restore HL
 $7281 RET           ; Done

; Compare HL with DE
;
; A 16-bit comparison: compares H with D and, if they are equal, L with E. Returns with Z set if HL=DE, and the carry flag set if HL is less than DE. A is
; corrupted.
;
;  Input:HL First number
;        DE Second number
; Output:F Z set if equal, carry set if HL<DE
c$7282 LD A,H        ; A = HL's high byte
 $7283 SUB D         ; Subtract DE's high byte
 $7284 RET NZ        ; Different: HL and DE are not equal (the carry flag also shows which is bigger)
 $7285 LD A,L        ; {Same high byte: now compare the low bytes
 $7286 SUB E         ;
 $7287 RET           ; }

; The WAIT command
;
; The four letters typed automatically by #R$7240 when the player is idle.
t$7288 DEFM "W"
 $7289 DEFM "A"
 $728A DEFM "I"
 $728B DEFM "T"

; Message interpreter control-code jump table
;
; Addresses of the handlers for message control codes $00 to $16, used by #R$72D4:
; .
; #TABLE(default)
; { =h Code | =h Handler | =h Meaning }
; { $00 | #R$735E | print the object whose address the caller pushed on the stack }
; { $01 | #R$736D | print the word the caller pushed on the stack }
; { $02 | #R$7375 | jump forwards or backwards by the signed byte that follows }
; { $03 | #R$7384 | print the noun of the instrument in the current command ($B5ED) }
; { $04 | #R$738B | print the pushed word with an article (a/an/the/some) }
; { $05, $0A, $0F, $12 | $7382 | do nothing }
; { $06 | #R$739A | print the actor's name }
; { $07 | #R$73A6 | print the target with its article }
; { $08 | $73B4 | print a backspace (to join a word to the previous one) }
; { $09 | $73B9 | print the instrument with its article }
; { $0B | #R$73D7 | call a sub-message at a relative address }
; { $0C | #R$73F0 | print HIS or YOUR for the actor }
; { $0D | #R$72BA | new line }
; { $0E | #R$73FE | print HIS or YOUR for the target }
; { $10 | #R$7403 | print the actor's name and IS or ARE }
; { $11 | #R$741C | the same for the target }
; { $13 | #R$7424 | the same for an object pushed on the stack }
; { $14 | #R$7337 | end the message with a new line }
; { $15 | #R$733B | end the message with a full stop and a new line }
; { $16 | $7352 | end the message }
; TABLE#
; .
; The IS/ARE and HIS/YOUR codes are what let one message serve both the player and the characters: 'you are dead' and 'thorin is dead' are the same message.
w$728C DEFW $735E    ; {Handlers for codes $00-$16
 $728E DEFW $736D    ;
 $7290 DEFW $7375    ;
 $7292 DEFW $7384    ;
 $7294 DEFW $738B    ;
 $7296 DEFW $7382    ;
 $7298 DEFW $739A    ;
 $729A DEFW $73A6    ;
 $729C DEFW $73B4    ;
 $729E DEFW $73B9    ;
 $72A0 DEFW $7382    ;
 $72A2 DEFW $73D7    ;
 $72A4 DEFW $73F0    ;
 $72A6 DEFW $72BA    ;
 $72A8 DEFW $73FE    ;
 $72AA DEFW $7382    ;
 $72AC DEFW $7403    ;
 $72AE DEFW $741C    ;
 $72B0 DEFW $7382    ;
 $72B2 DEFW $7424    ;
 $72B4 DEFW $7337    ;
 $72B6 DEFW $733B    ;
 $72B8 DEFW $7352    ; }

; Print a character from a message
;
; Used by the message interpreter for literal characters and control code $0D. The character is printed (#R$7580) and, if it was a carriage return, the 'last
; punctuation' flag at $B5F5 is cleared.
c$72BA CALL $7580    ; Print the character
 $72BD CP $0D        ; Was it a new line?
 $72BF RET NZ        ; No: nothing more to do
 $72C0 XOR A         ; {Yes: a fresh line has begun, so clear the "last punctuation" flag
 $72C1 LD ($B5F5),A  ;
 $72C4 RET           ; }

; Print "I cannot do that."
;
; Prints the message at $AEB2.
c$72C5 LD HL,$AEB2   ; "I cannot do that."
 $72C8 JR $72D4      ; Print it

; Print a message, suppressing actions inside a quotation
;
; If the parser is inside a quotation ($B60B set), the 'really do it' flag $B5EB is cleared first, so that commands being passed to another character are only
; tried, not carried out. Execution continues into #R$72D4.
c$72CA LD A,($B60B)  ; {Are we in the middle of a quotation (an order being given to a character)?
 $72CD AND A         ; }
 $72CE JR Z,$72D4    ; No: print the message as normal
 $72D0 XOR A         ; Yes: make sure this only counts as a trial, not something that really happens to the world...
 $72D1 LD ($B5EB),A  ; ...then fall into the ordinary message printer

; Print a message (message bytecode interpreter)
;
; Almost everything the game says is printed by this routine, which interprets a compact message 'bytecode' starting at the address in HL. Messages are not
; stored as ASCII; they are sequences of dictionary references and control codes, which is how The Hobbit fits so much text into 48K.
; .
; The entry at $72D4 saves DE, IX and A (restored at the end, $7352) so callers do not lose them. If the command is only being tried ($B5EB is 0) the flag $B5EC
; is cleared.
; .
; The loop at $72EB fetches a byte and decides what it is:
; .
; #LIST
; { $80-$FF: the first byte of a two-byte dictionary reference, high byte first. The low nibble of the first byte and all of the second give the word's offset
; from #R$6000; the three remaining flag bits (bits 4-6) choose an ending. Flag values 2, 3 and 6 mean 'this is the last word of the message': 2 just stops, 3
; adds a full stop and a new line, 6 adds a new line (#R$733F). Other values are passed on to #R$74B8 as printing flags (for example 'add an S'). }
; { $60-$7F: one of the 32 most common words, looked up in #R$AC31 by #R$748A. }
; { $20-$5F: a literal character, printed by #R$72BA. }
; { $00-$1F: a control code, dispatched through the table at #R$728C. }
; LIST#
; .
; Control codes below $14 are called as subroutines. A handler that returns with Z set lets the interpreter move on to the next byte; one that returns with Z
; reset asks it to print the dictionary word now in DE (so a handler can choose a word such as HIS or YOUR and have it printed). Codes $14 and above end the
; message.
; .
; Several control codes take an extra parameter from the stack: the caller pushes an object address or a word before calling the interpreter, and the handler
; removes it (see #R$735E).
; .
; The same interpreter runs the little scripts attached to rooms and objects, which is why the room and object tables contain what look like fragments of
; messages.
;
; Input:HL Address of the message bytecode
c$72D4 LD ($70D4),DE ; Store DE at $70D4
 $72D8 LD ($70D7),IX ; Store IX at $70D7
 $72DC LD ($70D3),A  ; Store A at $70D3
 $72DF LD A,($B5EB)  ; A = the "really do it" flag
 $72E2 AND A         ; Is A zero?
 $72E3 JR NZ,$72E8   ; If it is not zero, go to #R$72E8
 $72E5 LD ($B5EC),A  ; Store A in the "it would work" flag
; This entry point is used by the routine at #R$73D7.
*$72E8 PUSH HL       ; Save HL
 $72E9 POP IX        ; Restore IX
*$72EB LD A,(IX+$00) ; A = (IX+0)
 $72EE BIT 7,A       ; Bit 7 set: a dictionary word reference
 $72F0 JR Z,$730F    ; If the bit is clear, go to #R$730F
 $72F2 AND $7F       ; Keep only the bits of $7F
 $72F4 LD D,A        ; D = A
 $72F5 LD E,(IX+$01) ; E = (IX+1)
 $72F8 INC IX        ; Increment IX
 $72FA AND $F0       ; Flag values 3, 2 and 6 end the message
 $72FC CP $30        ; Is it "0"?
 $72FE JR Z,$733F    ; If yes, go to Print the last word of a message and finish (#R$733F)
 $7300 CP $20        ; Is it " "?
 $7302 JR Z,$733F    ; If yes, go to Print the last word of a message and finish (#R$733F)
 $7304 CP $60        ; Is it "`"?
 $7306 JR Z,$733F    ; If yes, go to Print the last word of a message and finish (#R$733F)
; This entry point is used by the routine at #R$748A.
*$7308 CALL $74B8    ; Print an ordinary dictionary word
*$730B INC IX        ; Increment IX
 $730D JR $72EB      ; Continue at #R$72EB
*$730F CP $20        ; Otherwise: control code, abbreviation or literal character
 $7311 JR C,$731D    ; If A < 32, go to #R$731D
 $7313 CP $60        ; Is it "`"?
 $7315 JP NC,$748A   ; $60-$7F: one-byte abbreviation
 $7318 CALL $72BA    ; Call: Print a character from a message (#R$72BA)
 $731B JR $730B      ; Continue at #R$730B
*$731D PUSH DE       ; Save DE
 $731E LD E,A        ; E = A
 $731F LD D,$00      ; D = 0
 $7321 LD HL,$728C   ; $00-$1F: index into the control-code jump table
 $7324 ADD HL,DE     ; Add HL,DE
 $7325 ADD HL,DE     ; Add HL,DE
 $7326 LD E,(HL)     ; E = (HL)
 $7327 INC HL        ; Increment HL
 $7328 LD D,(HL)     ; D = (HL)
 $7329 EX DE,HL      ; Swap DE and HL
 $732A POP DE        ; Restore DE
 $732B CP $14        ; Codes $14 and above end the message
 $732D JR NC,$7336   ; If A >= 20, go to #R$7336
 $732F CALL $7336    ; Call the handler; Z set means carry on
 $7332 JR Z,$730B    ; If the routine returned with Z set, go to #R$730B
 $7334 JR $7308      ; Z reset: print the word in DE, then carry on
*$7336 JP (HL)       ; Jump to the address in HL

; Message code $14: end with a new line
;
; Sets D to $60 (the 'new line' ending) and joins #R$733F after the word has been printed.
c$7337 LD D,$60      ; Flags meaning "add a new line after this word"
 $7339 JR $7342      ; Join the shared ending below

; Message code $15: end with a full stop
;
; Sets D to $30 (the 'full stop' ending) and joins #R$733F.
c$733B LD D,$30      ; Flags meaning "add a full stop, then a new line"
 $733D JR $7342      ; Join the shared ending below

; Print the last word of a message and finish
;
; Prints the word in DE (#R$74B8) and then ends the message according to the flags in D: bit 6 set gives a new line; otherwise bit 4 set gives a full stop and a
; new line; if neither, nothing is added. Finally the registers saved on entry to #R$72D4 (A, DE and IX) are restored and the interpreter returns to its caller.
;
; Input:DE Word (flags in the top nibble of D)
c$733F CALL $74B8    ; Print the word left over in DE
; This entry point is used by the routines at #R$7337 and #R$733B.
*$7342 LD A,$2E      ; "."
 $7344 BIT 6,D       ; Does the message want a new line here?
 $7346 JR NZ,$734F   ; If so, skip the full stop
 $7348 BIT 4,D       ; Does it want a full stop instead?
 $734A CALL NZ,$7580 ; If so, print it
 $734D BIT 4,D       ; (Tested again, this time to decide whether a new line follows the full stop)
*$734F CALL NZ,$7578 ; Print the new line
 $7352 LD DE,($70D4) ; Restore the DE the caller of this whole message had, before it began...
 $7356 LD IX,($70D7) ; ...and its IX...
 $735A LD A,($70D3)  ; ...and its A, all saved back at the very start (#R$72D4)
 $735D RET           ; The message is finished

; Message code $00: print an object passed on the stack
;
; The caller of #R$72D4 pushed the address of an object's word list before calling. This handler reaches past the interpreter's own return addresses (POP DE /
; POP HL / EX (SP),HL / PUSH DE), removes that parameter, and prints the object's name (#R$742B) unless the address is 0. The 'use an article' flag $B5F4 is
; cleared first, so no article is printed. Returns with Z set.
c$735E XOR A         ; {No article wanted before this name
 $735F LD ($B5F4),A  ; }
 $7362 POP DE        ; {Reach past the interpreter's own two return addresses...
 $7363 POP HL        ; }
 $7364 EX (SP),HL    ; ...to find the object's own word-list address the caller pushed, lifting it out...
 $7365 PUSH DE       ; ...and putting the two return addresses back exactly as they were
 $7366 LD A,H        ; {Is that address 0 (meaning "nothing to name")?
 $7367 OR L          ; }
 $7368 CALL NZ,$742B ; If not, print the object's name
 $736B XOR A         ; {Tell the interpreter to just carry on: nothing further needs printing
 $736C RET           ; }

; Message code $01: print a word passed on the stack
;
; Removes a word reference that the caller pushed on the stack (in the same way as #R$735E) and returns it in DE with Z reset, which makes the interpreter print
; it.
c$736D POP DE        ; {Reach past the interpreter's own two return addresses...
 $736E POP HL        ; }
 $736F EX (SP),HL    ; ...to find the word the caller pushed, lifting it out...
 $7370 PUSH DE       ; ...and putting the two return addresses back
 $7371 EX DE,HL      ; DE = that word
 $7372 OR $01        ; Make sure A is not zero...
 $7374 RET           ; ...so the interpreter is told to print the word now in DE

; Message code $02: relative jump
;
; Moves the message pointer IX by the signed byte that follows the code, so a message can skip over part of itself or loop. Returns with Z set. The entry point
; at $7382 (XOR A / RET) is used by the codes that do nothing.
c$7375 LD E,(IX+$01) ; {E = the signed jump distance that follows this code
 $7378 LD D,$00      ; }
 $737A BIT 7,E       ; {Is it negative?
 $737C JR Z,$7380    ; }
 $737E LD D,$FF      ; If so, sign-extend it into D
*$7380 ADD IX,DE     ; Move the message pointer by that many bytes
 $7382 XOR A         ; {Tell the interpreter to just carry on from the new position
 $7383 RET           ; }

; Message code $03: print the instrument's noun
;
; Returns the word stored at $B5ED (the noun the player used for the instrument, e.g. SWORD in 'hit thorin with the sword') in DE with Z reset, so the
; interpreter prints it.
c$7384 LD DE,($B5ED) ; DE = the noun the player used for the instrument (e.g. SWORD)
 $7388 OR $01        ; Make A non-zero...
 $738A RET           ; ...so the interpreter prints it

; Message code $04: print a word with an article
;
; Removes a word from the stack (as #R$736D) and prints it with an article, by setting $B5F4 and calling #R$746F. Returns with Z set.
c$738B POP DE        ; {Reach past the interpreter's own two return addresses...
 $738C POP HL        ; }
 $738D EX (SP),HL    ; ...to find the word the caller pushed, lifting it out...
 $738E PUSH DE       ; ...and putting the two return addresses back
 $738F EX DE,HL      ; DE = that word
 $7390 LD A,$01      ; {This time an article is wanted first...
 $7392 LD ($B5F4),A  ; }
 $7395 CALL $746F    ; ...so print it that way
 $7398 XOR A         ; {Already printed: tell the interpreter nothing more is needed
 $7399 RET           ; }

; Message code $06: print the actor's name
;
; Prints the name of the current actor ($B5DB) with no article, via #R$747F: 'you' for Bilbo, 'thorin', 'gandalf' and so on. The entry point at $739E is used by
; #R$7122 without clearing the article flag.
c$739A XOR A         ; {No article for a name
 $739B LD ($B5F4),A  ; }
; This entry point is used by the routine at #R$7122.
*$739E LD A,($B5DB)  ; A = the current actor
 $73A1 CALL $747F    ; Print their name ("you", "thorin"...)
 $73A4 XOR A         ; {Already printed: nothing more needed
 $73A5 RET           ; }

; Message code $07: print the target
;
; Prints the target of the command (object $B5D9) with its article. If $B5EF is set, the target is a room rather than an object, and the room's name is used
; instead (#R$71CC rather than #R$71D9). The entry at $73AB is used by #R$7122. Code $08 ($73B4) prints a backspace, and code $09 ($73B9) sets the article flag
; and continues into #R$73BE.
c$73A6 LD A,$01      ; {An article is wanted
 $73A8 LD ($B5F4),A  ; }
; This entry point is used by the routine at #R$7122.
*$73AB LD A,($B5EF)  ; {Is the target actually a room, rather than an object?
 $73AE AND A         ; }
 $73AF LD A,($B5D9)  ; A = the target's own number, either way
 $73B2 JR $73C5      ; Join the shared printing code below

; Message codes $08 and $09
;
; Code $08 ($73B4) prints a backspace, so that a word can be joined to the one before it (for example to add a suffix). Code $09 ($73B9) sets the 'print an
; article' flag and prints the instrument with its article, continuing into #R$73BE.
c$73B4 CALL $7580    ; CODE $08: print a backspace, joining this word onto the one before it
 $73B7 XOR A         ; {Nothing further to print
 $73B8 RET           ; }
 $73B9 LD A,$01      ; CODE $09: an article is wanted...
 $73BB LD ($B5F4),A  ; ...then fall into the shared code below, which prints the instrument

; Print the instrument
;
; Prints the instrument (the 'with' object, number in $B5DA) with its article; if $B5F0 is set the instrument is a room. Shares its tail with #R$73A6: the words
; are found with #R$71CC or #R$71D9 and printed with #R$742B.
c$73BE LD A,($B5F0)  ; {Is the instrument actually a room, rather than an object?
 $73C1 AND A         ; }
 $73C2 LD A,($B5DA)  ; A = the instrument's own number, either way
; This entry point is used by the routine at #R$73A6.
*$73C5 JR Z,$73CD    ; Not a room: skip ahead
 $73C7 PUSH HL       ; Save HL
 $73C8 CALL $71CC    ; {HL = that room's own name words
 $73CB JR $73D1      ; }
; This entry point is used by the routine at #R$747F.
*$73CD PUSH HL       ; Save HL
 $73CE CALL $71D9    ; HL = that object's own words
*$73D1 CALL $742B    ; Print them
 $73D4 POP HL        ; Restore HL
 $73D5 XOR A         ; {Already printed
 $73D6 RET           ; }

; Message code $0B: call a sub-message
;
; Interprets the message at a relative address (the signed byte after the code, counted from that byte) as a subroutine, by calling #R$72E8 recursively, and
; then continues with the current message. This lets common phrases be shared between messages.
c$73D7 INC IX        ; Step past this code, to its jump-distance byte
 $73D9 PUSH IX       ; {HL = that same address...
 $73DB POP HL        ; }
 $73DC PUSH HL       ; ...save it, ready to measure the jump from
 $73DD LD E,(IX+$00) ; {E = the signed jump distance
 $73E0 LD D,$00      ; }
 $73E2 BIT 7,E       ; {Negative?
 $73E4 JR Z,$73E8    ; }
 $73E6 LD D,$FF      ; If so, sign-extend it into D
*$73E8 ADD HL,DE     ; HL = the address of the sub-message
 $73E9 CALL $72E8    ; Print it, as a complete message in its own right
 $73EC POP IX        ; Restore IX to just after the jump-distance byte, so the outer message carries on from there
 $73EE XOR A         ; {Already printed
 $73EF RET           ; }

; Message code $0C: HIS or YOUR (actor)
;
; Returns the word YOUR if the actor is Bilbo (object 0) and HIS for anyone else, with Z reset so that the interpreter prints it. The entry at $73F3 is shared
; with #R$73FE.
c$73F0 LD A,($B5DB)  ; A = the current actor
; This entry point is used by the routine at #R$73FE.
*$73F3 LD DE,$0990   ; DE = HIS
 $73F6 AND A         ; Is the actor Bilbo (0)?
 $73F7 RET NZ        ; No: HIS is right, and Z is already reset, so the interpreter prints it
 $73F8 LD DE,$0BEA   ; Yes: DE = YOUR instead
 $73FB OR $01        ; Make A non-zero...
 $73FD RET           ; ...so YOUR gets printed

; Message code $0E: HIS or YOUR (target)
;
; As #R$73F0, but for the target of the command ($B5D9). This is how 'his defense is too strong' becomes 'your defense is too strong' when Thorin attacks Bilbo.
c$73FE LD A,($B5D9)  ; A = the target, rather than the actor
 $7401 JR $73F3      ; Join the shared HIS/YOUR code above

; Message code $10: "you are" or "thorin is"
;
; Prints the actor's name (#R$747F) and then returns ARE if the actor is Bilbo and IS otherwise, for the interpreter to print. Code $11 (#R$741C) does the same
; for the target, and code $13 (#R$7424) for an object pushed on the stack.
c$7403 LD A,($B5DB)  ; A = whose name to print - the actor here, or, via the entry points below, the target or a pushed object
 $7406 EX AF,AF'     ; Keep it safely out of the way while the name is printed
 $7407 XOR A         ; {No article for a name
; This entry point is used by the routine at #R$741C.
*$7408 LD ($B5F4),A  ; }
 $740B EX AF,AF'     ; A = the object again
 $740C PUSH AF       ; Save it once more
 $740D CALL $747F    ; Print the name
 $7410 POP AF        ; A = the object once more
 $7411 AND A         ; Is it Bilbo (0)?
 $7412 LD DE,$039F   ; DE = ARE
 $7415 RET NZ        ; Not Bilbo: ARE is right, and Z is already reset, so it gets printed
 $7416 LD DE,$0065   ; Bilbo: DE = IS instead
 $7419 OR $01        ; Make A non-zero...
 $741B RET           ; ...so IS gets printed

; Message code $11: target's name and IS/ARE
;
; See #R$7403. The target is object $B5D9, and it gets an article.
c$741C LD A,($B5D9)  ; A = the target, rather than the actor
; This entry point is used by the routine at #R$7424.
*$741F EX AF,AF'     ; Keep it safe while the name is printed
 $7420 LD A,$01      ; (marks this as not the plain "actor" entry point, though nothing else reads it)
 $7422 JR $7408      ; Join the shared code above

; Message code $13: pushed object's name and IS/ARE
;
; Removes an object number from the stack and continues as #R$741C.
c$7424 POP DE        ; {Reach past the interpreter's own two return addresses...
 $7425 POP HL        ; }
 $7426 POP AF        ; ...to find the object number the caller pushed
 $7427 PUSH HL       ; {Put the two return addresses back
 $7428 PUSH DE       ; }
 $7429 JR $741F      ; Join the target version above, using this object instead

; Print an object's name from its word list
;
; Prints the name of the thing whose word list is at HL (adjectives followed by the noun) by calling #R$9E1F with IY pointing at the list.
;
; Input:HL Word list
c$742B PUSH IY       ; Save the caller's IY
 $742D PUSH HL       ; {IY = the word-list address given in HL
 $742E POP IY        ; }
 $7430 CALL $9E1F    ; Print the noun with its adjectives
 $7433 POP IY        ; {Restore the caller's IY
 $7435 RET           ; }

; Print the article for a word
;
; Decides on and prints the article that goes in front of the word in DE, according to the flags in the top of D.
; .
; Names (bit 7 of D set) get no article. They do set the 'capitalise' flag $B5F5 so the name starts with a capital letter; the one exception is YOU, which is
; left alone.
; .
; Other words use bits 4-6 of D as an index (0-3) into a table of articles: #R$AC21 (THE, A, AN, SOME) normally, or #R$AC29 (THE, THE, THE, SOME) when a
; definite article is wanted ($B5F2 or $70D6 set). So each noun in the dictionary references carries its own article: 'a sword', 'an elvish sword', 'some wine'.
;
; Input:DE Word reference
c$7436 BIT 7,D       ; A name (bit 7 of D)?
 $7438 JR Z,$744C    ; No: an ordinary noun
 $743A LD A,E        ; {Is it YOU ($07AC)?
 $743B LD HL,$07AC   ;
 $743E CP L          ;
 $743F JR NZ,$7446   ;
 $7441 LD A,D        ;
 $7442 AND $0F       ;
 $7444 CP H          ; }
 $7445 RET Z         ; YOU gets neither an article nor a capital
*$7446 LD A,$01      ; Other names get a capital letter...
 $7448 LD ($B5F5),A  ; {...and no article
 $744B RET           ; }
*$744C LD HL,$AC21   ; HL = THE, A, AN, SOME
 $744F LD A,($B5F2)  ; {Is a definite article wanted?
 $7452 LD E,A        ;
 $7453 LD A,($70D6)  ;
 $7456 OR E          ; }
 $7457 JR Z,$745C    ; No
 $7459 LD HL,$AC29   ; Yes: HL = THE, THE, THE, SOME
*$745C LD A,D        ; {The word's flag bits 4-6 choose one of the four
 $745D RRCA          ;
 $745E RRCA          ;
 $745F RRCA          ;
 $7460 AND $1E       ;
 $7462 PUSH DE       ;
 $7463 LD E,A        ;
 $7464 LD D,$00      ;
 $7466 ADD HL,DE     ; }
 $7467 LD E,(HL)     ; {DE = the article
 $7468 INC HL        ;
 $7469 LD D,(HL)     ; }
 $746A CALL $74B8    ; {Print it
 $746D POP DE        ;
 $746E RET           ; }

; Print a word, with an article if required
;
; If the article flag $B5F4 is set, #R$7436 prints the article first. The flag bits in D are then cleared and the word is printed by #R$74B8.
;
; Input:DE Word reference
c$746F PUSH DE       ; Save DE, the word to print
 $7470 LD A,($B5F4)  ; {Was an article asked for?
 $7473 AND A         ; }
 $7474 CALL NZ,$7436 ; If so, print it first
 $7477 POP DE        ; Restore DE
 $7478 LD A,D        ; {Strip the flag bits out of D, keeping just the word's own offset...
 $7479 AND $0F       ;
 $747B LD D,A        ; }
 $747C JP $74B8      ; ...then print the word itself

; Print the name of object A
;
; Prints the name of object A. Object $FF (nobody) is printed as SOMEONE, which is what you see when an unseen character does something: 'someone opens the
; door'. Otherwise it continues at $73CD in #R$73BE.
;
; Input:A Object number
c$747F CP $FF        ; Is there no object at all ($FF, for an attacker Bilbo cannot see)?
 $7481 JP NZ,$73CD   ; If there is a real object, print its name as usual
 $7484 LD DE,$0AE3   ; No object: SOMEONE
 $7487 JP $74B8      ; Print that instead

; Print an abbreviated word
;
; Message bytes $60-$7F stand for the 32 most common words. The byte minus $60 indexes the table at #R$AC31 to get a dictionary reference (the high byte has $50
; added so it lands in the right flag range), and then the word is printed exactly as if it had been written out in full, by jumping back into #R$72D4.
c$748A SUB $60       ; {A = which of the 32 common words this is (the code minus $60)
 $748C LD E,A        ;
 $748D LD D,$00      ; }
 $748F LD HL,$AC31   ; HL = the table of abbreviated words
 $7492 ADD HL,DE     ; {HL = this word's own entry (2 bytes each)...
 $7493 ADD HL,DE     ; }
 $7494 LD E,(HL)     ; {DE = the word reference, low byte...
 $7495 INC HL        ; }
 $7496 LD A,(HL)     ; {...then the high byte, with $50 added, to bring it into range...
 $7497 ADD A,$50     ;
 $7499 LD D,A        ; }
 $749A JP $7308      ; Print it exactly as an ordinary word reference

; Word buffer
;
; Where #R$74B8 assembles the letters of a word, plus any verb ending, before printing it. Up to 20 characters.
b$749D DEFB $30,$00,$20,$28,$30,$30,$28,$24
 $74A5 DEFB $00,$00,$20,$20,$20,$20,$20,$18
 $74AD DEFB $00,$00,$00,$68

; Print a word from a list
;
; Fetches the word reference at HL (low byte first), moves HL on by two, strips the flag bits and falls into #R$74B8 to print it. Used to print the words of
; action table entries and object names one at a time.
;
;  Input:HL Word reference
; Output:HL Next word
c$74B1 LD E,(HL)     ; {DE = the next word reference in the list, low byte...
 $74B2 INC HL        ; }
 $74B3 LD A,(HL)     ; {...then the high byte...
 $74B4 INC HL        ; }
 $74B5 AND $0F       ; {...with its flag bits stripped away
 $74B7 LD D,A        ; }

; Print a dictionary word
;
; Prints one word from the dictionary, with the right verb ending and with word wrap. On entry DE holds the word reference: the low nibble of D and all of E are
; the offset from #R$6000, and the high nibble of D holds flags. A reference of zero prints nothing.
; .
; The letters are unpacked into a buffer at $749D (five-bit letter codes plus $60 give lower-case ASCII), using the usual end-of-word rule (bit 7, but never in
; the first two bytes).
; .
; VERB ENDINGS. The flag nibble decides whether the verb is to agree with a third-person subject: $50 never, $40 always, $10 if the target is not Bilbo, and
; anything else if the actor is not Bilbo. So one message can say 'you attack thorin' or 'thorin attacks you'. If an ending is needed and the word allows one
; (bit 7 of its second byte), the top three bits of its third byte choose an ending from the table at #R$B60F: S, ES, IES, a backspace followed by IES (to turn
; 'carry' into 'carries'), D, or ING.
; .
; WORD WRAP. The length of the word, with its ending, is compared with the room left on the line (at $75A8 in the lower window or $768E in the story window). If
; it will not fit, a new line is started first, keeping the capital-letter flag. A space is printed before the word unless it starts a line.
; .
; Words with flag nibble $70 set the capital-letter flag afterwards, so that the next word starts a sentence.
;
; Input:DE Word reference (flags in the high nibble of D)
c$74B8 LD A,D        ; {Is the word reference zero?
 $74B9 AND $0F       ;
 $74BB OR E          ; }
 $74BC RET Z         ; {Yes: nothing to print
 $74BD PUSH HL       ;
 $74BE PUSH BC       ;
 $74BF PUSH DE       ; }
 $74C0 LD C,D        ; C = the flags
 $74C1 LD A,D        ; {DE = the offset...
 $74C2 AND $0F       ;
 $74C4 LD D,A        ; }
 $74C5 LD HL,$6000   ; {...plus $6000: HL = the word in the dictionary
 $74C8 ADD HL,DE     ; }
 $74C9 LD DE,$749D   ; {DE = the letter buffer
 $74CC PUSH HL       ; }
 $74CD LD B,$00      ; B counts the letters
*$74CF LD A,(HL)     ; {Next letter code
 $74D0 AND $1F       ; }
 $74D2 JR Z,$74F0    ; 0 (padding): the word has ended
 $74D4 INC B         ; Count it
 $74D5 ADD A,$60     ; Turn it into a lower-case letter
 $74D7 LD (DE),A     ; {Put it in the buffer
 $74D8 INC DE        ; }
 $74D9 BIT 7,(HL)    ; {Was it the last letter (bit 7)?
 $74DB INC HL        ; }
 $74DC JR Z,$74CF    ; No: next letter
 $74DE LD A,B        ; {Bit 7 in the first two bytes does not count...
 $74DF CP $02        ;
 $74E1 JR Z,$74CF    ; }
 $74E3 CP $03        ; {...and for a two-letter word...
 $74E5 JR NZ,$74F0   ; }
 $74E7 DEC HL        ; {...look back at the first byte
 $74E8 DEC HL        ;
 $74E9 LD A,(HL)     ;
 $74EA INC HL        ;
 $74EB INC HL        ;
 $74EC BIT 7,A       ;
 $74EE JR NZ,$74CF   ; }
*$74F0 POP HL        ; HL = the start of the word again
 $74F1 LD A,C        ; {What does the flag nibble say about verb endings?
 $74F2 AND $F0       ; }
 $74F4 CP $50        ; {$50: never add an ending
 $74F6 JR Z,$7527    ; }
 $74F8 CP $40        ; {$40: always add one
 $74FA JR Z,$7509    ; }
 $74FC CP $10        ; {$10: add one if the target is not Bilbo
 $74FE LD A,($B5D9)  ;
 $7501 JR Z,$7506    ; }
 $7503 LD A,($B5DB)  ; Otherwise: add one if the actor is not Bilbo
*$7506 AND A         ; Bilbo ("you")?
 $7507 JR Z,$7527    ; Yes: no ending
*$7509 INC HL        ; {Does the word take an ending (bit 7 of its second byte)?
 $750A BIT 7,(HL)    ; }
 $750C JR Z,$7527    ; No
 $750E INC HL        ; {The top three bits of its third byte...
 $750F LD A,(HL)     ;
 $7510 AND $E0       ; }
 $7512 RRCA          ; {...times 4...
 $7513 RRCA          ;
 $7514 RRCA          ;
 $7515 LD L,A        ;
 $7516 LD H,$00      ; }
 $7518 LD BC,$B60F   ; {...index the table of endings
 $751B ADD HL,BC     ; }
 $751C LD B,$04      ; {Up to four characters
*$751E LD A,(HL)     ; }
 $751F AND A         ; {A 0 ends it
 $7520 JR Z,$7527    ;
 $7522 INC HL        ; }
 $7523 LD (DE),A     ; {Add the character to the word
 $7524 INC DE        ;
 $7525 DJNZ $751E    ; }
*$7527 LD HL,$749D   ; {B = the length of the word
 $752A EX DE,HL      ;
 $752B AND A         ;
 $752C SBC HL,DE     ;
 $752E LD B,L        ; }
 $752F LD A,($B5F2)  ; {Lower window or story window?
 $7532 AND A         ;
 $7533 PUSH AF       ;
 $7534 JR NZ,$753A   ; }
 $7536 LD A,($7693)  ; {Story window: is this the start of a line?
 $7539 AND A         ; }
*$753A LD A,$20      ; {If not, print a space first
 $753C CALL NZ,$7580 ;
 $753F POP AF        ; }
 $7540 LD A,($75A8)  ; {A = the room left on the line (lower window)...
 $7543 JR NZ,$7548   ; }
 $7545 LD A,($768E)  ; {...or in the story window
*$7548 LD HL,$B5F5   ; }
 $754B CP B          ; Will the word fit?
 $754C JR NC,$7553   ; Yes
 $754E LD A,(HL)     ; {No: start a new line, keeping the capital-letter flag
 $754F CALL $7578    ;
 $7552 LD (HL),A     ; }
*$7553 POP DE        ; {Does the word end a sentence (flag nibble $70)?
 $7554 LD A,D        ;
 $7555 AND $F0       ;
 $7557 CP $70        ;
 $7559 LD A,$01      ;
 $755B JR NZ,$755E   ; }
 $755D LD (HL),A     ; Yes: the next word gets a capital
*$755E LD HL,$749D   ; {Print the letters
*$7561 LD A,(HL)     ;
 $7562 CALL $7580    ;
 $7565 INC HL        ;
 $7566 DJNZ $7561    ;
 $7568 POP BC        ;
 $7569 POP HL        ;
 $756A RET           ; }

; Is output enabled?
;
; Returns with Z set if nothing should be printed at the moment: output happens only if both $B5EB (the command is really being carried out, not just tried) and
; $B5F3 (the event can be seen by the player) are non-zero. A is preserved.
;
; Output:F Z set if printing is switched off
c$756B PUSH HL       ; Save HL
 $756C LD L,A        ; Keep the caller's A safe in L for a moment
 $756D LD A,($B5EB)  ; {Is this action really happening (not just being tried)?
 $7570 LD H,A        ; }
 $7571 LD A,($B5F3)  ; Can Bilbo actually see or hear it happen?
 $7574 AND H         ; Both must be true for anything to be printed
 $7575 LD A,L        ; Restore the caller's own A
 $7576 POP HL        ; Restore HL
 $7577 RET           ; Z set means printing is switched off

; Print a newline
;
; Prints a carriage return ($0D) via #R$7580, preserving A.
c$7578 PUSH AF       ; Save the caller's AF
 $7579 LD A,$0D      ; A = carriage return
 $757B CALL $7580    ; Print it
 $757E POP AF        ; {Restore the caller's AF
 $757F RET           ; }

; Print a character
;
; The main character output routine. It does nothing if #R$756B says printing is switched off.
; .
; If $B5F2 is set, the character goes to the lower (input) window via #R$75AD, which is how the player's own typing, and replies such as 'I don't know the
; word', appear down there. Otherwise it goes to the upper story window via #R$7694.
; .
; Then comes one of the game's jokes. If the flag at $B5F1 is set, every S (or s) printed in the story window is followed by an H. That flag is set when Bilbo
; drinks the wine (the wine's object record calls #R$A9ED), and cleared five turns later by timer 7 (#R$A9FF). So for a while after drinking, the game slurs:
; 'you drink shome wine. gandalf goesh easht.'
;
; Input:A Character to print
c$7580 CALL $756B    ; Printing switched off?
 $7583 RET Z         ; Return if the routine returned with Z set
 $7584 PUSH AF       ; Save AF
 $7585 LD A,($B5F2)  ; Input window or story window?
 $7588 AND A         ; Is A zero?
 $7589 JR NZ,$75AC   ; If it is not zero, go to Print a character in the input window (entry from #R$7580) (#R$75AC)
 $758B POP AF        ; Restore AF
 $758C CALL $7694    ; Call: Put a character on the screen (#R$7694)
 $758F PUSH AF       ; Save AF
 $7590 LD A,($B5F1)  ; Has Bilbo been drinking?
 $7593 AND A         ; Is A zero?
 $7594 JR NZ,$7598   ; If it is not zero, go to #R$7598
 $7596 POP AF        ; Restore AF
 $7597 RET           ; Done
*$7598 POP AF        ; Restore AF
 $7599 CP $53        ; If so, follow every S with an H
 $759B JR Z,$75A0    ; If yes, go to #R$75A0
 $759D CP $73        ; Is it "s"?
 $759F RET NZ        ; Return if no
*$75A0 PUSH AF       ; Save AF
 $75A1 LD A,$48      ; A = 72
 $75A3 CALL $7694    ; Call: Put a character on the screen (#R$7694)
 $75A6 POP AF        ; Restore AF
 $75A7 RET           ; Done

; Unused
s$75A8 DEFS $04

; Print a character in the input window (entry from #R$7580)
;
; Discards the copy of AF that #R$7580 pushed and continues into #R$75AD.
c$75AC POP AF        ; Throw away the copy of AF that #R$7580 pushed, then fall into #R$75AD below

; Print a character in the lower (input) window
;
; Prints a character in the four-line window at the bottom of the screen, where the player's typing and the game's immediate replies appear. Unlike the story
; window, this one uses the Spectrum ROM's 8x8 font (#R$766D) at 32 characters per line, and letters are always shown in upper case.
; .
; The print position is kept at $75A9 and the number of columns left at $75A8. After each character, the cursor character (from $75AB, a '+') is drawn in the
; next position, so the player can see where the next key will appear.
; .
; ENTER blanks the cursor and scrolls the window up a line (#R$7600). A backspace ($08) rubs out the cursor, moves back one column and draws the cursor there;
; backspacing past the start of a line scrolls the window down again (#R$763D). Reaching the end of a line also scrolls the window.
c$75AD PUSH HL       ; {Save HL and AF
 $75AE PUSH AF       ; }
 $75AF LD HL,($75A9) ; HL = where the next character goes
 $75B2 CP $0D        ; {Is it ENTER?
 $75B4 JR NZ,$75BD   ; }
 $75B6 LD A,$20      ; {Yes: rub out the cursor with a space...
 $75B8 CALL $766D    ; }
 $75BB JR $75D4      ; ...then go straight to starting a new line
*$75BD CP $08        ; {Is it a backspace?
 $75BF JR Z,$75EA    ; }
 $75C1 CP $61        ; {Otherwise, is it a lower-case letter?
 $75C3 JR C,$75CB    ;
 $75C5 CP $7B        ;
 $75C7 JR NC,$75CB   ; }
 $75C9 AND $5F       ; If so, make it upper case: this window always shows capitals
*$75CB CALL $766D    ; Draw the character
 $75CE LD A,($75A8)  ; {One less column of room on this line
 $75D1 DEC A         ; }
 $75D2 JR NZ,$75DB   ; Room left: just update the cursor position below
*$75D4 LD L,$E0      ; Line full: move to the start of the next one...
 $75D6 CALL $7600    ; ...scrolling the window up
*$75D9 LD A,$20      ; Full width of room again, on the fresh line
*$75DB LD ($75A8),A  ; Save the columns left
 $75DE LD A,($75AB)  ; A = the cursor character ('+')
 $75E1 LD ($75A9),HL ; Remember where it goes
 $75E4 CALL $766D    ; Draw it, so the player can see where the next key will land
 $75E7 POP AF        ; Restore AF
 $75E8 POP HL        ; {Restore HL
 $75E9 RET           ; }
*$75EA LD A,$20      ; {BACKSPACE: rub out the cursor with a space
 $75EC CALL $766D    ; }
 $75EF DEC L         ; {Step back one character position
 $75F0 DEC L         ; }
 $75F1 LD A,($75A8)  ; {Was there anything on this line left to delete?
 $75F4 INC A         ;
 $75F5 CP $21        ; }
 $75F7 JR NZ,$75DB   ; Something there: just move the cursor back
 $75F9 LD L,$FF      ; Nothing left on this line: move up to the end of the previous one...
 $75FB CALL $763D    ; {...scrolling the window back down
 $75FE JR $75D9      ; }

; Scroll the input window up
;
; Scrolls the lower window (the four character rows starting at $5060, in the bottom third of the screen) up by one row, a pixel line at a time with LDIR, and
; then clears the bottom row at $50E0 by printing 32 spaces with #R$766D. All registers are preserved.
c$7600 PUSH HL       ; {Save the registers this uses
 $7601 PUSH DE       ;
 $7602 PUSH BC       ;
 $7603 PUSH AF       ; }
 $7604 LD HL,$5080   ; HL = the second character row of the input window...
 $7607 LD DE,$5060   ; ...DE = the first, where it is moving to
 $760A LD A,$04      ; {Four character rows to shift up
 $760C LD B,$00      ; }
*$760E PUSH HL       ; {Save the row addresses for a moment
 $760F PUSH DE       ; }
 $7610 LD C,$08      ; Eight pixel lines make up one character row
*$7612 PUSH HL       ; {Save this pixel line's addresses
 $7613 PUSH DE       ;
 $7614 PUSH BC       ; }
 $7615 LD C,$20      ; 32 bytes make up one pixel line across the screen
 $7617 LDIR          ; Copy it up
 $7619 POP BC        ; {Restore the counters
 $761A POP DE        ;
 $761B POP HL        ; }
 $761C INC H         ; {Move down to the next pixel line (the screen's odd layout means +$100 here, not +32)
 $761D INC D         ; }
 $761E DEC C         ; {One fewer pixel line to do
 $761F JR NZ,$7612   ; }
 $7621 POP DE        ; {Restore the row addresses
 $7622 POP HL        ; }
 $7623 LD C,$20      ; {Move both addresses on to the next character row
 $7625 ADD HL,BC     ;
 $7626 EX DE,HL      ;
 $7627 ADD HL,BC     ;
 $7628 EX DE,HL      ; }
 $7629 DEC A         ; {One fewer character row to do
 $762A JR NZ,$760E   ; }
 $762C LD B,$20      ; {The bottom row is now empty: clear it with 32 spaces
 $762E LD HL,$50E0   ;
 $7631 LD A,$20      ;
*$7633 CALL $766D    ;
 $7636 DJNZ $7633    ; }
 $7638 POP AF        ; {Restore the saved registers
 $7639 POP BC        ;
 $763A POP DE        ;
 $763B POP HL        ;
 $763C RET           ; }

; Scroll the input window down
;
; The reverse of #R$7600: moves the lower window's rows down by one character row, working from the bottom. Used when a backspace goes back past the start of a
; line of typing (#R$75AD).
c$763D PUSH HL       ; {Save the registers this uses
 $763E PUSH DE       ;
 $763F PUSH BC       ;
 $7640 PUSH AF       ; }
 $7641 LD HL,$50C0   ; HL = the third character row of the input window...
 $7644 LD DE,$50E0   ; ...DE = the fourth, where it is moving to
 $7647 LD A,$05      ; Five pixel-line moves are needed to shift everything down one row
*$7649 PUSH HL       ; {Save the row addresses
 $764A PUSH DE       ; }
 $764B LD B,$08      ; Eight pixel lines per character row
*$764D PUSH HL       ; {Save this pixel line's addresses
 $764E PUSH DE       ;
 $764F PUSH BC       ; }
 $7650 LD BC,$0020   ; 32 bytes per pixel line
 $7653 LDIR          ; Copy it down
 $7655 POP BC        ; {Restore the counters
 $7656 POP DE        ;
 $7657 POP HL        ; }
 $7658 INC H         ; {Move down to the next pixel line
 $7659 INC D         ; }
 $765A DJNZ $764D    ; One fewer pixel line to do
 $765C POP DE        ; {Restore the row addresses
 $765D POP HL        ; }
 $765E LD BC,$FFE0   ; {Move both addresses BACK one character row instead (a negative step)
 $7661 ADD HL,BC     ;
 $7662 EX DE,HL      ;
 $7663 ADD HL,BC     ;
 $7664 EX DE,HL      ; }
 $7665 DEC A         ; {One fewer character row to do
 $7666 JR NZ,$7649   ; }
 $7668 POP AF        ; {Restore the saved registers
 $7669 POP BC        ;
 $766A POP DE        ;
 $766B POP HL        ;
 $766C RET           ; }

; Print a character using the ROM font
;
; Draws character A at screen address HL using the Spectrum ROM's character set at $3D00 (8 x 8 pixels), then moves HL on to the next character cell. Used only
; for the lower (input) window.
;
;  Input:A Character
;        HL Screen address
; Output:HL Next character position
c$766D PUSH AF       ; {Save the registers this uses
 $766E PUSH BC       ;
 $766F PUSH DE       ;
 $7670 PUSH HL       ; }
 $7671 SUB $20       ; {A = the character code, counted from the space character
 $7673 LD L,A        ;
 $7674 LD H,$00      ; }
 $7676 ADD HL,HL     ; {...times 8, since each character's bitmap is 8 bytes...
 $7677 ADD HL,HL     ;
 $7678 ADD HL,HL     ; }
 $7679 LD DE,$3D00   ; {...added to the start of the ROM's own character set
 $767C ADD HL,DE     ; }
 $767D EX DE,HL      ; DE = the character's own bitmap
 $767E POP HL        ; {HL = where to draw it (put back for a moment)
 $767F PUSH HL       ; }
 $7680 LD B,$08      ; Eight pixel rows to copy
*$7682 LD A,(DE)     ; {Copy one row of the bitmap...
 $7683 LD (HL),A     ; }
 $7684 INC DE        ; Move on to the next row of the bitmap...
 $7685 INC H         ; {...and the next pixel line on screen (the odd layout means +$100)
 $7686 DJNZ $7682    ; }
 $7688 POP HL        ; {Restore HL and the other saved registers
 $7689 POP DE        ;
 $768A POP BC        ;
 $768B POP AF        ; }
 $768C INC L         ; {Move on to the next character cell
 $768D RET           ; }

; Unused
s$768E DEFS $06

; Put a character on the screen
;
; Prints one character in the story window, which fills the upper part of the screen and uses the game's own 6-pixel font (#R$77BC). The screen address is kept
; at $768F, the pixel offset within the byte at $7691, and the number of characters left on the line at $768E (42 per line).
; .
; Letters are converted to lower case, except that the first letter after a full stop or a new line is capitalised: the flag at $B5F5 is set by those, and
; cleared once a capital has been printed. This is why the game's text needs no capital letters in the dictionary.
; .
; A carriage return sends the finished line to the ZX Printer if it is switched on (#R$7B15), then scrolls the story window up (#R$775E) and starts a new line.
; Before scrolling, the game checks the line counter at $B606, which is set to 9 each time the player enters a command: after that many lines, each further line
; waits (for about half a second, or until a key is pressed) so that long bursts of text do not rush past unread. A key held down at that point has to be
; released before the text continues.
; .
; A backspace moves back 6 pixels (#R$7754) and rubs out the character there. A full line wraps automatically.
; .
; If $7692 is non-zero, that many spaces are printed at the start of the line first (an indent). This is the routine I used as a hook in the emulator to capture
; everything the game printed.
;
; Input:A Character code
c$7694 PUSH HL       ; {Save the registers this uses
 $7695 PUSH BC       ;
 $7696 PUSH AF       ; }
 $7697 LD HL,($768F) ; HL = the current print position on screen
 $769A LD A,($7691)  ; {C = the pixel offset within that screen byte
 $769D LD C,A        ; }
 $769E LD A,($7693)  ; {Has a capital letter already been printed since the last full stop or new line?
 $76A1 AND A         ; }
 $76A2 JR NZ,$76B9   ; Yes: no indent needed
 $76A4 LD A,($7692)  ; {Is an indent wanted at the start of this line (e.g. for a container's contents)?
 $76A7 AND A         ; }
 $76A8 JR Z,$76B9    ; No: skip straight to printing the character below
 $76AA LD B,A        ; B = how many indent spaces
*$76AB LD A,$20      ; {Draw a space...
 $76AD CALL $77BC    ; }
 $76B0 LD A,($768E)  ; {One less character of room on this line now
 $76B3 DEC A         ;
 $76B4 LD ($768E),A  ; }
 $76B7 DJNZ $76AB    ; Repeat for the whole indent
*$76B9 POP AF        ; {Restore the actual character to print
 $76BA PUSH AF       ; }
 $76BB CP $0D        ; {Is it a new line?
 $76BD JR NZ,$7700   ; }
 $76BF LD A,$01      ; {Yes: the very next character printed should get a capital letter
 $76C1 LD ($B5F5),A  ; }
*$76C4 XOR A         ; {No capital has been printed yet on this new line
 $76C5 LD ($7693),A  ; }
 $76C8 CALL $7B15    ; Send the finished line to the ZX Printer, if it is switched on
 $76CB PUSH BC       ; Save the pixel offset
 $76CC LD A,($B606)  ; {How many more lines can be printed before pausing for a key?
 $76CF AND A         ; }
 $76D0 JR NZ,$76E6   ; Some left: just count one down below
 $76D2 LD BC,$8000   ; {None left: wait for a key, but time out eventually rather than freeze forever
*$76D5 XOR A         ; }
 $76D6 IN A,($FE)    ; {Is a key being pressed right now?
 $76D8 AND $1F       ;
 $76DA CP $1F        ; }
 $76DC JR NZ,$76EA   ; Yes: stop waiting
 $76DE DEC BC        ; {No: count down the timeout
 $76DF LD A,B        ;
 $76E0 OR C          ;
 $76E1 JR NZ,$76D5   ; }
 $76E3 POP BC        ; {Timed out: give up waiting
 $76E4 JR $76F4      ; }
*$76E6 DEC A         ; {Still some lines left before a pause: one fewer
 $76E7 LD ($B606),A  ; }
*$76EA POP BC        ; Restore the pixel offset
*$76EB XOR A         ; {Wait here until a key really is pressed
 $76EC IN A,($FE)    ;
 $76EE AND $1F       ;
 $76F0 CP $1F        ;
 $76F2 JR NZ,$76EB   ; }
*$76F4 LD HL,$5020   ; {Back to the top of the story window
 $76F7 LD C,$01      ; }
 $76F9 CALL $775E    ; Scroll it up one line
 $76FC LD A,$2A      ; {Start the new line with a fresh indent marker
 $76FE JR $7746      ; }
*$7700 CP $08        ; {Is it a backspace?
 $7702 JR NZ,$7715   ; }
 $7704 CALL $7754    ; Move the print position back one character...
 $7707 LD A,$20      ; {...draw a space over what was there...
 $7709 CALL $77BC    ; }
 $770C CALL $7754    ; ...then move back again, ready for whatever comes next
 $770F LD A,($768E)  ; {One more character of room on the line
 $7712 INC A         ;
 $7713 JR $7746      ; }
*$7715 CP $41        ; {Is it an upper-case letter?
 $7717 JR C,$771F    ;
 $7719 CP $5B        ;
 $771B JR NC,$771F   ; }
 $771D OR $20        ; Yes: make it lower case, since the story window's own text is always in lower case
*$771F PUSH HL       ; Save HL
 $7720 LD HL,$B5F5   ; {Should THIS letter be a capital instead (the "start a new sentence" flag)?
 $7723 INC (HL)      ;
 $7724 DEC (HL)      ; }
 $7725 JR Z,$7733    ; No: leave it as it is
 $7727 CP $61        ; {Is it actually a lower-case letter that could be capitalised?
 $7729 JR C,$7733    ;
 $772B CP $7B        ;
 $772D JR NC,$7733   ; }
 $772F RES 5,A       ; Yes: make it upper case
 $7731 LD (HL),$00   ; The "next letter gets a capital" flag has now been used up
*$7733 CP $2E        ; {Is this character a full stop?
 $7735 JR NZ,$7738   ; }
 $7737 INC (HL)      ; If so, arrange for the very next letter to be capitalised
*$7738 POP HL        ; Restore HL
 $7739 CALL $77BC    ; Draw the character itself
 $773C LD ($7693),A  ; Remember that something has now been printed on this line, so no further indent is added
 $773F LD A,($768E)  ; {One less character of room on the line
 $7742 DEC A         ; }
 $7743 JP Z,$76C4    ; None left: treat it as if a new line had just been reached, to wrap and scroll
*$7746 LD ($768E),A  ; Save the room left on the line
 $7749 LD ($768F),HL ; Save the new print position
 $774C LD A,C        ; {Save the new pixel offset
 $774D LD ($7691),A  ; }
 $7750 POP AF        ; {Restore AF, BC and HL
 $7751 POP BC        ;
 $7752 POP HL        ;
 $7753 RET           ; }

; Move back one character position
;
; Moves the story window's print position back 6 pixels: C (the bit offset within the screen byte) is reduced by 6, and if that goes below zero it has 8 added
; and L is moved back one byte.
;
; Input:C Bit offset
;       L Screen address (low byte)
c$7754 LD A,C        ; A = the pixel offset within the current screen byte
 $7755 SUB $06       ; {Move back 6 pixels, the width of one character
 $7757 LD C,A        ; }
 $7758 RET NC        ; Still within the same byte: done
 $7759 ADD A,$08     ; {Crossed into the byte before: wrap the offset round...
 $775B LD C,A        ; }
 $775C DEC L         ; {...and step back to that earlier byte
 $775D RET           ; }

; Scroll the story window up
;
; Scrolls the top 17 character rows of the screen ($4000 onwards, down to $5020) up by one character row, pixel line by pixel line, taking care of the
; Spectrum's awkward screen layout at the boundaries between the thirds of the screen. The attributes of those rows are scrolled too (so that a picture's
; colours move with it). Finally the bottom row of the story window at $5020 is cleared by printing 42 spaces in the 6-pixel font.
c$775E PUSH AF       ; {Save the registers this uses
 $775F PUSH BC       ;
 $7760 PUSH HL       ;
 $7761 PUSH DE       ; }
 $7762 LD HL,$4020   ; HL = the second pixel row of the story window...
 $7765 LD DE,$4000   ; ...DE = the first, where it is moving to
 $7768 LD A,$11      ; {17 character rows make up the whole story window
 $776A LD B,$00      ; }
*$776C PUSH HL       ; {Save the row addresses
 $776D PUSH DE       ; }
 $776E LD C,$08      ; Eight pixel lines per character row
*$7770 PUSH HL       ; {Save this pixel line's addresses
 $7771 PUSH DE       ;
 $7772 PUSH BC       ; }
 $7773 LD C,$20      ; 32 bytes per pixel line
 $7775 LDIR          ; Copy it up
 $7777 POP BC        ; {Restore the counters
 $7778 POP DE        ;
 $7779 POP HL        ; }
 $777A INC H         ; {Move down to the next pixel line
 $777B INC D         ; }
 $777C DEC C         ; {One fewer pixel line to do
 $777D JR NZ,$7770   ; }
 $777F POP DE        ; {Restore the row addresses
 $7780 POP HL        ; }
 $7781 LD C,$20      ; {Move both addresses on to the next character row
 $7783 ADD HL,BC     ;
 $7784 EX DE,HL      ;
 $7785 ADD HL,BC     ;
 $7786 EX DE,HL      ; }
 $7787 PUSH AF       ; {The screen's odd memory layout means a plain add sometimes lands in the wrong third of the screen, so check and correct that:
 $7788 LD A,D        ;
 $7789 AND $07       ; }
 $778B JR Z,$7791    ; {DE is already fine as it is...
 $778D LD A,D        ; }
 $778E ADD A,$07     ; {...otherwise nudge it on to the next third
 $7790 LD D,A        ; }
*$7791 LD A,H        ; {Do the same correction for HL
 $7792 AND $07       ;
 $7794 JR Z,$779A    ;
 $7796 LD A,H        ;
 $7797 ADD A,$07     ;
 $7799 LD H,A        ; }
*$779A POP AF        ; Restore AF
 $779B DEC A         ; {One fewer character row to do
 $779C JR NZ,$776C   ; }
 $779E LD HL,$5820   ; {The attributes need to move up one row too...
 $77A1 LD DE,$5800   ;
 $77A4 LD BC,$0220   ; }
 $77A7 LDIR          ; ...so that a picture's colours scroll along with it
 $77A9 LD B,$2A      ; {The bottom row is now empty: clear it with 42 spaces, a full line of the 6-pixel font
 $77AB LD HL,$5020   ;
 $77AE LD C,$01      ;
 $77B0 LD A,$20      ;
*$77B2 CALL $77BC    ;
 $77B5 DJNZ $77B2    ; }
 $77B7 POP DE        ; {Restore the saved registers
 $77B8 POP HL        ;
 $77B9 POP BC        ;
 $77BA POP AF        ;
 $77BB RET           ; }

; Draw a character glyph
;
; Draws one 8x8 character from the font at #R$7815. The glyph address is $7715 + 8 x character code (the font only defines codes $20 to $7F, so the table
; effectively starts at $7815).
; .
; Characters are drawn on a 6-pixel pitch rather than the Spectrum's usual 8, which is why The Hobbit fits more text on a line than most Spectrum games. C holds
; the pixel offset within the current screen byte, so each glyph row is shifted right by C bits and may straddle two screen bytes: the first part is masked into
; (HL) and the overflow is shifted left and masked into (HL+1). After drawing, C is advanced by 6 and, if it passes 8, L moves on to the next byte.
;
; Input:A Character code
;       C Pixel offset within the screen byte (0-7)
;       HL Screen address of the top row
c$77BC PUSH AF       ; {Save the registers this uses
 $77BD PUSH BC       ;
 $77BE PUSH DE       ;
 $77BF PUSH HL       ; }
 $77C0 LD L,A        ; {HL = the character code...
 $77C1 LD H,$00      ; }
 $77C3 ADD HL,HL     ; {...times 8, since each glyph is 8 bytes...
 $77C4 ADD HL,HL     ;
 $77C5 ADD HL,HL     ; }
 $77C6 LD DE,$7715   ; {...added to the start of the game's own font
 $77C9 ADD HL,DE     ; }
 $77CA EX DE,HL      ; DE = the glyph's own bitmap
 $77CB POP HL        ; {HL = where to draw it (put back for a moment)
 $77CC PUSH HL       ; }
 $77CD LD B,$08      ; Eight pixel rows to draw
*$77CF LD A,(DE)     ; {A = this row of the glyph
 $77D0 PUSH BC       ; }
 $77D1 DEC C         ; {Is the pixel offset C exactly 0 (no shifting needed)?
 $77D2 INC C         ; }
 $77D3 LD B,$FF      ; B will become a mask of which bits belong to this glyph
 $77D5 JR Z,$77DE    ; No shift needed: skip the loop below
*$77D7 SRL A         ; Shift the glyph right by C bits...
 $77D9 SRL B         ; {...building the matching mask alongside it
 $77DB DEC C         ;
 $77DC JR NZ,$77D7   ; }
*$77DE LD C,A        ; C = the (possibly shifted) glyph bits for this screen byte
 $77DF LD A,B        ; {Combine them into the screen, keeping whatever was already there outside the mask
 $77E0 CPL           ;
 $77E1 AND (HL)      ;
 $77E2 OR C          ;
 $77E3 LD (HL),A     ; }
 $77E4 POP BC        ; Restore the pixel offset
 $77E5 DEC C         ; {Does the glyph spill over into the NEXT screen byte too?
 $77E6 INC C         ; }
 $77E7 JR Z,$7801    ; No: nothing more to do for this row
 $77E9 PUSH BC       ; {Yes: work out the overflow into that next byte
 $77EA LD A,$08      ;
 $77EC SUB C         ;
 $77ED LD C,A        ; }
 $77EE LD A,(DE)     ; {A = the same glyph row again
 $77EF LD B,$FF      ; }
*$77F1 SLA A         ; {This time shift it LEFT, to land the spilt-over bits at the start of the next byte...
 $77F3 SLA B         ;
 $77F5 DEC C         ;
 $77F6 JR NZ,$77F1   ; }
 $77F8 LD C,A        ; C = those overflow bits
 $77F9 LD A,B        ; {Combine them into the next screen byte, again keeping what was already there
 $77FA CPL           ;
 $77FB INC HL        ;
 $77FC AND (HL)      ;
 $77FD OR C          ;
 $77FE LD (HL),A     ; }
 $77FF DEC HL        ; {Back to the first byte, ready for the next pixel row
 $7800 POP BC        ; }
*$7801 INC DE        ; Move on to the next row of the glyph...
 $7802 INC H         ; {...and the next pixel line on screen (the odd layout means +$100)
 $7803 DJNZ $77CF    ; }
 $7805 POP HL        ; {Restore the saved registers
 $7806 POP DE        ;
 $7807 POP BC        ; }
 $7808 LD A,C        ; {Move the pixel offset on by 6, the width of a character...
 $7809 ADD A,$06     ; }
 $780B CP $08        ; {Did that cross into the next screen byte?
 $780D JR C,$7812    ; }
 $780F SUB $08       ; If so, wrap the offset round...
 $7811 INC L         ; ...and step on to that byte
*$7812 LD C,A        ; Save the new pixel offset
 $7813 POP AF        ; {Restore AF
 $7814 RET           ; }

; Font
;
; 96 characters, codes $20 (space) to $7F, 8 bytes each, top row first. Each glyph uses only the left 6 pixels, matching the 6-pixel character pitch used by
; #R$77BC. For example 'A' is at $791D: $00,$38,$44,$44,$7C,$44,$44,$00.
; .
; #FONT$7815,96
b$7815 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; {Characters $20-$7F
 $781D DEFB $00,$10,$10,$10,$10,$00,$10,$00 ;
 $7825 DEFB $00,$28,$28,$00,$00,$00,$00,$00 ;
 $782D DEFB $00,$28,$7C,$28,$7C,$28,$00,$00 ;
 $7835 DEFB $00,$10,$7C,$50,$7C,$14,$7C,$10 ;
 $783D DEFB $00,$64,$48,$10,$24,$4C,$00,$00 ;
 $7845 DEFB $20,$50,$20,$54,$48,$74,$00,$00 ;
 $784D DEFB $00,$08,$10,$00,$00,$00,$00,$00 ;
 $7855 DEFB $00,$08,$10,$10,$10,$10,$08,$00 ;
 $785D DEFB $00,$10,$08,$08,$08,$08,$10,$00 ;
 $7865 DEFB $00,$28,$10,$7C,$10,$28,$00,$00 ;
 $786D DEFB $00,$10,$10,$7C,$10,$10,$00,$00 ;
 $7875 DEFB $00,$00,$00,$00,$00,$10,$10,$20 ;
 $787D DEFB $00,$00,$00,$7C,$00,$00,$00,$00 ;
 $7885 DEFB $00,$00,$00,$00,$00,$30,$30,$00 ;
 $788D DEFB $00,$04,$08,$10,$20,$40,$00,$00 ;
 $7895 DEFB $00,$38,$4C,$54,$54,$64,$38,$00 ;
 $789D DEFB $00,$30,$50,$10,$10,$10,$7C,$00 ;
 $78A5 DEFB $00,$38,$44,$04,$38,$40,$7C,$00 ;
 $78AD DEFB $00,$38,$44,$18,$04,$44,$38,$00 ;
 $78B5 DEFB $00,$18,$28,$48,$7C,$08,$08,$00 ;
 $78BD DEFB $00,$7C,$40,$78,$04,$44,$38,$00 ;
 $78C5 DEFB $00,$38,$40,$78,$44,$44,$38,$00 ;
 $78CD DEFB $00,$7C,$04,$08,$10,$20,$20,$00 ;
 $78D5 DEFB $00,$38,$44,$38,$44,$44,$38,$00 ;
 $78DD DEFB $00,$38,$44,$44,$3C,$04,$38,$00 ;
 $78E5 DEFB $00,$00,$10,$00,$00,$10,$00,$00 ;
 $78ED DEFB $00,$00,$10,$00,$00,$10,$10,$20 ;
 $78F5 DEFB $00,$00,$08,$10,$20,$10,$08,$00 ;
 $78FD DEFB $00,$00,$00,$3C,$00,$3C,$00,$00 ;
 $7905 DEFB $00,$00,$20,$10,$08,$10,$20,$00 ;
 $790D DEFB $00,$38,$44,$08,$10,$00,$10,$00 ;
 $7915 DEFB $00,$38,$54,$54,$58,$40,$38,$00 ;
 $791D DEFB $00,$38,$44,$44,$7C,$44,$44,$00 ;
 $7925 DEFB $00,$78,$44,$78,$44,$44,$78,$00 ;
 $792D DEFB $00,$38,$44,$40,$40,$44,$38,$00 ;
 $7935 DEFB $00,$70,$48,$44,$44,$48,$70,$00 ;
 $793D DEFB $00,$7C,$40,$78,$40,$40,$7C,$00 ;
 $7945 DEFB $00,$7C,$40,$78,$40,$40,$40,$00 ;
 $794D DEFB $00,$38,$44,$40,$5C,$44,$38,$00 ;
 $7955 DEFB $00,$44,$44,$7C,$44,$44,$44,$00 ;
 $795D DEFB $00,$7C,$10,$10,$10,$10,$7C,$00 ;
 $7965 DEFB $00,$04,$04,$04,$44,$44,$38,$00 ;
 $796D DEFB $00,$48,$50,$60,$50,$48,$44,$00 ;
 $7975 DEFB $00,$40,$40,$40,$40,$40,$7C,$00 ;
 $797D DEFB $00,$44,$6C,$54,$44,$44,$44,$00 ;
 $7985 DEFB $00,$44,$64,$54,$54,$4C,$44,$00 ;
 $798D DEFB $00,$38,$44,$44,$44,$44,$38,$00 ;
 $7995 DEFB $00,$78,$44,$44,$78,$40,$40,$00 ;
 $799D DEFB $00,$38,$44,$44,$54,$48,$34,$00 ;
 $79A5 DEFB $00,$78,$44,$44,$78,$48,$44,$00 ;
 $79AD DEFB $00,$38,$40,$38,$04,$44,$38,$00 ;
 $79B5 DEFB $00,$7C,$10,$10,$10,$10,$10,$00 ;
 $79BD DEFB $00,$44,$44,$44,$44,$44,$38,$00 ;
 $79C5 DEFB $00,$44,$44,$44,$44,$28,$10,$00 ;
 $79CD DEFB $00,$44,$44,$44,$54,$6C,$44,$00 ;
 $79D5 DEFB $00,$44,$28,$10,$10,$28,$44,$00 ;
 $79DD DEFB $00,$44,$44,$28,$10,$10,$10,$00 ;
 $79E5 DEFB $00,$7C,$04,$18,$20,$40,$7C,$00 ;
 $79ED DEFB $00,$38,$20,$20,$20,$20,$38,$00 ;
 $79F5 DEFB $00,$40,$20,$10,$08,$04,$00,$00 ;
 $79FD DEFB $00,$38,$08,$08,$08,$08,$38,$00 ;
 $7A05 DEFB $00,$10,$38,$54,$10,$10,$10,$00 ;
 $7A0D DEFB $00,$00,$00,$00,$00,$00,$00,$7C ;
 $7A15 DEFB $00,$18,$24,$70,$20,$20,$7C,$00 ;
 $7A1D DEFB $00,$00,$38,$04,$3C,$44,$3C,$00 ;
 $7A25 DEFB $00,$40,$40,$78,$44,$44,$78,$00 ;
 $7A2D DEFB $00,$00,$38,$40,$40,$40,$38,$00 ;
 $7A35 DEFB $00,$04,$04,$3C,$44,$44,$3C,$00 ;
 $7A3D DEFB $00,$00,$38,$44,$78,$40,$3C,$00 ;
 $7A45 DEFB $00,$18,$20,$30,$20,$20,$20,$00 ;
 $7A4D DEFB $00,$00,$3C,$44,$44,$3C,$04,$38 ;
 $7A55 DEFB $00,$40,$40,$78,$44,$44,$44,$00 ;
 $7A5D DEFB $00,$10,$00,$30,$10,$10,$38,$00 ;
 $7A65 DEFB $00,$08,$00,$08,$08,$08,$48,$30 ;
 $7A6D DEFB $00,$20,$28,$30,$30,$28,$24,$00 ;
 $7A75 DEFB $00,$20,$20,$20,$20,$20,$18,$00 ;
 $7A7D DEFB $00,$00,$68,$54,$54,$54,$54,$00 ;
 $7A85 DEFB $00,$00,$78,$44,$44,$44,$44,$00 ;
 $7A8D DEFB $00,$00,$38,$44,$44,$44,$38,$00 ;
 $7A95 DEFB $00,$00,$78,$44,$44,$78,$40,$40 ;
 $7A9D DEFB $00,$00,$38,$48,$48,$38,$08,$0C ;
 $7AA5 DEFB $00,$00,$38,$20,$20,$20,$20,$00 ;
 $7AAD DEFB $00,$00,$38,$40,$38,$04,$78,$00 ;
 $7AB5 DEFB $00,$20,$70,$20,$20,$20,$18,$00 ;
 $7ABD DEFB $00,$00,$44,$44,$44,$44,$38,$00 ;
 $7AC5 DEFB $00,$00,$44,$44,$28,$28,$10,$00 ;
 $7ACD DEFB $00,$00,$44,$54,$54,$54,$28,$00 ;
 $7AD5 DEFB $00,$00,$44,$28,$10,$28,$44,$00 ;
 $7ADD DEFB $00,$00,$44,$44,$44,$3C,$04,$38 ;
 $7AE5 DEFB $00,$00,$7C,$08,$10,$20,$7C,$00 ;
 $7AED DEFB $00,$1C,$10,$60,$10,$10,$1C,$00 ;
 $7AF5 DEFB $00,$10,$10,$10,$10,$10,$10,$00 ;
 $7AFD DEFB $00,$70,$10,$0C,$10,$10,$70,$00 ;
 $7B05 DEFB $00,$28,$50,$00,$00,$00,$00,$00 ;
 $7B0D DEFB $00,$10,$08,$7C,$00,$7C,$08,$10 ; }

; Copy a line of text to the ZX Printer
;
; The Hobbit can send its output to a ZX Printer (the PRINT and NOPRINT commands). If the flag at $B5E3 is set, this routine is called by #R$7694 at the end of
; every line of text, and it copies the 8 pixel rows of that line from the screen, starting at $5020, to the printer.
; .
; The ZX Printer is driven directly through port $FB. For each pixel row, the 32 bytes are sent one bit at a time: for each dot the routine waits for the
; printer's encoder signal (bit 0 of the port) and then outputs the dot. D controls the motor speed: it starts at 1 (slow), and after the first two rows the
; value derived from E runs the motor at full speed. After the 8 rows the motor is stopped (OUT ($FB),4). If the printer is not connected (bit 7 of the port
; reads as 1) the routine gives up straight away.
c$7B15 LD A,($B5E3)  ; Is the printer switched on?
 $7B18 AND A         ; Is A zero?
 $7B19 RET Z         ; Return if it is zero
 $7B1A PUSH HL       ; Save HL
 $7B1B PUSH DE       ; Save DE
 $7B1C PUSH BC       ; Save BC
 $7B1D LD D,$01      ; Slow motor; HL = start of the line on the screen
 $7B1F LD HL,$5020   ; HL = $5020
 $7B22 XOR A         ; A = 0
 $7B23 LD E,A        ; E = A
*$7B24 OUT ($FB),A   ; Start the motor and wait for the printer to be ready
*$7B26 IN A,($FB)    ; Read the keyboard/port
 $7B28 ADD A,A       ; Add A,A
 $7B29 JP M,$7B67    ; Bit 7 set: no printer connected
 $7B2C JR NC,$7B26   ; If carry clear, go to #R$7B26
 $7B2E PUSH HL       ; Save HL
 $7B2F PUSH DE       ; Save DE
 $7B30 LD A,D        ; A = D
 $7B31 CP $02        ; Compare with 2
 $7B33 SBC A,A       ; Subtract A,A with carry
 $7B34 AND E         ; Keep only the bits of E
 $7B35 RLCA          ; Rotate A left
 $7B36 AND E         ; Keep only the bits of E
 $7B37 LD D,A        ; D = A
*$7B38 LD C,(HL)     ; C = (HL)
 $7B39 PUSH HL       ; Save HL
 $7B3A LD B,$08      ; Send eight dots per screen byte
*$7B3C LD A,D        ; A = D
 $7B3D RLC C         ; Shift/rotate C
 $7B3F RRA           ; Rotate A right through carry
 $7B40 LD H,A        ; H = A
*$7B41 IN A,($FB)    ; Wait for the encoder...
 $7B43 RRA           ; Rotate A right through carry
 $7B44 JR NC,$7B41   ; If carry clear, go to #R$7B41
 $7B46 LD A,H        ; A = H
 $7B47 OUT ($FB),A   ; ...and send the dot
 $7B49 DJNZ $7B3C    ; Loop back until B reaches 0
 $7B4B POP HL        ; Restore HL
 $7B4C INC HL        ; Next byte, until all 32 have been done
 $7B4D LD A,L        ; A = L
 $7B4E AND $1F       ; Keep only the bits of $1F
 $7B50 JR NZ,$7B38   ; If it is not zero, go to #R$7B38
*$7B52 IN A,($FB)    ; Read the keyboard/port
 $7B54 RRA           ; Rotate A right through carry
 $7B55 JR NC,$7B52   ; If carry clear, go to #R$7B52
 $7B57 LD A,D        ; A = D
 $7B58 RRCA          ; Rotate A right
 $7B59 OUT ($FB),A   ; Write to the port (border colour, beeper or printer)
 $7B5B POP DE        ; Restore DE
 $7B5C POP HL        ; Restore HL
 $7B5D INC H         ; Next pixel row
 $7B5E INC E         ; Increment E
 $7B5F BIT 3,E       ; Test bit 3 of E
 $7B61 JR Z,$7B24    ; If the bit is clear, go to #R$7B24
 $7B63 LD A,$04      ; Stop the motor
 $7B65 OUT ($FB),A   ; Write to the port (border colour, beeper or printer)
*$7B67 POP BC        ; Restore BC
 $7B68 POP DE        ; Restore DE
 $7B69 POP HL        ; Restore HL
 $7B6A RET           ; Done

; Short delay
;
; Counts BC down from 1000. This takes about 26,000 T-states, a little over 7 ms, and slows the keyboard scan in #R$7B86 down enough to debounce the keys. It
; also sets the pace of the idle timer in #R$7240. BC is 0 on return.
c$7B6B LD BC,$03E8   ; BC = 1000
*$7B6E DEC BC        ; {Count down...
 $7B6F LD A,B        ;
 $7B70 OR C          ; }
 $7B71 JR NZ,$7B6E   ; {...to zero, taking a little over 7ms
 $7B73 RET           ; }

; Keyboard scan state
;
; #LIST
; { $7B74-$7B7B: a mask for each of the eight half-rows of the keyboard, ORed with the reading so that those keys are never seen as pressed. The masks hide CAPS
; SHIFT ($01 in the first half-row) and SYMBOL SHIFT ($02 in the last), which are read separately as shift keys, and the unused keys 1, 3, 4 ($0D in the 1-5
; half-row) and 9 ($02 in the 0-6 half-row). }
; { $7B7C-$7B7D: the newly pressed key found by the last scan: the bits in $7B7C and the half-row in $7B7D, or 0 for none. }
; { $7B7E-$7B85: the previous reading of each half-row, used to detect keys that have just gone down. }
; LIST#
b$7B74 DEFB $01,$00,$00,$0D,$02,$00,$00,$02 ; Key masks
 $7B7C DEFB $00,$00                         ; New key
 $7B7E DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; Previous readings

; Read a key
;
; Scans the keyboard directly through port $FE (the game does not use the ROM keyboard routine or interrupts) and returns the ASCII code of a key that has just
; been pressed, or 0 if no new key has been pressed. Holding a key down does not repeat it.
; .
; The routine first waits a few milliseconds (#R$7B6B), then reads each of the eight half-rows in turn, starting with port $FEFE (CAPS SHIFT to V) and rotating
; the high byte of the port address to reach the next row. Each reading is ORed with that row's mask from #R$7B74. A key counts as newly pressed if its bit is 0
; now but was 1 in the previous reading kept at $7B7E; the row and bits of such a key are saved at $7B7C.
; .
; If a new key was found, its row and bit are turned into a number from 0 to 39 (row x 5 + bit, $7BC0-$7BCE). Then the shift keys are checked directly: if CAPS
; SHIFT is held, or SYMBOL SHIFT is not, the normal table at #R$7BEE is used; if SYMBOL SHIFT is held (and CAPS SHIFT is not), the symbol table at #R$7C16 is
; used. The table entry is returned in A.
; .
; In my emulator I replaced this routine with one that fed typed commands to the game.
;
; Output:A ASCII code of the key, or 0
c$7B86 PUSH HL       ; Save HL
 $7B87 PUSH IX       ; Save IX
 $7B89 PUSH BC       ; Save BC
 $7B8A CALL $7B6B    ; Short delay; clear the new-key record
 $7B8D LD ($7B7C),BC ; Store BC in the new key record
 $7B91 LD HL,$7B7E   ; HL = $7B7E
 $7B94 LD IX,$7B74   ; IX = Keyboard scan state (#R$7B74)
 $7B98 LD BC,$FEFE   ; Start with the CAPS SHIFT-V half-row
*$7B9B IN A,(C)      ; Read it and hide the ignored keys
 $7B9D AND $1F       ; Keep only the bits of $1F
 $7B9F OR (IX+$00)   ; Combine with (IX+$00)
 $7BA2 PUSH AF       ; Save AF
 $7BA3 CPL           ; Any key down now that was up before?
 $7BA4 AND (HL)      ; Keep only the bits of (HL)
 $7BA5 CPL           ; A = NOT A
 $7BA6 JR Z,$7BAF    ; If it is zero, go to #R$7BAF
 $7BA8 LD ($7B7C),BC ; Yes: remember the row and the bits
 $7BAC LD ($7B7C),A  ; Store A in the new key record
*$7BAF POP AF        ; Restore AF
 $7BB0 LD (HL),A     ; Save this reading for next time
 $7BB1 INC HL        ; Increment HL
 $7BB2 INC IX        ; Increment IX
 $7BB4 RLC B         ; Next half-row
 $7BB6 JR C,$7B9B    ; If carry is set, go to #R$7B9B
 $7BB8 LD BC,($7B7C) ; Was a new key found?
 $7BBC LD A,B        ; A = B
 $7BBD OR C          ; Combine with C
 $7BBE JR Z,$7BE9    ; If it is zero, go to #R$7BE9
 $7BC0 LD A,$FB      ; Work out its number: 5 x row...
*$7BC2 ADD A,$05     ; Add A,$05
 $7BC4 RRC B         ; Shift/rotate B
 $7BC6 JR C,$7BC2    ; If carry set, go to #R$7BC2
 $7BC8 DEC A         ; Decrement A
*$7BC9 INC A         ; Increment A
 $7BCA RRC C         ; ...+ bit
 $7BCC JR C,$7BC9    ; If carry set, go to #R$7BC9
 $7BCE LD C,A        ; C = A
 $7BCF LD B,$00      ; B = 0
 $7BD1 LD HL,$7BEE   ; Use the normal table...
 $7BD4 LD A,$FE      ; ...if CAPS SHIFT is pressed...
 $7BD6 IN A,($FE)    ; Read the keyboard/port
 $7BD8 AND $01       ; Keep only the bits of $01
 $7BDA JR Z,$7BE4    ; If it is zero, go to #R$7BE4
 $7BDC LD A,$7F      ; ...or SYMBOL SHIFT is not
 $7BDE IN A,($FE)    ; Read the keyboard/port
 $7BE0 AND $02       ; Keep only the bits of $02
 $7BE2 JR NZ,$7BE7   ; If it is not zero, go to #R$7BE7
*$7BE4 LD HL,$7C16   ; Otherwise use the SYMBOL SHIFT table
*$7BE7 ADD HL,BC     ; Look up the key
 $7BE8 LD A,(HL)     ; A = (HL)
*$7BE9 POP BC        ; Restore BC
 $7BEA POP IX        ; Restore IX
 $7BEC POP HL        ; Restore HL
 $7BED RET           ; Done

; Keyboard table
;
; The character for each key when SYMBOL SHIFT is not held (with or without CAPS SHIFT), five entries per half-row in the order the rows are scanned. 0 means
; the key does nothing. Only letters, ENTER and SPACE are here, plus: 5 and 0 give $08 (delete, or west as the first key of a line), 8 gives $09 (east), 7 gives
; $5B (north) and 6 gives $0A (south). See #R$6E46.
b$7BEE DEFB $00,$5A,$58,$43,$56 ; CAPS SHIFT, Z, X, C, V
 $7BF3 DEFB $41,$53,$44,$46,$47 ; A, S, D, F, G
 $7BF8 DEFB $51,$57,$45,$52,$54 ; Q, W, E, R, T
 $7BFD DEFB $00,$00,$00,$00,$08 ; 1, 2, 3, 4, 5
 $7C02 DEFB $08,$00,$09,$5B,$0A ; 0, 9, 8, 7, 6
 $7C07 DEFB $50,$4F,$49,$55,$59 ; P, O, I, U, Y
 $7C0C DEFB $0D,$4C,$4B,$4A,$48 ; ENTER, L, K, J, H
 $7C11 DEFB $20,$00,$4D,$4E,$42 ; SPACE, SYMBOL SHIFT, M, N, B

; Keyboard table (SYMBOL SHIFT)
;
; The character for each key when SYMBOL SHIFT is held. Most keys give the same as #R$7BEE; the differences are SYMBOL SHIFT with 2 ('@', repeat the last
; command, #R$6E71), 0 ($18, delete the whole line, #R$6E82), P (double quote, for speech), M (full stop), N (comma) and SPACE ($02).
b$7C16 DEFB $00,$5A,$58,$43,$56 ; CAPS SHIFT, Z, X, C, V
 $7C1B DEFB $41,$53,$44,$46,$47 ; A, S, D, F, G
 $7C20 DEFB $51,$57,$45,$52,$54 ; Q, W, E, R, T
 $7C25 DEFB $00,$40,$00,$00,$08 ; 1, 2, 3, 4, 5
 $7C2A DEFB $18,$00,$09,$5B,$0A ; 0, 9, 8, 7, 6
 $7C2F DEFB $22,$4F,$49,$55,$59 ; P, O, I, U, Y
 $7C34 DEFB $0D,$4C,$4B,$4A,$48 ; ENTER, L, K, J, H
 $7C39 DEFB $02,$00,$2E,$2C,$42 ; SPACE, SYMBOL SHIFT, M, N, B

; Parser work area
;
; Used by #R$7C4F: the flag at $7C44 and the ten bytes from $7C45 are cleared at the start of each parse.
b$7C3E DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $7C46 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $7C4E DEFB $00

; Parse the command
;
; The parser. It works through the tokens in #R$7093 (the pointer to the next token is kept at $B5CD) and turns them into one or more 24-byte command frames,
; starting at #R$B8B8 and growing downwards in memory ($B8A0, $B888...). The number of frames built is counted in $B5F7.
; .
; A frame holds: the verb (offset 0; bit 7 of byte 1 marks a command with ALL, and bit 6 marks an extra frame that only holds an exception for ALL EXCEPT), an
; adverb, direction or particle (offset 2), and two noun phrases of 10 bytes each (offsets 4 and 14). A noun phrase is two prepositions, a noun and two
; adjectives, so 'put the small curious key in the wooden chest' becomes PUT, (KEY, SMALL, CURIOUS), (IN, CHEST, WOODEN).
; .
; The parser is a state machine. Register E holds a set of flags saying what may come next: bit 1 'a verb may start here', bit 2 'an adverb is allowed', bit 3
; 'we have just had AND', bit 4 'an article is allowed', bit 6 'the first noun phrase is still empty', bit 7 'the second noun phrase is still empty', bit 0 'the
; verb has been followed by a direction'. Register D holds the class of the token being processed.
; .
; For each token, #R$7F3D fetches it and the class (top nibble, divided by 8) indexes the jump table at #R$7C9C, which sends it to a handler: adverbs to $7DBC,
; IN/INTO to #R$7E5F, directions to #R$7DB6, verbs to $7DFD, GO/RUN to #R$7DF9, nouns to $7E9B, adjectives to $7E93, prepositions to #R$7E6C, articles to
; #R$7E5A, special words to #R$8009, AND to #R$7DD5, THEN (and full stop) to $7CC4 and the end of the line to #R$7CC0.
; .
; A word that is not allowed where it appears goes to #R$7FEE, which prints 'what?' (inside a quotation it is ignored instead, so that orders to other
; characters are more forgiving).
; .
; If a previous command was left unfinished ($B60A set, for example after the game asked 'which key?'), the parser starts in a different state so that the words
; just typed are fitted into the old frame (see $7CFC).
c$7C4F LD IY,$B8B8   ; IY = the first command frame
 $7C53 XOR A         ; {Not inside a quotation
; This entry point is used by the routine at #R$80B5.
*$7C54 LD ($B60B),A  ; }
 $7C57 CALL $7F29    ; No ALL or ALL EXCEPT in force
 $7C5A LD ($B5F7),A  ; No frames built yet
 $7C5D LD E,$FF      ; State: everything allowed
 $7C5F LD A,($B60A)  ; {Is an unfinished command waiting to be completed?
 $7C62 AND A         ; }
 $7C63 LD D,$A0      ; (Pretend the previous word was AND)
 $7C65 JP NZ,$7CDE   ; Yes: go straight to the end-of-line processing, which merges the new words in
 $7C68 LD D,$C0      ; Previous class: end of line
; This entry point is used by the routines at #R$7CC0 and #R$8009.
*$7C6A XOR A         ; {START OF A COMMAND: no prepositions yet
 $7C6B LD ($7C44),A  ; }
 $7C6E LD A,E        ; {Allow a verb (bit 1), an adverb (bit 2), and both noun phrases (bits 6 and 7)...
 $7C6F OR $C7        ;
 $7C71 LD E,A        ; }
 $7C72 LD A,($B609)  ; {...but after ALL EXCEPT...
 $7C75 CP $02        ;
 $7C77 JR NZ,$7C7B   ; }
 $7C79 RES 1,E       ; ...no new verb is allowed
*$7C7B CALL $7F2E    ; Clear the frame
; This entry point is used by the routines at #R$7DB6, #R$7DFB, #R$7E6C, #R$7FEE, #R$806B, #R$8072, #R$808A, #R$809A, #R$80CD and #R$8158.
*$7C7E LD HL,$7C45   ; {NEXT NOUN PHRASE: clear the 10-byte noun phrase buffer
 $7C81 LD B,$0A      ;
 $7C83 CALL $70D9    ; }
 $7C86 SET 4,E       ; Articles are allowed again
; This entry point is used by the routine at #R$7E5A.
*$7C88 CALL $7F3D    ; {NEXT WORD: fetch it; A and D = its class, BC = the word
 $7C8B PUSH DE       ; }
 $7C8C RRCA          ; {Class / 8 = offset into the jump table
 $7C8D RRCA          ;
 $7C8E RRCA          ;
 $7C8F LD E,A        ;
 $7C90 LD D,$00      ; }
 $7C92 LD HL,$7C9C   ; {HL = the handler for this class
 $7C95 ADD HL,DE     ;
 $7C96 LD E,(HL)     ;
 $7C97 INC HL        ;
 $7C98 LD D,(HL)     ;
 $7C99 EX DE,HL      ;
 $7C9A POP DE        ; }
 $7C9B JP (HL)       ; Go to it

; Parser jump table
;
; Addresses of the parser's handler for each word class (see #R$7C4F), indexed by class / 16.
w$7C9C DEFW $7DBC    ; {Adverb, IN/INTO, direction, verb, GO/RUN, noun, adjective, preposition, article, special, AND, THEN, end of line
 $7C9E DEFW $7E5F    ;
 $7CA0 DEFW $7DB6    ;
 $7CA2 DEFW $7DFD    ;
 $7CA4 DEFW $7DF9    ;
 $7CA6 DEFW $7E9B    ;
 $7CA8 DEFW $7E93    ;
 $7CAA DEFW $7E6C    ;
 $7CAC DEFW $7E5A    ;
 $7CAE DEFW $8009    ;
 $7CB0 DEFW $7DD5    ;
 $7CB2 DEFW $7CC4    ;
 $7CB4 DEFW $7CC0    ; }

; Is the parser inside a quotation (set Z)?
;
; Returns with Z set if $B60B is exactly 1 (inside one level of quotation).
c$7CB6 LD A,($B60B)  ; A = how many levels of quotation we are inside
 $7CB9 DEC A         ; Is that exactly one level (an ordinary order to a character, not a quotation within a quotation)?
 $7CBA RET           ; Z reflects the answer

; Is the parser inside a quotation?
;
; Returns with Z reset if $B60B is non-zero (inside a quotation), Z set otherwise.
c$7CBB LD A,($B60B)  ; A = how many levels of quotation we are inside
 $7CBE AND A         ; Is that zero (not inside any quotation at all)?
 $7CBF RET           ; Z set means not in a quotation; NZ means we are

; Parser: end of line (and THEN / full stop)
;
; Handles the end-of-line token, and (from $7CC4) THEN or a full stop. It closes the current command frame. If a verb was required but none was given it
; complains (#R$7FF9).
; .
; For ALL (see #R$808A) the verb is flagged. The frame count $B5F7 is increased and, for THEN, the parser goes back to the start state for the next command
; ($7C6A).
; .
; At the end of the line some tidying up is done. If the previous command was unfinished ($B60A), the new words are merged into it ($7D02-$7D4B): empty slots in
; the old frame are filled from the new one. Then frames that have no verb of their own (because of AND, as in 'take the key and the sword') are given the verb
; of the frame before them (#R$7F81). Finally, noun phrases consisting of IT are resolved, and if a quotation is still open the parser starts again.
c$7CC0 XOR A          ; {End of the line: no more commands will follow
 $7CC1 LD ($B5F6),A   ; }
; This entry point is used by the routines at #R$7DD5 and #R$7DFB.
*$7CC4 BIT 1,E        ; THEN, full stop or end: has a verb been given (bit 1 of E clear)?
 $7CC6 JR Z,$7CDE     ; Yes: close the frame
 $7CC8 LD A,($B5F7)   ; {No verb. Is this the first frame?
 $7CCB AND A          ; }
 $7CCC JR NZ,$7CDE    ; No: the verb will be copied from the frame before
 $7CCE LD A,($B5CF)   ; {First frame without a verb. Was the previous word the end of the line too?
 $7CD1 CP $C0         ;
 $7CD3 JR NZ,$7CD8    ;
 $7CD5 CP D           ; }
 $7CD6 JR Z,$7CB6     ; An empty line: nothing to do
*$7CD8 CALL $7CBB     ; Inside a quotation?
 $7CDB JP Z,$7FF9     ; No: a command with no verb, so "what?"
; This entry point is used by the routine at #R$7C4F.
*$7CDE LD A,($B609)   ; {Close the frame. Is ALL in force?
 $7CE1 DEC A          ;
 $7CE2 JR NZ,$7CE8    ; }
 $7CE4 SET 7,(IY+$01) ; Yes: mark the verb with bit 7 (ALL)
*$7CE8 LD HL,$B5F7    ; {HL = the frame count
 $7CEB DEC A          ;
 $7CEC LD A,D         ;
 $7CED JR NZ,$7CF3    ; }
 $7CEF CP $A0         ; {(Under ALL EXCEPT, an AND does not start a new frame)
 $7CF1 JR Z,$7CF4     ; }
*$7CF3 INC (HL)       ; Count the frame
*$7CF4 CALL $7F5D     ; Move on to the next frame
 $7CF7 CP $A0         ; Was this an AND or THEN rather than the end of the line?
 $7CF9 JP Z,$7C6A     ; Yes: start the next command
 $7CFC LD A,($B60A)   ; {END OF THE LINE. Is an unfinished command waiting?
 $7CFF AND A          ; }
 $7D00 JR Z,$7D4C     ; No: go on to share verbs between frames
 $7D02 PUSH DE        ; {Yes: HL = the slot in the old frame that the question was about ($B60A holds its offset)
 $7D03 LD E,A         ;
 $7D04 LD D,$00       ;
 $7D06 LD HL,$B8B8    ;
 $7D09 ADD HL,DE      ;
 $7D0A PUSH IY        ; }
 $7D0C LD IY,$B8A0    ; IY = the frame just typed
 $7D10 LD A,(IY+$08)  ; {Does its first noun phrase have a noun?
 $7D13 OR (IY+$09)    ;
 $7D16 LD DE,$B8A8    ; }
 $7D19 JR Z,$7D32     ; No: use it anyway
 $7D1B LD A,(IY+$08)  ; {Is it the same noun the old command used?
 $7D1E CP (HL)        ;
 $7D1F JR NZ,$7D29    ;
 $7D21 LD A,(IY+$09)  ;
 $7D24 INC HL         ;
 $7D25 CP (HL)        ;
 $7D26 DEC HL         ; }
 $7D27 JR Z,$7D32     ; Yes: take this phrase
*$7D29 LD A,(IY+$12)  ; {Otherwise try the second noun phrase
 $7D2C OR (IY+$13)    ;
 $7D2F LD DE,$B8B2    ;
*$7D32 POP IY         ; }
 $7D34 JR NZ,$7D4B    ; No suitable phrase: leave the old command as it was
 $7D36 EX DE,HL       ; {Fill the empty words of the old phrase (noun and two adjectives) from the new one...
 $7D37 LD B,$03       ;
*$7D39 LD A,(HL)      ;
 $7D3A INC HL         ;
 $7D3B OR (HL)        ;
 $7D3C DEC HL         ; }
 $7D3D JR NZ,$7D41    ; {...keeping any word already there
 $7D3F LD A,(DE)      ;
 $7D40 LD (HL),A      ;
*$7D41 INC HL         ;
 $7D42 INC DE         ;
 $7D43 JR NZ,$7D47    ;
 $7D45 LD A,(DE)      ;
 $7D46 LD (HL),A      ;
*$7D47 INC HL         ;
 $7D48 INC DE         ; }
 $7D49 DJNZ $7D39     ; {...for all three words
*$7D4B POP DE         ; }
*$7D4C PUSH IY        ; {SHARE VERBS: start just above the first frame
 $7D4E LD IY,$B8D0    ; }
 $7D52 LD A,($B5F7)   ; {B = the number of frames
 $7D55 LD B,A         ;
 $7D56 PUSH BC        ; }
 $7D57 CALL $7F5C     ; Step to the first frame
*$7D5A LD A,B         ; {Any frames left?
 $7D5B AND A          ; }
 $7D5C JR Z,$7D6E     ; No
 $7D5E CALL $7F5C     ; Step to the next frame
 $7D61 LD A,(IY+$01)  ; {Does it have a verb of its own?
 $7D64 AND $7F        ;
 $7D66 OR (IY+$00)    ; }
 $7D69 CALL Z,$7F81   ; No (it came from AND): give it the previous frame's verb
 $7D6C JR $7D5A       ; Loop
*$7D6E POP BC         ; {SHARE SECOND NOUN PHRASES, working backwards:
 $7D6F POP IY         ;
 $7D71 PUSH IY        ; }
 $7D73 CALL $7F56     ; step to the previous frame
*$7D76 LD A,B         ; {Any frames left?
 $7D77 AND A          ; }
 $7D78 JP Z,$7DA8     ; No: finish
 $7D7B CALL $7F56     ; Step back one more
 $7D7E LD A,(IY+$12)  ; {Does this frame lack a second noun phrase...
 $7D81 OR (IY+$13)    ;
 $7D84 JR NZ,$7D76    ; }
 $7D86 LD A,(IY+$00)  ; {...and have the same verb as the frame after it...
 $7D89 CP (IX+$00)    ;
 $7D8C JR NZ,$7D76    ;
 $7D8E LD A,(IY+$01)  ;
 $7D91 CP (IX+$01)    ;
 $7D94 JR NZ,$7D76    ; }
 $7D96 LD A,(IX+$0E)  ; {...which does have one?
 $7D99 OR (IX+$0F)    ;
 $7D9C JR Z,$7D76     ; }
 $7D9E EXX            ; {Then copy that phrase into this frame ("put the key and the sword in the chest")
 $7D9F LD DE,$000E    ;
 $7DA2 CALL $7FB4     ; }
 $7DA5 JP $7D76       ; {Loop
*$7DA8 POP IY         ; }
 $7DAA LD A,($B5F6)   ; {More commands to come (THEN)?
 $7DAD AND A          ; }
 $7DAE RET Z          ; No: parsing is complete
 $7DAF CALL $7CBB     ; Inside a quotation?
 $7DB2 RET Z          ; No: return
 $7DB3 JP $7C6A       ; Yes: carry on parsing the words after it

; Parser: a direction
;
; A direction on its own ('north') is a complete movement command: if a verb may start here (bit 1 of E), it is treated as GO NORTH ($7DFB). After a verb, a
; direction is stored as the frame's particle, like an adverb ($7DBC): bit 2 of E must allow it, and it is put at offset 2 of the frame (#R$7FE2). The entry at
; $7DBC is the handler for adverbs.
c$7DB6 BIT 1,E       ; May a verb start here?
 $7DB8 JR NZ,$7DFB   ; Yes: treat the direction as "go <direction>"
 $7DBA LD D,$00      ; Otherwise it is used like an adverb
 $7DBC BIT 2,E       ; ADVERB: is an adverb allowed here?
 $7DBE JP Z,$7FF3    ; No: syntax error
 $7DC1 LD A,($B609)  ; {Under ALL EXCEPT...
 $7DC4 CP $02        ;
 $7DC6 JR NZ,$7DCB   ; }
 $7DC8 CALL $7F22    ; ...start a new frame for it
*$7DCB RES 2,E       ; No more adverbs
 $7DCD LD L,$02      ; {Store the word at offset 2 of the frame
 $7DCF CALL $7FE2    ; }
 $7DD2 JP $7C7E      ; Next noun phrase

; Parser: AND
;
; AND (or a comma) is ambiguous: it may join two objects ('take the key and the sword') or two commands ('take the key and go east'). The parser cannot tell
; until it sees what follows, so it records where it is: the token pointer (in $7C3E and $B5CD, pointing back at the AND), the state flags E ($7C40), the frame
; pointer IY ($7C41) and the frame count ($7C43). It then carries on as though a new command had begun ($7CC4). If a verb turns up next, the new command stands.
; If not, the verb handler at $7DFD is never reached and the next frame inherits the verb of this one (#R$7F81).
; .
; Bit 3 of E is reset to show that an AND has just been seen.
c$7DD5 RES 3,E       ; {Note that AND has been seen (bit 3 clear)
 $7DD7 PUSH DE       ; }
*$7DD8 CALL $7F3D    ; {Skip any further ANDs and commas
 $7DDB CP $A0        ;
 $7DDD JR Z,$7DD8    ; }
 $7DDF DEC HL        ; {Step back so the word after them will be read again
 $7DE0 DEC HL        ; }
 $7DE1 LD ($7C3E),HL ; {Save the token pointer...
 $7DE4 LD ($B5CD),HL ;
 $7DE7 POP DE        ; }
 $7DE8 LD A,E        ; {...the state flags...
 $7DE9 LD ($7C40),A  ; }
 $7DEC LD ($7C41),IY ; ...the frame pointer...
 $7DF0 LD A,($B5F7)  ; {...and the frame count, so the parser can backtrack here
 $7DF3 LD ($7C43),A  ; }
 $7DF6 JP $7CC4      ; Then carry on as if a new command were starting

; Parser: GO or RUN
;
; Clears bit 0 of E and continues into #R$7DFB, so that GO and RUN are treated as verbs that may be followed by a direction.
c$7DF9 RES 0,E       ; Clear this state bit, then fall into the ordinary verb handler below: GO and RUN are treated as verbs that may be followed by a direction

; Parser: a verb
;
; The entry at $7DFB (from #R$7DB6) supplies the verb GO ($30 class) for a bare direction; the entry at $7DFD handles verbs typed by the player.
; .
; If a verb arrives when a command has already been started and there has been no AND, the parser backtracks: the state saved by the last AND (#R$7DD5) is
; restored and the AND is reinterpreted as THEN, splitting the line into two commands.
; .
; Otherwise the verb must be allowed here (bit 1 of E). It is stored at offset 0 of the frame (#R$7FDE). GO and RUN look ahead (from $7E31) past any adverbs: if
; the next word is a direction, the verb is dropped and the direction stored as the particle, so that 'go north' and 'north' produce the same frame.
c$7DFB LD D,$30      ; Class of GO (for a bare direction)
 $7DFD BIT 3,E       ; VERB: has there just been an AND?
 $7DFF JR NZ,$7E1F   ; Yes: a new command after AND is fine
 $7E01 CALL $7CBB    ; Inside a quotation?
 $7E04 JR NZ,$7E1F   ; Yes: accept it
 $7E06 LD HL,($7C3E) ; {A second verb without AND: backtrack to the last AND...
 $7E09 LD ($B5CD),HL ; }
 $7E0C LD D,$B0      ; ...and treat it as THEN
 $7E0E LD A,($7C40)  ; {Restore the state saved at the AND
 $7E11 LD E,A        ;
 $7E12 LD A,($7C43)  ;
 $7E15 LD ($B5F7),A  ;
 $7E18 LD IY,($7C41) ; }
 $7E1C JP $7CC4      ; Close the frame and start a new one
*$7E1F CALL $7F29    ; A verb cancels ALL
 $7E22 BIT 1,E       ; Is a verb allowed here?
 $7E24 JP Z,$7FF3    ; No: syntax error
 $7E27 BIT 0,E       ; Is this a GO followed by a direction?
 $7E29 JR Z,$7E31    ; No: look ahead
*$7E2B CALL $7FDE    ; Store the verb in the frame
 $7E2E JP $7C7E      ; Next noun phrase
*$7E31 PUSH DE       ; {Look ahead past any adverbs...
 $7E32 PUSH BC       ;
 $7E33 LD HL,($B5CD) ;
 $7E36 PUSH HL       ;
*$7E37 CALL $7F3D    ;
 $7E3A CP $00        ;
 $7E3C JR Z,$7E37    ;
 $7E3E SET 0,E       ; }
 $7E40 CP $20        ; ...is the next word a direction?
 $7E42 JR Z,$7E4C    ; Yes
 $7E44 POP HL        ; {No: rewind and store the verb normally
 $7E45 LD ($B5CD),HL ;
 $7E48 POP BC        ;
 $7E49 POP DE        ;
 $7E4A JR $7E2B      ; }
*$7E4C CALL $7FDE    ; {Store GO as the verb...
 $7E4F POP HL        ;
 $7E50 POP BC        ;
 $7E51 POP HL        ; }
 $7E52 LD L,$02      ; {...and the direction at offset 2
 $7E54 CALL $7FE2    ; }
 $7E57 JP $7C7E      ; Next noun phrase

; Parser: an article
;
; Articles (A, AN, THE and the like) are ignored, apart from clearing bit 4 of E; the parser goes straight on to the next word ($7C88).
c$7E5A RES 4,E       ; No article is expected next
 $7E5C JP $7C88      ; Go back for the next word: the article itself is simply ignored

; Parser: IN or INTO
;
; IN and INTO are usually prepositions, and are handled as such (#R$7E6C, with class $70). The exception is when a verb may start here and the previous word was
; AND or a comma, in which case they begin a new command such as 'and in': the parser jumps back to $7DFB to treat them like a direction.
c$7E5F BIT 1,E       ; May a verb start here?
 $7E61 JR Z,$7E6A    ; No: treat IN/INTO as an ordinary preposition
 $7E63 LD A,($B5CF)  ; {A verb could start here - was the word just before this one AND or a comma?
 $7E66 CP $A0        ; }
 $7E68 JR Z,$7DFB    ; If so, IN/INTO really begins a new command (like a direction): treat it as one
*$7E6A LD D,$70      ; Otherwise it is an ordinary preposition after all

; Parser: a noun phrase
;
; Collects one noun phrase into the buffer at $7C45 (cleared by the main parser loop): up to two prepositions (#R$7EE6; a third one is an error), any number of
; articles (skipped), up to two adjectives (#R$7ED3; a third one is an error), and a noun, which ends the phrase ($7E9B stores it at $7C49). Adjectives enter at
; $7E93 and nouns at $7E9B. A phrase that ends without a noun (for example 'look through') is allowed and simply has no noun.
; .
; The phrase is then stored in the frame by #R$7EF5: the first phrase at offset 4 and the second at offset 14. When ALL EXCEPT is in force ($B609 = 2), each
; extra noun phrase instead starts a new frame (#R$7F22), with bit 6 of its verb marked, so that 'take all except the sword and the key' produces one frame per
; exception.
c$7E6C CALL $7EE6      ; Store the preposition
*$7E6F CALL $7F3D      ; Next word
 $7E72 CP $70          ; Another preposition?
 $7E74 JR Z,$7E6C      ; Yes: store it too
 $7E76 CP $80          ; {An article?
 $7E78 JR NZ,$7E83     ; }
 $7E7A BIT 4,E         ; Are articles allowed here?
 $7E7C CALL Z,$7FEE    ; No: syntax error
 $7E7F RES 4,E         ; Only one article
 $7E81 JR $7E6F        ; Next word
*$7E83 CP $60          ; {An adjective?
 $7E85 JR Z,$7E93      ; }
 $7E87 CP $50          ; {A noun?
 $7E89 JR Z,$7E9B      ; }
 $7E8B LD HL,($B5CB)   ; {Anything else ends the phrase: step back so it is read again
 $7E8E LD ($B5CD),HL   ;
 $7E91 JR $7EA1        ; }
*$7E93 CALL $7ED3      ; Store the adjective
 $7E96 CALL $7F3D      ; {Next word
 $7E99 JR $7E83        ; }
*$7E9B LD HL,$7C49     ; {Store the noun
 $7E9E LD (HL),C       ;
 $7E9F INC HL          ;
 $7EA0 LD (HL),B       ; }
*$7EA1 LD D,$50        ; {The phrase is complete. Under ALL EXCEPT...
 $7EA3 LD A,($B609)    ;
 $7EA6 CP $02          ;
 $7EA8 JR NZ,$7ECC     ; }
 $7EAA LD HL,($7C45)   ; {...a phrase without a preposition...
 $7EAD LD A,H          ;
 $7EAE OR L            ;
 $7EAF JR NZ,$7EC9     ; }
 $7EB1 BIT 6,(IY+$19)  ; {...is an exception: is this frame already an exception frame?
 $7EB5 JR NZ,$7EBF     ; }
 $7EB7 LD BC,$FFE8     ; {No: make a new frame for it
 $7EBA ADD IY,BC       ;
 $7EBC CALL $7F2E      ; }
*$7EBF CALL $7F1A      ; Store the phrase as its first noun phrase...
 $7EC2 LD (IY+$01),$40 ; ...and mark the frame as an exception (bit 6)
 $7EC6 JP $7C7E        ; Next noun phrase
*$7EC9 CALL $7F22      ; A phrase with a preposition under ALL EXCEPT: new frame
*$7ECC CALL $7EF5      ; Store the phrase in the frame
 $7ECF JP Z,$7C7E      ; {Next noun phrase
 $7ED2 RET             ; }

; Parser: store an adjective
;
; Stores the adjective token BC in the first empty adjective slot of the noun phrase buffer ($7C4B or $7C4D). If both are full, it is a syntax error (#R$7FEE).
c$7ED3 LD HL,$7C4B   ; HL = the first adjective slot of the noun phrase being built
; This entry point is used by the routine at #R$7EE6.
*$7ED6 LD A,(HL)     ; {Is it still empty?
 $7ED7 INC HL        ;
 $7ED8 OR (HL)       ; }
 $7ED9 JR Z,$7EE2    ; Yes: use this slot
 $7EDB INC HL        ; {No: try the second adjective slot instead
 $7EDC LD A,(HL)     ;
 $7EDD INC HL        ;
 $7EDE OR (HL)       ; }
 $7EDF JP NZ,$7FEE   ; That is full too - a third adjective makes no sense: syntax error
*$7EE2 LD (HL),B     ; {Store the adjective's high byte...
 $7EE3 DEC HL        ; }
 $7EE4 LD (HL),C     ; {...and its low byte
 $7EE5 RET           ; }

; Parser: store a preposition
;
; Counts the prepositions in the current noun phrase ($7C44) and stores the token BC in the first empty preposition slot ($7C45 or $7C47). A third preposition
; is a syntax error (#R$7FEE).
c$7EE6 LD HL,$7C44   ; HL = the count of prepositions seen in this noun phrase so far
 $7EE9 INC (HL)      ; {One more
 $7EEA LD A,(HL)     ; }
 $7EEB CP $03        ; Is that three or more?
 $7EED JP NC,$7FEE   ; A third preposition makes no sense: syntax error
 $7EF0 LD HL,$7C45   ; Otherwise HL = the first or second preposition slot...
 $7EF3 JR $7ED6      ; ...and store it there, sharing the adjective-storing code above

; Parser: store a noun phrase in the frame
;
; Copies the 10-byte noun phrase from $7C45 into the command frame: to offset 4 if bit 6 of E says the first phrase is still empty ($7F1A), otherwise to offset
; 14 if bit 7 says the second is empty ($7F02). The corresponding bit of E is cleared. If both phrases are already full, it is a syntax error (#R$7FEE).
c$7EF5 BIT 6,E       ; Is the first noun phrase free?
 $7EF7 JR NZ,$7F1A   ; Yes: store it there
 $7EF9 BIT 7,E       ; Is the second free?
 $7EFB JR NZ,$7F02   ; Yes: store it there
 $7EFD CALL $7FEE    ; {Neither: syntax error
 $7F00 XOR A         ;
 $7F01 RET           ; }
; This entry point is used by the routine at #R$80AF.
*$7F02 RES 7,E       ; {The second phrase is now taken
 $7F04 PUSH DE       ; }
 $7F05 LD DE,$000E   ; {Offset 14 in the frame
*$7F08 PUSH BC       ;
 $7F09 PUSH IY       ;
 $7F0B POP HL        ; }
 $7F0C ADD HL,DE     ; {DE = the place in the frame
 $7F0D EX DE,HL      ; }
 $7F0E LD HL,$7C45   ; {Copy the 10-byte noun phrase there
 $7F11 LD BC,$000A   ;
 $7F14 LDIR          ;
 $7F16 POP BC        ;
 $7F17 POP DE        ; }
 $7F18 XOR A         ; {Return with Z set
 $7F19 RET           ; }
; This entry point is used by the routines at #R$7E6C and #R$80AF.
*$7F1A RES 6,E       ; {The first phrase is now taken
 $7F1C PUSH DE       ; }
 $7F1D LD DE,$0004   ; {Offset 4 in the frame
 $7F20 JR $7F08      ; }

; Parser: move on to the next frame
;
; Finds the next frame (#R$7F6F) and makes it the current one (IY).
c$7F22 CALL $7F6F    ; IX = the next frame (24 bytes lower, since frames are built downwards)
 $7F25 PUSH IX       ; IY = that same frame...
 $7F27 POP IY        ; ...which becomes the current one

; Parser: clear the ALL state
;
; Sets $B609 to 0: no ALL or ALL EXCEPT is in force.
c$7F29 XOR A         ; {A = 0: no ALL, and no ALL EXCEPT, is in force
 $7F2A LD ($B609),A  ;
 $7F2D RET           ; }

; Parser: clear the current frame
;
; Clears the 24 bytes of the frame at IY, and the two bytes of the verb of the frame after it (at IY-24), so that the next frame starts empty.
c$7F2E PUSH IY       ; {HL = the current frame
 $7F30 POP HL        ; }
 $7F31 LD B,$18      ; 24 bytes to clear: the whole frame
 $7F33 CALL $70D9    ; Clear it
 $7F36 LD (IY-$18),B ; Also clear the verb of the frame that comes after this one (2 bytes, 24 further along)...
 $7F39 LD (IY-$17),B ; {...(B is 0 here, left over from the clearing loop) so it starts empty too
 $7F3C RET           ; }

; Parser: fetch the next token
;
; Reads the next token from the token buffer (pointer at $B5CD), which it then advances by two. On return D holds the class (the top nibble of the first byte)
; and BC the word: B the top nibble of the offset and C the bottom byte. The previous class is saved at $B5CF (so that handlers can see what came before), and
; the position of the token is saved at $B5CB for error messages. A also holds the class.
;
; Output:A Class
;        D Class
;        BC Word
c$7F3D LD HL,($B5CD) ; HL = the token pointer
 $7F40 LD ($B5CB),HL ; Remember where this word is, for error messages
 $7F43 LD A,D        ; {Remember the previous class
 $7F44 LD ($B5CF),A  ; }
 $7F47 LD A,(HL)     ; {B = the top four bits of the word offset
 $7F48 AND $0F       ;
 $7F4A LD B,A        ; }
 $7F4B LD A,(HL)     ; {D = A = the class
 $7F4C AND $F0       ;
 $7F4E LD D,A        ;
 $7F4F INC HL        ; }
 $7F50 LD C,(HL)     ; {C = the bottom eight bits of the offset
 $7F51 INC HL        ; }
 $7F52 LD ($B5CD),HL ; {Move the token pointer on
 $7F55 RET           ; }

; Parser: step back to the previous frame
;
; Decrements B (a frame counter), finds the previous frame (#R$7F6F, 24 bytes higher) and swaps IX and IY, so that IY is the previous frame and IX the one we
; came from.
c$7F56 DEC B         ; One frame fewer to go
 $7F57 CALL $7F6F    ; IX = the previous frame (24 bytes higher)
 $7F5A JR $7F60      ; Swap IX and IY

; Parser: step on to the next frame
;
; Decrements B, finds the next frame (#R$7F69, 24 bytes lower) and swaps IX and IY, so that IY is the next frame and IX the one we came from. The entry at $7F5D
; does not decrement B.
c$7F5C DEC B         ; One frame fewer to go
; This entry point is used by the routine at #R$7CC0.
*$7F5D CALL $7F69    ; IX = the next frame (24 bytes lower)
; This entry point is used by the routine at #R$7F56.
*$7F60 PUSH IX       ; {Swap IX and IY...
 $7F62 PUSH IY       ;
 $7F64 POP IX        ; }
 $7F66 POP IY        ; {...so IY is the new frame and IX the old one
 $7F68 RET           ; }

; Find the next frame (24 bytes lower)
;
; Returns IX = IY - 24: the frame after the current one in parse order (frames are built downwards from #R$B8B8). Frames that only hold an exception for ALL
; EXCEPT (bit 6 of byte 1) are skipped. Continues into #R$7F6F at $7F73.
c$7F69 PUSH DE       ;
 $7F6A LD DE,$FFE8   ; {Step -24: the next frame
 $7F6D JR $7F73      ; }

; Find the previous frame (24 bytes higher)
;
; Returns IX = IY + 24: the frame before the current one in parse order, skipping ALL EXCEPT exception frames (bit 6 of byte 1). The entry at $7F73 is shared
; with #R$7F69, which uses -24 instead.
c$7F6F PUSH DE        ;
 $7F70 LD DE,$0018    ; Step +24: the previous frame
; This entry point is used by the routine at #R$7F69.
*$7F73 PUSH IY        ; {IX = IY...
 $7F75 POP IX         ; }
*$7F77 ADD IX,DE      ; ...plus the step
 $7F79 BIT 6,(IX+$01) ; Is this an exception frame (bit 6)?
 $7F7D JR NZ,$7F77    ; {Yes: skip over it
 $7F7F POP DE         ;
 $7F80 RET            ; }

; Parser: give a frame the previous frame's verb
;
; Copies the verb from the frame at IX into the frame at IY (keeping IY's flag bits). This is how the verb is shared when AND joins objects: 'take the key and
; the sword' produces two TAKE frames.
; .
; If the new frame has a second noun phrase, and bit 7 of E is set, the second noun phrase and the particle of the previous frame are copied too ($7FC9), so
; that 'put the key and the sword in the chest' puts both in the chest.
c$7F81 EXX           ; Switch to the alternate registers for a moment
 $7F82 LD A,(IX+$01) ; A = the previous frame's own verb flags...
 $7F85 AND $7F       ; ...with the ALL bit (bit 7) stripped out, since that should not be copied along
 $7F87 OR (IY+$01)   ; {Combine that with whatever flags this frame already carries (such as its own EXCEPT bit)
 $7F8A LD (IY+$01),A ; }
 $7F8D LD A,(IX+$00) ; {Copy the verb itself too
 $7F90 LD (IY+$00),A ; }
 $7F93 EXX           ; Back to the ordinary registers
 $7F94 LD A,(IY+$1C) ; {Does the new frame have a second noun phrase of its own?
 $7F97 OR (IY+$1D)   ; }
 $7F9A RET Z         ; No noun there at all: nothing more to copy
 $7F9B BIT 7,E       ; Is the "second phrase still empty" state flag set?
 $7F9D RET Z         ; It is not empty: leave it as it is
 $7F9E EXX           ; Switch to the alternate registers again
 $7F9F PUSH IY       ; {HL = the new frame's own address
 $7FA1 POP HL        ; }
 $7FA2 LD DE,$0012   ; {Move on to its particle...
 $7FA5 ADD HL,DE     ; }
 $7FA6 PUSH HL       ; Save that address
 $7FA7 LD DE,$FFF6   ; {Move back instead to the PREVIOUS frame's own particle
 $7FAA ADD HL,DE     ; }
 $7FAB POP DE        ; DE = the new frame's particle address, HL = the previous frame's
 $7FAC LD BC,$0006   ; {Copy 6 bytes: the particle, and the start of the noun that follows it
 $7FAF LDIR          ; }
 $7FB1 LD DE,$0004   ; Offset to the second noun phrase
; This entry point is used by the routine at #R$7CC0.
*$7FB4 CALL $7FC9    ; Copy that whole phrase too, from the previous frame
 $7FB7 LD A,(IY+$02) ; {Does the new frame's OWN particle turn out to be still empty?
 $7FBA OR (IY+$03)   ; }
 $7FBD LD DE,$0002   ; {If so, copy just the particle word on its own as well
 $7FC0 CALL Z,$7FCD  ; }
 $7FC3 EXX           ; {Back to the ordinary registers
 $7FC4 RET           ; }

; Copy part of one frame to another
;
; Copies C bytes at offset DE from the frame at IX to the same offset in the frame at IY. Entry points: $7FC5 copies 6 bytes (a noun and two adjectives), $7FC9
; copies 10 (a whole noun phrase) and $7FCD copies 2 (one word). Used by #R$7F81 and #R$7CC0 to share words between commands.
c$7FC5 LD C,$06      ; {6 bytes: a noun with two adjectives
 $7FC7 JR $7FCF      ; }
; This entry point is used by the routine at #R$7F81.
*$7FC9 LD C,$0A      ; {10 bytes: a whole noun phrase
 $7FCB JR $7FCF      ; }
; This entry point is used by the routine at #R$7F81.
*$7FCD LD C,$02      ; 2 bytes: a single word
*$7FCF PUSH IY       ; {HL = the destination frame, moved on by DE...
 $7FD1 POP HL        ;
 $7FD2 ADD HL,DE     ; }
 $7FD3 PUSH HL       ; Save that address
 $7FD4 PUSH IX       ; {HL = the source frame, moved on by the same amount...
 $7FD6 POP HL        ;
 $7FD7 ADD HL,DE     ; }
 $7FD8 POP DE        ; DE = the destination, HL = the source
 $7FD9 LD B,$00      ; {Copy the given number of bytes
 $7FDB LDIR          ;
 $7FDD RET           ; }

; Parser: store the verb
;
; Clears bit 1 of E (no more verbs allowed) and stores the token BC at offset 0 of the current frame. The entry at $7FE2 stores BC at offset L instead (used for
; the particle at offset 2).
;
;  Input:BC Token
; Output:E Updated state
c$7FDE RES 1,E       ; No more verbs allowed on this line, until the next command starts
 $7FE0 LD L,$00      ; L = the offset within the frame to store at (0 for the verb, or wherever the caller set it for the particle)
; This entry point is used by the routines at #R$7DB6 and #R$7DFB.
*$7FE2 PUSH DE       ; Save DE
 $7FE3 PUSH IY       ; {HL = the current frame, plus that offset...
 $7FE5 POP DE        ;
 $7FE6 LD H,$00      ;
 $7FE8 ADD HL,DE     ; }
 $7FE9 LD (HL),C     ; {Store the word's low byte...
 $7FEA INC HL        ; }
 $7FEB LD (HL),B     ; ...then its high byte (with the class in the top nibble)
 $7FEC POP DE        ; {Restore DE
 $7FED RET           ; }

; Parser: syntax error
;
; Called when a word turns up where it is not allowed. Inside a quotation the word is simply skipped. Otherwise the parser's own return address is discarded and
; #R$7FF9 prints 'what?'.
c$7FEE CALL $7CBB    ; Are we inside a quotation (an order to a character)?
 $7FF1 RET NZ        ; Yes: quietly ignore the bad word and let the order carry on
 $7FF2 POP HL        ; No: throw away our own return address, since the rest of this line is being abandoned
; This entry point is used by the routines at #R$7DB6, #R$7DFB and #R$8072.
*$7FF3 CALL $7CBB    ; Check again (the same test, just to be sure)
 $7FF6 JP NZ,$7C7E   ; If it now looks like we ARE in a quotation after all, go back into the parser as if nothing had gone wrong; otherwise fall straight into
                     ; #R$7FF9 below and print "what?"

; Print "what?"
;
; Prints 'what?' (the message at $AC93) in the lower window, and returns with Z reset so that the command is abandoned.
c$7FF9 LD HL,$AC93   ; "what?"
 $7FFC LD A,$01      ; {Send it to the lower (input) window...
 $7FFE LD ($B5F2),A  ; }
 $8001 CALL $72D4    ; ...and print it
 $8004 OR $01        ; Make A non-zero...
 $8006 RET           ; ...so the main loop knows this command has failed

; Unused
s$8007 DEFS $02

; Parser: special words
;
; Looks the special word up in the table at #R$8029 and jumps to its handler. DE (the word's class and the parser's state) is saved on the stack at $800C and
; restored at $8027 before the jump.
; .
; If the word is not in the table, the jump at $801C goes back into the parser WITHOUT restoring DE, leaving two bytes on the stack. Every special word except
; DO is in the table, so in practice this happens only when the player types DO - and then the game loses control completely (see the bug note).
; .
; The special words are ALL, EXCEPT, IT, ONE, the game commands PRINT, NOPRINT, LOAD, SAVE, QUIT, HELP, SCORE and PAUSE, and a quotation mark (which has class
; $90 and a word of 0, and matches the first entry, #R$80CD).
c$8009 LD HL,$8029   ; HL = the table of special words
 $800C PUSH DE       ; Save the class and the parser state...
 $800D LD D,$0D      ; Thirteen entries to check
*$800F LD A,(HL)     ; {Compare the low byte of the word
 $8010 INC HL        ;
 $8011 CP C          ; }
 $8012 JR NZ,$8018   ; No match: next entry
 $8014 LD A,(HL)     ; {Compare the high nibble
 $8015 CP B          ; }
 $8016 JR Z,$801F    ; Found it
*$8018 INC HL        ; {Next entry
 $8019 DEC D         ;
 $801A JR NZ,$800F   ; }
 $801C JP $7C6A      ; Not in the table: carry on parsing - but DE is never restored, so two bytes are left on the stack (see the bug note)
*$801F LD DE,$0019   ; {Found: the handlers are 25 bytes further on
 $8022 ADD HL,DE     ; }
 $8023 LD E,(HL)     ; {HL = the handler
 $8024 INC HL        ;
 $8025 LD D,(HL)     ;
 $8026 EX DE,HL      ; }
 $8027 POP DE        ; ...restore the class and state
 $8028 JP (HL)       ; Jump to the handler

; Special words
;
; Thirteen word references (low byte first) followed by the thirteen addresses of their handlers (#R$8009).
b$8029 DEFW $0000    ; {Quote, ALL, EXCEPT, IT, ONE, PRINT, NOPRINT, LOAD, SAVE, QUIT, HELP, SCORE, PAUSE
 $802B DEFW $004E    ;
 $802D DEFW $0249    ;
 $802F DEFW $03A2    ;
 $8031 DEFW $04B1    ;
 $8033 DEFW $04FF    ;
 $8035 DEFW $047D    ;
 $8037 DEFW $03F2    ;
 $8039 DEFW $0584    ;
 $803B DEFW $051C    ;
 $803D DEFW $0322    ;
 $803F DEFW $058E    ;
 $8041 DEFW $04DC    ; }
 $8043 DEFW $80CD    ; {Handlers
 $8045 DEFW $808A    ;
 $8047 DEFW $8072    ;
 $8049 DEFW $809A    ;
 $804B DEFW $7C7E    ;
 $804D DEFW $805D    ;
 $804F DEFW $8067    ;
 $8051 DEFW $8209    ;
 $8053 DEFW $8284    ;
 $8055 DEFW $8149    ;
 $8057 DEFW $8158    ;
 $8059 DEFW $81A7    ;
 $805B DEFW $81F2    ; }

; PRINT and NOPRINT
;
; PRINT ($805D) switches on copying of the story window to a ZX Printer (#R$7B15), by setting $B5E3 to 1, but only if a printer is attached: bit 6 of port $FB
; is 0 when one is. NOPRINT ($8067) sets $B5E3 to 0.
; .
; The test for the printer has a curious slip: when no printer is attached, the JR NZ at $805F jumps to $8069, which is in the middle of the LD ($B5E3),A
; instruction. The bytes there are executed as EX (SP),HL and OR L before execution reaches #R$806B. In my tests the game carried on normally after PRINT with
; no printer, so the damage appears to be harmless in practice.
c$805D IN A,($FB)    ; Read the ZX Printer's status port
 $805F BIT 6,A       ; Is a printer actually attached (bit 6 clear means yes)?
 $8061 JR NZ,$806B   ; No printer: leave printing switched off (joins the shared ending below, via the mis-jump described in the bug note)
 $8063 LD A,$01      ; {PRINT: switch printing on
 $8065 JR $8068      ; }
 $8067 XOR A         ; {NOPRINT: switch it off
*$8068 LD ($B5E3),A  ; }

; Special word finished: carry on parsing
;
; Restores the previous word class from $B5CF into D and goes back to the parser loop ($7C7E). Used by the game commands, which are not part of the command
; being parsed.
c$806B LD A,($B5CF)  ; A = the word class that came before this special word
 $806E LD D,A        ; Restore it, as if the special word had never been seen
 $806F JP $7C7E      ; Go back to reading the next word

; EXCEPT
;
; EXCEPT (or BUT) is only allowed straight after ALL ($B609=1). It sets $B609 to 2 and bit 7 of the current frame's verb, so that the command applies to
; everything except the objects that follow.
c$8072 LD A,($B609)  ; {Is ALL actually in force?
 $8075 CP $01        ; }
 $8077 JP NZ,$7FF3   ; No: EXCEPT makes no sense here - syntax error
 $807A LD A,$02      ; {Yes: switch to ALL EXCEPT
 $807C LD ($B609),A  ; }
 $807F LD A,(IY+$01) ; {Mark the CURRENT frame's verb with the EXCEPT bit...
 $8082 OR $80        ; }
 $8084 LD (IY+$01),A ; ...so #R$7E6C knows any further noun phrases are exceptions, not extra targets
 $8087 JP $7C7E      ; Go back to reading the next word

; ALL
;
; Sets $B609 to 1 (ALL in force) unless ALL EXCEPT is already in force.
c$808A LD A,($B609)  ; {Is ALL EXCEPT already in force?
 $808D CP $02        ; }
 $808F JP Z,$7C7E    ; Yes: a second ALL changes nothing - just carry on
 $8092 LD A,$01      ; {No: switch plain ALL on
 $8094 LD ($B609),A  ; }
 $8097 JP $7C7E      ; Go back to reading the next word

; IT
;
; Replaces IT with the object most recently mentioned: the noun and two adjectives saved at $B5D1 (by #R$8614 each time a command names a target) are copied
; into the noun phrase buffer, which is then stored in the frame (#R$80AF). So 'take the key. unlock the door with it.' works.
c$809A PUSH DE       ; Save DE
 $809B LD HL,$B5D1   ; HL = the words remembered for IT (the last object named)
 $809E LD DE,$7C49   ; {Copy them into the noun-phrase buffer currently being built
 $80A1 LD BC,$0006   ;
 $80A4 LDIR          ; }
 $80A6 POP DE        ; Restore DE
 $80A7 BIT 7,E       ; Is the first noun phrase still empty?
 $80A9 CALL $80AF    ; Store this phrase in whichever slot is free
 $80AC JP $7C7E      ; Go back to reading the next word

; Store the noun phrase in the frame (jump)
;
; Jumps to $7F02 (second noun phrase) if Z is set, otherwise to $7F1A (first noun phrase); see #R$7EF5.
c$80AF JP Z,$7F02    ; First phrase already taken: store in the second
 $80B2 JP $7F1A      ; Otherwise store in the first

; Opening quotation mark
;
; Begins a quotation, as in SAY TO THORIN "GO EAST". The current word class and frame count are saved ($8007, $8008), and the parser is re-entered at $7C54 with
; the frame pointer moved to a fresh frame, so that the words inside the quotation are parsed as complete commands of their own.
c$80B5 LD A,D        ; {Save the word class we had reached...
 $80B6 LD ($8007),A  ; }
 $80B9 PUSH DE       ; {...and DE, BC and IY, so the parser can be restored exactly when the quotation closes
 $80BA PUSH BC       ;
 $80BB PUSH IY       ; }
 $80BD LD A,($B5F7)  ; {Save the frame count too
 $80C0 LD ($8008),A  ; }
 $80C3 LD DE,$FFE8   ; {Move on to a fresh frame (24 bytes higher, since frames are built downwards)
 $80C6 ADD IY,DE     ; }
 $80C8 LD A,$01      ; One level deeper inside a quotation
 $80CA JP $7C54      ; Start parsing again, from a clean state, for the words inside the quotes

; Quotation mark
;
; A quotation mark (class $90, word 0) arrives here from #R$8009. If no quotation is open, it is an opening quote (#R$80B5). Otherwise it closes the quotation:
; $B60B is decreased, and the frames that were parsed inside it are moved to the orders buffer at #R$B628 so that the character spoken to can act on them later.
; .
; The orders buffer has eight slots of 25 bytes. Each command is put in the first free slot: the slot's first byte is set to $FF (in use) and the 24-byte frame
; is copied after it. An ALL EXCEPT exception frame (bit 6) is stored as an empty order. $B627 is set to the number of orders stored. The parser state saved at
; the opening quote is then restored.
c$80CD LD A,($B60B)    ; {Are we already inside a quotation?
 $80D0 AND A           ; }
 $80D1 JR Z,$80B5      ; No: this is an OPENING quote (#R$80B5)
 $80D3 DEC A           ; {Yes: this closes it - one level shallower
 $80D4 LD ($B60B),A    ; }
 $80D7 LD A,($8008)    ; {A = the frame count as it was when the quotation opened
 $80DA LD B,A          ; }
 $80DB LD A,($B5F7)    ; {Subtract that from the frame count now, giving how many frames were built INSIDE the quotation
 $80DE SUB B           ;
 $80DF AND A           ; }
 $80E0 LD C,$00        ; C will count how many orders are actually stored
 $80E2 JR Z,$8130      ; None at all (an empty quotation): tidy up and finish, below
 $80E4 POP IY          ; {Restore IY to the frame just before the quotation opened...
 $80E6 PUSH IY         ; }
 $80E8 LD DE,$FFE8     ; {...then move up to the FIRST frame built inside it
 $80EB ADD IY,DE       ; }
 $80ED LD B,A          ; B = how many frames to process
*$80EE LD IX,$B628     ; IX = the start of the orders buffer
 $80F2 PUSH DE         ; {Find the first free slot (marked with a 0 in its first byte)...
 $80F3 PUSH BC         ;
 $80F4 LD DE,$0019     ;
 $80F7 LD B,$08        ;
*$80F9 LD A,(IX+$00)   ;
 $80FC AND A           ;
 $80FD JR Z,$8103      ;
 $80FF ADD IX,DE       ;
 $8101 DJNZ $80F9      ; }
*$8103 LD (IX+$00),$FF ; ...mark it in use (properly addressed later, in #R$88A7)
 $8107 INC IX          ; Move past the slot's own marker byte, to where the frame goes
 $8109 POP BC          ; {Restore the frame counter
 $810A POP DE          ; }
 $810B JR NZ,$8130     ; No free slot was found: the rest of the orders are simply lost
 $810D BIT 6,(IY+$01)  ; Is this frame only an ALL EXCEPT exception, with no command of its own?
 $8111 JR Z,$8119      ; No: copy it properly, below
 $8113 LD (IX-$01),$00 ; {Yes: store it as an empty order instead
 $8117 JR $812B        ; }
*$8119 PUSH BC         ; {Copy the whole 24-byte frame into the order slot...
 $811A LD B,$18        ;
*$811C LD A,(IY+$00)   ;
 $811F LD (IX+$00),A   ;
 $8122 INC IY          ;
 $8124 INC IX          ;
 $8126 DJNZ $811C      ;
 $8128 POP BC          ; }
 $8129 ADD IY,DE       ; Move IY on to the next frame that was inside the quotation
*$812B ADD IY,DE       ; (the exception-frame path joins here too, at the same offset)
 $812D INC C           ; One more order stored
 $812E DJNZ $80EE      ; Repeat for every frame that was built inside the quotation
*$8130 XOR A           ; {No ALL or ALL EXCEPT is in force any more
 $8131 LD ($B609),A    ; }
 $8134 LD A,C          ; {Remember how many orders were actually stored
 $8135 LD ($B627),A    ; }
 $8138 POP IY          ; Restore the frame pointer from before the quotation opened
 $813A LD A,($8008)    ; {Restore the frame count too
 $813D LD ($B5F7),A    ; }
 $8140 POP BC          ; {Restore BC and DE, saved when the quotation opened
 $8141 POP DE          ; }
 $8142 LD A,($8007)    ; {Restore the word class the parser had reached
 $8145 LD D,A          ; }
 $8146 JP $7C7E        ; Go back to reading the next word, as if the whole quotation had been a single word

; QUIT
;
; Prints the score (#R$81AD), waits for a key, and restarts the game (#R$6C27).
c$8149 CALL $81AD    ; Print the score
*$814C XOR A         ; {Wait for a key
 $814D IN A,($FE)    ;
 $814F AND $1F       ;
 $8151 CP $1F        ;
 $8153 JR Z,$814C    ; }
 $8155 JP $6C27      ; Restart the game

; HELP
;
; HELP gives a hint that depends on where Bilbo is. His room is looked up in the table at #R$8185; if it is there, that message is printed, otherwise the
; general one at $B358: 'you're doing fine.' The message goes to the lower window. HELP is ignored if a character is the actor (for example inside SAY TO).
c$8158 LD A,($B5DB)  ; {Is the current actor Bilbo, not a character (e.g. during SAY TO)?
 $815B AND A         ; }
 $815C JP NZ,$7C7E   ; Not Bilbo: ignore HELP entirely and carry on parsing
 $815F PUSH HL       ; {Save HL and IX
 $8160 PUSH IX       ; }
 $8162 LD HL,$B358   ; "you're doing fine." - the general hint
 $8165 LD A,($C01B)  ; A = Bilbo's own room
 $8168 LD IX,$8185   ; {Is there a specific hint for this room?
 $816C CALL $9D12    ; }
 $816F JR Z,$8177    ; No: keep the general hint
 $8171 LD L,(IX+$01) ; {Yes: HL = that room's own hint instead
 $8174 LD H,(IX+$02) ; }
*$8177 LD A,$01      ; {Print it in the lower window
 $8179 LD ($B5F2),A  ;
 $817C CALL $72D4    ; }
 $817F POP IX        ; {Restore IX and HL
 $8181 POP HL        ; }
 $8182 JP $806B      ; Carry on parsing

; Help messages
;
; Room number and message address pairs for #R$8158, terminated by $FF. The hints are:
; .
; #LIST
; { Room 6: 'a trolls door needs a trolls key.' }
; { Room 9: 'elves are good at reading symbols.' }
; { Room 13: 'a window should be no obstacle to a thief with friends.' }
; { Room 66: 'boats can help. look carefully.' }
; { Room 31: 'wait around and time your exit carefully.' }
; { Room 32: 'timing is critical, remember barrels float.' }
; { Room 42: 'wait a while.' }
; { Room 46: 'take care to leave at the right time.' }
; { Room 41: 'a living dragon is deadly, look to bard.' }
; { Room 26: 'don't stay too long.' }
; { Room 5: 'wait for the new day dawning.' }
; LIST#
b$8185 DEFB $06,$6B,$B3,$09,$7B,$B3,$0D,$8B
 $818D DEFB $B3,$42,$AF,$B3,$1F,$BB,$B3,$20
 $8195 DEFB $CB,$B3,$2A,$EB,$B3,$2E,$F5,$B3
 $819D DEFB $29,$09,$B4,$1A,$20,$B4,$05,$2F
 $81A5 DEFB $B4,$FF

; SCORE
;
; Prints the score (#R$81AD) and carries on parsing (#R$806B).
c$81A7 CALL $81AD    ; Print the score
 $81AA JP $806B      ; Carry on parsing

; Print the score
;
; Prints 'you have mastered xx.x% of this adventure.' The score is kept at $B5E8 in tenths of a percent (so 1000 would be 100.0%). The hundreds and tens are
; printed with #R$81E6 (a leading zero in the hundreds is suppressed), then a decimal point and the tenths digit.
c$81AD PUSH HL       ; {Save HL and DE
 $81AE PUSH DE       ; }
 $81AF XOR A         ; {Print in the lower window
 $81B0 LD ($B5F2),A  ; }
 $81B3 LD HL,$B345   ; {"you have mastered "
 $81B6 CALL $72D4    ; }
 $81B9 LD HL,($B5E8) ; HL = the score, in tenths of a percent
 $81BC LD DE,$0064   ; {Print the hundreds digit, dividing by 100...
 $81BF CALL $81E6    ; }
 $81C2 CALL NZ,$7580 ; ...but only if it is not zero (no leading zero)
 $81C5 LD DE,$000A   ; {Print the tens digit, dividing what is left by 10
 $81C8 CALL $81E6    ;
 $81CB CALL $7580    ; }
 $81CE LD A,$2E      ; {"."
 $81D0 CALL $7580    ; }
 $81D3 LD A,L        ; {Whatever is left (0-9) is the tenths digit
 $81D4 ADD A,$30     ;
 $81D6 CALL $7580    ; }
 $81D9 XOR A         ; {No forced capital for the word that follows
 $81DA LD ($B5F5),A  ; }
 $81DD LD HL,$B353   ; {"% of this adventure."
 $81E0 CALL $72D4    ; }
 $81E3 POP DE        ; {Restore DE and HL
 $81E4 POP HL        ;
 $81E5 RET           ; }

; Divide by repeated subtraction
;
; Divides HL by DE by repeated subtraction, returning the ASCII digit of the quotient in A and the remainder in HL. Z is set if the digit is '0'.
;
;  Input:HL Number
;        DE Divisor
; Output:A Digit ("0"-"9")
;        HL Remainder
c$81E6 LD A,$2F      ; A will become the ASCII digit ("0"-1, since the loop below starts by incrementing it)
*$81E8 INC A         ; One more digit counted
 $81E9 AND A         ; {Subtract the divisor from what is left...
 $81EA SBC HL,DE     ; }
 $81EC JR NC,$81E8   ; ...as many times as it will go
 $81EE ADD HL,DE     ; Put back the one subtraction that went too far
 $81EF CP $30        ; {Is the digit "0" (Z reflects whether it is)?
 $81F1 RET           ; }

; PAUSE
;
; Turns the border green, waits for a key to be pressed and released (#R$8271), and turns the border white again. The game is frozen in the meantime: no timers
; run and no characters act.
c$81F2 LD A,$04      ; {Green border
 $81F4 OUT ($FE),A   ; }
 $81F6 CALL $8271    ; Wait for a key to be pressed, then released
*$81F9 XOR A         ; {Wait here until a key really is pressed
 $81FA IN A,($FE)    ;
 $81FC AND $1F       ;
 $81FE CP $1F        ;
 $8200 JR NZ,$81F9   ; }
 $8202 LD A,$07      ; {White border again
 $8204 OUT ($FE),A   ; }
 $8206 JP $806B      ; Carry on parsing

; LOAD
;
; Loads a saved game from tape using the ROM routine LD-BYTES ($0556), in four headerless blocks: the 28 game variables (#R$B5CB, from $B5DC), the object table
; (#R$C00B), the timers and characters (#R$C973) and the room table (#R$B97A). These are exactly the areas that the game backs up at start-up (#R$6C00), and
; together they are the entire state of the game. Afterwards three bytes are copied from $B5DC back to $C8D1 (see #R$8284). If a block fails to load, #R$8250
; reports a tape error and restarts the game.
; .
; Two things live outside the four blocks. The three bytes of Bard's current order are handled specially (see #R$8284). But the address of the hidden route
; chosen at the start of the game is not saved at all: #R$970B writes it into the code of Elrond's map routine (the operand at $A6C5), not into the saved data.
c$8209 PUSH IX       ; {Save IX and DE
 $820B PUSH DE       ; }
 $820C LD A,$FF      ; A headerless block is expected...
 $820E SCF           ; ...and it should be loaded, not verified
 $820F LD IX,$B5DC   ; {Load the 28 bytes of game variables...
 $8213 LD DE,$001C   ; }
 $8216 CALL $8250    ; ...restarting the game if the tape fails
 $8219 LD A,$FF      ; {Then the object table...
 $821B SCF           ;
 $821C LD IX,$C00B   ;
 $8220 LD DE,$0614   ;
 $8223 CALL $8250    ; }
 $8226 LD A,$FF      ; {Then the timers and character table...
 $8228 SCF           ;
 $8229 LD IX,$C973   ;
 $822D LD DE,$00BF   ;
 $8230 CALL $8250    ; }
 $8233 LD A,$FF      ; {Then the room table...
 $8235 SCF           ;
 $8236 LD IX,$B97A   ;
 $823A LD DE,$05D9   ;
 $823D CALL $8250    ; }
 $8240 DI            ; Interrupts off while poking at memory directly
 $8241 LD HL,$B5DC   ; {Restore the three bytes of Bard's own remembered order...
 $8244 LD DE,$C8D1   ; }
 $8247 CALL $826B    ; ...which were tucked in among the saved variables
 $824A POP DE        ; {Restore DE and IX
 $824B POP IX        ; }
 $824D JP $806B      ; Carry on parsing

; Load a block, or restart on a tape error
;
; Calls LD-BYTES. If it fails, prints 'tape error - hit any key to restart program', waits for a key and restarts the game (#R$6C27), because a half-loaded game
; state could not be trusted.
c$8250 CALL $0556    ; The ROM's own LD-BYTES routine
 $8253 RET C         ; Loaded successfully: carry on
 $8254 LD A,$01      ; {Failed: print in the lower window
 $8256 LD ($B5F2),A  ; }
 $8259 LD HL,$B249   ; {"tape error - hit any key to restart program."
 $825C CALL $72D4    ; }
*$825F XOR A         ; {Wait for a key
 $8260 IN A,($FE)    ;
 $8262 AND $1F       ;
 $8264 CP $1F        ;
 $8266 JR Z,$825F    ; }
 $8268 JP $6C27      ; Restart the game (a half-loaded state cannot be trusted)

; Copy three bytes
;
; Copies three bytes from HL to DE (used to move the bytes at $C8D1 in or out of the saved variables).
c$826B LD BC,$0003   ; {Three bytes to copy
 $826E LDIR          ;
 $8270 RET           ; }

; Wait for a key press and release
;
; Waits until no key is pressed, then until one is.
c$8271 XOR A         ; {Wait here until no key at all is pressed
 $8272 IN A,($FE)    ;
 $8274 AND $1F       ;
 $8276 CP $1F        ;
 $8278 JR NZ,$8271   ; }
*$827A XOR A         ; {Then wait until one really is pressed
 $827B IN A,($FE)    ;
 $827D AND $1F       ;
 $827F CP $1F        ;
 $8281 JR Z,$827A    ;
 $8283 RET           ; }

; SAVE
;
; Saves the game to tape. Three bytes at $C8D1 (part of the data after the room-entry handlers) are first copied over the start of the saved variables at $B5DC
; so that they are saved too. The player is asked to start the tape and press a key, and the four blocks listed under #R$8209 are saved with the ROM routine
; SA-BYTES ($04C2).
; .
; Then, unusually for a 1982 game, it offers to VERIFY the save: 'rewind and prepare tape for verification - then hit any key', and reads the four blocks back
; with the ROM routine in verify mode (#R$8312).
c$8284 PUSH IX       ; {Save IX and DE
 $8286 PUSH DE       ; }
 $8287 LD DE,$B5DC   ; {Tuck Bard's own remembered order (from $C8D1) in among the saved variables for a moment...
 $828A LD HL,$C8D1   ;
 $828D CALL $826B    ; }
 $8290 LD A,$01      ; {Ask the player to get the tape ready, in the lower window
 $8292 LD ($B5F2),A  ;
 $8295 LD HL,$B234   ;
 $8298 CALL $72D4    ; }
 $829B CALL $8271    ; Wait for a key
 $829E LD A,$FF      ; {Save the 28 bytes of game variables (with Bard's order folded in)...
 $82A0 LD IX,$B5DC   ;
 $82A4 LD DE,$001C   ; }
 $82A7 CALL $04C2    ; ...using the ROM's own SA-BYTES routine
 $82AA LD A,$FF      ; {Then the object table...
 $82AC LD IX,$C00B   ;
 $82B0 LD DE,$0614   ;
 $82B3 CALL $04C2    ; }
 $82B6 LD A,$FF      ; {Then the timers and character table...
 $82B8 LD IX,$C973   ;
 $82BC LD DE,$00BF   ;
 $82BF CALL $04C2    ; }
 $82C2 LD A,$FF      ; {Then the room table...
 $82C4 LD IX,$B97A   ;
 $82C8 LD DE,$05D9   ;
 $82CB CALL $04C2    ; }
 $82CE LD HL,$B296   ; {Ask for the tape to be rewound, ready to verify what was just saved
 $82D1 CALL $72D4    ; }
 $82D4 CALL $8271    ; Wait for a key
 $82D7 LD A,$FF      ; {Verify the variables...
 $82D9 AND A         ;
 $82DA LD IX,$B5DC   ;
 $82DE LD DE,$001C   ;
 $82E1 CALL $8312    ; }
 $82E4 LD A,$FF      ; {...then the object table...
 $82E6 AND A         ;
 $82E7 LD IX,$C00B   ;
 $82EB LD DE,$0614   ;
 $82EE CALL $8312    ; }
 $82F1 LD A,$FF      ; {...the timers and characters...
 $82F3 AND A         ;
 $82F4 LD IX,$C973   ;
 $82F8 LD DE,$00BF   ;
 $82FB CALL $8312    ; }
 $82FE LD A,$FF      ; {...and the room table
 $8300 AND A         ;
 $8301 LD IX,$B97A   ;
 $8305 LD DE,$05D9   ;
 $8308 CALL $8312    ; }
; This entry point is used by the routine at #R$8312.
*$830B DI            ; Interrupts off while poking at memory directly
 $830C POP DE        ; {Restore DE and IX
 $830D POP IX        ; }
 $830F JP $806B      ; Carry on parsing

; Verify a block
;
; Calls the ROM's LD-BYTES in verify mode. On failure it prints 'tape error - hit any key to continue' and abandons the verification; the game carries on.
c$8312 CALL $0556    ; The ROM's own LD-BYTES routine, in verify mode
 $8315 RET C         ; Verified correctly: carry on
 $8316 LD A,$01      ; {Failed: print in the lower window
 $8318 LD ($B5F2),A  ; }
 $831B LD HL,$B273   ; {"tape error - hit any key to continue."
 $831E CALL $72D4    ; }
*$8321 XOR A         ; {Wait for a key
 $8322 IN A,($FE)    ;
 $8324 AND $1F       ;
 $8326 CP $1F        ;
 $8328 JR Z,$8321    ; }
 $832A POP DE        ; {Abandon the verification, but carry on with the rest of the game (unlike a LOAD failure, this is not fatal)
 $832B JP $830B      ; }

; Command execution work area
;
; Used by #R$83A7 and the routines after it while a command is being matched to objects. The first 17 bytes are cleared by #R$839A for each command.
; .
; #LIST
; { $832E, $832F: flags for the target and the instrument (bit 0: a noun was given; bit 1: a matching object has been found) }
; { $8330-$8332: counts of candidate objects and of those for which the action would work }
; { $8333-$8338 and $8339-$833E: the noun and adjectives given for the target and for the instrument }
; { $833F, $8341: where the search for the target and instrument has got to }
; { $8343: the ALL flag of the frame }
; { $8344: set when only one candidate is wanted }
; { $8345, $8346: frame offsets of the target and instrument phrases }
; { $8347, $8348: the candidate target and instrument }
; { $8349-$834E: the verb, particle and preposition used to find the action }
; { $834F: the action table entry }
; LIST#
b$832E DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $8336 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $833E DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $8346 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $834E DEFB $00,$00,$00

; Execute a command and run the turn
;
; Called by the main loop (#R$6D0A) after parsing. It works through the command frames built by the parser, one per command, starting at #R$B8B8.
; .
; For each frame, #R$83A7 finds the action and the objects it applies to. If that fails, the frame is dropped. Otherwise the action is carried out for real:
; $B5EB is set to 1, #R$7122 reports it ('you take the sword.'), #R$946F performs it, and #R$9611 ends the turn, letting the characters act and the timers run.
; So every command the player types costs one turn, and a line with three commands costs three turns.
; .
; A command with ALL is repeated ($837F) for each object it applies to, one turn each. When a frame is finished, the next frame (24 bytes lower) is taken,
; skipping the exception frames of ALL EXCEPT, until the frame count $B5F7 reaches 0.
; .
; If the previous command was left unfinished ($B60A), it is picked up again at $8385 instead.
c$8351 XOR A          ; {No ALL command is still in progress yet
 $8352 LD ($B60C),A   ; }
 $8355 LD IY,$B8B8    ; IY = the first command frame
 $8359 LD HL,$B60A    ; {Was the previous line left with an unfinished command (e.g. waiting for "which key?" to be answered)?
 $835C CP (HL)        ; }
 $835D LD (HL),A      ; Either way, clear that flag now - this line's typing settles the question
 $835E JP NZ,$8385    ; If it WAS waiting, skip straight to picking up where it left off, rather than starting a fresh frame
*$8361 CALL $83A7     ; Find the action and its objects for this frame
 $8364 JR NZ,$836B    ; Found: carry it out below
 $8366 XOR A          ; {Not found (the command made no sense): give up on the rest of this line too
 $8367 LD ($B5F6),A   ;
 $836A RET            ; }
*$836B CALL $84DE     ; Found: would the action actually succeed? (a dry run, changing nothing)
 $836E JP Z,$87E6     ; No: let the action's own handler explain why, rather than saying nothing at all
 $8371 LD A,$01       ; {Yes: mark this as really happening now, not just a trial
 $8373 LD ($B5EB),A   ; }
 $8376 CALL $7122     ; Report it in words ("you take the sword.")
 $8379 CALL $946F     ; Carry it out
; This entry point is used by the routine at #R$858F.
*$837C CALL $9611     ; End the turn: let every other character act, and the timers tick
; This entry point is used by the routine at #R$87AD.
*$837F LD A,($B60C)   ; {Is an ALL command still working through more objects?
 $8382 AND A          ; }
 $8383 JR NZ,$8361    ; Yes: go round again for the next one
; This entry point is used by the routine at #R$87AD.
*$8385 LD A,($B5F7)   ; {How many more command frames are left on this line?
 $8388 DEC A          ;
 $8389 LD ($B5F7),A   ; }
 $838C RET Z          ; None left: the whole line is finished
 $838D LD BC,$FFE8    ; {Step on to the next frame (24 bytes lower, since frames are built downwards)
*$8390 ADD IY,BC      ; }
 $8392 BIT 6,(IY+$01) ; Is this frame only an ALL EXCEPT exception, with no command of its own?
 $8396 JR NZ,$8390    ; Yes: skip over it and look at the one after
 $8398 JR $8361       ; Otherwise carry it out

; Clear the command execution work area
;
; Clears the 17 bytes at #R$832E and $B5F2.
c$839A XOR A         ; A = 0
 $839B LD ($B5F2),A  ; Print any replies in the lower (input) window for now, not the story window
 $839E LD HL,$832E   ; {17 bytes of work area to clear
 $83A1 LD B,$11      ; }
 $83A3 CALL $70D9    ; {Clear it
 $83A6 RET           ; }

; Find the action and objects for a command
;
; The target ($B5D9) and instrument ($B5DA) are set to $FF (none) and the work area is cleared. #R$858F then finds the action table entry that matches the
; frame's verb, particle and preposition; if none does, the routine returns with Z set.
; .
; The action number (1-59) is worked out from the entry's address and stored in $B5D8. The flags of the entry (#R$8569) say whether the action needs a target
; and an instrument (bits 3 and 2 of $B60D). If it needs neither, the routine is done. Otherwise #R$8405 searches for suitable objects, trying each candidate
; with a dry run. If the objects cannot be decided, #R$87AD deals with it (asking 'which key?', saying 'I do not see the key', and so on). With ALL, #R$8464
; moves on to the next object.
;
; Output:F Z set if the command could not be matched
c$83A7 LD A,$FF      ; {No instrument or target chosen yet
 $83A9 LD ($B5DA),A  ;
 $83AC LD ($B5D9),A  ; }
 $83AF CALL $839A    ; Clear the work area
 $83B2 CALL $858F    ; Find the action table entry that matches this frame's verb and words
 $83B5 RET Z         ; No such action exists: give up
 $83B6 LD A,$01      ; {Work out the action's own number...
 $83B8 PUSH IX       ;
 $83BA POP HL        ;
 $83BB LD DE,$AA47   ;
 $83BE SBC HL,DE     ;
 $83C0 JR Z,$83CA    ; }
 $83C2 LD DE,$0008   ; {...by counting how many 8-byte entries lie before it in the action table
*$83C5 INC A         ;
 $83C6 SBC HL,DE     ;
 $83C8 JR NZ,$83C5   ; }
*$83CA LD ($B5D8),A  ; Remember the action number
 $83CD LD ($B5D7),A  ; ...(kept a second time, so #R$A79F can read Bard's own last order from it later)
 $83D0 LD ($834F),IX ; Remember the action table entry itself
 $83D4 CALL $8569    ; Work out what this action needs: a target, an instrument, whether it works in the dark
 $83D7 CALL $8492    ; Start searching for a target
 $83DA XOR A         ; {For now, everything is only a trial: nothing really happens yet
 $83DB LD ($B5EB),A  ; }
 $83DE LD A,($B60D)  ; {Does this action need a target, an instrument, or both?
 $83E1 AND $0C       ; }
 $83E3 JR Z,$8402    ; Neither: the action can go ahead with no objects at all
 $83E5 LD A,($8343)  ; {Is this whole command an ALL?
 $83E8 LD ($B60C),A  ; }
 $83EB RLCA          ; {Is only a single candidate wanted, rather than every matching object?
 $83EC AND $01       ;
 $83EE LD ($8344),A  ; }
*$83F1 CALL $8405    ; Search for a workable target and instrument
 $83F4 JP NZ,$87AD   ; None found, or more than one possible: explain why, or ask "which key?"
 $83F7 LD A,($B60C)  ; {Is this an ALL command, with more objects still to try?
 $83FA AND A         ; }
 $83FB JR Z,$8402    ; No: this one candidate is the whole answer
 $83FD CALL $8464    ; Yes: is there another object ALL should also apply to?
 $8400 JR NZ,$83F1   ; If so, search again with it in mind
*$8402 OR $01        ; Make A non-zero...
 $8404 RET           ; ...telling the caller a workable command was found

; Search for a target and an instrument
;
; Tries the objects that fit the noun phrases of the command, in two nested loops: for each candidate target (#R$86BC) it tries each candidate instrument
; (#R$8708). For every combination, a dry run of the action (#R$84DE, which runs the action with $B5EB clear) says whether it would work. The first combination
; that works is kept. Counts of the candidates are kept at $8330-$8332 so that #R$87AD can tell whether there were none, one or several.
; .
; When only one candidate is allowed ($8344), the search stops after the first.
;
; Output:F Z reset if no workable combination was found
c$8405 CALL $86BC    ; Find the next candidate target for which the action would actually work
 $8408 JR NZ,$841F   ; None found (or several already tried): go and see how many there were in total
 $840A LD A,($8331)  ; {Did EXACTLY one candidate target turn out to work?
 $840D CP $01        ; }
 $840F RET NZ        ; No (none, or more than one): give up, leaving the caller to explain why
 $8410 LD A,($8347)  ; Yes: A = that one candidate
 $8413 LD ($B5D9),A  ; It becomes the target
 $8416 CALL $84AB    ; Start searching for an instrument too
 $8419 CALL $84C9    ; Does this action even need one?
 $841C JR NZ,$8446   ; Yes: go and look for it
 $841E RET           ; No: we are done, with just the target settled
*$841F LD HL,$8330   ; {No workable target this time: count how many candidates fitted the words at all
 $8422 INC (HL)      ; }
 $8423 CALL $84C9    ; Does the action need an instrument?
 $8426 JR Z,$8441    ; No: try this same target candidate again, ignoring the instrument entirely
 $8428 CALL $84AB    ; Yes: start searching for an instrument to go with THIS candidate
 $842B CALL $8708    ; Find the next candidate instrument for which it would work
*$842E JR Z,$8405    ; None: go back and try a different target instead
 $8430 LD A,($8344)  ; {Found one - but does the caller only want a single candidate overall (rather than checking for ambiguity)?
 $8433 DEC A         ; }
 $8434 RET Z         ; Yes: stop here, with this pairing as the answer
 $8435 LD A,($B5D9)  ; {No: remember this target as one that works...
 $8438 LD ($8347),A  ; }
 $843B LD HL,$8331   ; {...and count it
 $843E INC (HL)      ; }
 $843F JR $8405      ; ...then go on looking for more targets, to see whether the choice is ambiguous
*$8441 CALL $84DE    ; Try the action with just this target and no instrument
 $8444 JR $842E      ; Treat the result exactly as if an instrument search had just finished
*$8446 CALL $8708    ; Look for another candidate instrument for the current target
 $8449 JR NZ,$8458   ; None left: count how many there were in total
 $844B LD A,($8332)  ; {Did EXACTLY one candidate instrument work?
 $844E CP $01        ; }
 $8450 RET NZ        ; No: give up, leaving the caller to explain why
 $8451 LD A,($8348)  ; Yes: A = that one candidate
 $8454 LD ($B5DA),A  ; {It becomes the instrument
 $8457 RET           ; }
*$8458 LD A,($B5DA)  ; {Found another workable instrument: remember it...
 $845B LD ($8348),A  ; }
 $845E LD HL,$8332   ; {...and count it
 $8461 INC (HL)      ; }
 $8462 JR $8446      ; ...then keep looking, to see whether the choice is ambiguous

; ALL: find the next object
;
; For a command with ALL, looks through the frames that follow (the exceptions, marked with bit 6) and checks that the target found is not one of the objects
; excluded by EXCEPT. Returns with Z reset if it is excluded.
c$8464 PUSH IY        ; {Save IY, DE and HL
 $8466 PUSH DE        ;
 $8467 PUSH HL        ; }
*$8468 LD DE,$FFE8    ; {Step back to the frame BEFORE the current one (24 bytes higher), since ALL EXCEPT exceptions are listed there
 $846B ADD IY,DE      ; }
 $846D BIT 6,(IY+$01) ; Is that an ALL EXCEPT exception frame?
 $8471 JR Z,$848D     ; No (we have run out of exceptions): give up, there is nothing more to try
 $8473 LD IX,$BF50    ; Otherwise search every object...
*$8477 PUSH IY        ; {IY = the exception's own words
 $8479 POP HL         ;
 $847A LD DE,$0008    ;
 $847D ADD HL,DE      ; }
 $847E CALL $9D2E     ; {...for one that fits THIS exception
 $8481 CP $FF         ; }
 $8483 JR Z,$8468     ; None does: try the exception before that one
 $8485 LD HL,$B5D9    ; {Found one - but is it the very object we were about to use as the target?
 $8488 CP (HL)        ; }
 $8489 JR NZ,$8477    ; No: that is fine, look for another match to this exception instead
 $848B OR $01         ; It IS the one we were about to use: reject it (make A non-zero, so the caller skips this object)
*$848D POP HL         ; {Restore HL, DE and IY
 $848E POP DE         ;
 $848F POP IY         ;
 $8491 RET            ; }

; Start the search for targets
;
; Sets up the table (objects or rooms) in which the target will be searched for (#R$84BD), according to bits 2-3 of $B60E, and saves the starting position in
; $833F. Does nothing when repeating an ALL command.
c$8492 LD A,($B60C)  ; {Is an ALL command already partway through its list of objects?
 $8495 AND A         ; }
 $8496 RET NZ        ; Yes: do not restart the search - carry straight on from where it was
; This entry point is used by the routine at #R$84E6.
*$8497 LD A,($B60E)  ; A = the action's second set of flags
 $849A RRCA          ; {Shift its "which table" bits down...
 $849B RRCA          ; }
 $849C CALL $84BD    ; ...and choose the object index, or the character-only/object-only index, accordingly
 $849F LD A,($B5EF)  ; {Is the target actually meant to be a room?
 $84A2 AND A         ; }
 $84A3 CALL NZ,$9DDE ; If so, search the actor's own room's exits instead of the object table
 $84A6 LD ($833F),IX ; {Remember where the search has got to
 $84AA RET           ; }

; Start the search for instruments
;
; As #R$8492, for the instrument: the position is kept at $8341.
c$84AB LD A,($B60E)  ; A = the action's second set of flags
 $84AE CALL $84BD    ; Choose the object index, or the character-only/object-only index
 $84B1 LD A,($B5F0)  ; {Is the instrument actually meant to be a room?
 $84B4 AND A         ; }
 $84B5 CALL NZ,$9DDE ; If so, search the actor's own room's exits instead
 $84B8 LD ($8341),IX ; {Remember where the search has got to
 $84BC RET           ; }

; Choose the object table to search
;
; Sets IX to the object index at #R$BF53 if the low two bits of A are 0, or to $BF50 (three bytes earlier, which makes the search start with a dummy entry)
; otherwise.
c$84BD LD IX,$BF53   ; IX = the ordinary object index...
 $84C1 AND $03       ; Do the flags call for characters only, or objects only?
 $84C3 RET Z         ; Neither: the ordinary index is fine as it is
 $84C4 LD IX,$BF50   ; {Otherwise start one entry earlier, so the very first search step lands on the true first entry
 $84C8 RET           ; }

; Does the action need an instrument?
;
; Returns with Z reset if the action needs an instrument (bit 2 of $B60D) that has not yet been given. If bit 1 of $B60D is set, the instrument may be left out,
; and the routine returns with Z set.
c$84C9 LD A,($B60D)  ; A = the action's main flags
 $84CC BIT 2,A       ; Does it need an instrument at all?
 $84CE RET Z         ; No: nothing more to check
 $84CF LD HL,$832F   ; {Yes - has a genuine instrument noun actually been named?
 $84D2 BIT 0,(HL)    ; }
 $84D4 RET NZ        ; It has: an instrument is definitely needed
 $84D5 BIT 1,A       ; {No instrument was named - but may this action be used without one?
 $84D7 JR NZ,$84DC   ; }
 $84D9 OR $01        ; {No, it may not: an instrument really is required
 $84DB RET           ; }
*$84DC XOR A         ; {Yes, it may: no instrument is required after all
 $84DD RET           ; }

; Try the action (dry run)
;
; Runs the action with #R$946F and returns with Z set if it would not work ($B5EC is 0). Called while $B5EB is 0, so nothing actually happens and nothing is
; printed.
c$84DE CALL $946F    ; Carry out the action, with nothing yet really happening
 $84E1 LD A,($B5EC)  ; {Did it say it would work?
 $84E4 AND A         ;
 $84E5 RET           ; }

; Would this action work? (for a character)
;
; Used when a character is deciding what to do (#R$976C): works out, for the action in $B5D8 and the objects in $B5D9 and $B5DA, whether the action would
; succeed, without printing anything and without disturbing the player's command. The work area pointer at $833F is saved and restored. Returns with Z set if
; the action would not work.
c$84E6 PUSH HL       ; {Save every register this uses
 $84E7 PUSH IY       ;
 $84E9 PUSH IX       ;
 $84EB PUSH DE       ;
 $84EC PUSH BC       ; }
 $84ED LD HL,($833F) ; {Save where the player's own target search had got to
 $84F0 PUSH HL       ; }
 $84F1 LD A,($B5D8)  ; {IX = the action table entry for the action being tried
 $84F4 CALL $70DF    ;
 $84F7 PUSH HL       ;
 $84F8 POP IX        ; }
 $84FA CALL $839A    ; Clear the work area
 $84FD CALL $70EA    ; Work out this action's own flag bytes
 $8500 CALL $8569    ; Decode them
 $8503 LD A,($B5D9)  ; {A = the target the character wants to try
 $8506 LD B,A        ; }
 $8507 LD A,($B5EF)  ; {Copy its words into the target work area, as if it had been typed
 $850A LD DE,$8333   ;
 $850D CALL $8554    ; }
 $8510 LD A,($B5DA)  ; {Do the same for the instrument
 $8513 LD B,A        ;
 $8514 LD A,($B5F0)  ;
 $8517 LD DE,$8339   ;
 $851A CALL $8554    ; }
 $851D CALL $8497    ; Start the object search fresh, in case a room search is needed instead
 $8520 XOR A         ; {For now, this is only a trial
 $8521 LD ($B5EB),A  ; }
 $8524 LD A,($B60D)  ; {Does the action need a target or an instrument at all?
 $8527 AND $0C       ; }
 $8529 JR NZ,$8534   ; It does: check it properly below
 $852B CALL $946F    ; {It needs neither: just try it directly
 $852E LD A,($B5EC)  ;
 $8531 AND A         ;
 $8532 JR $8543      ; }
*$8534 LD A,$01      ; {It does need objects: only accept a single, unambiguous match
 $8536 LD ($8344),A  ; }
 $8539 CALL $8405    ; Search for a workable target and instrument
 $853C JR Z,$8541    ; Found: success
 $853E XOR A         ; {Not found: failure
 $853F JR $8543      ;
*$8541 OR $01        ; }
*$8543 LD A,$01      ; {Whatever the player was doing, it really is happening again now
 $8545 LD ($B5EB),A  ; }
 $8548 POP HL        ; {Restore the player's own target-search position...
 $8549 LD ($833F),HL ; }
 $854C POP BC        ; {...and every other saved register
 $854D POP DE        ;
 $854E POP IX        ;
 $8550 POP IY        ;
 $8552 POP HL        ;
 $8553 RET           ; }

; Copy an object's or a room's words
;
; If B is not $FF, copies the six bytes of words (noun and two adjectives) of object B (or of room B, if A is non-zero) to DE.
c$8554 INC B         ; Was there actually no object given at all ($FF)?
 $8555 RET Z         ; If so, there is nothing to copy
 $8556 DEC B         ; Restore B
 $8557 AND A         ; {Is the thing being named actually a room, rather than an object?
 $8558 LD A,B        ;
 $8559 JR Z,$8560    ; }
 $855B CALL $71CC    ; {An object: HL = its own words
 $855E JR $8563      ; }
*$8560 CALL $71D9    ; A room: HL = its own name words
*$8563 LD BC,$0006   ; {Copy all 6 bytes - the noun and its two adjectives
 $8566 LDIR          ;
 $8568 RET           ; }

; Decode the flags of the action
;
; Turns the flag nibbles of the action table entry (see #R$70EA) into separate variables: $B601 (bit 6 of $B60E: the action is allowed in the dark), $B5FF (bit
; 0 of $B60D: the objects need not be within reach), $B5EF (bit 7: the target is a room rather than an object) and $B5F0 (bit 6: the instrument is a room).
c$8569 LD A,($B60E)  ; A = the action's second set of flags
 $856C AND $40       ; {Is it allowed in the dark?
 $856E LD ($B601),A  ; }
 $8571 LD A,($B60D)  ; {A = the action's main flags
 $8574 LD B,A        ; }
 $8575 AND $01       ; {Do the objects need not be within reach?
 $8577 LD ($B5FF),A  ;
 $857A LD A,B        ; }
 $857B AND $80       ; {Is the target actually a room, rather than an object?
 $857D JR Z,$8581    ;
 $857F LD A,$01      ;
*$8581 LD ($B5EF),A  ; }
 $8584 LD A,B        ; {Is the instrument actually a room too?
 $8585 AND $40       ;
 $8587 JR Z,$858B    ;
 $8589 LD A,$01      ;
*$858B LD ($B5F0),A  ;
 $858E RET           ; }

; Find the action for a command
;
; Collects the verb of the current frame and up to two prepositions from its noun phrases into $8349-$834E, and then searches the action table (#R$AA47) for an
; entry with the same verb and prepositions (#R$71EA). If one is found, #R$8614 sorts out which noun phrase is the target and which the instrument, and the
; routine returns with Z reset.
; .
; If none is found there are two cases. If the verb was right but the other words were wrong ($B5D0 set), 'I do not know the verb ...' is printed ($8895). If
; the verb has no actions at all (WAIT, JUMP, SING, SMILE and many others), the game prints 'you wait. time passes...' with the verb substituted ($AC97), and a
; turn goes by. This is how all the verbs that do nothing get their reply.
c$858F PUSH IY       ; Save the caller's IY, the current frame
 $8591 LD L,(IY+$00) ; {HL = the frame's own verb...
 $8594 LD H,(IY+$01) ; }
 $8597 LD A,H        ; {Is the ALL bit (bit 7) set on it?
 $8598 AND $80       ; }
 $859A LD ($8343),A  ; Remember whether this whole command is an ALL
 $859D RES 7,H       ; Strip that bit back out of the verb itself
 $859F LD ($8349),HL ; Keep the plain verb
 $85A2 LD HL,$834B   ; {Clear the four preposition slots that follow it
 $85A5 PUSH HL       ;
 $85A6 LD B,$04      ;
 $85A8 CALL $70D9    ;
 $85AB POP HL        ; }
 $85AC LD B,$02      ; Up to two prepositions to pick out from the two noun phrases
 $85AE LD E,$04      ; First noun phrase's first preposition slot...
 $85B0 CALL $869D    ; ...pick it up, if there is one
 $85B3 LD E,$0E      ; Second noun phrase's first preposition slot...
 $85B5 CALL $869D    ; ...pick it up too
 $85B8 LD E,$06      ; {First noun phrase's second preposition slot...
 $85BA CALL $869D    ; }
 $85BD LD E,$10      ; {Second noun phrase's second preposition slot...
 $85BF CALL $869D    ; }
 $85C2 XOR A         ; {The verb has not yet been shown to match anything
 $85C3 LD ($B5D0),A  ; }
 $85C6 LD HL,$8349   ; HL = the verb and prepositions just collected
 $85C9 LD DE,$0008   ; DE = 8, the size of one action table entry
 $85CC LD IX,$AA47   ; IX = the start of the action table
*$85D0 PUSH IX       ; {IY = the entry being compared
 $85D2 POP IY        ; }
 $85D4 CALL $71EA    ; Does this entry match the verb and words collected above?
 $85D7 JR Z,$860C    ; Yes: settle which words are the target and which the instrument, below
 $85D9 ADD IX,DE     ; No: move on to the next entry
 $85DB LD A,(IX+$01) ; {Have we reached the end of the table (an entry of all zeros)?
 $85DE OR (IX+$00)   ; }
 $85E1 JR NZ,$85D0   ; Not yet: try this next entry
 $85E3 POP IY        ; End of the table, with no match: restore IY
 $85E5 LD A,($B5D0)  ; {Did the verb itself match anything, just with the wrong words?
 $85E8 AND A         ; }
 $85E9 JP NZ,$8895   ; Yes: "I do not know the verb ..."
 $85EC LD HL,($8349) ; {No: this verb has no actions at all - push it as the message parameter...
 $85EF PUSH HL       ; }
 $85F0 LD HL,$AC97   ; ..."you <verb>. time passes..."
 $85F3 XOR A         ; {Print it in the lower window, as if the command had succeeded
 $85F4 LD ($B5F2),A  ; }
 $85F7 LD ($B60C),A  ; No ALL is in progress
 $85FA LD A,$01      ; {This is really happening, not just a trial
 $85FC LD ($B5EB),A  ; }
 $85FF CALL $72CA    ; Print the message
 $8602 LD A,($B60B)  ; {Are we inside a quotation (an order to a character)?
 $8605 DEC A         ; }
 $8606 RET Z         ; If so, that is all - let the caller move on to the next frame as usual
 $8607 POP HL        ; {Otherwise throw away our own two return addresses...
 $8608 POP HL        ; }
 $8609 JP $837C      ; ...and jump straight to ending the turn, as if a real action had just happened
*$860C POP IY        ; A match was found: restore IY, the current frame
 $860E CALL $8614    ; Work out which of its noun phrases is the target and which the instrument
 $8611 OR $01        ; Make A non-zero...
 $8613 RET           ; ...telling the caller a matching action was found

; Assign the noun phrases to target and instrument
;
; Decides which of the command's two noun phrases is the target and which the instrument, from the preposition the action expects and bit 5 of the action's
; flags. So 'hit thorin with the sword' and 'with the sword hit thorin' both work. The target's words are copied to $8333 and also to $B5D1 (for IT), and the
; instrument's to $8339. Bit 0 of $832E and $832F is set if the phrase actually has a noun.
c$8614 AND A         ; Did #R$71EA find the two words in the natural order (A=0) or crossed over (A=1)?
 $8615 JR Z,$8625    ; Natural order: nothing to undo
 $8617 LD HL,($834B) ; {Crossed over: swap the two prepositions collected by #R$858F...
 $861A LD DE,($834D) ;
 $861E LD ($834B),DE ; }
 $8622 LD ($834D),HL ; ...putting them back the natural way round
*$8625 CALL $70EA    ; Work out the action's own flag bytes
 $8628 LD HL,$834B   ; {Was any preposition collected at all?
 $862B LD A,(HL)     ;
 $862C INC HL        ;
 $862D OR (HL)       ; }
 $862E JR NZ,$8635   ; Yes, at least one: work out which noun phrase it actually came from, below
 $8630 LD A,($B60E)  ; {None at all (e.g. plain TAKE): use the action's own default choice of which phrase is the target
 $8633 JR $8654      ; }
*$8635 DEC HL        ; Back to the first collected preposition
 $8636 LD A,(HL)     ; {Does it match the SECOND noun phrase's own first preposition?
 $8637 CP (IY+$0E)   ; }
 $863A JR NZ,$8644   ; No: try matching it against the second phrase's other preposition instead
 $863C INC HL        ; {Low bytes matched: check the high bytes too
 $863D LD A,(HL)     ;
 $863E CP (IY+$0F)   ; }
 $8641 JR Z,$864F    ; A full match: this preposition belongs to the SECOND noun phrase
 $8643 DEC HL        ; No match after all: back to the low byte
*$8644 LD A,(HL)     ; {Does it match the second phrase's OTHER preposition slot instead?
 $8645 CP (IY+$10)   ; }
 $8648 JR NZ,$864F   ; Neither: give up trying to tell which phrase it belongs to
 $864A INC HL        ; {Matched: check the high byte too
 $864B LD A,(HL)     ;
 $864C CP (IY+$11)   ; }
*$864F LD A,($B60D)  ; A = the action's main flags
 $8652 JR NZ,$8656   ; The preposition was NOT shown to belong to the second phrase: use the flags as they are
*$8654 XOR $20       ; It WAS shown to belong to the second phrase: flip the "which phrase is the target" bit
*$8656 BIT 5,A       ; Is the SECOND noun phrase the target?
 $8658 LD BC,$1208   ; {Assume not: (second phrase's noun offset, first phrase's noun offset)
 $865B JR Z,$8660    ; }
 $865D LD BC,$0812   ; It is: swap the two offsets round instead
*$8660 LD HL,$8345   ; {Remember the two offsets, for use below
 $8663 LD (HL),B     ;
 $8664 INC HL        ;
 $8665 LD (HL),C     ; }
 $8666 LD A,B        ; A = whichever offset is the TARGET's own noun
 $8667 LD DE,$8333   ; Copy its words into the target work area...
 $866A LD HL,$832E   ; {...and mark whether a target noun was actually given
 $866D CALL $8682    ; }
 $8670 LD A,C        ; {The target's own words also become the new meaning of the word IT...
 $8671 LD HL,$8333   ;
 $8674 LD DE,$B5D1   ;
 $8677 LD BC,$0006   ;
 $867A LDIR          ; }
 $867C LD DE,$8339   ; A = whichever offset is the INSTRUMENT's own noun
 $867F LD HL,$832F   ; Copy its words into the instrument work area too
*$8682 PUSH BC       ; (Shared code, reached both directly above and by falling in here) save BC
 $8683 LD C,A        ; {C = the frame offset to copy from
 $8684 LD B,$00      ; }
 $8686 PUSH HL       ; Save the flag-byte address for a moment
 $8687 PUSH IY       ; {HL = the frame, plus that offset...
 $8689 POP HL        ;
 $868A ADD HL,BC     ; }
 $868B LD BC,$0006   ; {Copy 6 bytes: the noun and its two adjectives
 $868E LDIR          ; }
 $8690 XOR A         ; {Was anything actually copied (is any of it non-zero)?
 $8691 LD B,$06      ;
*$8693 DEC HL        ;
 $8694 OR (HL)       ;
 $8695 DJNZ $8693    ; }
 $8697 POP HL        ; Restore the flag-byte address
 $8698 POP BC        ; Restore BC
 $8699 RET Z         ; Nothing was given: leave the flag alone
 $869A SET 0,(HL)    ; {Something was given: record that a noun really was named
 $869C RET           ; }

; Pick up a preposition from the frame
;
; Copies the word at offset E of the frame to (HL) and moves HL on, unless it is empty or B (the number of words wanted) has reached 0.
c$869D XOR A         ; {Does the caller still want any more prepositions from this phrase?
 $869E CP B          ; }
 $869F RET Z         ; {No: nothing more to do
 $86A0 LD D,$00      ; }
 $86A2 PUSH IY       ; Save the caller's IY, the current frame
 $86A4 ADD IY,DE     ; IY = the frame, plus the offset of the preposition slot asked for
 $86A6 LD A,(IY+$00) ; {Copy its low byte to where HL points...
 $86A9 LD (HL),A     ;
 $86AA INC HL        ; }
 $86AB LD A,(IY+$01) ; {...then its high byte
 $86AE LD (HL),A     ; }
 $86AF DEC HL        ; Step back to the low byte
 $86B0 OR (IY+$00)   ; Was that slot actually empty (both bytes zero)?
 $86B3 POP IY        ; Restore the caller's IY
 $86B5 RET Z         ; Empty: leave HL where it is, so the next candidate can use the same two bytes
 $86B6 DEC B         ; A real preposition was found: one fewer still wanted
 $86B7 INC HL        ; {Move on past the two bytes just filled
 $86B8 INC HL        ;
 $86B9 RET           ; }

; Call the routine at IY
;
; JP (IY): used to call a search routine chosen at run time (#R$9D2E for objects, #R$9DE9 for rooms).
c$86BA JP (IY)       ; Jump to whichever search routine (object or room) the caller has selected

; Find the next candidate target
;
; Searches for the next object (or room, if $B5EF is set) that fits the target's words, starting from where the last search left off ($833F). Only candidates
; for which the action would work are returned (#R$86ED). Returns A=$FF when there are no more.
c$86BC PUSH IY       ; Save the caller's IY
 $86BE LD IX,($833F) ; IX = where the target search last left off
 $86C2 LD A,($B5EF)  ; {Is the target actually meant to be a room?
 $86C5 DEC A         ; }
 $86C6 JR Z,$86E2    ; Yes: search rooms instead, below
 $86C8 LD IY,$9D2E   ; No: IY = the object-search routine
 $86CC LD A,($B60E)  ; {A = the action's own filter (characters only, objects only, or anything)
 $86CF RRCA          ;
 $86D0 RRCA          ;
 $86D1 AND $03       ;
 $86D3 LD ($B600),A  ; }
 $86D6 CALL $86ED    ; {Find the next candidate object for which the action would work
 $86D9 CP $FF        ; }
*$86DB LD ($833F),IX ; Remember where the search has got to
 $86DF POP IY        ; {Restore the caller's IY
 $86E1 RET           ; }
*$86E2 LD IY,$9DE9   ; Rooms: IY = the room-search routine instead
 $86E6 CALL $86ED    ; {Find the next candidate room for which the action would work
 $86E9 CP $FF        ;
 $86EB JR $86DB      ; }

; Find the next candidate target for which the action works
;
; Calls the search routine at IY with the target's words, and for each object found, puts it in $B5D9 and tries the action (#R$9436). Stops at the first one for
; which it would work.
c$86ED LD HL,$8333   ; HL = the target's own collected words (noun and adjectives)
 $86F0 CALL $86BA    ; {Search for the next object or room that fits them
 $86F3 CP $FF        ; }
 $86F5 RET Z         ; None left: give up
 $86F6 LD ($B5D9),A  ; {Found one: it becomes the target, provisionally
 $86F9 LD HL,$832E   ; }
 $86FC SET 1,(HL)    ; Remember that we are still searching (rather than having settled on an answer)
 $86FE CALL $9436    ; {Could the action even apply to it at all?
 $8701 LD A,($B5EC)  ;
 $8704 AND A         ; }
 $8705 JR Z,$86ED    ; No: try the next candidate
 $8707 RET           ; Yes: this is a workable candidate

; Find the next candidate instrument
;
; As #R$86BC, for the instrument; the position is kept at $8341, and the candidate goes into $B5DA.
c$8708 XOR A         ; {Assume reach does not matter, for now
 $8709 LD ($B5FF),A  ; }
 $870C PUSH IY       ; Save the caller's IY
 $870E LD IX,($8341) ; IX = where the instrument search last left off
 $8712 LD A,($B5F0)  ; {Is the instrument actually meant to be a room?
 $8715 DEC A         ; }
 $8716 JR Z,$873A    ; Yes: search rooms instead
 $8718 LD IY,$9D2E   ; No: IY = the object-search routine
 $871C LD A,($B60E)  ; {A = the action's own filter
 $871F AND $03       ;
 $8721 LD ($B600),A  ; }
 $8724 CALL $8745    ; {Find the next candidate object for which it would work
 $8727 CP $FF        ; }
*$8729 LD ($8341),IX ; Remember where the search has got to
 $872D POP IY        ; Restore the caller's IY
 $872F PUSH AF       ; Save the result for a moment
 $8730 LD A,($B60D)  ; {Does this particular action say reach does not matter?
 $8733 AND $01       ;
 $8735 LD ($B5FF),A  ; }
 $8738 POP AF        ; {Restore the result
 $8739 RET           ; }
*$873A LD IY,$9DE9   ; Rooms: IY = the room-search routine instead
 $873E CALL $8745    ; {Find the next candidate room for which it would work
 $8741 CP $FF        ;
 $8743 JR $8729      ; }

; Find the next candidate instrument for which the action works
;
; As #R$86ED, for the instrument.
c$8745 LD HL,$8339   ; HL = the instrument's own collected words
 $8748 CALL $86BA    ; {Search for the next object or room that fits them
 $874B CP $FF        ; }
 $874D RET Z         ; None left: give up
 $874E LD ($B5DA),A  ; {Found one: it becomes the instrument, provisionally
 $8751 LD HL,$832F   ; }
 $8754 SET 1,(HL)    ; Remember we are still searching
 $8756 CALL $84DE    ; Would the whole action work with this instrument?
 $8759 JR Z,$8745    ; No: try the next candidate
 $875B RET           ; Yes: this is a workable candidate

; Prepare to reply to the player
;
; Sets $B5EB (really do it) and $B5F2 (print in the lower window), ready to print a reply.
c$875C LD A,$01      ; {From now on, this really is happening...
 $875E LD ($B5EB),A  ; }
 $8761 LD ($B5F2),A  ; {...and any reply goes to the lower (input) window
 $8764 RET           ; }

; Leave the command unfinished
;
; Saves the current frame at #R$B8B8 and stores A in $B60A, so that the next thing the player types is used to complete this command. Used after 'which key?'
; and '... what?'.
c$8765 LD ($B60A),A  ; Remember which situation this is (which key?/what with?/...), for #R$8351 to recognise next time
 $8768 PUSH IY       ; {HL = the current frame
 $876A POP HL        ; }
 $876B LD DE,$B8B8   ; {Save the whole 24-byte frame at #R$B8B8 permanently...
 $876E LD BC,$0018   ; }
 $8771 LDIR          ; {...so the next thing the player types can be merged into it (#R$7CC0)
 $8773 RET           ; }

; Ask "which ...?"
;
; When the noun fits more than one object and more than one of them would work, the game asks 'which key?' ($ACC0, with the noun pushed as the parameter) and
; leaves the command unfinished (#R$8765), so that the player's next words - 'the small one', 'curious' - are fitted into it (#R$7CC0).
c$8774 LD A,($8345)  ; A = the offset of whichever frame slot holds the ambiguous noun
 $8777 LD HL,($8333) ; HL = the target's own noun word
; This entry point is used by the routine at #R$8789.
*$877A PUSH HL       ; Push it as the message parameter
 $877B CALL $8765    ; Leave the command unfinished, waiting for the player to say which one they mean
 $877E LD HL,$ACC0   ; "which <noun>?" (falls into #R$8781, which prints it)

; Print a reply and give up
;
; Prints the message at HL in the lower window (#R$875C, #R$72CA) and returns with A=0.
c$8781 CALL $875C    ; Make sure this prints properly, in the lower window
 $8784 CALL $72CA    ; Print the message
 $8787 XOR A         ; {Tell the caller the command could not be completed
 $8788 RET           ; }

; Decide about the instrument
;
; The instrument's counterpart of #R$87AD, using the flags at $832F: no noun given goes to #R$883E ('unlock the door with what?'), a noun that matched nothing
; widens the search as for the target, and if exactly one instrument would work the action is simply carried out.
c$8789 LD HL,$832F   ; {Was any noun at all given for the instrument?
 $878C BIT 0,(HL)    ; }
 $878E JP Z,$883E    ; No: go and ask "with what?" or say there was nothing suitable
 $8791 BIT 1,(HL)    ; {Are we still in the middle of searching (rather than already knowing the answer)?
 $8793 LD HL,$8339   ;
 $8796 LD DE,$B5DA   ;
 $8799 LD BC,$B5F0   ; }
 $879C JR Z,$87EF    ; Not searching yet: go and search properly, exactly as for the target
 $879E LD A,($8332)  ; {Already searched: did EXACTLY one instrument candidate work?
 $87A1 AND A         ; }
 $87A2 JP Z,$87E6    ; None worked at all: let the action's own handler explain why
 $87A5 LD A,($8346)  ; (the frame offset, though not needed again here)
 $87A8 LD A,($8339)  ; A = the instrument's own noun word
 $87AB JR $877A      ; More than one worked: ask "which one?"

; Report why the objects could not be decided
;
; Called when #R$8405 did not settle on exactly one workable target, to explain why - or to make the best of it. Inside a quotation (an order to a character) it
; says nothing at all and returns, so characters are not given the player's excuses.
; .
; If exactly one candidate target would work, the instrument is dealt with instead (#R$8789). Otherwise the target's flags at $832E decide:
; .
; #LIST
; { No noun was given ($8821): the words of the action are pushed and, if nothing suitable could be found at all, 'i see nothing to open' is printed; if there
; was something, the command is left unfinished (#R$8765) and the game asks 'open what?', so that the next thing typed completes it. }
; { A noun was given but nothing matching it was found ($87EF): the search is widened - first to the rooms leading off this one (#R$9DE9, for commands such as
; GO INTO), then to every object anywhere (#R$9D2E with the filter set to 2) - so that something the player has named but cannot use is still recognised. If it
; is found, it is made the target and the action is reported as a failure (#R$7111, 'you cannot open the door'); if not, 'i do not see the door here'. }
; { Several candidates fit the words: 'which key?' (#R$8774), again leaving the command unfinished. }
; { Exactly one candidate, or none, but the action would not work with it: the action is carried out for real anyway ($87E6), so that its own handler prints the
; proper reason. }
; LIST#
c$87AD LD A,($B60B)  ; {Are we inside a quotation (an order to a character)?
 $87B0 DEC A         ; }
 $87B1 RET Z         ; Yes: say nothing - characters are not given the player's own excuses
 $87B2 LD A,($B60C)  ; {Is an ALL command still working through a list of objects?
 $87B5 AND A         ; }
 $87B6 JR Z,$87BC    ; No: work out what really went wrong, below
 $87B8 POP HL        ; Yes: this particular object just did not work out, but others might - abandon it quietly...
 $87B9 JP $8385      ; ...and go straight on to whatever ALL should try next
*$87BC LD A,($8331)  ; {Did EXACTLY ONE target candidate work, with the problem lying only with the instrument?
 $87BF CP $01        ; }
 $87C1 JR Z,$8789    ; Yes: go and sort out the instrument specifically
 $87C3 LD HL,$832E   ; {No: was any noun at all given for the target?
 $87C6 BIT 0,(HL)    ; }
 $87C8 JP Z,$8821    ; No: go and ask "open what?" or say there was nothing to open
 $87CB BIT 1,(HL)    ; {Are we still in the middle of searching?
 $87CD LD HL,$8333   ;
 $87D0 LD DE,$B5D9   ;
 $87D3 LD BC,$B5EF   ; }
 $87D6 JR Z,$87EF    ; Not searching yet: go and search properly, below
 $87D8 LD A,($8330)  ; {Already searched: how many candidates fitted the words at all?
 $87DB AND A         ; }
 $87DC JR Z,$87E6    ; {None at all: let the action's own handler explain why
 $87DE DEC A         ; }
 $87DF JR NZ,$8774   ; More than one: ask "which one?"
 $87E1 CALL $84C9    ; Exactly one candidate, but the action still failed - does it even need an instrument?
 $87E4 JR NZ,$8789   ; It does: go and sort that out instead
; This entry point is used by the routines at #R$8351 and #R$8789.
*$87E6 CALL $875C    ; It does not, or nothing else fits: carry the action out anyway...
 $87E9 CALL $946F    ; ...so its own handler can explain the real reason ("you cannot open the door")
 $87EC JP $837F      ; Then carry on with the rest of the turn as usual
; This entry point is used by the routine at #R$8789.
*$87EF PUSH HL       ; SEARCH PROPERLY: save the noun that was given
 $87F0 CALL $9DDE    ; IX = the actor's own room's exits
 $87F3 LD A,$01      ; {Assume, for now, that the noun names a nearby room
 $87F5 LD (BC),A     ; }
 $87F6 CALL $9DE9    ; {Does any exit lead to a room with that name?
 $87F9 CP $FF        ; }
 $87FB JR NZ,$8811   ; Yes: that settles it - use that room
 $87FD POP HL        ; No: restore the noun
 $87FE LD A,$02      ; {Widen the search to EVERY object in the game, not just nearby ones...
 $8800 LD ($B600),A  ;
 $8803 LD IX,$BF50   ; }
 $8807 XOR A         ; {...and note that reach no longer matters
 $8808 LD (BC),A     ; }
 $8809 PUSH HL       ; Save the noun again
 $880A CALL $9D2E    ; {Search absolutely everywhere for something matching it
 $880D CP $FF        ; }
 $880F JR Z,$8816    ; Nothing anywhere fits those words
*$8811 POP HL        ; {Something was found (a room, or a distant object): use it as the target/instrument...
 $8812 LD (DE),A     ; }
 $8813 JP $7111      ; ...and report the action as a failure ("you cannot open the door"), since it is out of reach
*$8816 CALL $875C    ; Truly nothing fits those words anywhere
 $8819 LD HL,$ACC7   ; {"I do not see the X here."
 $881C CALL $72CA    ; }
 $881F XOR A         ; {The command could not be completed
 $8820 RET           ; }
*$8821 CALL $8869    ; {NO NOUN GIVEN FOR THE TARGET: push the action's own words as message parameters
 $8824 LD HL,($8349) ;
 $8827 PUSH HL       ; }
 $8828 LD HL,$ACD5   ; "I see nothing to <verb> <particle> <preposition>."
 $882B LD A,($8331)  ; {Was there in fact exactly one possible object, even with no noun named?
 $882E AND A         ; }
 $882F JP Z,$8781    ; No, none at all: print that message and give up
 $8832 LD A,($8345)  ; {Yes, exactly one: use it anyway, and say which one was chosen
 $8835 CALL $8765    ; }
 $8838 LD HL,$ACB8   ; {"<verb> <particle> <preposition> what?" (one more chance to name it precisely)
 $883B JP $8781      ; }

; Report a missing or unsuitable instrument
;
; The instrument's counterpart of the end of #R$87AD. If nothing was found to match the words, 'i see nothing to unlock the door with'. Otherwise the command is
; left unfinished (#R$8765) and the game asks 'unlock the door with what?' ($ACB4), so the player can simply answer 'the key'. The words of the question are
; pushed by #R$8869.
c$883E CALL $8865    ; Push the action's own particle and preposition, for the "with what?" question
 $8841 LD A,($B5D9)  ; A = the target
 $8844 CALL $71D9    ; HL = its own words
 $8847 PUSH HL       ; Push them too, so the question can name the target ("unlock the door with what?")
 $8848 CALL $8869    ; {Push the action's own words again, this time for the "I see nothing to..." message
 $884B LD HL,($8349) ;
 $884E PUSH HL       ; }
 $884F LD HL,$ACDB   ; "I see nothing to <verb> the <target> <preposition>."
 $8852 LD A,($8332)  ; {Was there in fact exactly one possible instrument?
 $8855 AND A         ; }
 $8856 JP Z,$8781    ; No, none at all: print that message and give up
 $8859 LD A,($8346)  ; {Yes, exactly one: use it anyway
 $885C CALL $8765    ; }
 $885F LD HL,$ACB4   ; {"<verb> the <target> <preposition> what?"
 $8862 JP $8781      ; }

; Push the words of the action for a question (instrument)
;
; Enters #R$8869 with A=$28 (the opcode of JR Z) instead of $20 (JR NZ).
c$8865 LD A,$28      ; The opcode for JR Z, for the self-modifying trick below
 $8867 JR $886B      ; Join the shared code

; Push the words of the action for a question
;
; Pushes the particle and the preposition of the current action (from the action table entry at $834F) on the stack, as parameters for a message such as 'take
; what?' or 'unlock the door with what?'. Words that should not appear are replaced by 0.
; .
; This routine modifies itself: it writes A (the opcode for either JR NZ or JR Z) into the two conditional jumps at $887F and $888E before running them, so that
; the same code can test flag bits for either the target or the instrument. It then returns by jumping to its return address, which it had to move out of the
; way under the pushed words (the EX (SP),HL instructions).
c$8869 LD A,$20       ; The opcode for JR NZ instead (the target version)
; This entry point is used by the routine at #R$8865.
*$886B LD ($887F),A   ; Poke it into the first conditional jump below...
 $886E LD ($888E),A   ; ...and the second, so the very same code can test either the target's or the instrument's own flags
 $8871 LD IX,($834F)  ; IX = the current action table entry
 $8875 LD L,(IX+$04)  ; {HL = its particle word
 $8878 LD H,(IX+$05)  ; }
 $887B BIT 7,(IX+$07) ; Does this action even have a particle worth mentioning?
 $887F JR NZ,$8884    ; (rewritten JR NZ or JR Z, as poked in above)
 $8881 LD HL,$0000    ; No: push 0 instead, so nothing gets printed for an empty word
*$8884 EX (SP),HL     ; {Push the particle (or 0) as a message parameter
 $8885 PUSH HL        ; }
 $8886 LD L,(IX+$02)  ; {HL = the action's own preposition word
 $8889 LD H,(IX+$03)  ; }
 $888C BIT 5,H        ; Does this action have a preposition worth mentioning?
 $888E JR NZ,$8893    ; (rewritten JR NZ or JR Z)
 $8890 LD HL,$0000    ; No: push 0 instead
*$8893 EX (SP),HL     ; Push the preposition as a message parameter
 $8894 JP (HL)        ; Return to whichever routine called this one

; "I do not know the verb ..."
;
; Pushes the verb, particle and preposition the player used and prints 'I do not know the verb "..."' ($ACA4): the verb is known, but not with those words (for
; example 'take through the door').
c$8895 LD HL,($834D) ; {Push the second collected preposition...
 $8898 PUSH HL       ; }
 $8899 LD HL,($834B) ; {...and the first...
 $889C PUSH HL       ; }
 $889D LD HL,($8349) ; {...and the verb itself, as message parameters
 $88A0 PUSH HL       ; }
 $88A1 LD HL,$ACA4   ; "I do not know the verb "..."."
 $88A4 JP $8781      ; Print it and give up

; Address the orders to a character
;
; After SAY TO someone "...", the commands inside the quotation are waiting in the orders buffer (#R$B628), each in a slot marked $FF. This routine gives the
; first A of them to the character being spoken to, by writing the character's object number ($B5D9) into the slots' first bytes. Any further waiting orders
; (more than the character will accept) are thrown away by setting their first byte to 0.
c$88A7 PUSH BC         ;
 $88A8 PUSH IX         ;
 $88AA PUSH DE         ;
 $88AB LD B,A          ; B = the number of orders the character will take
 $88AC LD A,($B627)    ; {C = the number of orders waiting
 $88AF LD C,A          ; }
 $88B0 CP B            ; {More wanted than there are?
 $88B1 JR NC,$88B4     ; }
 $88B3 LD B,A          ; Then take them all
*$88B4 LD A,C          ; {C = the number left over
 $88B5 SUB B           ;
 $88B6 LD C,A          ; }
 $88B7 LD IX,$B60F     ; IX = one slot before the orders buffer
 $88BB LD DE,$0019     ; 25 bytes per slot
 $88BE XOR A           ; {Any to hand over?
 $88BF CP B            ; }
 $88C0 JR Z,$88D3      ; No
*$88C2 ADD IX,DE       ; {Find the next waiting order (marked $FF)
 $88C4 LD A,(IX+$00)   ;
 $88C7 CP $FF          ;
 $88C9 JR NZ,$88C2     ; }
 $88CB LD A,($B5D9)    ; {Address it to the character
 $88CE LD (IX+$00),A   ; }
 $88D1 DJNZ $88C2      ; Next
*$88D3 LD B,C          ; {Now the left-over orders:
 $88D4 XOR A           ;
 $88D5 CP B            ; }
 $88D6 JR Z,$88E7      ; None
*$88D8 ADD IX,DE       ; {find each one...
 $88DA LD A,(IX+$00)   ;
 $88DD CP $FF          ;
 $88DF JR NZ,$88D8     ; }
 $88E1 LD (IX+$00),$00 ; {...and throw it away
 $88E5 DJNZ $88D8      ;
*$88E7 POP DE          ;
 $88E8 POP IX          ;
 $88EA POP BC          ;
 $88EB RET             ; }

; Find an order for the current actor
;
; Searches the eight 25-byte slots of the orders buffer (#R$B628) for one addressed to the current actor ($B5DB). Returns with Z set and HL pointing at the slot
; if one is found.
;
; Output:F Z set if found
;        HL Order slot
c$88EC LD HL,$B628   ; HL = the start of the orders buffer
 $88EF LD DE,$0019   ; DE = 25, the size of one order slot
 $88F2 LD A,($B5DB)  ; A = the current actor
 $88F5 LD B,$08      ; Eight slots to check
*$88F7 CP (HL)       ; Is this slot addressed to the actor?
 $88F8 RET Z         ; Yes: found it, with HL pointing at the slot
 $88F9 ADD HL,DE     ; {No: move on to the next slot
 $88FA DJNZ $88F7    ; }
 $88FC RET           ; None found

; Does the actor have an order waiting?
;
; As #R$88EC, preserving BC, DE and HL.
c$88FD PUSH HL       ; {Save HL, DE and BC
 $88FE PUSH DE       ;
 $88FF PUSH BC       ; }
 $8900 CALL $88EC    ; Search for an order (only the flags this leaves behind matter here)
 $8903 POP BC        ; {Restore BC, DE and HL
 $8904 POP DE        ;
 $8905 POP HL        ;
 $8906 RET           ; }

; Obey an order
;
; Called with A non-zero by #R$976C when a character has been given an order by the player. The order's slot is found (#R$88EC) and freed, and the 24-byte frame
; stored in it is matched to an action and objects exactly as if the player had typed it (#R$83A7), but with the quotation flag set so that nothing is printed
; while this happens. If the action would work (#R$84DE), the character will carry it out on its turn; if not, all the character's orders are cancelled
; (#R$894D).
; .
; With A=0 it only frees the slot.
;
; Input:A 0 to discard the order
c$8907 PUSH IX       ;
 $8909 PUSH IY       ;
 $890B PUSH BC       ;
 $890C PUSH DE       ;
 $890D PUSH HL       ;
 $890E LD C,A        ; C = 0 to discard the order, 1 to obey it
 $890F CALL $88EC    ; HL = the actor's order slot
 $8912 LD (HL),$00   ; Free the slot
 $8914 INC HL        ; HL = the command frame stored in it
 $8915 XOR A         ; {Discarding?
 $8916 CP C          ; }
 $8917 JR NZ,$8924   ; No: obey it
 $8919 OR $01        ; Return with Z reset
 $891B EX (SP),HL    ; {Return HL (the frame) to the caller
*$891C POP HL        ;
 $891D POP DE        ;
 $891E POP BC        ;
 $891F POP IY        ;
 $8921 POP IX        ;
 $8923 RET           ; }
*$8924 PUSH HL       ; {IY = the frame
 $8925 POP IY        ; }
 $8927 LD A,$01      ; {Pretend to be inside a quotation so nothing is printed
 $8929 LD ($B60B),A  ;
 $892C LD A,($B60C)  ;
 $892F PUSH AF       ; }
 $8930 CALL $83A7    ; {Find the action and objects for the order, as if the player had typed it
 $8933 EX AF,AF'     ; }
 $8934 XOR A         ; {Back to normal
 $8935 LD ($B60B),A  ;
 $8938 POP AF        ;
 $8939 LD ($B60C),A  ;
 $893C EX AF,AF'     ; }
 $893D JR Z,$8944    ; It made no sense: give up
 $893F CALL $84DE    ; Would it work?
 $8942 JR NZ,$891C   ; Yes: return with Z reset; the character will do it
*$8944 LD A,($B5DB)  ; {No: the character forgets all its orders
 $8947 CALL $894D    ; }
 $894A XOR A         ; {Return with Z set
 $894B JR $891C      ; }

; Cancel a character's orders
;
; Clears every slot of the orders buffer (#R$B628) that is addressed to character A. Used when a character cannot carry out an order and when a character dies
; (#R$96DD).
;
; Input:A Character
c$894D PUSH HL       ; {Save HL, DE and BC
 $894E PUSH DE       ;
 $894F PUSH BC       ; }
 $8950 LD HL,$B628   ; HL = the start of the orders buffer
 $8953 LD DE,$0019   ; DE = 25, the size of one slot
 $8956 LD B,$08      ; Eight slots to check
*$8958 CP (HL)       ; Is this slot addressed to character A?
 $8959 JR NZ,$895D   ; No: leave it alone
 $895B LD (HL),$00   ; Yes: free the slot
*$895D ADD HL,DE     ; {Move on to the next slot
 $895E DJNZ $8958    ; }
 $8960 POP BC        ; {Restore BC, DE and HL
 $8961 POP DE        ;
 $8962 POP HL        ;
 $8963 RET           ; }

; Unused
s$8964 DEFS $01

; Draw the picture of a room, if it has one
;
; Looks the room A up in the picture index at #R$CC00. If there is a picture, it is drawn by #R$8985. The result of the search is stored at $8964, where #R$95B9
; later looks to decide whether to wait for a key after the picture has been drawn.
;
; Input:A Room number
c$8965 PUSH AF       ; {Save every register this uses
 $8966 PUSH HL       ;
 $8967 PUSH BC       ;
 $8968 PUSH DE       ;
 $8969 PUSH IX       ; }
 $896B LD IX,$CC00   ; IX = the picture index
 $896F CALL $9D12    ; Does room A have a picture?
 $8972 LD ($8964),A  ; Remember the answer for #R$95B9 to check afterwards
 $8975 LD L,(IX+$01) ; {HL = the picture's own address, if there is one
 $8978 LD H,(IX+$02) ; }
 $897B CALL NZ,$8985 ; If there is, draw it
 $897E POP IX        ; {Restore every saved register
 $8980 POP DE        ;
 $8981 POP BC        ;
 $8982 POP HL        ;
 $8983 POP AF        ;
 $8984 RET           ; }

; Draw a picture
;
; Interprets the picture data at HL. Pictures are drawn with vector commands, not stored as bitmaps, which is how 22 full-width pictures fit into a few
; kilobytes. The first two bytes set the border colour and the colour of the picture area, which is cleared (#R$8BE9); if Bilbo is in the dark the picture is
; not drawn at all.
; .
; The picture area is the top 128 pixel rows of the screen. The drawing position is kept in D (x, 0-255) and E (y, 0-127, measured upwards from the bottom); it
; starts in the middle, at (127,63). Then each command byte is one of:
; .
; #TABLE(default)
; { =h Byte | =h Command }
; { $00 | end of picture }
; { $08 | move: the next two bytes are the new x and y }
; { %1dddssss, %sslllll | line: bits 0-2 give the direction, bits 3-6 and the top two bits of the next byte give the slope, and the rest of that byte the
; length; drawn by #R$8B2F }
; { %01000ccc, x, y | flood fill from (x,y) with ink colour ccc (#R$8A4F) }
; { %00100ccc, address, runs... | paint attribute cells with paper colour ccc: starting at the given attribute address, each following byte moves up, right,
; down or left (bits 0-1) a number of cells (bits 2-7, plus 1), painting as it goes; ended by $FF }
; TABLE#
; .
; Lines and fills also set the ink colour of every attribute cell they touch (#R$8B93), so colour is applied as the picture is drawn. Anything else is ignored.
; .
; A picture normally ends with a 0. Two pictures (rooms 13 and 5) instead end with a move command whose coordinate bytes are the colour bytes of the next
; picture in memory, so they go on to draw that picture as well (see #R$E02C and #R$E142).
;
; Input:HL Picture data
c$8985 PUSH IY       ; {Save the registers the caller uses
 $8987 PUSH HL       ; }
 $8988 PUSH HL       ; {IY = the picture data
 $8989 POP IY        ;
 $898B PUSH DE       ;
 $898C PUSH BC       ; }
 $898D CALL $8BE9    ; Set the border, clear and colour the picture area (or give up if Bilbo is in the dark)
 $8990 LD D,$7F      ; Start the pen in the middle: x = 127...
 $8992 LD E,$3F      ; {...y = 63
 $8994 LD B,$01      ;
 $8996 LD C,$01      ;
 $8998 LD L,$01      ; }
*$899A LD A,(IY+$00) ; NEXT COMMAND: fetch it
 $899D AND A         ; Zero?
 $899E JP Z,$8A47    ; {Yes: the end of the picture
 $89A1 INC IY        ; }
 $89A3 CP $08        ; $08: move the pen?
 $89A5 JR NZ,$89B3   ; No
 $89A7 LD D,(IY+$00) ; {D = the new x
 $89AA INC IY        ; }
 $89AC LD E,(IY+$00) ; {E = the new y
 $89AF INC IY        ; }
 $89B1 JR $899A      ; Next command
*$89B3 BIT 7,A       ; Bit 7 set: a line?
 $89B5 JR Z,$89D8    ; {No
 $89B7 LD B,A        ; }
 $89B8 AND $07       ; {C = the direction (bits 0-2)
 $89BA LD C,A        ; }
 $89BB LD A,B        ; {B = bits 3-6 of the first byte...
 $89BC RRCA          ;
 $89BD AND $3C       ;
 $89BF LD B,A        ; }
 $89C0 LD A,(IY+$00) ; {L = the length (bottom six bits of the second byte, plus 1)
 $89C3 AND $3F       ;
 $89C5 LD L,A        ;
 $89C6 INC L         ; }
 $89C7 LD A,(IY+$00) ; {...combined with the top two bits of the second byte to give the slope
 $89CA INC IY        ;
 $89CC RLCA          ;
 $89CD RLCA          ;
 $89CE AND $03       ;
 $89D0 OR B          ;
 $89D1 LD B,A        ; }
 $89D2 INC B         ; (plus 1)
 $89D3 CALL $8B2F    ; Draw the line
 $89D6 JR $899A      ; Next command
*$89D8 BIT 6,A       ; Bit 6 set: a flood fill?
 $89DA JR Z,$89F0    ; No
 $89DC AND $07       ; A = the colour
 $89DE PUSH DE       ; Keep the pen position
 $89DF LD D,(IY+$00) ; {D = x of the point to fill from
 $89E2 INC IY        ; }
 $89E4 LD E,(IY+$00) ; {E = y
 $89E7 INC IY        ; }
 $89E9 CALL $8A4F    ; Fill
 $89EC POP DE        ; Restore the pen position
 $89ED JP $899A      ; Next command
*$89F0 BIT 5,A       ; Bit 5 set: paint character cells?
 $89F2 JP Z,$899A    ; No: ignore the byte
 $89F5 AND $07       ; {C = the colour, shifted into the paper bits
 $89F7 RLCA          ;
 $89F8 RLCA          ;
 $89F9 RLCA          ;
 $89FA PUSH HL       ;
 $89FB PUSH DE       ;
 $89FC PUSH BC       ;
 $89FD LD C,A        ; }
 $89FE LD H,(IY+$00) ; {HL = the attribute address (high byte first)
 $8A01 INC IY        ;
 $8A03 LD L,(IY+$00) ;
 $8A06 INC IY        ; }
*$8A08 LD A,(IY+$00) ; {Next run byte
 $8A0B INC IY        ; }
 $8A0D CP $FF        ; {$FF ends the runs
 $8A0F JR Z,$8A41    ;
 $8A11 LD B,A        ; }
 $8A12 AND $03       ; {E = the direction (0 up, 1 right, 2 down, 3 left)
 $8A14 LD E,A        ; }
 $8A15 LD A,B        ; {B = the number of cells (bits 2-7, plus 1)
 $8A16 RRCA          ;
 $8A17 RRCA          ;
 $8A18 AND $3F       ;
 $8A1A INC A         ;
 $8A1B LD B,A        ; }
*$8A1C LD A,(HL)     ; {A = the cell's ink colour, shifted into the paper position
 $8A1D AND $07       ;
 $8A1F RLCA          ;
 $8A20 RLCA          ;
 $8A21 RLCA          ; }
 $8A22 CP C          ; {Would the ink be the same as the new paper?
 $8A23 JR NZ,$8A27   ; }
 $8A25 XOR $38       ; Yes: use the complementary ink so the drawing stays visible
*$8A27 RRCA          ; {Shift the ink back down
 $8A28 RRCA          ;
 $8A29 RRCA          ; }
 $8A2A OR C          ; Combine with the new paper...
 $8A2B LD (HL),A     ; ...and store the attribute
 $8A2C LD A,E        ; {Move one cell in the run's direction:
 $8A2D AND A         ; }
 $8A2E CALL Z,$8AD3  ; {up,
 $8A31 DEC A         ; }
 $8A32 CALL Z,$8AFF  ; {right,
 $8A35 DEC A         ; }
 $8A36 CALL Z,$8AE4  ; {down,
 $8A39 DEC A         ; }
 $8A3A CALL Z,$8AF5  ; or left
 $8A3D DJNZ $8A1C    ; Next cell of the run
 $8A3F JR $8A08      ; {Next run
*$8A41 POP BC        ;
 $8A42 POP DE        ;
 $8A43 POP HL        ; }
 $8A44 JP $899A      ; Next command
; This entry point is used by the routine at #R$8BE9.
*$8A47 POP BC        ; {Restore the registers
 $8A48 POP DE        ;
 $8A49 POP HL        ;
 $8A4A POP IY        ;
 $8A4C RET           ; }

; Unused
s$8A4D DEFS $02

; Flood fill
;
; Fills the area around the point (D,E) with ink colour A (kept at $8C2C for #R$8B93). It is a scan-line fill: from the starting point it moves left to the edge
; of the area, then works rightwards along the row, setting each pixel. At every pixel it looks at the pixel above and the pixel below: where an unfilled
; stretch begins in the row above or below, that position is pushed on the stack as a 'seed' to be filled later. The flags at $8A4D (above) and $8A4E (below)
; stop it pushing a seed for every pixel of the same stretch. When the row is done, the next seed is popped and the process repeats, until the marker $0080
; pushed at the start comes back off the stack.
; .
; Because each row is filled from its left-hand end, and seeds are only pushed at the starts of stretches, the fill needs very little stack even for large
; areas.
;
; Input:A Colour
;       D x
;       E y
c$8A4F LD ($8C2C),A  ; {Save the fill colour
 $8A52 PUSH DE       ;
 $8A53 PUSH HL       ; }
 $8A54 LD HL,$0080   ; {Push the end marker (a y value of $80 is impossible)
 $8A57 PUSH HL       ; }
*$8A58 CALL $8ACC    ; Is the pixel at (D,E) set?
 $8A5B JR NZ,$8A64   ; Yes: we have found the left-hand boundary
 $8A5D CALL $8B26    ; No: move left
 $8A60 JR NZ,$8A58   ; Keep going until a set pixel or the edge
 $8A62 JR $8A6A      ; At the left edge of the picture: start here
*$8A64 CALL $8B93    ; Colour the boundary pixel...
 $8A67 CALL $8B1F    ; ...and step right onto the first empty pixel
*$8A6A LD HL,$0000   ; {Not yet tracking a stretch above or below
 $8A6D LD ($8A4D),HL ; }
*$8A70 CALL $8B09    ; {Look at the pixel above
 $8A73 LD A,$00      ; }
 $8A75 JR Z,$8A8C    ; At the top edge: nothing to do above
 $8A77 CALL $8ACC    ; {Is it set?
 $8A7A LD A,$00      ; }
 $8A7C JR NZ,$8A87   ; Set: not part of the area
 $8A7E LD A,($8A4D)  ; {Empty. Already tracking this stretch above?
 $8A81 AND A         ; }
 $8A82 JR NZ,$8A87   ; Yes: no new seed
 $8A84 PUSH DE       ; No: push it as a seed
 $8A85 LD A,$01      ; {...and start tracking
*$8A87 PUSH AF       ; }
 $8A88 CALL $8B18    ; {Back down to the current row
 $8A8B POP AF        ; }
*$8A8C LD ($8A4D),A  ; Remember whether we are tracking above
 $8A8F CALL $8B18    ; {Look at the pixel below
 $8A92 LD A,$00      ; }
 $8A94 JR Z,$8AAB    ; At the bottom edge: nothing to do below
 $8A96 CALL $8ACC    ; {Is it set?
 $8A99 LD A,$00      ; }
 $8A9B JR NZ,$8AA6   ; Set: not part of the area
 $8A9D LD A,($8A4E)  ; {Empty. Already tracking this stretch below?
 $8AA0 AND A         ; }
 $8AA1 JR NZ,$8AA6   ; Yes: no new seed
 $8AA3 PUSH DE       ; No: push it as a seed
 $8AA4 LD A,$01      ; {...and start tracking
*$8AA6 PUSH AF       ; }
 $8AA7 CALL $8B09    ; {Back up to the current row
 $8AAA POP AF        ; }
*$8AAB LD ($8A4E),A  ; Remember whether we are tracking below
 $8AAE CALL $8B93    ; Fill this pixel
 $8AB1 CALL $8B1F    ; Step right
 $8AB4 JR Z,$8ABE    ; At the right edge: this row is done
 $8AB6 CALL $8ACC    ; Is the next pixel set?
 $8AB9 JR Z,$8A70    ; No: carry on along the row
 $8ABB CALL $8B93    ; Yes: colour the boundary pixel too
*$8ABE POP DE        ; Pop the next seed
 $8ABF LD A,E        ; {Is it the end marker?
 $8AC0 CP $80        ; }
 $8AC2 JR NZ,$8A58   ; No: fill from there
 $8AC4 LD A,$00      ; {Done: reset the drawing colour
 $8AC6 LD ($8C2C),A  ;
 $8AC9 POP HL        ;
 $8ACA POP DE        ;
 $8ACB RET           ; }

; Test a pixel
;
; Returns with Z reset if the pixel at (D,E) is set.
;
; Input:D x
;       E y
c$8ACC PUSH HL       ;
 $8ACD CALL $8BBC    ; HL = the screen byte, A = the bit for the pixel
 $8AD0 AND (HL)      ; {Z reset if the pixel is set
 $8AD1 POP HL        ;
 $8AD2 RET           ; }

; Move an attribute address up a row
;
; Subtracts 32 from HL, unless that would move it above the attribute file ($5800), in which case HL is unchanged. Used when painting colours (#R$8985).
c$8AD3 PUSH AF       ; {Save AF and DE
 $8AD4 PUSH DE       ; }
 $8AD5 LD DE,$0020   ; {DE = 32, the width of one attribute row
 $8AD8 AND A         ; }
 $8AD9 SBC HL,DE     ; Move HL up a row
 $8ADB LD A,H        ; {Did that go above the top of the attribute file?
 $8ADC CP $57        ;
 $8ADE JR NZ,$8AE1   ; }
 $8AE0 ADD HL,DE     ; If so, undo the move: stay on the top row
*$8AE1 POP DE        ; {Restore DE and AF
 $8AE2 POP AF        ;
 $8AE3 RET           ; }

; Move an attribute address down a row
;
; Adds 32 to HL, unless that would move it off the bottom of the attribute file.
c$8AE4 PUSH AF       ; {Save AF and DE
 $8AE5 PUSH DE       ; }
 $8AE6 LD DE,$0020   ; DE = 32, the width of one attribute row
 $8AE9 ADD HL,DE     ; Move HL down a row
 $8AEA LD A,H        ; {Did that go past the bottom of the attribute file?
 $8AEB CP $5A        ;
 $8AED JR NZ,$8AF1   ; }
 $8AEF AND A         ; {If so, undo the move: stay on the bottom row
 $8AF0 SBC HL,DE     ; }
 $8AF2 POP DE        ; {Restore DE and AF
 $8AF3 POP AF        ;
 $8AF4 RET           ; }

; Move an attribute address left
;
; Decreases HL, unless that would move it out of the attribute file.
c$8AF5 PUSH AF       ; Save AF
 $8AF6 DEC HL        ; Move HL one cell left
 $8AF7 LD A,H        ; {Did that go off the left edge of the attribute file?
 $8AF8 CP $57        ;
 $8AFA JR NZ,$8AFD   ; }
 $8AFC INC HL        ; If so, undo the move: stay put
*$8AFD POP AF        ; {Restore AF
 $8AFE RET           ; }

; Move an attribute address right
;
; Increases HL, unless that would move it out of the attribute file.
c$8AFF PUSH AF       ; Save AF
 $8B00 INC HL        ; Move HL one cell right
 $8B01 LD A,H        ; {Did that go past the right edge?
 $8B02 CP $5A        ;
 $8B04 JR NZ,$8B07   ; }
 $8B06 DEC HL        ; If so, undo the move: stay put
*$8B07 POP AF        ; {Restore AF
 $8B08 RET           ; }

; Move the drawing position up
;
; Increases E (y), unless it would go past 127. Returns with Z set if the edge was reached. A is preserved.
c$8B09 INC E         ; y + 1
 $8B0A BIT 7,E       ; Past 127?
 $8B0C JR Z,$8B13    ; No: return with Z reset
 $8B0E DEC E         ; {Yes: undo it...
 $8B0F LD H,A        ; }
 $8B10 XOR A         ; {...and return with Z set (A preserved)
 $8B11 LD A,H        ;
 $8B12 RET           ;
; This entry point is used by the routine at #R$8B18.
*$8B13 LD H,A        ; }
 $8B14 OR $01        ; {Reset Z (A preserved)
 $8B16 LD A,H        ;
 $8B17 RET           ; }

; Move the drawing position down
;
; Decreases E, unless it would go below 0. Returns with Z set at the edge.
c$8B18 DEC E         ; y one lower
 $8B19 BIT 7,E       ; Did that go below 0, off the bottom of the picture area?
 $8B1B JR Z,$8B13    ; No: continue at the shared ending (reused from #R$8B09)
 $8B1D INC E         ; Yes: undo the move
 $8B1E RET           ; Z stays set, telling the caller the edge was reached

; Move the drawing position right
;
; Increases D (x), unless it would go past 255. Returns with Z set at the edge.
c$8B1F INC D         ; x one higher
 $8B20 RET NZ        ; Still within 0-255: done
 $8B21 DEC D         ; Wrapped past 255: undo the move
 $8B22 LD H,A        ; Save A for a moment...
 $8B23 XOR A         ; ...set Z, to tell the caller the edge was reached...
 $8B24 LD A,H        ; {...then restore A
 $8B25 RET           ; }

; Move the drawing position left
;
; Decreases D, unless it would go below 0. Returns with Z set at the edge.
c$8B26 DEC D         ; x one lower
 $8B27 LD H,A        ; Save A for a moment
 $8B28 LD A,D        ; {Did x wrap below 0 (become 255)?
 $8B29 CP $FF        ; }
 $8B2B LD A,H        ; Restore A
 $8B2C RET NZ        ; Still within range: done
 $8B2D INC D         ; Wrapped: undo the move
 $8B2E RET           ; Z is set, telling the caller the edge was reached

; Draw a line
;
; Draws a line of L+1 pixels from (D,E) in one of eight directions (bits 0-2 of C). Bit 0 says whether the line is mostly vertical or mostly horizontal; bits 1
; and 2 give the vertical and horizontal directions. The line moves one pixel along its main direction every step, and one pixel along the other direction every
; B steps, so lines have slopes of 1, 1/2, 1/3 and so on rather than arbitrary angles. Drawing stops early at the edge of the picture area.
;
; Input:C Direction
;       B Steps per sideways move
;       L Length
;       D,E Start
c$8B2F BIT 0,C       ; Mostly vertical (bit 0 set)?
 $8B31 JR NZ,$8B63   ; Yes
 $8B33 PUSH HL       ; {MOSTLY HORIZONTAL:
 $8B34 PUSH BC       ; }
*$8B35 CALL $8B93    ; Plot the pixel
 $8B38 BIT 2,C       ; {Leftwards (bit 2)?
 $8B3A JR Z,$8B43    ; }
 $8B3C CALL $8B26    ; Step left
 $8B3F JR Z,$8B60    ; {Stop at the edge
 $8B41 JR $8B48      ; }
*$8B43 CALL $8B1F    ; Step right
 $8B46 JR Z,$8B60    ; Stop at the edge
*$8B48 DEC B         ; Time for a vertical step?
 $8B49 JR NZ,$8B5D   ; Not yet
 $8B4B BIT 1,C       ; {Downwards (bit 1)?
 $8B4D JR Z,$8B56    ; }
 $8B4F CALL $8B18    ; Step down
 $8B52 JR Z,$8B60    ; {Stop at the edge
 $8B54 JR $8B5B      ; }
*$8B56 CALL $8B09    ; Step up
 $8B59 JR Z,$8B60    ; Stop at the edge
*$8B5B POP BC        ; {Reload the step counter B
 $8B5C PUSH BC       ; }
*$8B5D DEC L         ; One pixel fewer to draw
 $8B5E JR NZ,$8B35   ; {Loop
*$8B60 POP BC        ;
 $8B61 POP HL        ;
 $8B62 RET           ; }
*$8B63 PUSH HL       ; {MOSTLY VERTICAL:
 $8B64 PUSH BC       ; }
*$8B65 CALL $8B93    ; Plot the pixel
 $8B68 BIT 1,C       ; {Downwards (bit 1)?
 $8B6A JR Z,$8B73    ; }
 $8B6C CALL $8B18    ; Step down
 $8B6F JR Z,$8B90    ; {Stop at the edge
 $8B71 JR $8B78      ; }
*$8B73 CALL $8B09    ; Step up
 $8B76 JR Z,$8B90    ; Stop at the edge
*$8B78 DEC B         ; Time for a sideways step?
 $8B79 JR NZ,$8B8D   ; Not yet
 $8B7B BIT 2,C       ; {Leftwards (bit 2)?
 $8B7D JR Z,$8B86    ; }
 $8B7F CALL $8B26    ; Step left
 $8B82 JR Z,$8B90    ; {Stop at the edge
 $8B84 JR $8B8B      ; }
*$8B86 CALL $8B1F    ; Step right
 $8B89 JR Z,$8B90    ; Stop at the edge
*$8B8B POP BC        ; {Reload the step counter
 $8B8C PUSH BC       ; }
*$8B8D DEC L         ; One pixel fewer to draw
 $8B8E JR NZ,$8B65   ; {Loop
*$8B90 POP BC        ;
 $8B91 POP HL        ;
 $8B92 RET           ; }

; Plot a pixel
;
; Sets the pixel at (D,E) and gives its attribute cell the ink colour held at $8C2C, keeping the cell's paper colour. If the ink would be the same as the paper
; (and so invisible), the ink is changed to its complement (XOR $38 before shifting).
c$8B93 PUSH HL       ;
 $8B94 CALL $8BBC    ; {HL = the screen byte, A = the pixel's bit
 $8B97 PUSH AF       ;
 $8B98 PUSH HL       ; }
 $8B99 LD A,H        ; {Work out the attribute address from the screen address
 $8B9A AND $18       ;
 $8B9C RRCA          ;
 $8B9D RRCA          ;
 $8B9E RRCA          ;
 $8B9F ADD A,$58     ;
 $8BA1 LD H,A        ; }
 $8BA2 LD A,(HL)     ; {Keep only the cell's paper colour
 $8BA3 AND $38       ;
 $8BA5 LD (HL),A     ; }
 $8BA6 LD A,($8C2C)  ; {A = the drawing colour, in the paper position
 $8BA9 RLCA          ;
 $8BAA RLCA          ;
 $8BAB RLCA          ; }
 $8BAC CP (HL)       ; {Same as the paper?
 $8BAD JR NZ,$8BB1   ; }
 $8BAF XOR $38       ; Yes: use its complement so it shows
*$8BB1 RRCA          ; {Back into the ink position
 $8BB2 RRCA          ;
 $8BB3 RRCA          ; }
 $8BB4 OR (HL)       ; Combine with the paper...
 $8BB5 LD (HL),A     ; {...and store it
 $8BB6 POP HL        ; }
 $8BB7 POP AF        ; A = the pixel's bit
 $8BB8 OR (HL)       ; {Set the pixel
 $8BB9 LD (HL),A     ;
 $8BBA POP HL        ;
 $8BBB RET           ; }

; Get the screen address of a pixel
;
; Converts the picture coordinates (D,E) to a screen address HL and a bit mask A. The y coordinate is turned upside down (127-E), because pictures are drawn
; with y measured upwards, and then split up in the usual way for the Spectrum's interleaved screen layout.
;
;  Input:D x
;        E y
; Output:HL Screen address
;        A Bit mask
c$8BBC LD A,$7F      ; {Turn y upside down: row = 127 - y
 $8BBE SUB E         ;
 $8BBF LD L,A        ; }
 $8BC0 AND $07       ; The low three bits of the row are the pixel line within the character...
 $8BC2 OR $40        ; {...in the display file at $4000
 $8BC4 LD H,A        ; }
 $8BC5 LD A,L        ; {Bits 6-7 of the row choose the third of the screen
 $8BC6 AND $C0       ;
 $8BC8 RRCA          ;
 $8BC9 RRCA          ;
 $8BCA RRCA          ;
 $8BCB OR H          ;
 $8BCC LD H,A        ; }
 $8BCD LD A,L        ; {Bits 3-5 choose the character row within the third
 $8BCE AND $38       ;
 $8BD0 RLCA          ;
 $8BD1 RLCA          ;
 $8BD2 LD L,A        ; }
 $8BD3 LD A,D        ; {x / 8 is the column
 $8BD4 RRCA          ;
 $8BD5 RRCA          ;
 $8BD6 RRCA          ;
 $8BD7 AND $1F       ;
 $8BD9 OR L          ;
 $8BDA LD L,A        ; }
 $8BDB LD A,D        ; {x AND 7 is the bit within the byte
 $8BDC AND $07       ;
 $8BDE PUSH BC       ;
 $8BDF LD B,A        ;
 $8BE0 INC B         ; }
 $8BE1 LD A,$01      ; {Start with bit 0 and rotate right x AND 7 + 1 times, giving $80 for x AND 7 = 0
*$8BE3 RRC A         ;
 $8BE5 DJNZ $8BE3    ;
 $8BE7 POP BC        ;
 $8BE8 RET           ; }

; Start a picture: clear the picture area
;
; Reads the picture's first two bytes: the border colour, which is set straight away, and the attribute for the picture area. The top two thirds of the screen
; ($4000-$4FFF) are cleared, and the 512 attributes of that area are filled with the picture's colour.
; .
; If Bilbo is in the dark (#R$954D), the border and attributes are set to black instead, and the drawing is abandoned: the return address is discarded and the
; routine jumps to the end of #R$8985.
c$8BE9 CALL $954D    ; Is Bilbo in the dark? (carry set if so)
 $8BEC EX AF,AF'     ; Keep the answer in the alternate AF
 $8BED LD A,(IY+$00) ; {A = the border colour (first byte of the picture)
 $8BF0 INC IY        ;
 $8BF2 EX AF,AF'     ; }
 $8BF3 JR NC,$8BF8   ; Not dark: keep it
 $8BF5 EX AF,AF'     ; {Dark: black border
 $8BF6 XOR A         ;
 $8BF7 EX AF,AF'     ;
*$8BF8 EX AF,AF'     ; }
 $8BF9 OUT ($FE),A   ; {Set the border
 $8BFB PUSH HL       ;
 $8BFC PUSH DE       ;
 $8BFD PUSH BC       ; }
 $8BFE LD HL,$4000   ; {Clear the top two thirds of the screen ($4000-$4FFF)
 $8C01 LD DE,$4001   ;
 $8C04 LD BC,$0FFF   ;
 $8C07 LD (HL),$00   ;
 $8C09 LDIR          ; }
 $8C0B LD HL,$5800   ; {512 attributes from $5800
 $8C0E LD DE,$5801   ;
 $8C11 LD BC,$01FF   ; }
 $8C14 LD A,(IY+$00) ; {A = the picture's colours (second byte)
 $8C17 INC IY        ;
 $8C19 EX AF,AF'     ; }
 $8C1A JR NC,$8C1F   ; Not dark: keep them
 $8C1C EX AF,AF'     ; {Dark: black on black
 $8C1D XOR A         ;
 $8C1E EX AF,AF'     ;
*$8C1F EX AF,AF'     ; }
 $8C20 LD (HL),A     ; {Fill the attributes
 $8C21 LDIR          ;
 $8C23 POP BC        ;
 $8C24 POP DE        ;
 $8C25 POP HL        ; }
 $8C26 EX AF,AF'     ; Not dark?
 $8C27 RET NC        ; Then return and draw the picture
 $8C28 POP HL        ; Dark: discard the return address...
 $8C29 JP $8A47      ; ...and skip the drawing altogether

; Drawing colour
;
; The ink colour used by #R$8B93 when plotting, set by the flood fill (#R$8A4F) and reset to 0 afterwards.
b$8C2C DEFB $38

; LOOK
;
; Describes the room the actor is in (#R$958E). The dry-run check (#R$9C99) comes first, so trying LOOK costs nothing.
c$8C2D CALL $9C99    ; Dry run? Then stop here: LOOK always works
 $8C30 LD IX,($B5FC) ; IX = the current actor's own record
 $8C34 LD A,(IX+$10) ; A = the actor's own room
 $8C37 JP $958E      ; Describe that room, in full

; Is the actor carrying the target?
;
; Returns normally if the actor is carrying the target (#R$9BCD). If not, it prints 'you are not carrying it.' and returns to the caller's caller, so the action
; goes no further.
c$8C3A CALL $9BCD    ; Is the target held by the current actor?
 $8C3D RET C         ; Yes: carry on with whatever the caller wanted to do next
 $8C3E POP HL        ; No: throw away the caller's own return address...
 $8C3F LD HL,$ACE4   ; ..."you are not carrying it."
 $8C42 JP $72D4      ; ...and print that instead, ending the action here

; DROP
;
; The actor must be carrying the target (#R$8C3A). If the target is tied to the rope (it is 'held by' object 18), it is the rope that is dropped.
; .
; Dropping means setting the object's holder to $FF, which leaves it in the room. But objects with bit 1 of their flags set are liquids or things that do not
; survive being put down: they 'evaporate', which means their location is set to 0 (nowhere) and a message says so. The objects that behave like this are
; numbers 9, 20 (the wine), 21, 22, 23, 24 and 42.
c$8C45 CALL $8C3A      ; Is the actor carrying it? (If not, "you are not carrying it.")
 $8C48 CALL $9C99      ; Dry run? Then stop: it would work
 $8C4B LD IX,($B5F8)   ; IX = the object's record
 $8C4F LD A,(IX+$01)   ; {Is it tied to the rope (object 18)?
 $8C52 CP $12          ; }
 $8C54 JR NZ,$8C5A     ; No
 $8C56 LD IX,$C255     ; Yes: it is the rope that gets dropped
*$8C5A LD (IX+$01),$FF ; Nobody holds it now: it lies in the room
 $8C5E BIT 1,(IX+$07)  ; Does it evaporate?
 $8C62 RET Z           ; No: done
 $8C63 LD (IX+$10),$00 ; Yes: it goes nowhere
 $8C67 LD HL,$B034     ; "<object> evaporates."
 $8C6A LD DE,$0008     ; {Push the object's name as the parameter
 $8C6D ADD IX,DE       ;
 $8C6F PUSH IX         ;
 $8C71 CALL $72D4      ;
 $8C74 RET             ; }

; TAKE OUT OF
;
; The containers' handler for TAKE X OUT OF Y (the goblins' cache, the cupboard, the chest and the boat). The target must actually be inside the container
; (#R$9BD3 checks the holder chain), or 'the X is not in the Y.' Then it is taken like anything else (the rest of #R$8CC8, reached at $8CD1).
c$8C75 LD A,($B5D9)  ; A = the target of the current command
 $8C78 LD HL,$B5DA   ; HL = the address holding the instrument (the container we are meant to take it out of)
 $8C7B CALL $9BD3    ; Is the target actually inside that container? (reuses the tail of #R$9BCD, comparing against whatever holder number sits at HL)
 $8C7E LD HL,$AEA8   ; "the X is not in the Y."
 $8C81 JP NZ,$72D4   ; If it is not inside, say so and stop
 $8C84 JR $8CD1      ; Otherwise take it just like an ordinary TAKE (joins the rest of #R$8CC8)

; Can the actor lift the target?
;
; Checks the weights for TAKE and CARRY. Byte 3 of an object record is its weight. The target's weight, plus the weight of everything it contains (#R$9C42),
; must not exceed the actor's lifting capacity (byte 3 of the actor's record), or 'the X is too heavy to lift.' And the actor's capacity minus what they are
; already carrying minus the new load must not go negative, or 'you are carrying too much.' Doors and other multi-place objects (#R$91B0), and objects fixed in
; place, cannot be taken at all.
c$8C86 LD IX,($B5F8)  ; IX = the target's record
 $8C8A LD A,($B5D9)   ; {A = the weight of everything in the target...
 $8C8D CALL $9C42     ; }
 $8C90 ADD A,(IX+$03) ; {...plus its own weight
 $8C93 JR NC,$8C97    ; }
 $8C95 LD A,$FF       ; (capped at 255)
*$8C97 LD B,A         ; B = the total
 $8C98 LD IY,($B5FC)  ; IY = the actor's record
 $8C9C LD A,(IY+$03)  ; A = how much the actor can lift
 $8C9F SUB B          ; Can it lift the load?
 $8CA0 LD HL,$ACF7    ; "the X is too heavy to lift."
 $8CA3 JR C,$8CB5     ; {No: say so
 $8CA5 PUSH AF        ; }
 $8CA6 LD A,($B5DB)   ; {Subtract what the actor is already carrying
 $8CA9 CALL $9C42     ;
 $8CAC LD B,A         ;
 $8CAD POP AF         ;
 $8CAE SUB B          ; }
 $8CAF JP P,$8CBA     ; Still not negative: it can be taken
 $8CB2 LD HL,$ACFF    ; "you are carrying too much."
*$8CB5 EX (SP),HL     ; {Print the message instead of returning...
 $8CB6 POP HL         ; }
 $8CB7 JP $72D4       ; ...and stop the action
; This entry point is used by the routines at #R$91B9 and #R$9392.
*$8CBA CALL $91B0     ; Is the target an ordinary object?
 $8CBD JR NZ,$8CC4    ; No (a door, say): it cannot be taken
 $8CBF BIT 1,(IX+$07) ; {Objects with bit 1 set ("evaporates") can be taken; others...
 $8CC3 RET Z          ;
*$8CC4 POP HL         ; }
 $8CC5 JP $9EBF       ; ...(this path) cannot: report failure

; TAKE and CARRY
;
; If the actor already has the target: 'you are already carrying the X.' Otherwise, after the weight checks (#R$8C86), the actor becomes the object's holder
; (byte 1 of its record). Taking the rope also takes anything tied to it.
c$8CC8 CALL $9BCD    ; Is the actor already holding the target?
 $8CCB LD HL,$AD04   ; "you are already carrying the X."
 $8CCE JP C,$72D4    ; Yes: say so
; This entry point is used by the routine at #R$8C75.
*$8CD1 CALL $8C86    ; Check the weights
 $8CD4 CALL $9C99    ; Dry run? Then stop: it would work
 $8CD7 LD A,($B5DB)  ; {The actor becomes the target's holder
 $8CDA LD (IX+$01),A ; }
 $8CDD LD A,(IX+$01) ; {Was it the rope (object 18)?
 $8CE0 CP $12        ; }
 $8CE2 RET NZ        ; No: done
 $8CE3 LD A,($B5DB)  ; {Yes: whatever is tied to the rope goes with it
 $8CE6 LD ($C256),A  ;
 $8CE9 RET           ; }

; Points for visiting rooms
;
; Room number and points (a word, in tenths of a percent) for #R$8D19, which adds them to the score the first time Bilbo enters the room. Terminated by $FF.
; .
; #TABLE(default)
; { =h Room | =h Points }
; { 4 lonelands | 2.5% }
; { 7 trolls' cave | 5% }
; { 11 narrow place | 2.5% }
; { 22 Beorn's house | 2.5% }
; { 13 goblins' dungeon | 7.5% }
; { 65 dark stuffy passage | 5% }
; { 27 smothering forest | 2.5% }
; { 28 levelled elvish clearing | 2.5% }
; { 31 dark dungeon | 5% }
; { 34 long lake | 10% }
; { 38 dale valley | 2.5% }
; { 42 side door | 2.5% }
; { 43 smooth straight passage | 5% }
; { 41 lower halls | 20% }
; TABLE#
; .
; Together they are worth 75%, and nothing else in the game adds to the score, so 75.0% is the most anyone can achieve. Being captured and thrown into a dungeon
; counts as a visit, so both dungeons score.
b$8CEA DEFB $04,$19,$00
 $8CED DEFB $07,$32,$00
 $8CF0 DEFB $0B,$19,$00
 $8CF3 DEFB $16,$19,$00
 $8CF6 DEFB $0D,$4B,$00
 $8CF9 DEFB $41,$32,$00
 $8CFC DEFB $1B,$19,$00
 $8CFF DEFB $1C,$19,$00
 $8D02 DEFB $1F,$32,$00
 $8D05 DEFB $22,$64,$00
 $8D08 DEFB $26,$19,$00
 $8D0B DEFB $2A,$19,$00
 $8D0E DEFB $2B,$32,$00
 $8D11 DEFB $29,$C8,$00
 $8D14 DEFB $FF         ; End marker

; Move variables
;
; $8D15: the destination room's record. $8D17: the destination room. $8D18: the size of the actor plus its load.
b$8D15 DEFB $06,$D8  ; Room record
 $8D17 DEFB $FD      ; Destination room
 $8D18 DEFB $CB      ; Size

; Move an actor (GO north, EAST, etc.)
;
; Moves the current actor one step in the direction given by the action number (1-10: north, south, east, west, northeast, northwest, southeast, southwest, up,
; down). Used for the player's movement commands and for every character that moves.
; .
; IN THE DARK, Bilbo does not know which way he is going: the direction is replaced by a random one ($8D1E). And if there is no exit that way, instead of 'you
; cannot go that way' he stumbles: his strength is halved, and he reads 'but fall and hit your head.', or, once his strength has dropped to nothing, 'but fall
; and smash your skull.' and dies.
; .
; A character being carried by another character (for example Bilbo carried by someone) is set down first. The size of the actor plus everything it carries is
; worked out ($8D18). The exit must exist; if it has a door, the door must be open (or broken); Bilbo cannot use a door with bit 7 of its attributes set; and
; the actor must be no bigger than the door ('the window is too small for you to enter'). If the destination room has a capacity, there must be room ('the boat
; is too full for you to enter').
; .
; Then the actor's location becomes the destination and everything it carries moves with it (#R$9B38). If the actor is Bilbo, the room-entry handler for the
; destination is run (#R$C67D), and the room is described. The first time Bilbo enters a room, bit 6 of the room's flags is set, the room is described in full
; (#R$958E), and if the room is in the scoring table at #R$8CEA its points are added to the score. On later visits the short description is used (#R$9606).
c$8D19 CALL $954D      ; Is Bilbo in the dark?
 $8D1C JR NC,$8D27     ; No: go on with the direction he chose
 $8D1E LD A,$09        ; In the dark: pick a random direction from 1 to 10 instead...
 $8D20 CALL $9BF4      ; A = a random number from 0 to A
 $8D23 INC A           ; Increment A
 $8D24 LD ($B5D8),A    ; ...and make it the action
; This entry point is used by the routines at #R$8EA0 and #R$A1FD.
*$8D27 LD IY,($B5FC)   ; IY = the actor's record
 $8D2B LD A,(IY+$01)   ; Is the actor being held by something?
 $8D2E CP $FF          ; Is it nobody ($FF)?
 $8D30 JR Z,$8D3F      ; No: skip
 $8D32 CALL $9B25      ; IX = the holder's record
 $8D35 BIT 6,(IX+$07)  ; Is the holder a living character (bit 6)?
 $8D39 JR Z,$8D55      ; No (a box or barrel): the actor cannot just walk off
 $8D3B LD (IY+$01),$FF ; Yes: the actor gets down from the character carrying it
*$8D3F LD A,($B5DB)    ; Work out the size of the actor plus everything it carries...
 $8D42 CALL $9C3D      ; Call: Total size of an object's contents (#R$9C3D)
 $8D45 ADD A,(IY+$02)  ; ...plus its own size
 $8D48 LD ($8D18),A    ; ...and keep it for the door and room checks
 $8D4B LD A,($B5D8)    ; A = the direction
 $8D4E CALL $9E51      ; IX = the exit that way, if there is one
 $8D51 CP $FF          ; Is there one?
 $8D53 JR NZ,$8D76     ; Yes: go and check it
*$8D55 CALL $954D      ; No exit (or it cannot be used): is Bilbo in the dark?
 $8D58 JP NC,$9EBF     ; No: just report the failure ("you cannot go that way")
 $8D5B CALL $9C99      ; Dry run? Then stop here
 $8D5E LD IX,$C00B     ; IX = Bilbo's record
 $8D62 AND A           ; Clear the carry flag
 $8D63 LD HL,$AC71     ; "but fall and hit your head."
 $8D66 RR (IX+$05)     ; Halve Bilbo's strength
 $8D6A JP NZ,$72D4     ; If he has any left, print the message and return
 $8D6D LD HL,$AC7E     ; Otherwise: "but fall and smash your skull."
 $8D70 CALL $72D4      ; Print it
 $8D73 JP $903C        ; Bilbo is dead
*$8D76 LD A,(IX+$02)   ; A = the exit's destination room
 $8D79 AND A           ; Is there one?
 $8D7A JR Z,$8D55      ; No: the exit cannot be used
 $8D7C LD ($8D17),A    ; Save the destination room number
 $8D7F LD A,(IX+$01)   ; A = the exit's door, if any
 $8D82 AND A           ; Is there a door?
 $8D83 JR Z,$8DA4      ; No door: go on to the destination room
 $8D85 CALL $9B25      ; IX = the door's record
 $8D88 LD A,(IX+$07)   ; A = the door's flags
 $8D8B AND $28         ; Is it open (bit 5) or broken (bit 3)?
 $8D8D JR Z,$8D55      ; No: the door is in the way
 $8D8F LD A,($B5DB)    ; Is the actor Bilbo?
 $8D92 AND A           ; Is A zero?
 $8D93 JR NZ,$8D9B     ; No: skip the next check
 $8D95 BIT 7,(IX+$04)  ; Bit 7 of the door's attributes: a way Bilbo cannot use
 $8D99 JR NZ,$8D55     ; Set: he cannot go this way
*$8D9B LD A,($8D18)    ; A = the size of the actor and its load
 $8D9E LD B,(IX+$02)   ; B = the size of the door
 $8DA1 SUB B           ; Compare them
 $8DA2 JR NC,$8E1C     ; Too big: "the X is too small for you to enter"
*$8DA4 LD A,($8D17)    ; A = the destination room
 $8DA7 LD B,A          ; Keep it in B
 $8DA8 CALL $9B0C      ; IX = its room record
 $8DAB LD ($8D15),IX   ; Keep that for later
 $8DAF LD A,$FF        ; Does the room have a capacity ($FF = unlimited)?
 $8DB1 CP (IX+$01)     ; Compare with the byte at (IX+$01)
 $8DB4 JR Z,$8DC1      ; Unlimited: go ahead
 $8DB6 LD A,B          ; A = the destination room
 $8DB7 CALL $9B96      ; A = the space left in it
 $8DBA LD C,A          ; Keep it in C
 $8DBB LD A,($8D18)    ; A = the size of the actor and its load
 $8DBE SUB C           ; Compare them
 $8DBF JR NC,$8E21     ; Too big: "the X is too full for you to enter"
; This entry point is used by the routine at #R$9B38.
*$8DC1 CALL $9C99      ; Dry run? Then stop here: the move would work
 $8DC4 LD (IY+$10),B   ; Move the actor: its location becomes the destination
 $8DC7 LD A,($B5DB)    ; {Move everything the actor holds with it
 $8DCA CALL $9B38      ; }
 $8DCD LD A,($B5DB)    ; {Is the actor Bilbo?
 $8DD0 CP $00          ; }
 $8DD2 RET NZ          ; No: a character has moved, and that is all
 $8DD3 LD IX,$C67D     ; {Look up the destination in the room-entry handlers
 $8DD7 LD A,($8D17)    ;
 $8DDA CALL $9D12      ; }
 $8DDD JR Z,$8DE8      ; None: skip
 $8DDF LD L,(IX+$01)   ; {HL = the handler...
 $8DE2 LD H,(IX+$02)   ; }
 $8DE5 CALL $9AC7      ; ...and run it
; This entry point is used by the routine at #R$C6D9.
*$8DE8 CALL $954D      ; Is Bilbo now in the dark?
 $8DEB RET C           ; Yes: he sees nothing, so describe nothing
 $8DEC LD A,($B5DB)    ; {Is the actor Bilbo?
 $8DEF AND A           ; }
 $8DF0 LD A,($8D17)    ; A = the room
 $8DF3 JR NZ,$8E19     ; No: describe it anyway (entry for other callers)
 $8DF5 LD HL,($8D15)   ; HL = the room record
 $8DF8 BIT 6,(HL)      ; Has Bilbo been here before (bit 6 of the room's flags)?
 $8DFA JP NZ,$9606     ; Yes: give the short description
 $8DFD SET 6,(HL)      ; No: mark the room as visited
 $8DFF PUSH AF         ; Save the room number
 $8E00 LD IX,$8CEA     ; {Look the room up in the scoring table
 $8E04 CALL $9D12      ; }
 $8E07 JR Z,$8E18      ; {Not there: no points
 $8E09 PUSH DE         ; }
 $8E0A LD E,(IX+$01)   ; {DE = the points for this room
 $8E0D LD D,(IX+$02)   ; }
 $8E10 LD HL,($B5E8)   ; {Add them to the score
 $8E13 ADD HL,DE       ;
 $8E14 LD ($B5E8),HL   ;
 $8E17 POP DE          ; }
*$8E18 POP AF          ; Restore the room number
*$8E19 JP $958E        ; Describe the room in full
*$8E1C LD HL,$AD16     ; {"<the door> is too small for you to enter"
 $8E1F JR $8E28        ; }
*$8E21 LD IX,($8D15)   ; IX = the destination room record
 $8E25 LD HL,$AD21     ; {"<the room> is too full for you to enter"
*$8E28 PUSH HL         ; }
 $8E29 LD L,(IX+$02)   ; Push the room's (or door's) words as the message parameter
 $8E2C LD H,(IX+$03)   ; {H = (IX+3)
 $8E2F EX (SP),HL      ; }
 $8E30 CALL $72D4      ; Print the message
 $8E33 RET             ; Done

; Is an object shut inside something?
;
; Follows the holders of object A upwards while they are open. Returns with Z set if it reaches a loose object (so the object is out in the open) and Z reset if
; it meets a closed container.
c$8E34 PUSH IX        ; Save IX
 $8E36 CALL $9B25     ; IX = object A's own record
*$8E39 LD A,(IX+$01)  ; A = whoever is holding it
 $8E3C CP $FF         ; {Held by nobody at all: it is out in the open
 $8E3E JR Z,$8E4B     ; }
 $8E40 CALL $9B25     ; Held by something: IX = that holder's own record
 $8E43 BIT 5,(IX+$07) ; Is the holder open?
 $8E47 JR NZ,$8E39    ; Yes: look inside IT in turn (and see who holds that)
 $8E49 OR $01         ; No (shut away): make A non-zero
*$8E4B POP IX         ; {Restore IX
 $8E4D RET            ; }

; LOOK THROUGH (a door or window)
;
; The LOOK THROUGH handler of every door (and, via #R$A678, the window). The door must be open (otherwise 'the door is closed'), and the actor must not be shut
; inside anything. Then it continues as #R$8E5A.
c$8E4E LD A,($B5D9)  ; A = the target (the door or window)
 $8E51 CALL $9B25    ; IX = its own record
 $8E54 CALL $A4C3    ; Is it open?
 $8E57 JP Z,$A09C    ; No: say so and stop ("the door is closed.")

; LOOK ACROSS (a river)
;
; Finds the exit that passes through the target (#R$9E6E). If it leads anywhere, and the room on the other side is lit, the actor is moved there for a moment,
; the room is described ('you see ...', #R$9589), and the actor is put back. If the far side is dark: 'it is dark.' This is how you can see what is on the other
; bank of the river, or behind a door, without going there.
c$8E5A LD A,($B5DB)   ; A = the current actor
 $8E5D CALL $8E34     ; Is the actor shut inside something (rather than free to look around)?
 $8E60 RET NZ         ; Yes: cannot look through anything from in there
 $8E61 CALL $9E6E     ; {Find the exit that passes through the target (the door, window or river)
 $8E64 CP $FF         ; }
 $8E66 JP Z,$9EBF     ; No such exit: fail with the usual message
 $8E69 LD A,(IX+$02)  ; {A = where that exit leads
 $8E6C CP $00         ; }
 $8E6E JP Z,$9EBF     ; Leads nowhere: fail
 $8E71 CALL $9C99     ; Dry run? Then stop here: it would work
 $8E74 PUSH IX        ; Save the exit
 $8E76 CALL $9B0C     ; IX = the room on the far side
 $8E79 BIT 7,(IX+$00) ; Is it lit?
 $8E7D POP IX         ; Restore the exit
 $8E7F JR Z,$8E97     ; Dark over there: "it is dark." (below)
 $8E81 LD IY,($B5FC)  ; IY = the actor's own record
 $8E85 LD A,(IY+$10)  ; {Save the actor's TRUE room for a moment...
 $8E88 PUSH AF        ; }
 $8E89 LD A,(IX+$02)  ; {...and pretend, just for a moment, that they are on the far side
 $8E8C LD (IY+$10),A  ; }
 $8E8F CALL $9589     ; Describe what can be seen from there ("you see ...")
 $8E92 POP AF         ; {Put the actor back in their real room
 $8E93 LD (IY+$10),A  ;
 $8E96 RET            ; }
*$8E97 LD HL,$AD12    ; {"it is dark."
 $8E9A JP $72D4       ; }

; GO THROUGH (a door, window or river)
;
; Finds the exit through the target (#R$9E6E) and goes through it (#R$8EA0). The GO THROUGH handler of every door, the spider web and the portcullis.
c$8E9D CALL $9E6E    ; Find the exit that passes through the target, then fall into #R$8EA0 to use it

; Go through an exit
;
; Moves the actor through the exit at IX (see the room records at #R$B97A): byte 0 the direction, byte 1 a door or other obstacle, byte 2 the destination. Exits
; with no destination cannot be used. If the exit has a door, the door must be open (bit 5 of its flags). The direction is then used as the action number and
; the move is made by #R$8D19 (at $8D27). If the exit cannot be used, #R$9EBF reports it.
;
; Input:IX Exit
;       A $FF if there is no exit
c$8EA0 CP $FF         ; Is there no such exit at all?
 $8EA2 JP Z,$9EBF     ; Fail with the usual message
 $8EA5 LD A,(IX+$02)  ; {A = where the exit leads
 $8EA8 CP $00         ; }
 $8EAA JP Z,$9EBF     ; Leads nowhere: fail
 $8EAD LD A,(IX+$01)  ; {Does the exit have a door?
 $8EB0 CP $00         ; }
 $8EB2 JR Z,$8EC2     ; No: go straight ahead
 $8EB4 PUSH IX        ; Yes: save the exit
 $8EB6 CALL $9B25     ; IX = the door's own record
 $8EB9 BIT 5,(IX+$07) ; Is it open?
 $8EBD POP IX         ; Restore the exit
 $8EBF JP Z,$9EBF     ; Closed: fail ("you cannot go that way")
*$8EC2 CALL $9C99     ; Dry run? Then stop here: it would work
 $8EC5 LD A,(IX+$00)  ; {A = the exit's own direction, used as the movement action
 $8EC8 LD ($B5D8),A   ; }
 $8ECB LD A,$FF       ; {No specific target - just moving in this direction
 $8ECD LD ($B5D9),A   ; }
 $8ED0 JP $8D27       ; Carry out the move (joining the ordinary movement routine partway through)

; FILL WITH
;
; The barrel's FILL handler. The instrument must be something that pours (bit 1 of its flags: water and wine, for example) and the target must not already be
; full ('the barrel is full'). The work is done by PUT IN (#R$91B9) with target and instrument swapped (#R$9E93), so FILL THE BARREL WITH WATER is really PUT
; THE WATER IN THE BARREL.
; .
; Filling from a river is a special case: if the instrument is object 23 or 24 (the river's water or black water), a fresh object 21 or 22 ('water', 'black
; water') is used instead, so the river never runs dry.
c$8ED3 LD IX,($B5F8)   ; IX = the target's own record (the container being filled)
 $8ED7 LD A,($B5DA)    ; {Is the instrument the fast river's water, or the enchanted river's black water?
 $8EDA CP $17          ; }
 $8EDC JR Z,$8EFC      ; {Ordinary river water: go and use a fresh copy of it, below
 $8EDE CP $18          ; }
 $8EE0 JR Z,$8F04      ; Black water: likewise
*$8EE2 LD IY,($B5FA)   ; Anything else: IY = the instrument's own record
 $8EE6 BIT 1,(IY+$07)  ; Does it actually pour (is it a liquid)?
 $8EEA JP Z,$9EBF      ; No: fail with the usual message
 $8EED BIT 2,(IX+$07)  ; Is the container already full?
 $8EF1 LD A,$82        ; A = the state code for FULL
 $8EF3 JP NZ,$A09C     ; Yes: say so and stop
 $8EF6 LD HL,$91B9     ; No: do the work as an ordinary PUT IN...
 $8EF9 JP $9E93        ; ...with target and instrument swapped, so "fill X with Y" becomes "put Y in X"
*$8EFC LD A,$15        ; Ordinary river water: A = a FRESH water object
 $8EFE LD IY,$C343     ; {IY = its own record
 $8F02 JR $8F0A        ; }
*$8F04 LD A,$16        ; {Black water: A = a fresh black-water object instead
 $8F06 LD IY,$C358     ; }
*$8F0A LD ($B5DA),A    ; {That fresh object becomes the instrument
 $8F0D LD ($B5FA),IY   ; }
 $8F11 LD (IY+$01),$FF ; It starts out held by nobody...
 $8F15 JR $8EE2        ; ...then join the ordinary FILL code above (so the river itself never runs dry)

; RUN
;
; Running means going in a random direction. A random number from 1 to 9 is chosen (#R$9BF4), and the exits of the room are tried from that direction onwards,
; cycling round, until one with a destination is found (#R$9E51); the actor then moves that way (#R$8D19).
c$8F17 LD A,$0A      ; {Pick a random direction from 1 to 10
 $8F19 CALL $9BF4    ;
 $8F1C CP $00        ; }
 $8F1E JR Z,$8F17    ; (0 is not a real direction: try again)
*$8F20 LD B,A        ; B = that direction
 $8F21 CALL $9E51    ; {Is there a usable exit that way?
 $8F24 CP B          ; }
 $8F25 JR Z,$8F31    ; Yes: run that way
 $8F27 LD A,B        ; {No: try the next direction round instead...
 $8F28 INC A         ;
 $8F29 CP $0A        ;
 $8F2B JR C,$8F20    ; }
 $8F2D LD A,$01      ; {...wrapping back to 1 after 10
 $8F2F JR $8F20      ; }
*$8F31 LD ($B5D8),A  ; That direction becomes the movement action
 $8F34 JP $8D19      ; Move that way

; ENTER and GO INTO
;
; Finds the exit of the current room that leads to the room named as the target (#R$9E76) and goes through it (#R$8EA0), so 'go into the tunnel' works without
; naming a direction.
c$8F37 LD A,($B5D9)  ; A = the target (the room named, e.g. "the tunnel")
 $8F3A CALL $9E76    ; Find the exit that leads there
 $8F3D JP $8EA0      ; Go through it

; FOLLOW
;
; If the character being followed is in the same room, nothing happens: 'I cannot follow X from here.' Otherwise the actor looks for an exit from the current
; room that leads straight to the room the character is in (#R$9E76) and takes it (#R$8EA0). So you can only follow someone who has just left by a direct exit.
c$8F40 LD IX,($B5FC) ; IX = the actor's own record
 $8F44 LD B,(IX+$10) ; B = the actor's own room
 $8F47 LD IX,($B5F8) ; IX = the target character's own record
 $8F4B LD A,(IX+$10) ; {Is the target actually in the same room as the actor?
 $8F4E CP B          ; }
 $8F4F JR Z,$8F59    ; Yes: there is nowhere to follow them to (below)
 $8F51 CALL $9E76    ; {No: find the exit that leads straight to where they are
 $8F54 CP $FF        ; }
 $8F56 JP NZ,$8EA0   ; Found one: go through it
*$8F59 LD HL,$AEDB   ; {No direct exit (or they are right here): "I cannot follow X from here."
 $8F5C JP $72D4      ; }

; THROW AT
;
; The default handler for THROW X AT Y. After checking that the actor can lift the thing thrown (#R$8C86), it becomes an attack: if the target is alive, the
; fight routine (#R$90DB, ATTACK) is used, otherwise the breaking routine (#R$9257, STRIKE), in both cases with the thrown object as the weapon (#R$9E93).
; Afterwards the thrown object lands at the target's feet (its holder is cleared) and the target reacts as if attacked (#R$953F).
c$8F5F CALL $8C86      ; Can the actor actually lift the thing being thrown (the target)?
 $8F62 LD HL,$90DB     ; {Assume the thing being thrown AT is alive: HL = the fight routine, action 15 (ATTACK)
 $8F65 LD A,$0F        ; }
 $8F67 LD IX,($B5FA)   ; IX = the record of whatever is being thrown at (currently the "instrument", via AT)
 $8F6B BIT 6,(IX+$07)  ; Is it actually alive?
 $8F6F JR NZ,$8F76     ; Yes: keep the fight routine
 $8F71 LD HL,$9257     ; {No (e.g. a window): HL = the breaking routine instead, action 11 (STRIKE)
 $8F74 LD A,$0B        ; }
*$8F76 LD ($B5D8),A    ; This becomes the action to carry out
 $8F79 CALL $9E93      ; Run it with target and instrument swapped, so the thing thrown AT becomes the new target, and the thing thrown becomes the weapon
 $8F7C LD A,$2A        ; {Restore the action number to THROW AT itself, for the rest of the turn
 $8F7E LD ($B5D8),A    ; }
 $8F81 LD A,($B5EB)    ; {Did this really happen (not just a trial)?
 $8F84 CP $01          ; }
 $8F86 RET NZ          ; Only a trial: nothing more to do
 $8F87 LD IX,($B5F8)   ; It really happened: IX = the thrown object's own record
 $8F8B LD (IX+$01),$FF ; It falls to the ground, held by nobody
 $8F8F LD A,$0F        ; {Let whatever it hit react as if attacked
 $8F91 LD ($B5D8),A    ;
 $8F94 LD A,($B5D9)    ;
 $8F97 JP $953F        ; }
 $8F9A LD (IX+$01),$FF ; (unreachable leftover code)

; TALK TO and SAY TO
;
; Hands the orders collected from a quotation (#R$80CD) to the character being spoken to (#R$88A7). Something that is not a character cannot take orders.
; .
; Whether the character obeys depends on byte 6 of its entry in #R$C9BA. A value of 0 means it always obeys. Otherwise a random number from 0 up to that value
; is picked (#R$9BF4), and 0 means it says "no". Because of the way the random numbers are skewed (#R$9BFD), the chance of a refusal goes DOWN as the value goes
; up: 1 gives a refusal half the time, 3 a quarter of the time, and 5 or 6 one time in eight. So the value is really a measure of willingness rather than
; stubbornness: the trolls, the wood elf and the butler (1) are the most contrary, Gollum and Bard (3) refuse one order in four, Gandalf, Elrond and Thorin (5
; and 6) one in eight - and the goblins, the warg and the dragon (0) never refuse at all.
c$8F9E CALL $9C99    ; Dry run? Then stop: talking always works
 $8FA1 LD A,($B5D9)  ; {Is the person spoken to a character?
 $8FA4 CALL $99E0    ;
 $8FA7 CP $FF        ; }
 $8FA9 LD A,$00      ; (A = 0: no orders to hand over)
 $8FAB JR Z,$8FC2    ; No: the orders are thrown away
 $8FAD LD A,($B5EA)  ; {Is Gollum waiting for his answer?
 $8FB0 CP $00        ; }
 $8FB2 JR NZ,$8FC2   ; Yes: the words go to him, no refusal
 $8FB4 LD A,(IY+$06) ; {A = the character's stubbornness
 $8FB7 CP $00        ; }
 $8FB9 JR Z,$8FC2    ; 0: always obeys
 $8FBB CALL $9BF4    ; {Otherwise pick a random number from 0 up to the stubbornness
 $8FBE CP $00        ; }
 $8FC0 JR Z,$8FC6    ; 0: refuses
*$8FC2 CALL $88A7    ; {Hand over the orders (A of them)
 $8FC5 RET           ; }
*$8FC6 LD HL,$B0D5   ; {"<character> says "no"."
 $8FC9 CALL $72D4    ; }
 $8FCC SUB A         ; {No orders
 $8FCD JR $8FC2      ; }

; DIG (the sand)
;
; The sand's DIG handler: digging opens it (#R$9081), revealing anything buried in it; digging again closes it.
c$8FCF CALL $9C99     ; Dry run? Then stop here: it would work
 $8FD2 LD IX,($B5F8)  ; IX = the sand's own record
 $8FD6 BIT 5,(IX+$07) ; Is it already open (dug)?
 $8FDA JP Z,$9081     ; No: open it, as if by OPEN (revealing whatever is buried)
 $8FDD JP $90AF       ; Yes: close it again instead (covering things back up)

; SHOOT
;
; The shooter must be carrying the bow (object 25): otherwise 'you are not carrying the bow.' Then, if it would work, it is treated as an attack.
; .
; Anyone except Bard: the dragon cannot be hit at all ('the arrow misses the dragon by a wide margin'), and anyone else is missed if a random number from 0 to 8
; (#R$9BF4) is below 3.
; .
; Bard (object 70) never misses. On a hit the arrow (object 26) is left lying where it fell, 'the arrow hits X.', and a living target is killed outright
; (#R$96DD); anything else is broken (#R$9257).
; .
; So the only way to kill the dragon is to get Bard to shoot it - which is what the HELP message in the lower halls means by 'look to bard'.
c$8FE0 LD A,$19        ; {Is the actor holding the bow (object 25)?
 $8FE2 CALL $9BD0      ; }
 $8FE5 LD HL,$B013     ; "you are not carrying the bow."
 $8FE8 JP NC,$72D4     ; If not, say so and stop
 $8FEB CALL $90B4      ; Check the target is something that can be attacked at all
 $8FEE CALL $9C99      ; Dry run? Then stop here: it would work
 $8FF1 LD A,$0F        ; {Treat this as an ordinary attack from now on
 $8FF3 LD ($B5D8),A    ; }
 $8FF6 LD A,($B5DB)    ; {Is the actor Bard himself?
 $8FF9 CP $46          ; }
 $8FFB JR Z,$9012      ; Yes: Bard never misses - skip the ordinary chance-to-miss below
 $8FFD LD A,($B5D9)    ; {No: is the target the dragon?
 $9000 CP $3C          ; }
 $9002 LD HL,$B019     ; "the arrow misses the dragon by a wide margin."
 $9005 JP Z,$72D4      ; Against the dragon, anyone but Bard always misses
 $9008 LD A,$08        ; {Anyone else: pick a random number from 0 to 8
 $900A CALL $9BF4      ; }
 $900D CP $03          ; Below 3?
 $900F JP C,$72D4      ; Yes: the shot misses (HL still holds the "misses" message)
*$9012 LD IX,$C3D9     ; IX = the arrow's own record
 $9016 LD A,($B5D9)    ; {Is the target the strong arrow itself (an odd edge case)?
 $9019 CP $1A          ;
 $901B JR Z,$9021      ; }
 $901D LD (IX+$01),$FF ; Otherwise the arrow falls to the ground, held by nobody
*$9021 LD HL,$B028     ; {"the arrow hits X."
 $9024 CALL $72D4      ; }
 $9027 LD IX,($B5F8)   ; IX = the target's own record
 $902B CALL $A0F8      ; Is the target actually alive?
 $902E JP NZ,$9257     ; No: break it instead (STRIKE)
 $9031 LD A,($B5D9)    ; {Yes: kill it outright
 $9034 CALL $96DD      ; }
 $9037 LD A,$06        ; A = the state code for DEAD
 $9039 JP $A09C        ; "the X is dead."

; The player is dead
;
; Called whenever Bilbo is killed (for example by Thorin at the end of the fight in #R$90DB, or by the stinging thing in #R$AA2E). Prints 'you are dead' and the
; score ('you have mastered 0.0% of this adventure') from the message at #R$AEE3 and #R$81AD, waits for a key, and restarts the game at #R$6C27 with everything
; restored from the backups.
c$903C SUB A         ; {The actor is Bilbo again
 $903D LD ($B5DB),A  ; }
 $9040 LD HL,$AEE3   ; {"you are dead."
 $9043 CALL $72D4    ; }
 $9046 CALL $81AD    ; Print the score
; This entry point is used by the routine at #R$A8CA.
*$9049 XOR A         ; {Wait for a key
 $904A IN A,($FE)    ;
 $904C AND $1F       ;
 $904E CP $1F        ;
 $9050 JR Z,$9049    ; }
 $9052 JP $6C27      ; Restart the game

; INVENTORY
;
; Prints 'you are carrying.' and then either '      nothing' or a list of the objects held by the actor (#R$9EF8), using #R$9CEC to count them first.
c$9055 CALL $9C99    ; Dry run? Then stop here: it always works
 $9058 LD HL,$ACE9   ; {"you are carrying."
 $905B CALL $72D4    ; }
 $905E LD A,($B5DB)  ; A = the current actor
 $9061 CALL $9CEC    ; {Are they carrying anything visible at all?
 $9064 AND A         ; }
 $9065 LD HL,$B22D   ; "      nothing"
 $9068 JP Z,$72D4    ; If not, say so
 $906B LD A,($B5DB)  ; Otherwise: A = the actor again
 $906E LD IX,($B5FC) ; {B = the actor's own room
 $9072 LD B,(IX+$10) ; }
 $9075 JP $9EF8      ; List everything they hold

; OPEN
;
; Checks that the target is not locked or already open (#R$A129; if it is, #R$A09C says so, e.g. 'the door is locked'). Then sets bit 5 (open) of its flags. If
; the target is an ordinary object (a container rather than a door) and has something in it, the contents are listed (#R$9EF8) unless the actor is in the dark
; (#R$9F89).
c$9078 CALL $A129     ; Is the target locked, or already open?
 $907B JP NZ,$A09C    ; If either, explain why it cannot be opened ("the door is locked."/"the chest is open.")
 $907E CALL $9C99     ; Dry run? Then stop here: it would work
; This entry point is used by the routines at #R$8FCF and #R$A28E.
*$9081 SET 5,(IX+$07) ; Open it
 $9085 LD A,(IX+$00)  ; {Is the target an ordinary, single-place object (not a door, which needs no further reply)?
 $9088 DEC A          ; }
 $9089 RET NZ         ; A door: nothing more to say
 $908A LD A,($B5D9)   ; {An ordinary container: does it hold anything visible?
 $908D CALL $9CEC     ;
 $9090 AND A          ; }
 $9091 RET Z          ; Nothing inside: nothing more to say
 $9092 LD A,($B5D9)   ; {Something inside: print the heading for it ("in the chest there is")
 $9095 CALL $9F89     ; }
 $9098 RET C          ; Nothing worth listing after all: stop
 $9099 LD B,(IX+$10)  ; B = the target's own room
 $909C LD A,($B5D9)   ; {List everything it holds
 $909F JP $9EF8       ; }

; CLOSE
;
; Checks the target is open (#R$A4C3; otherwise 'the X is closed'), then clears bit 5 of its flags.
c$90A2 LD IX,($B5F8)  ; IX = the target's own record
 $90A6 CALL $A4C3     ; Is it open?
 $90A9 JP Z,$A09C     ; No, already closed: say so
 $90AC CALL $9C99     ; Dry run? Then stop here: it would work
; This entry point is used by the routine at #R$8FCF.
*$90AF RES 5,(IX+$07) ; {Close it
 $90B3 RET            ; }

; Check that a target may be attacked (sides)
;
; Characters on the same side do not fight each other. The target's side bits (4-6 of byte 4 of its record) are compared with the attacker's; if they have any
; in common, the attack is quietly ruled out: the 'would work' flag is cleared and the attack routine's caller is abandoned.
; .
; But the player is allowed to attack a friend. When Bilbo is the attacker and the target is on his side (bit 4), that bit is cleared in the target's record
; first - permanently. So hitting Thorin or Gandalf takes them off Bilbo's side for the rest of the game, which is what lets them fight back (and, since no one
; is on the same side any more, lets other characters attack them too).
c$90B4 LD IX,($B5F8)  ; IX = the target's record
 $90B8 LD A,($B5DB)   ; {Is the attacker Bilbo?
 $90BB AND A          ; }
 $90BC JR NZ,$90C8    ; No: just compare sides
 $90BE BIT 4,(IX+$04) ; Is the target on Bilbo's side (bit 4)?
 $90C2 JR Z,$90C8     ; No
 $90C4 RES 4,(IX+$04) ; Yes: it is not any more - for good
*$90C8 LD A,(IX+$04)  ; {A = the target's side bits...
 $90CB AND $70        ; }
 $90CD LD IX,($B5FC)  ; IX = the attacker's record
 $90D1 AND (IX+$04)   ; ...in common with the attacker's?
 $90D4 RET Z          ; None: the attack may go ahead
 $90D5 POP HL         ; Same side: drop the caller's return address...
 $90D6 XOR A          ; {...and record that the attack would not work
 $90D7 LD ($B5EC),A   ;
 $90DA RET            ; }

; Attack (HIT, KILL, ATTACK, STRIKE, SMASH ...)
;
; The fight routine. It is used both when the player attacks someone and when another character attacks (for example Thorin retaliating, or the trolls and
; goblins attacking Bilbo). The attacker's object record is pointed to by $B5FC, the target's by $B5F8, and the weapon's (if any) by $B5FA; $B5DA holds the
; weapon's object number, or $FF when there is none.
; .
; It uses two bytes of the 8-byte object header (see #R$C00B): byte 5 is STRENGTH and byte 6 is DEFENCE. Some starting values: Bilbo 64/64, Thorin 104/120,
; Gandalf 112/136, the trolls 160/160, the goblins 72/96, Bard 96/96, the dragon 192/192, and the short strong sword has strength 64 (255 in my modified tape).
; .
; Step 1: 'you attack thorin' is printed ($90FE onwards), naming the weapon if one was used.
; .
; Step 2: the attack value is the attacker's strength ($90F9), plus the weapon's strength if one was used ($9102-$9116), capped at 255. A weapon is only
; accepted if byte 0 of its record is 1 (an ordinary one-place object); otherwise the message at #R$AE52 is printed.
; .
; Step 3: the attack value is randomised by #R$917D (roughly -10 to +10) and so is the target's defence ($9121-$912A).
; .
; Step 4: if the randomised defence is greater than or equal to the attack, the blow does nothing: 'but the effort is wasted. his defense is too strong'
; (#R$AE43).
; .
; Step 5: if the attack exceeds the defence by more than 16, the blow is fatal. The message at #R$AD2D ('with one well placed blow you cleave his skull') is
; printed and bit 3 of the target's flag byte (byte 7) is set, marking it dead ($9168).
; .
; Step 6: otherwise the target is wounded. The difference d (1-16) selects a message from the table at #R$9190 - the larger the margin the nastier the
; description. The code then tries to reduce the target's strength by d/2+1 and its defence by d/4+1 ($914E-$9164), skipping either reduction if it would go
; below 0. It computes d/2 and d/4 with RRCA (rotate right) rather than SRL (shift right), though.
; .
; BUG: RRCA moves the bit shifted out of the bottom back into the top, so the halving only works when the bit being shifted out is 0. With Thorin (strength 104,
; defence 120) the actual results are: margins 4, 8, 12 and 16 reduce both strength and defence as intended (for example margin 8 takes him to 99/117); margins
; 2, 6, 10 and 14 reduce strength only; margins 3, 7, 11 and 15 do nothing at all; and margins 1, 5, 9 and 13 leave strength alone but slash his defence by
; about 65, to 52-55, which makes the next blow very likely to kill him.
; .
; BUG: the table at #R$9190 only has useful entries for differences 1 to 15. A difference of exactly 16 reads the two bytes at $91B0 (which are code, $DD $2A)
; as a message address, so the game interprets ROM at $2ADD as a message and prints garbage.
c$90DB CALL $90B4     ; Check the target is something that can be attacked
 $90DE LD A,($B5DA)   ; Was a weapon named?
 $90E1 LD HL,$026F    ; {HL = the word used when there is no weapon
 $90E4 CP $FF         ; }
 $90E6 JR Z,$90F2     ; No weapon: skip
 $90E8 LD IX,($B5FA)  ; IX = the weapon's record
 $90EC LD L,(IX+$08)  ; {HL = the weapon's noun (e.g. SWORD)
 $90EF LD H,(IX+$09)  ; }
*$90F2 LD ($B5ED),HL  ; Keep it for the report ("...with the sword")
 $90F5 LD IX,($B5FC)  ; IX = the attacker's record
 $90F9 LD B,(IX+$05)  ; B = the attacker's strength
 $90FC LD A,($B5DA)   ; Is there a weapon?
 $90FF INC A          ; ($FF + 1 = 0)
 $9100 JR Z,$9119     ; No: attack with strength alone
 $9102 LD IY,($B5FA)  ; IY = the weapon's record
 $9106 LD A,(IY+$00)  ; {Is it an ordinary object (one place)?
 $9109 DEC A          ; }
 $910A LD HL,$AE52    ; "you cannot kill with the X"
 $910D JP NZ,$72D4    ; No: say so and stop
 $9110 LD A,(IY+$05)  ; A = the weapon's strength
 $9113 ADD A,B        ; Add the attacker's strength
 $9114 JR NC,$9118    ; No overflow: fine
 $9116 LD A,$FF       ; Overflow: cap it at 255
*$9118 LD B,A         ; {B = the attack value
*$9119 LD A,B         ; }
 $911A CALL $917D     ; {Randomise the attack value by about +/-10
 $911D LD B,A         ; }
 $911E CALL $9C99     ; Dry run? Then stop here: the attack would happen
 $9121 LD IX,($B5F8)  ; IX = the target's record
 $9125 LD A,(IX+$06)  ; A = the target's defence
 $9128 CALL $917D     ; Randomise it too
 $912B CP B           ; Is the defence at least as big as the attack?
 $912C LD HL,$AE43    ; "but the effort is wasted. his defense is too strong."
 $912F JP NC,$72D4    ; Yes: the blow does nothing
 $9132 LD C,A         ; C = the defence
 $9133 ADD A,$10      ; {Defence + 16...
 $9135 JR NC,$9139    ; }
 $9137 LD A,$FF       ; (capped at 255)
*$9139 CP B           ; ...less than the attack?
 $913A JR C,$9168     ; Yes: a fatal blow
 $913C LD A,B         ; {A wound. A = the margin (attack - defence, 1-16)
 $913D SUB C          ; }
 $913E RLCA           ; {Double it to index the wound messages
 $913F LD E,A         ;
 $9140 LD D,$00       ; }
 $9142 LD IY,$9190    ; {IY = the wound message table
 $9146 ADD IY,DE      ; }
 $9148 LD L,(IY+$00)  ; {HL = the message for this margin (a margin of 16 runs off the end of the table)
 $914B LD H,(IY+$01)  ; }
 $914E RRCA           ; {Halve the doubled margin twice with RRCA: margin/2, but with bit 0 rotated into bit 7 (see the bug note)
 $914F RRCA           ; }
 $9150 LD B,A         ; B = the "half" margin
 $9151 CPL            ; A = 255 - B
 $9152 ADD A,(IX+$05) ; Add the target's strength: carry only if strength > B
 $9155 JR NC,$915A    ; It would go negative: leave it alone
 $9157 LD (IX+$05),A  ; Otherwise strength = strength - B - 1
*$915A LD A,B         ; A = the "half" margin again
 $915B RRCA           ; Halve it again (RRCA again)
 $915C CPL            ; A = 255 - that
 $915D ADD A,(IX+$06) ; Add the target's defence
 $9160 JR NC,$9165    ; It would go negative: leave it
 $9162 LD (IX+$06),A  ; Otherwise defence = defence - (margin/4) - 1
*$9165 JP $72D4       ; Print the wound message
*$9168 LD HL,$AD2D    ; {"with one well placed blow <actor> cleaves <his/your> skull."
 $916B CALL $72D4     ; }
 $916E SET 3,(IX+$07) ; Mark the target dead
 $9172 LD A,($B5D9)   ; A = the target
 $9175 CALL $96DD     ; Kill it: drop its things, remove it from the character table
 $9178 LD A,$06       ; {Then report "<target> is dead."
 $917A JP $A09C       ; }

; Randomise a fight value
;
; Adds a random amount to the value in B, using #R$9BFD with a range of 10, and returns the result in A, clamped to 0-255.
; .
; The random amount C is a signed number between -10 and +10, but it is heavily biased towards positive values: only about 1 in 25 adjustments is negative, and
; +1 to +5 are twice as likely as +6 to +10 (see #R$9BFD).
; .
; BUG: the clamping is wrong for negative adjustments. After ADD A,B the code treats the carry flag as 'overflow'. When C is negative (say -3, which is $FD) and
; B is at least 3, the addition B+$FD always produces a carry, even though the true result (B-3) is perfectly valid. The code then sees that C is negative and
; returns 0 instead of B-3. So whenever the adjustment is negative, the value collapses to 0. When this happens to a defence value, the next blow is almost
; certainly fatal; when it happens to an attack value, the blow is wasted. This bug is the reason a bare-handed Bilbo occasionally kills Thorin, and one reason
; for the game's famous sudden deaths.
;
;  Input:B Value to randomise
; Output:A Randomised value (0-255)
c$917D PUSH BC       ;
 $917E LD B,A        ; B = the value to randomise
 $917F LD A,$0A      ; {A random number from -10 to +10...
 $9181 CALL $9BFD    ; }
 $9184 LD C,A        ; ...in C
 $9185 ADD A,B       ; A = value + random number
 $9186 JR NC,$918E   ; No carry: that is the answer
 $9188 XOR A         ; Carry: assume it overflowed; A = 0...
 $9189 BIT 7,C       ; ...is the random number negative?
 $918B JR NZ,$918E   ; Yes: return 0. (But adding a negative number always sets the carry, so every negative adjustment gives 0: the bug)
 $918D DEC A         ; {Positive: the value really overflowed, so return 255
*$918E POP BC        ;
 $918F RET           ; }

; Wound messages
;
; Addresses of the messages printed when a blow wounds but does not kill, indexed by twice the margin by which the attack beat the defence (see #R$90DB). Entry
; 0 is never used (a margin of 0 means the blow was wasted). The small margins give the mildest messages and the larger margins the most violent ones, such as
; 'you hit thorin hard on the shoulder - thorin staggers and almost falls'.
; .
; The table has 16 entries ($9190-$91AF), but the margin can be 16, which reads past the end into the code at $91B0 (see the bug note in #R$90DB).
w$9190 DEFW $AE2F    ; {Messages for margins 0-15
 $9192 DEFW $AE1E    ;
 $9194 DEFW $AE13    ;
 $9196 DEFW $AE08    ;
 $9198 DEFW $ADFC    ;
 $919A DEFW $ADE7    ;
 $919C DEFW $ADD5    ;
 $919E DEFW $ADC4    ;
 $91A0 DEFW $ADAD    ;
 $91A2 DEFW $AD9F    ;
 $91A4 DEFW $AD8B    ;
 $91A6 DEFW $AD7E    ;
 $91A8 DEFW $AD6D    ;
 $91AA DEFW $AD63    ;
 $91AC DEFW $AD4D    ;
 $91AE DEFW $AD3C    ; }

; Is the target an ordinary object?
;
; Returns with Z set if byte 0 of the target's record is 1: an object in one place. Doors and other things that exist in two places have 2.
;
; Output:F Z set if the target is an ordinary object
c$91B0 LD IX,($B5F8) ; IX = the target's own record
 $91B4 LD A,(IX+$00) ; {Does it occupy just one place (rather than two, like a door)?
 $91B7 DEC A         ; }
 $91B8 RET           ; Z reflects the answer

; PUT IN, PUT ON and DROP IN
;
; The handler for putting the target into (or on) a container, the instrument. The target must be something that can be picked up (#R$8CBA), and not already in
; the container ('I cannot do that'). Except for PUT ON, the container must be open ('the chest is closed'). There must be room: the container's size (byte 2),
; minus the target's size, minus the size of what is already inside (#R$9C3D), must be positive ('the chest is too full'). Then the target takes the container's
; location and the container becomes its holder.
c$91B9 CALL $8CBA     ; Is the target something that can even be picked up at all?
 $91BC LD A,($B5DA)   ; {Is the instrument (the container) actually the same object as the target's own holder already?
 $91BF CP (IX+$01)    ; }
 $91C2 JP Z,$72C5     ; Yes: "I cannot do that." (it's already there)
 $91C5 LD IY,($B5FA)  ; IY = the instrument's (the container's) own record
 $91C9 LD A,($B5D8)   ; {Is this actually PUT ON (action 18), rather than PUT IN or DROP IN?
 $91CC CP $12         ; }
 $91CE JR Z,$91D6     ; PUT ON: no need for the container to be open
 $91D0 BIT 5,(IY+$07) ; PUT IN or DROP IN: is the container open?
 $91D4 JR Z,$9201     ; No: say so and stop, below
*$91D6 LD A,(IY+$02)  ; A = the container's own capacity (its size)
 $91D9 SUB (IX+$02)   ; Subtract the target's own size
 $91DC JR C,$91E8     ; Already too big even on its own: fail, below
 $91DE PUSH AF        ; Save what is left
 $91DF LD A,($B5DA)   ; {A = how much the container already holds
 $91E2 CALL $9C3D     ;
 $91E5 LD B,A         ; }
 $91E6 POP AF         ; {Subtract that too
 $91E7 SUB B          ; }
*$91E8 LD HL,$AD0D    ; "the X is too full."
 $91EB JP C,$72D4     ; Not enough room at all: say so and stop
 $91EE JP Z,$72D4     ; Exactly full, with no room to spare: likewise
 $91F1 CALL $9C99     ; Dry run? Then stop here: it would work
 $91F4 LD A,(IY+$10)  ; {The target moves to the container's own room...
 $91F7 LD (IX+$10),A  ; }
 $91FA LD A,($B5DA)   ; {...and the container becomes its new holder
 $91FD LD (IX+$01),A  ;
 $9200 RET            ; }
*$9201 LD A,$05       ; A = the state code for OPEN/CLOSED
 $9203 JP $A094       ; "the X is closed."

; EAT and DRINK
;
; Eating food makes the actor stronger: 10 is added to their strength (byte 5 of their record). If the target is inside a container (for example a drink in a
; bottle), the container's 'full' flag (bit 2) is cleared and the actor gains only 1. The food or drink then vanishes: its holder is set to $FF and all its
; locations to 0.
; .
; But there is a limit. If the new strength would be 128 or more, the game prints 'his foul gluttony has killed him' ('your foul gluttony has killed you' for
; Bilbo), and the actor dies (#R$96DD). Bilbo starts with strength 64, so the seventh helping of food is fatal.
c$9206 CALL $9C99      ; Dry run? Then stop here: eating and drinking always work
 $9209 LD IX,($B5F8)   ; IX = the food or drink's own record
 $920D LD A,(IX+$01)   ; {Is it lying loose, or inside something (a bottle, say)?
 $9210 CP $FF          ; }
 $9212 JR Z,$921F      ; Loose: skip the container step below
 $9214 CALL $9B25      ; Inside something: IX = that container's own record
 $9217 RES 2,(IX+$07)  ; It is no longer full
 $921B LD A,$01        ; {Drinking from a container only gives 1 point of strength
 $921D JR $9224        ; }
; This entry point is used by the routine at #R$A842.
*$921F CALL $9C99      ; (Reached only when the action is genuinely happening, so this always passes straight through)
 $9222 LD A,$0A        ; Eating or drinking on its own gives 10 points of strength
*$9224 LD IX,($B5FC)   ; IX = the actor's own record
 $9228 ADD A,(IX+$05)  ; Add the gain to the actor's current strength
 $922B CP $80          ; Would that take strength to 128 or more?
 $922D JR NC,$9246     ; Yes: the meal proves fatal (see below)
 $922F LD (IX+$05),A   ; No: store the new, higher strength
 $9232 LD IX,($B5F8)   ; IX = the food or drink's own record
 $9236 LD (IX+$01),$FF ; It is held by nobody now...
 $923A LD B,(IX+$00)   ; ...B = how many locations it has (normally 1)...
*$923D LD (IX+$10),$00 ; {...and each of those locations becomes 0: it has vanished entirely
 $9241 INC IX          ;
 $9243 DJNZ $923D      ;
 $9245 RET             ; }
*$9246 LD HL,$B038     ; {"your foul gluttony has killed you."
 $9249 CALL $72D4      ; }
 $924C LD A,($B5DB)    ; A = the actor
 $924F JP $96DD        ; The actor dies

; "The X is broken"
;
; Reports that the target is broken (#R$A094 with state $83).
c$9252 LD A,$83      ; A = the state code for BROKEN
 $9254 JP $A094      ; "the X is broken."

; STRIKE (break something)
;
; Breaking things - STRIKE, BREAK and SMASH, and THROW at something that is not alive. Things that pour cannot be broken, and nor can anything with a defence of
; 0. If there is an instrument, it must have some strength and must itself have a STRIKE handler (so you can smash a door with the sword but not with the
; lunch).
; .
; The force is the instrument's strength plus the actor's strength plus a random number from -21 to +21 (#R$9BFD), capped at 255. If that is at least the
; target's defence, the target breaks: it is marked broken, its adjective becomes BROKEN (#R$A0BC), its strength is halved, and if it is a container its
; contents fall out. 'the door is broken.'
; .
; Then the instrument may break too, whether or not the target did: its defence plus a random number from -21 to +21 is compared with the target's defence, and
; if it is at least as large the instrument breaks. As written, this makes a tougher instrument more likely to break. Worse, the addition has the same
; carry-flag mistake as the fight code (#R$917D): a negative random number sets the carry, which is taken as an overflow, and the value becomes 255 - so the
; instrument breaks whenever the random number is negative. In 40 test runs in the emulator of BREAK DOOR WITH SWORD against the heavy rock door, the sword
; broke 9 times; with the bow, whose defence of 16 could never reach the door's 144 honestly, the bow still broke 5 times.
c$9257 LD IX,($B5F8)  ; IX = the target's record
 $925B BIT 1,(IX+$07) ; Is the object "evaporates" (bit 1 of its flags)?
 $925F JP NZ,$9EBF    ; If the bit is set, go to Report failure (#R$9EBF)
 $9262 BIT 3,(IX+$07) ; Is the object dead/broken (bit 3 of its flags)?
 $9266 JP NZ,$9303    ; If the bit is set, go to #R$9303
 $9269 SUB A          ; A = 0
 $926A CP (IX+$06)    ; Compare with the byte at (IX+$06)
 $926D JP Z,$9EBF     ; If yes, go to Report failure (#R$9EBF)
 $9270 LD B,A         ; B = A
 $9271 LD A,($B5DA)   ; A = the instrument
 $9274 INC A          ; (sets Z if A was $FF: none)
 $9275 JR Z,$9296     ; If it is zero, go to #R$9296
 $9277 LD IY,($B5FA)  ; IY = the instrument's record
 $927B LD A,(IY+$05)  ; A = the object's strength
 $927E AND A          ; Is A zero?
 $927F JP Z,$9EBF     ; If it is zero, go to Report failure (#R$9EBF)
 $9282 PUSH IX        ; Save IX
 $9284 LD IX,($B5FA)  ; IX = the instrument's record
 $9288 LD A,$0B       ; A = 11
 $928A CALL $9ADC     ; Call: Find an object's handler for an action (#R$9ADC)
 $928D POP IX         ; Restore IX
 $928F INC A          ; Increment A
 $9290 JP Z,$9EBF     ; If the routine returned with Z set, go to Report failure (#R$9EBF)
 $9293 LD B,(IY+$05)  ; B = the object's strength
*$9296 CALL $9C99     ; Dry run? Then just record that this would work, and return from the caller
 $9299 LD A,$15       ; A = 21
 $929B CALL $9BFD     ; Call: Random number in a range (#R$9BFD)
 $929E ADD A,B        ; Add A,B
 $929F LD IY,($B5FC)  ; IY = the actor's record
 $92A3 ADD A,(IY+$05) ; Add the object's strength
 $92A6 JR NC,$92AA    ; If the routine returned with carry reset, go to #R$92AA
 $92A8 LD A,$FF       ; A = 255
*$92AA SUB (IX+$06)   ; Subtract the object's defence
 $92AD JR C,$92CA     ; If carry is set, go to #R$92CA
 $92AF SET 3,(IX+$07) ; Set the object's "dead/broken" flag (bit 3)
 $92B3 LD A,($B5D9)   ; A = the target
 $92B6 CALL $A0BC     ; Call: Mark an object as dead or broken (#R$A0BC)
 $92B9 SRA (IX+$05)   ; Shift/rotate (IX+$05)
 $92BD LD A,(IX+$04)  ; How are the target's contents described?
 $92C0 CP $02         ; In (0) or on (1)?
 $92C2 CALL C,$9CA5   ; Then they fall out of the broken container
 $92C5 LD A,$83       ; A = 131
 $92C7 CALL $A09C     ; Call: "The X is Y" (#R$A09C)
*$92CA LD A,($B5DA)   ; A = the instrument
 $92CD CP $FF         ; Is it nobody ($FF)?
 $92CF RET Z          ; Return if yes
 $92D0 LD IY,($B5FA)  ; IY = the instrument's record
 $92D4 BIT 3,(IY+$07) ; Is the object dead/broken (bit 3 of its flags)?
 $92D8 RET NZ         ; Return if the bit is set
 $92D9 LD B,(IY+$06)  ; B = the object's defence
 $92DC LD A,$15       ; A = 21
 $92DE CALL $9BFD     ; Call: Random number in a range (#R$9BFD)
 $92E1 ADD A,B        ; Add A,B
 $92E2 JR NC,$92E6    ; If the routine returned with carry reset, go to #R$92E6
 $92E4 LD A,$FF       ; A = 255
*$92E6 SUB (IX+$06)   ; Subtract the object's defence
 $92E9 RET C          ; Return if carry is set
 $92EA SET 3,(IY+$07) ; Set the object's "dead/broken" flag (bit 3)
 $92EE LD A,($B5DA)   ; A = the instrument
 $92F1 CALL $A0BC     ; Call: Mark an object as dead or broken (#R$A0BC)
 $92F4 LD A,(IY+$05)  ; A = the object's strength
 $92F7 SRA A          ; Shift/rotate A
 $92F9 LD (IY+$05),A  ; Set the object's strength to A
 $92FC CALL $9CA5     ; Call: Drop everything the target holds (#R$9CA5)
 $92FF PUSH IY        ; Save IY
 $9301 POP IX         ; Restore IX
*$9303 LD A,$83       ; A = 131
 $9305 JP $A09C       ; Finish by jumping to "The X is Y" (#R$A09C)

; GIVE TO
;
; The actor must be carrying the target (#R$9BCD; otherwise 'you are not carrying it'). The receiver must be able to carry it: the target's weight plus what the
; receiver already carries (#R$9C42) must not exceed the receiver's capacity, or 'X is carrying too much'. Then the receiver becomes the target's holder, the
; target moves to the receiver's room, and #R$9B38 tells anyone who sees it.
c$9308 LD IY,($B5FA)  ; IY = the instrument's (the receiver's) own record
 $930C CALL $9BCD     ; Is the actor actually holding the target?
 $930F LD HL,$ACE4    ; "you are not carrying it."
 $9312 JP NC,$72D4    ; If not, say so and stop
 $9315 LD A,($B5DA)   ; A = the receiver
 $9318 CALL $9C42     ; A = how much the receiver is already carrying
 $931B LD IX,($B5F8)  ; IX = the target's own record
 $931F ADD A,(IX+$03) ; Add the target's own weight to that
 $9322 PUSH AF        ; {Keep the combined total for a moment
 $9323 POP BC         ; }
 $9324 LD A,(IY+$03)  ; A = the receiver's own carrying capacity
 $9327 SUB B          ; Subtract the combined total: would that go below zero?
 $9328 LD HL,$ACFF    ; "X is carrying too much."
 $932B JP C,$72D4     ; Too much for them to take: say so and stop
 $932E CALL $9C99     ; Dry run? Then stop here: it would work
 $9331 LD A,($B5DA)   ; {The receiver becomes the target's new holder...
 $9334 LD (IX+$01),A  ; }
 $9337 LD A,(IY+$10)  ; {...in the receiver's own room
 $933A LD (IX+$10),A  ; }
 $933D LD B,A         ; B = that room
 $933E LD A,($B5D9)   ; {Move the target there, telling Bilbo about it if he can see it
 $9341 JP $9B38       ; }

; EXAMINE
;
; If the object has a description message, it is printed. The address of that message is stored in the object's fourth word slot (bytes 14 and 15 of its
; record), which is not needed for words when the object has only one or two adjectives. Otherwise the game just says 'you see the X.'
c$9344 CALL $9C99    ; Dry run? Then stop here: EXAMINE always works
 $9347 LD A,($B5D9)  ; A = the target
 $934A CALL $9B25    ; IX = its own record
 $934D LD L,(IX+$0E) ; {HL = its own description, if it has one written specially for it
 $9350 LD H,(IX+$0F) ; }
 $9353 LD A,H        ; {Is there actually a description there?
 $9354 OR L          ; }
 $9355 JP NZ,$72D4   ; Yes: print it, and that is the whole answer
 $9358 LD HL,$AEF2   ; {No description: "you see"
 $935B CALL $72D4    ; }
 $935E PUSH IX       ; {IY = the target's own record
 $9360 POP IY        ; }
 $9362 CALL $9E10    ; Print its name
 $9365 LD A,$2E      ; {A full stop...
 $9367 CALL $7580    ; }
 $936A CALL $7578    ; {...then a new line
 $936D RET           ; }

; EMPTY
;
; The barrel's EMPTY handler. It must be open ('the barrel is closed') and have something in it ('the barrel is empty'). Its contents are tipped out where it
; stands (#R$9CA5) and it is no longer full.
c$936E LD IX,($B5F8)  ; IX = the target's own record
 $9372 CALL $A4C3     ; Is it open?
 $9375 JP Z,$A09C     ; No: "the X is closed."
 $9378 LD A,($B5D9)   ; A = the target
 $937B CALL $9CEC     ; {Does it hold anything visible?
 $937E CP $00         ; }
 $9380 JR Z,$938D     ; No: it is already empty, below
 $9382 CALL $9C99     ; Dry run? Then stop here: it would work
 $9385 CALL $9CA5     ; Tip everything it holds out, into its own place
 $9388 RES 2,(IX+$07) ; {It is no longer full
 $938C RET            ; }
*$938D LD A,$02       ; A = the state code for FULL/EMPTY
 $938F JP $A09C       ; "the X is empty."

; PUT or DROP something in the river
;
; The rivers' PUT IN and DROP IN handler. The river is an object in two places, one on each bank. The thing dropped in is carried to the location on the other
; side from the actor ('... and it gets swept away'); if the actor is on the river's second bank, the thing goes to location 0, and is lost.
c$9392 CALL $8CBA      ; Is the target something that can even be picked up?
 $9395 CALL $9C99      ; Dry run? Then stop here: it would work
 $9398 LD A,($B5E7)    ; A = the room the actor started this turn in (one bank of the river)
 $939B LD IX,($B5FA)   ; IX = the river's own record (which has two locations, one on each bank)
 $939F LD B,(IX+$00)   ; B = how many locations it has
*$93A2 CP (IX+$10)     ; {Is the actor's bank the FIRST of them?
 $93A5 JR Z,$93AE      ; }
 $93A7 INC IX          ; {No: try the next location
 $93A9 DJNZ $93A2      ; }
 $93AB JP $72C5        ; Neither bank matches (should not happen): "I cannot do that."
*$93AE LD A,(IX+$11)   ; A = the OTHER bank (the one after this location)
 $93B1 DEC B           ; {Was this actually the last location?
 $93B2 JR NZ,$93B5     ; }
 $93B4 XOR A           ; If so, there is no far bank: it is simply lost (room 0)
*$93B5 LD IX,($B5F8)   ; IX = the target's own record
 $93B9 LD (IX+$10),A   ; It moves to the far bank...
 $93BC LD (IX+$01),$FF ; ...held by nobody
 $93C0 LD B,A          ; B = that room
 $93C1 LD A,($B5D9)    ; {Move it there, and report it if Bilbo can see
 $93C4 CALL $9B38      ; }
 $93C7 LD HL,$ACEF     ; {"...and it gets swept away."
 $93CA JP $72D4        ; }

; LOCK
;
; The target must be closed and not already locked (#R$A129). The instrument must not be broken (bit 3 of its flags) or 'the key is broken'. Then bit 0 (locked)
; of the target's flags is set.
; .
; LOCK and UNLOCK share their last instructions: this routine writes $C6 into $93EB, turning the instruction at $93E8 into SET 0,(IX+$07); #R$93ED writes $86
; there, turning it into RES 0,(IX+$07).
c$93CD CALL $A129     ; Is the target already locked, or not even closed?
 $93D0 JP NZ,$A09C    ; If either, say why it cannot be locked
 $93D3 LD A,$C6       ; A = $C6, the machine-code for a SET instruction
; This entry point is used by the routine at #R$93ED.
*$93D5 LD ($93EB),A   ; Poke that into the instruction at $93EB below, so that from now on it locks rather than unlocks - this and #R$93ED share their final
                      ; steps by rewriting each other
 $93D8 LD IY,($B5FA)  ; IY = the instrument's (the key's) own record
 $93DC BIT 3,(IY+$07) ; Is the key broken?
 $93E0 LD A,$83       ; A = the state code for BROKEN
 $93E2 JP NZ,$A094    ; If it is broken, say so and stop
 $93E5 CALL $9C99     ; Dry run? Then stop here: it would work
 $93E8 SET 0,(IX+$07) ; {Lock the target (this very byte is what #R$93ED rewrites to RES, to unlock instead)
 $93EC RET            ; }

; UNLOCK
;
; The target must be locked (bit 0 of its flags) or 'the door is unlocked'; the instrument must fit (#R$A134). Then the RES instruction is written into #R$93CD
; and the lock is cleared there.
c$93ED LD IX,($B5F8)  ; IX = the target's own record
 $93F1 BIT 0,(IX+$07) ; Is it actually locked?
 $93F5 LD A,$00       ; A = the state code for UNLOCKED
 $93F7 JP Z,$A09C     ; No, already unlocked: say so
 $93FA CALL $A134     ; Locked: does the key fit (is the door open enough to check)?
 $93FD JP NZ,$A09C    ; No: say why not
 $9400 LD A,$86       ; A = $86, the machine-code for a RES instruction
 $9402 JR $93D5       ; Poke that into the shared instruction, then join #R$93CD, which finishes the job by clearing the lock

; THROW ... ACROSS / THROUGH
;
; The actor must be carrying the target. The instrument (the thing thrown across or through, such as a river or a window) must be one of the exits of the room
; (#R$9E71), and if it is a door it must be open ('the window is closed'). The target is then dropped and moved to the room on the other side, and #R$9B38
; reports it.
c$9404 CALL $8C3A      ; Is the actor holding the target?
 $9407 LD A,($B5DA)    ; A = the instrument (the river, window or similar being thrown across or through)
 $940A CALL $9E71      ; {Find the room's exit that passes through it
 $940D CP $FF          ; }
 $940F JP Z,$9EBF      ; No such exit exists: fail with the usual "you cannot go that way"-style message
 $9412 LD IY,($B5FA)   ; IY = the instrument's own record
 $9416 BIT 5,(IY+$07)  ; Is it open (or is that even required)?
 $941A LD A,$05        ; A = the state code for OPEN/CLOSED
 $941C JP Z,$A094      ; Closed: say so and stop
 $941F CALL $9C99      ; Dry run? Then stop here: it would work
 $9422 LD B,(IX+$02)   ; B = this exit's destination room
 $9425 LD IX,($B5F8)   ; IX = the target's own record
 $9429 LD (IX+$01),$FF ; It is held by nobody now...
 $942D LD (IX+$10),B   ; ...and lands in the room on the far side
 $9430 LD A,($B5D9)    ; {Move it there, telling Bilbo about it if he can see it
 $9433 JP $9B38        ; }

; Could the action apply to this target?
;
; Used while choosing between candidate objects (#R$86ED). Sets $B5EC to 1 if the action could possibly apply to the target: either there is a default handler
; for the action (#R$C61F), or the target itself has a handler for it (#R$9ADC). The checks in #R$A100 are also applied. Sets $B5EC to 0 if the action is not
; possible at all, for example when the target is the actor.
c$9436 PUSH IX       ; {Save the caller's IX and HL
 $9438 PUSH HL       ; }
 $9439 CALL $9A9F    ; Does the action even make sense (not done to yourself, for instance)?
 $943C LD A,$00      ; Assume not
 $943E JR Z,$9468    ; It does not: record that and stop
 $9440 LD A,($B5D8)  ; A = the action being tried
 $9443 LD IX,$C61F   ; {Is there a default handler for it (one that applies to any object)?
 $9447 CALL $9D12    ; }
 $944A CP $FF        ; (A is left holding either the action, if found, or $FF if there is no default handler)
 $944C LD A,$01      ; Assume it could apply
 $944E JR NZ,$9468   ; A default handler exists: that settles it
 $9450 CALL $A100    ; No default handler: is this one of the actions that uses the instrument's own handlers rather than the target's?
 $9453 LD A,$01      ; Assume it could apply
 $9455 JR Z,$9468    ; Yes: accept it for now (the instrument itself gets checked properly later)
 $9457 LD A,($B5D9)  ; {No: does the TARGET itself carry a handler for this action?
 $945A CALL $9B25    ;
 $945D LD A,($B5D8)  ;
 $9460 CALL $9ADC    ; }
 $9463 LD A,$01      ; Assume it could apply
 $9465 JR C,$9468    ; It does (found): that settles it
 $9467 SUB A         ; No handler anywhere: it could not apply after all
*$9468 LD ($B5EC),A  ; Record the answer
 $946B POP HL        ; {Restore the caller's HL and IX
 $946C POP IX        ;
 $946E RET           ; }

; Carry out the action
;
; Performs the current action ($B5D8) with the current target ($B5D9) and instrument ($B5DA). During a dry run ($B5EB = 0) nothing is printed or changed, and
; the routines report success in $B5EC instead.
; .
; First the basic checks: the action must make sense (#R$9A9F: you cannot, for instance, give something to yourself; if it fails, 'I cannot do that.'). If it is
; dark (#R$954D) and the action needs light, 'I see nothing.' unless the objects are being carried. The records of the target and instrument are found and saved
; in $B5F8 and $B5FA, and each must be within reach (#R$9686).
; .
; Then the handlers are found. If the target (or, for certain actions listed at #R$A13B, the instrument) has handlers of its own for this action (#R$9ADC), they
; are called one after another: the matching entry and any entries with action 0 straight after it. Otherwise the default handler for the action is looked up in
; #R$C61F. If there is none, 'I cannot do that.'
; .
; Finally, if the action really happened and the player did it in the dark, the darkness message is printed, and #R$953F gives any character involved as target
; or instrument a chance to react (#R$99FB).
c$946F PUSH HL       ;
 $9470 PUSH IX       ;
 $9472 PUSH BC       ;
 $9473 CALL $9A9F    ; Does the action make sense (not done to yourself, and so on)?
 $9476 JP Z,$953A    ; No: "I cannot do that."
 $9479 CALL $954D    ; Is it too dark for Bilbo to see?
 $947C JR NC,$9499   ; No: carry on
 $947E LD A,($B601)  ; {Dark. Can this action be done in the dark anyway?
 $9481 AND A         ; }
 $9482 JR NZ,$9491   ; No: "I see nothing"
 $9484 CALL $9BCD    ; Is the target something Bilbo is holding?
 $9487 JR NC,$9491   ; No: "I see nothing"
 $9489 LD A,($B5DA)  ; {Is the instrument something he is holding?
 $948C CALL $9BD0    ; }
 $948F JR C,$9499    ; Yes: he can manage by touch
*$9491 LD HL,$AEB7   ; {"I see nothing."
 $9494 CALL $72D4    ;
 $9497 JR $94FB      ; }
*$9499 LD A,($B5EF)  ; {Is the target a room?
 $949C CP $01        ; }
 $949E JP Z,$952C    ; Yes: straight to the default handler
 $94A1 LD A,($B5D9)  ; {Is there a target?
 $94A4 CP $FF        ; }
 $94A6 JP Z,$952C    ; No: straight to the default handler
 $94A9 CALL $9B25    ; IX = the target's record...
 $94AC LD ($B5F8),IX ; ...which is saved for the handlers
 $94B0 LD A,($B5D9)  ; {Is it within the player's reach?
 $94B3 CALL $9686    ; }
 $94B6 JR NZ,$94FB   ; No: stop (the reason has been printed)
 $94B8 LD A,($B5DA)  ; {Is there an instrument?
 $94BB CP $FF        ; }
 $94BD JR Z,$94DA    ; No: use the target's handlers
 $94BF LD A,($B5F0)  ; {Is the instrument a room?
 $94C2 CP $01        ; }
 $94C4 JR Z,$952C    ; Yes: default handler
 $94C6 LD A,($B5DA)  ; {IX = the instrument's record...
 $94C9 CALL $9B25    ; }
 $94CC LD ($B5FA),IX ; ...saved for the handlers
 $94D0 CALL $9686    ; Is it within reach?
 $94D3 JR NZ,$94FB   ; No: stop
 $94D5 CALL $A100    ; Is this one of the actions the instrument handles (PUT IN, TAKE OUT OF...)?
 $94D8 JR Z,$94DE    ; Yes: use the instrument's handlers (IX is still its record)
*$94DA LD IX,($B5F8) ; Otherwise use the target's
*$94DE LD A,($B5D8)  ; A = the action
 $94E1 CALL $9ADC    ; Does the object have its own handler for it?
 $94E4 JR NC,$952C   ; No: use the default handler
*$94E6 LD L,(IX+$01) ; {HL = the handler...
 $94E9 LD H,(IX+$02) ; }
 $94EC CALL $9AC7    ; ...run it
 $94EF INC IX        ; {Next entry in the list
 $94F1 INC IX        ;
 $94F3 INC IX        ; }
 $94F5 SUB A         ; {Is it action 0 (a chained handler)?
 $94F6 CP (IX+$00)   ; }
 $94F9 JR Z,$94E6    ; Yes: run that too
*$94FB LD A,($B5EB)  ; {Did the action really happen?
 $94FE CP $01        ; }
 $9500 JR NZ,$9527   ; No: done
 $9502 LD A,($B5DB)  ; {Was it the player?
 $9505 CP $00        ; }
 $9507 JR NZ,$950F   ; No: skip
 $9509 CALL $954D    ; {If the player is in the dark, add "it is dark."
 $950C CALL C,$72D4  ; }
*$950F LD A,($B5D8)  ; {B = the action
 $9512 LD B,A        ; }
 $9513 LD A,($B5D9)  ; {Let the target react (a character that was attacked, say)
 $9516 LD IX,($B5F8) ;
 $951A CALL $953F    ; }
 $951D LD A,($B5DA)  ; {Let the instrument react too
 $9520 LD IX,($B5FA) ;
 $9524 CALL $953F    ;
*$9527 POP BC        ;
 $9528 POP IX        ;
 $952A POP HL        ;
 $952B RET           ; }
*$952C LD A,($B5D8)  ; {DEFAULT HANDLER: look the action up in #R$C61F
 $952F LD IX,$C61F   ;
 $9533 CALL $9D12    ; }
 $9536 CP $FF        ; Found?
 $9538 JR NZ,$94E6   ; Yes: run it
*$953A CALL $72C5    ; {No: "I cannot do that."
 $953D JR $9527      ; }

; Let a character react to what was done to it
;
; If the object at IX is a living character (bit 6 of its flags set, bit 3 clear), #R$99FB is called with the action number in B, which may switch the character
; to a new behaviour (for example, to fight back when attacked).
;
; Input:IX Object record
;       B Action number
c$953F BIT 6,(IX+$07) ; Is the object at IX a living character?
 $9543 RET Z          ; No: nothing reacts
 $9544 BIT 3,(IX+$07) ; Is it already dead?
 $9548 RET NZ         ; Yes: the dead do not react either
 $9549 CALL $99FB     ; {Give it a chance to switch its behaviour in response to what was just done to it
 $954C RET            ; }

; Is it too dark for Bilbo to see?
;
; Returns with the carry flag set (and HL pointing at the message 'it is dark.') if the player is acting and cannot see. Characters are never affected: they can
; always see.
; .
; Bilbo can see if he is inside something (#R$9DC8) or if his room is lit (bit 7 of the first byte of its record). Otherwise he can only see if the short strong
; sword (object 14, record at #R$C00B + $1E9 = $C1F4) is with him (#R$9D86) and its flags have bit 2 set, bit 3 (broken) clear and bit 4 ('on') set. In other
; words, the sword is the game's only lamp: it glows, as Sting does in the book. The sword starts with these bits set, so carrying it lights up every dark
; place.
;
; Output:F Carry set if it is too dark
;        HL "it is dark."
c$954D LD A,($B5DB)   ; {Is the current actor Bilbo?
 $9550 AND A          ; }
 $9551 RET NZ         ; No (a character): they can always see - return with no carry
 $9552 PUSH IX        ; {Yes: save IX and BC
 $9554 PUSH BC        ; }
 $9555 LD IX,$C00B    ; IX = Bilbo's own record
 $9559 CALL $9DC8     ; Is he shut inside something closed, or out in the open (or inside something open)?
 $955C INC A          ; ($FF, "loose", becomes 0 here)
 $955D JR NZ,$9568    ; Shut away: check the sword instead, below
 $955F CALL $9C8C     ; Out in the open: IX = his own room's record
 $9562 BIT 7,(IX+$00) ; Is the room lit?
 $9566 JR NZ,$9582    ; Yes: he can see (no carry)
*$9568 PUSH IY        ; No, or shut away: save IY
 $956A LD IY,$C1F4    ; IY = the short strong sword's own record
 $956E CALL $9D86     ; Is the sword near Bilbo?
 $9571 POP IY         ; Restore IY
 $9573 JR Z,$957E     ; It is not: dark, below
 $9575 LD A,($C1FB)   ; It is near: A = the sword's own flags
 $9578 XOR $F7        ; Flip every flag bit except "broken"...
 $957A AND $1C        ; ...then keep just "full", "broken" and "on": zero here means full=1, broken=0, on=1 - the sword is glowing
 $957C JR Z,$9586     ; If so, he can see
*$957E LD HL,$AD12    ; "it is dark."
 $9581 SCF            ; Set the carry flag: it is too dark
*$9582 POP BC         ; {Restore BC and IX
 $9583 POP IX         ;
 $9585 RET            ; }
*$9586 AND A          ; {Clear the carry flag: he can see after all
 $9587 JR $9582       ; }

; Describe the room through a door
;
; Describes the room the actor is (temporarily) in, starting with '<actor> see' instead of 'you are in'. Used by #R$8E4E to show what can be seen through an
; open door or across a river.
c$9589 LD HL,$AEF2   ; "you see"
 $958C JR $95AB      ; Join the shared room-description code below, using this heading instead of "you are in"

; Describe a room
;
; Prints the full description of room A. The message used for this is 'you are <preposition> ...' at $AEEE, and before printing it this routine writes the
; room's preposition - OUTSIDE, INSIDE, IN, ON or AT, chosen by bits 1-3 of the room's first byte from #R$B970 - into the message itself, at $AEEF. So the text
; of the message is changed each time a room is described. #R$95B9 then does the rest.
;
; Input:A Room number
c$958E PUSH AF       ;
 $958F CALL $9B0C    ; IX = the room's record
 $9592 LD A,(IX+$00) ; {Bits 1-3 of its flags choose the preposition
 $9595 AND $0E       ;
 $9597 LD E,A        ;
 $9598 LD D,$00      ; }
 $959A LD HL,$B970   ; {HL = the table of prepositions
 $959D ADD HL,DE     ; }
 $959E LD E,(HL)     ; {DE = OUTSIDE, INSIDE, IN, ON or AT
 $959F INC HL        ;
 $95A0 LD D,(HL)     ; }
 $95A1 LD HL,$AEEF   ; {Write it into the message "you are ..." (high byte first)
 $95A4 LD (HL),D     ;
 $95A5 INC HL        ;
 $95A6 LD (HL),E     ;
 $95A7 POP AF        ; }
 $95A8 LD HL,$AEEE   ; {HL = that message
; This entry point is used by the routine at #R$9589.
*$95AB PUSH IX       ;
 $95AD PUSH IY       ;
 $95AF PUSH BC       ; }
 $95B0 CALL $95B9    ; {Describe the room
 $95B3 POP BC        ;
 $95B4 POP IY        ;
 $95B6 POP IX        ;
 $95B8 RET           ; }

; Describe a room (continued)
;
; Prints the room's name from its word list, or its own description script if bytes 8-9 of the room record are non-zero (#R$95E4). Then the room's picture is
; drawn if it has one (#R$8965); if it did, the game waits for a key (#R$95F8) so the player can look at it. Then the doors (#R$9FF8), the visible exits
; (#R$A068) and the objects and characters present (#R$9EDD) are listed.
c$95B9 LD B,A        ; B = the room
 $95BA CALL $9B0C    ; IX = its record
 $95BD CALL $72D4    ; Print "you are in" (or a short heading from the caller)
 $95C0 LD L,(IX+$08) ; {Does the room have its own description script?
 $95C3 LD H,(IX+$09) ;
 $95C6 LD A,H        ;
 $95C7 OR L          ; }
 $95C8 CALL $95E4    ; Print that, or else the room's name
 $95CB LD A,B        ; {Draw its picture, if it has one
 $95CC CALL $8965    ; }
 $95CF LD A,($8964)  ; {Was there a picture?
 $95D2 INC A         ; }
 $95D3 CALL NZ,$95F8 ; If so, wait for a key so it can be looked at
 $95D6 CALL $7578    ; New line
 $95D9 LD A,B        ; {"to the east there is the round green door" and so on
 $95DA CALL $9FF8    ; }
; This entry point is used by the routine at #R$9606.
*$95DD LD A,B        ; {"visible exits are: ..."
 $95DE CALL $A068    ; }
 $95E1 JP $9EDD      ; Finish with "you see: ..."

; Print a room's name or description
;
; If Z is reset, HL is a description script and it is printed. Otherwise the three name words of the room (from offset 2 of the record at IX) are printed with
; #R$9E1F.
c$95E4 JP NZ,$72D4   ; Does the room have its own description script (rather than needing its name printed)?
; This entry point is used by the routine at #R$9606.
*$95E7 LD DE,$0002   ; A room's own name words start 2 bytes into its record
 $95EA PUSH IY       ; Save the caller's IY
 $95EC PUSH IX       ; {Copy the room's record into IY as well...
 $95EE POP IY        ; }
 $95F0 ADD IY,DE     ; ...then move it on to the name words
 $95F2 CALL $9E1F    ; Print the room's own name (as a noun with adjectives)
 $95F5 POP IY        ; {Restore the caller's IY
 $95F7 RET           ; }

; Wait for a key after a picture
;
; Waits until a key is pressed, then resets the border to white (the picture may have changed it).
c$95F8 XOR A         ; {Is a key already being held down (so we should wait for it to be released first)?
 $95F9 IN A,($FE)    ;
 $95FB AND $1F       ; }
 $95FD CP $1F        ; {Yes: keep waiting
 $95FF JR Z,$95F8    ; }
 $9601 LD A,$07      ; {A key has been pressed: reset the border to white (a picture may have changed its colour)
 $9603 OUT ($FE),A   ;
 $9605 RET           ; }

; Describe a room briefly
;
; Prints the name of room A (#R$95E7) and a new line, and then carries on with the doors, exits and contents as in #R$95B9 ($95DD), without the picture.
c$9606 CALL $9B0C    ; IX = room A's own record
 $9609 CALL $95E7    ; Print its name
 $960C CALL $7578    ; New line
 $960F JR $95DD      ; Join the rest of the full room description (doors, exits and contents), skipping the picture

; End of turn: run the timers
;
; Called once per turn after the player's command. First #R$A8CA and #R$976C (via $9618 and $961B) let the other characters take their turns, then the timer
; table at #R$C973 is processed.
; .
; Each 7-byte timer entry has: a reload value, the current count, the address of an 'expire' routine, a threshold, and the address of a 'tick' routine. A count
; of 0 means the timer is not running. For each running timer the count is decremented ($963B). If it has just reached 0, the expire routine is called ($9657).
; If it is still above 0 but at or below the threshold, the tick routine is called instead ($966E).
; .
; Only one timer is allowed to expire per turn: the flag at $B5E1 records that one has already fired, and any other timer that reaches 0 in the same turn is
; given a count of 1 so that it fires next turn instead.
; .
; Timers are started by setting their count to their reload value, which various event routines do by copying byte 0 of the entry to byte 1 (for example
; #R$C6CC).
c$9611 PUSH HL       ; {Save the registers: the end of the turn must not disturb the caller
 $9612 PUSH IX       ;
 $9614 PUSH IY       ;
 $9616 PUSH BC       ;
 $9617 PUSH DE       ; }
 $9618 CALL $A8CA    ; Has the game been won (treasure in the chest)?
 $961B CALL $976C    ; Let every other character take its turn
 $961E SUB A         ; {No timer has expired yet this turn
 $961F LD ($B5E1),A  ; }
 $9622 INC A         ; {From now on things really happen: set the "would work"...
 $9623 LD ($B5EC),A  ; }
 $9626 LD ($B5EB),A  ; ...and "really do it" flags
 $9629 LD IY,$C973   ; IY = the first timer entry
*$962D LD A,(IY+$00) ; Fetch its reload value
 $9630 CP $FF        ; $FF marks the end of the table
 $9632 JR Z,$9679    ; All timers done: finish
 $9634 LD A,(IY+$01) ; A = the timer's count
 $9637 CP $00        ; Is the timer running?
 $9639 JR Z,$9671    ; No: next timer
 $963B DEC A         ; {Count down one turn
 $963C LD (IY+$01),A ; }
 $963F CP $00        ; Has it reached 0?
 $9641 JR NZ,$965C   ; Not yet: see whether it is time for the tick routine
 $9643 LD A,($B5E1)  ; {It has expired. Has another timer already expired this turn?
 $9646 CP $01        ; }
 $9648 LD (IY+$01),A ; Set the count to 1 if so (so it fires next turn) or leave it at 0
 $964B JR Z,$965C    ; Another timer has fired: wait until next turn
 $964D INC A         ; {This is the first: note that a timer has fired this turn
 $964E LD ($B5E1),A  ; }
 $9651 LD L,(IY+$02) ; {HL = the expire routine...
 $9654 LD H,(IY+$03) ; }
 $9657 CALL $9AC7    ; ...and run it
 $965A JR $9671      ; Next timer
*$965C LD A,(IY+$04) ; A = the threshold for the tick routine
 $965F CP $00        ; Is there one?
 $9661 JR Z,$9671    ; No: next timer
 $9663 CP (IY+$01)   ; Is the count at or below the threshold?
 $9666 JR C,$9671    ; No: next timer
 $9668 LD L,(IY+$05) ; {HL = the tick routine...
 $966B LD H,(IY+$06) ; }
 $966E CALL $9AC7    ; ...and run it
*$9671 LD DE,$0007   ; {Move on to the next 7-byte entry
 $9674 ADD IY,DE     ; }
 $9676 JP $962D      ; Loop
*$9679 LD A,$01      ; {Turn output back on for the player
 $967B LD ($B5F3),A  ; }
 $967E POP DE        ; {Restore the registers
 $967F POP BC        ;
 $9680 POP IY        ;
 $9682 POP IX        ;
 $9684 POP HL        ;
 $9685 RET           ; }

; Is the object within the player's reach?
;
; Stops the player using something that another character is holding. Characters are not subject to this check, and neither are objects that nobody is holding
; or that Bilbo himself is holding (directly or inside something he carries).
; .
; If object A is held by a living character, and Bilbo is visible, the game says, for example, 'gandalf is carrying the curious map.' and returns with Z reset:
; the action is not allowed. But if Bilbo is invisible - wearing the ring clears bit 7 of his flags - the check is skipped, and he can take things straight out
; of other characters' hands.
;
;  Input:A Object
; Output:F Z reset if the object is out of reach
c$9686 CP $FF         ; Nothing at all?
 $9688 RET Z          ; {Then there is nothing to check
 $9689 PUSH IX        ;
 $968B PUSH IY        ;
 $968D PUSH BC        ; }
 $968E LD B,A         ; B = the object
 $968F LD A,($B5DB)   ; {Is the actor Bilbo?
 $9692 CP $00         ; }
 $9694 JR Z,$9699     ; Yes: check
 $9696 XOR A          ; {A character: always allowed (Z set)
 $9697 JR $96D4       ;
*$9699 LD A,B         ; }
 $969A CALL $9B25     ; IX = the object's record
 $969D LD A,(IX+$01)  ; {Is anyone holding it?
 $96A0 CP $FF         ; }
 $96A2 JR Z,$96D4     ; {No: allowed
 $96A4 LD A,B         ; }
 $96A5 PUSH IX        ; {IY = the object's record
 $96A7 POP IY         ; }
 $96A9 CALL $9BD0     ; Is Bilbo holding it (perhaps inside something)?
 $96AC JR C,$96D4     ; Yes: allowed
 $96AE CALL $9B25     ; IX = the holder's record
 $96B1 BIT 6,(IX+$07) ; Is the holder a living character?
 $96B5 JR Z,$96D4     ; No (a box, a table): allowed
 $96B7 LD A,($C012)   ; {Is Bilbo visible?
 $96BA BIT 7,A        ; }
 $96BC JR Z,$96D4     ; No - he is wearing the ring: allowed
 $96BE LD L,(IY+$08)  ; {Push the object's name...
 $96C1 LD H,(IY+$09)  ;
 $96C4 PUSH HL        ; }
 $96C5 LD L,(IX+$08)  ; {...and the holder's
 $96C8 LD H,(IX+$09)  ;
 $96CB PUSH HL        ; }
 $96CC LD HL,$AED6    ; {"gandalf is carrying the curious map."
 $96CF CALL $72D4     ; }
 $96D2 OR $01         ; {Not allowed: return with Z reset
*$96D4 POP BC         ;
 $96D5 POP IY         ;
 $96D7 POP IX         ;
 $96D9 RET            ; }

; Kill the target
;
; Loads the target ($B5D9) and continues into #R$96DD. Used by BURN (#R$A232).
c$96DA LD A,($B5D9)  ; A = the target of the current command (falls straight into #R$96DD, which kills character A)

; Kill a character
;
; If A is 0, it is Bilbo who has died, and #R$903C ends the game. Otherwise the character's dead flag (bit 3) is set, everything it carries is dropped where it
; stands (#R$9CA8), it is removed from the character table (#R$C9BA) so it no longer acts, its adjectives are replaced by DEAD (#R$A0BC), and any orders waiting
; for it are cancelled (#R$894D).
;
; Input:A Character
c$96DD AND A           ; Is it Bilbo (object 0)?
 $96DE JP Z,$903C      ; {Yes: the game is over
 $96E1 PUSH BC         ;
 $96E2 PUSH IY         ;
 $96E4 PUSH IX         ; }
 $96E6 LD C,A          ; C = the character
 $96E7 CALL $9B25      ; IX = its record
 $96EA SET 3,(IX+$07)  ; Mark it dead
 $96EE CALL $9CA8      ; {It drops everything it carries
 $96F1 LD A,C          ; }
 $96F2 CALL $99E0      ; {Find it in the character table
 $96F5 CP $FF          ;
 $96F7 LD A,C          ; }
 $96F8 JR Z,$96FE      ; Not there: skip
 $96FA LD (IY+$00),$00 ; Clear its slot: it will never act again
*$96FE CALL $A0BC      ; {Its adjective becomes DEAD
 $9701 LD A,C          ; }
 $9702 CALL $894D      ; {Cancel any orders it was given
 $9705 POP IX          ;
 $9707 POP IY          ;
 $9709 POP BC          ;
 $970A RET             ; }

; Choose the random features of a new game
;
; Called at the start of every game. It makes Bilbo the actor and then makes two random choices.
; .
; The hidden route: one of five exits listed in the table at #R$C6FD is chosen (a random number 1-5 from #R$9BF4) and blanked out in its room record, so that
; way is closed. The address of the chosen entry is written into the instruction at $A6C3, where Elrond will need it (#R$A6B8). The candidates are the exits
; from Beorn's house to the great river, from the forest gate to the bewitched gloomy place, from the treeless opening to the goblins' outside gate, from the
; long lake to lake town, and from the misty mountain to the narrow place. Because of the way #R$9BF4 works, the first and last are chosen half as often as the
; others.
; .
; Gollum's riddle: one of the four entries at #R$C6EB is chosen (each equally likely) and its address stored at $B5DF (see #R$A7C6).
c$970B SUB A         ; {Bilbo is the actor...
 $970C LD ($B5DB),A  ; }
 $970F LD ($B5E2),A  ; ...the map has not been read...
 $9712 LD ($B5EA),A  ; ...and Gollum is not waiting for an answer
 $9715 LD HL,$C00B   ; {The actor's record is Bilbo's
 $9718 LD ($B5FC),HL ; }
 $971B LD A,$04      ; {Pick a random number from 0 to 4...
 $971D CALL $9BF4    ; }
 $9720 INC A         ; {...plus 1: one of the five hidden routes
 $9721 LD B,A        ; }
 $9722 LD IY,$C6F7   ; IY = the route table
 $9726 LD DE,$0006   ; Six bytes per entry
*$9729 ADD IY,DE     ; {Step to the chosen entry
 $972B DJNZ $9729    ; }
 $972D LD ($A6C5),IY ; Write its address into the LD IY instruction in Elrond's map routine (#R$A6B8)
 $9731 LD L,(IY+$01) ; {HL = the address of the exit in the room record
 $9734 LD H,(IY+$02) ; }
 $9737 LD B,$03      ; {Blank out its three bytes: the way is closed
*$9739 LD (HL),$00   ;
 $973B INC HL        ;
 $973C DJNZ $9739    ; }
 $973E LD A,$03      ; {Pick a random number from 0 to 3...
 $9740 CALL $9BF4    ; }
 $9743 LD E,A        ; {...times 4...
 $9744 LD D,$00      ;
 $9746 SLA E         ;
 $9748 SLA E         ; }
 $974A LD HL,$C6EB   ; {...to choose one of the four riddle entries
 $974D ADD HL,DE     ; }
 $974E LD ($B5DF),HL ; {Remember it for Gollum
 $9751 RET           ; }

; Print a message and end the sentence
;
; Prints the message at HL, then a full stop and a new line.
c$9752 CALL $72D4    ; Print the message
 $9755 LD A,$2E      ; {"."
 $9757 CALL $7580    ; }
 $975A JP $7578      ; New line

; Is the action really happening?
;
; Returns to the caller only if both $B5EB (really do it) and $B5EC (it would work) are set. Otherwise it discards the caller's return address, so the caller
; returns at once.
c$975D PUSH BC       ; Save BC
 $975E LD BC,($B5EB) ; {B = "it would work", C = "really happening"
 $9762 LD A,C        ; }
 $9763 AND B         ; Are both true?
 $9764 JR NZ,$9767   ; Yes: carry on normally
 $9766 POP BC        ; No: discard the caller's own return address too...
*$9767 POP BC        ; {...so control passes back one level further, skipping whatever the caller was about to do
 $9768 RET           ; }

; Unused
s$9769 DEFS $03

; Let the other characters act
;
; This is The Hobbit's famous 'independent characters' system. Every character in the table at #R$C9BA gets a turn after the player.
; .
; Each entry of that table is 7 bytes: the character's object number (0 if the character is dead or gone), a count used by #R$99B4, the address of the
; character's current place in its behaviour program, the address of its reaction table, and a 'stubbornness' value used by #R$8F9E.
; .
; For each living character, the character becomes the current actor ($B5DB, $B5FC) and the room it starts the turn in is noted ($B5E7). Output is switched on
; only if Bilbo can see the character (#R$9D77), so the player sees only what happens in front of him. If Bilbo is in the dark, the first character to do
; anything in his room produces 'you hear a noise.' instead ($AF19).
; .
; A character that is inside something (held by an object rather than standing in a room) tries to get out first (#R$9A71).
; .
; Then the character's behaviour program is run. Each instruction starts with a byte whose low nibble is its type and whose high bits are flags: bit 4 'jump
; afterwards to the address that follows', bit 5 'do this only once' (the instruction is cleared to 0 after use), bit 6 'do not take orders at this point'. The
; types are:
; .
; #LIST
; { 0-3: do an action. The next three bytes are the action, the target and the instrument (#R$9883). If bit 0 of the flags is set, the next two bytes are
; instead the address of a routine that does something special - most of the routines in the range $A406-$A91B are such character routines. }
; { 4: do an action without objects, such as moving in a direction (#R$98CF). An action of $FF just jumps. }
; { $0C: change the character's reaction (#R$99FB). }
; { $0E: jump to the address that follows. }
; { $0F: choose at random one of the behaviours in the reaction table (#R$99B4). }
; { anything else: go back to the first behaviour in the reaction table. }
; LIST#
; .
; Before the program, if the player has given the character an order (#R$88FD) and the current instruction allows it (bit 6 clear), the order is obeyed instead
; (#R$8907, $9929).
; .
; A character stops after 6 instructions in one turn ($9769). At the end the player becomes the actor again, with output switched on.
c$976C CALL $9A5D    ; Note Bilbo's room and whether he is in the dark
 $976F LD IY,$C9BA   ; IY = the first entry of the character table
*$9773 XOR A         ; {Reset the count of instructions tried by this character
 $9774 LD ($9769),A  ; }
 $9777 LD A,(IY+$00) ; A = the character's object number
 $977A CP $FF        ; End of the table?
 $977C JP Z,$9864    ; Yes: all done
 $977F CP $00        ; 0 means a dead character or an empty slot
 $9781 JP Z,$985C    ; Skip it
 $9784 LD ($B5DB),A  ; Make the character the current actor
 $9787 CALL $9ECB    ; A = its room, IX = its record
 $978A LD ($B5FC),IX ; Its record is the actor's record...
 $978E LD ($B5E7),A  ; ...and its room is the room it starts the turn in
 $9791 SUB A         ; {Switch output off until we know Bilbo can see
 $9792 LD ($B5F3),A  ;
 $9795 PUSH IY       ; }
 $9797 LD IY,$C00B   ; IY = Bilbo's record
 $979B CALL $9D77    ; {Can Bilbo see the character?
 $979E POP IY        ; }
 $97A0 JR Z,$97C3    ; No: its actions will not be printed
 $97A2 LD A,($976A)  ; {Has "you hear a noise" already been printed this turn?
 $97A5 CP $02        ; }
 $97A7 JR Z,$97C3    ; Yes: keep quiet
 $97A9 LD A,$01      ; {Output on: Bilbo can see what the character does
 $97AB LD ($B5F3),A  ; }
 $97AE LD A,($976A)  ; {Is Bilbo in the dark ($976A = 1)?
 $97B1 CP $01        ; }
 $97B3 JR NZ,$97C3   ; No: carry on
 $97B5 INC A         ; {Yes: remember that the noise has been heard ($976A = 2)
 $97B6 LD ($976A),A  ; }
 $97B9 LD HL,$AF19   ; {"you hear a noise."
 $97BC CALL $72D4    ; }
 $97BF SUB A         ; {And switch output off: Bilbo sees nothing
 $97C0 LD ($B5F3),A  ; }
*$97C3 LD A,$FF      ; {Is the character held by something?
 $97C5 CP (IX+$01)   ; }
 $97C8 JP NZ,$9A71   ; Yes: try to get out instead (#R$9A71)
; This entry point is used by the routine at #R$9A71.
*$97CB LD IX,($B5FC) ; IX = the character's record
 $97CF CALL $88FD    ; Has the player given it an order?
 $97D2 LD A,$00      ; {$B5E5 = 1 if so, 0 if not
 $97D4 JR NZ,$97D7   ;
 $97D6 INC A         ;
*$97D7 LD ($B5E5),A  ; }
; This entry point is used by the routine at #R$98CF.
*$97DA LD L,(IY+$02) ; {HL = where the character has got to in its behaviour program
 $97DD LD H,(IY+$03) ; }
; This entry point is used by the routine at #R$98CF.
*$97E0 LD A,($9769)  ; {Has the character already tried six instructions this turn?
 $97E3 CP $06        ; }
 $97E5 JR Z,$985C    ; Yes: that is enough, next character
 $97E7 LD A,(HL)     ; A = the instruction byte
 $97E8 LD DE,$0004   ; DE = 4, the length of an action instruction
 $97EB PUSH HL       ; {IX = the instruction
 $97EC POP IX        ; }
 $97EE AND $0F       ; The low nibble is the instruction type
 $97F0 CP $05        ; Types 0-4 are actions
 $97F2 JR NC,$9826   ; Types 5 and up: go and decode them
 $97F4 LD A,($B5E5)  ; {An action instruction. Is an order from the player waiting?
 $97F7 CP $01        ; }
 $97F9 JR NZ,$981A   ; No: carry out the program
 $97FB BIT 6,(HL)    ; Does this instruction refuse orders (bit 6)?
 $97FD JR NZ,$981A   ; Yes: carry out the program
 $97FF SUB A         ; {The order is being dealt with now
 $9800 LD ($B5E5),A  ;
 $9803 INC A         ; }
 $9804 CALL $8907    ; Match the order to an action and objects
 $9807 JR Z,$981A    ; It cannot be done: carry on with the program instead
 $9809 LD A,$01      ; {The order will be obeyed for real
 $980B LD ($B5EB),A  ;
 $980E LD ($B5EC),A  ; }
 $9811 LD HL,$985C   ; {Arrange to go on to the next character afterwards
 $9814 PUSH HL       ;
 $9815 PUSH IX       ; }
 $9817 JP $9929      ; Do it (#R$9921), then return to $985C
*$981A LD A,(HL)     ; {Fetch the instruction type again
 $981B AND $0F       ; }
 $981D CP $04        ; {Type 4: an action without objects
 $981F JP Z,$98CF    ; }
 $9822 JR C,$9883    ; Types 0-3: an action with objects, or a routine
 $9824 JR $985C      ; (Not reached)
*$9826 CP $0E        ; {Type $0E: go to
 $9828 JR NZ,$9838   ; }
 $982A LD E,(IX+$01) ; {Store the address that follows as the new program position
 $982D LD (IY+$02),E ;
 $9830 LD E,(IX+$02) ;
 $9833 LD (IY+$03),E ; }
 $9836 JR $97DA      ; And carry on from there, in the same turn
*$9838 CP $0C        ; {Type $0C: change behaviour on a named action
 $983A JR NZ,$9847   ; }
 $983C LD B,(IX+$01) ; B = the action
 $983F LD A,(IY+$00) ; A = this character
 $9842 CALL $99FB    ; Switch to its reaction for that action
 $9845 JR $97DA      ; Carry on
*$9847 CP $0F        ; {Type $0F: pick a behaviour at random
 $9849 JR NZ,$9850   ;
 $984B CALL $99B4    ; }
 $984E JR $97DA      ; Carry on
*$9850 CP $00        ; {Type 0 would skip the instruction here, but types below 5 never get this far
 $9852 JR NZ,$9857   ;
 $9854 ADD HL,DE     ;
 $9855 JR $97E0      ; }
*$9857 SUB A         ; {Any other type: return to the default behaviour (reaction table entry 0)...
 $9858 LD E,A        ; }
 $9859 CALL $99C3    ; ...and end this character's turn
; This entry point is used by the routines at #R$9883, #R$98CF and #R$9A71.
*$985C LD DE,$0007   ; {Next character: entries are 7 bytes long
 $985F ADD IY,DE     ;
 $9861 JP $9773      ; }
*$9864 SUB A         ; {All characters done: Bilbo is the actor again
 $9865 LD ($B5DB),A  ; }
 $9868 INC A         ; {Output back on
 $9869 LD ($B5F3),A  ; }
 $986C LD HL,$C00B   ; {The actor's record is Bilbo's
 $986F LD ($B5FC),HL ;
 $9872 RET           ; }

; Advance a character's program pointer
;
; Moves the program pointer past the current instruction (HL+DE), skipping two more bytes if bit 4 of the instruction says a jump address follows, and stores it
; in the character's table entry.
c$9873 ADD HL,DE      ; Move past this instruction
 $9874 BIT 4,(IX+$00) ; {Does it have a "failure address" that follows it?
 $9878 JR Z,$987C     ; }
 $987A INC HL         ; {If so, skip past that too
 $987B INC HL         ; }
*$987C LD (IY+$02),L  ; {Store the new position back into the character's own table entry
 $987F LD (IY+$03),H  ;
 $9882 RET            ; }

; Character instruction: do an action
;
; Carries out an action instruction from a character's behaviour program. Normally the three bytes after the instruction byte give the action, the target and
; the instruction ($B5D8-$B5DA) and #R$9921 tries it. If bit 0 of the instruction byte is set, the next two bytes are the address of a special routine, which is
; called first as a dry run and, if it says it would work, for real.
; .
; If the action worked, and the instruction has a jump address (bit 4), the program jumps there. If bit 5 is set the instruction is erased so it will not be
; done again.
c$9883 CALL $9873      ; Move the program pointer past this instruction (and its failure address, if any)
 $9886 BIT 0,(IX+$00)  ; Is it a call to a special routine (bit 0)?
 $988A JR NZ,$98A5     ; Yes
 $988C LD A,(IX+$01)   ; {The action...
 $988F LD ($B5D8),A    ; }
 $9892 LD A,(IX+$02)   ; {...the target...
 $9895 LD ($B5D9),A    ; }
 $9898 LD A,(IX+$03)   ; {...and the instrument
 $989B LD ($B5DA),A    ; }
 $989E CALL $9921      ; Try it
 $98A1 JR Z,$9905      ; It failed
 $98A3 JR $98C2        ; It worked
*$98A5 LD L,(IX+$01)   ; {HL = the special routine
 $98A8 LD H,(IX+$02)   ; }
 $98AB SUB A           ; {Run it first as a dry run: "really do it" off...
 $98AC LD ($B5EB),A    ; }
 $98AF LD ($B5EC),A    ; {...and "would work" off
 $98B2 CALL $9AC7      ; }
 $98B5 LD A,($B5EC)    ; {Did it say it would work?
 $98B8 CP $01          ; }
 $98BA JR NZ,$9905     ; No: it failed
 $98BC LD ($B5EB),A    ; {Yes: run it again for real
 $98BF CALL $9AC7      ; }
*$98C2 BIT 5,(IX+$00)  ; Success. Is this a once-only instruction (bit 5)?
 $98C6 JP Z,$985C      ; No: this character's turn is over
 $98C9 LD (IX+$00),$00 ; Yes: wipe out its instruction byte
 $98CD JR $985C        ; Turn over

; Character instruction: action without objects
;
; The byte after the instruction is an action with no target or instrument (typically a movement direction, so a character's program can be a route), tried with
; #R$9921. An action of $FF means 'jump to the address that follows' if bit 4 is set. The entry at $9905 counts the instructions done this turn and follows jump
; addresses.
c$98CF LD DE,$0002    ; This instruction is 2 bytes long (plus a failure address)
 $98D2 CALL $9873     ; Move the program pointer past it
 $98D5 LD A,(IX+$01)  ; A = the action
 $98D8 CP $FF         ; $FF: no action at all?
 $98DA JR Z,$98EF     ; Yes
 $98DC LD ($B5D8),A   ; Set the action...
 $98DF LD A,$FF       ; {...with no target or instrument: the game will choose them
 $98E1 LD ($B5D9),A   ;
 $98E4 LD ($B5DA),A   ; }
 $98E7 CALL $9921     ; Try it
 $98EA JR Z,$9905     ; It failed
 $98EC JP $985C       ; It worked: turn over
*$98EF BIT 4,(IX+$00) ; No action. Is there an address after it (bit 4)?
 $98F3 JP Z,$985C     ; No: just end the turn (the character waits)
 $98F6 LD L,(IX+$02)  ; {Yes: jump there next turn
 $98F9 LD H,(IX+$03)  ;
 $98FC LD (IY+$02),L  ;
 $98FF LD (IY+$03),H  ; }
 $9902 JP $985C       ; Turn over
; This entry point is used by the routine at #R$9883.
*$9905 LD HL,$9769    ; {FAILURE: count it (six failures end the turn)
 $9908 INC (HL)       ; }
 $9909 BIT 4,(IX+$00) ; Is there a failure address (bit 4)?
 $990D JP Z,$97DA     ; No: go on to the next instruction
 $9910 ADD IX,DE      ; {Yes: fetch it...
 $9912 LD H,(IX+$01)  ;
 $9915 LD L,(IX+$00)  ; }
 $9918 LD (IY+$02),L  ; {...make it the program position...
 $991B LD (IY+$03),H  ; }
 $991E JP $97E0       ; ...and carry on from there, in the same turn

; A character tries an action
;
; Checks with #R$84E6 whether the action would work; returns with Z set if not. Otherwise the action is reported (#R$7122) and performed (#R$946F), and the
; routine returns with Z reset.
; .
; The report is the tricky part, because Bilbo may be able to see only part of what happens. Actions on rooms, and GO THROUGH by a character that did not start
; in Bilbo's room, are not reported. If the target is a door (something in two places) and the character is on the other side of it from Bilbo, the report is
; printed with the actor replaced by $FF, so Bilbo reads 'someone opens the door' - he sees the door open but not who opened it.
; .
; Afterwards #R$9A28 prints '<character> enters.' if the character has just come into Bilbo's room, and '<object> appears.' if the target has.
;
; Output:F Z set if the action would not work
c$9921 PUSH IX       ;
 $9923 CALL $84E6    ; Would the action work?
 $9926 JP Z,$99B1    ; No: return with Z set
; This entry point is used by the routine at #R$976C.
*$9929 LD A,($B5EF)  ; {Is the target a room?
 $992C CP $01        ; }
 $992E JR Z,$998D    ; Yes: do it without a report
 $9930 LD A,($B5D8)  ; {Is it GO THROUGH (action 30)...
 $9933 CP $1E        ;
 $9935 JR NZ,$9940   ; }
 $9937 LD A,($B5E7)  ; {...by a character that did not start the turn in Bilbo's room?
 $993A LD HL,$C01B   ;
 $993D CP (HL)       ; }
 $993E JR NZ,$998D   ; Then do it without a report
*$9940 LD A,($B5D9)  ; {Is there a target?
 $9943 CP $FF        ; }
 $9945 JR Z,$9986    ; No: report normally
 $9947 CALL $9ECB    ; A = the target's room
 $994A LD ($976B),A  ; (remember it)
 $994D CP $FF        ; Is it in one place?
 $994F JR NZ,$9986   ; Yes: report normally
 $9951 LD BC,($B5E6) ; {A door. C = Bilbo's room, B = the character's room
 $9955 LD A,C        ; }
 $9956 CP B          ; The same room?
 $9957 JR Z,$9986    ; Yes: report normally
 $9959 LD B,(IX+$00) ; {Is Bilbo on one side of the door?
*$995C CP (IX+$10)   ;
 $995F JR Z,$9967    ;
 $9961 INC IX        ;
 $9963 DJNZ $995C    ; }
 $9965 JR $9986      ; No: report normally
*$9967 LD A,($B5DB)  ; {Yes, and the character is on the other side:
 $996A LD B,A        ; }
 $996B LD A,$FF      ; {the actor becomes "someone"...
 $996D LD ($B5DB),A  ; }
 $9970 LD A,$01      ; {...output is switched on...
 $9972 LD ($B5F3),A  ;
 $9975 PUSH IY       ; }
 $9977 CALL $7122    ; {...and Bilbo reads "someone opens the door"
 $997A POP IY        ; }
 $997C SUB A         ; {Output off again
 $997D LD ($B5F3),A  ; }
 $9980 LD A,B        ; {Restore the actor
 $9981 LD ($B5DB),A  ;
 $9984 JR $998D      ;
*$9986 PUSH IY       ; }
 $9988 CALL $7122    ; {Report the action
 $998B POP IY        ; }
*$998D CALL $946F    ; Do it
 $9990 LD A,($B5DB)  ; {Has the character just come into Bilbo's room?
 $9993 LD HL,$B5E7   ; }
 $9996 LD DE,$AF09   ; {"<character> enters."
 $9999 CALL $9A28    ; }
 $999C LD A,($B5EF)  ; {Unless the target is a room...
 $999F CP $01        ;
 $99A1 JR Z,$99AF    ; }
 $99A3 LD A,($B5D9)  ; {...has the target just appeared in Bilbo's room?
 $99A6 LD HL,$976B   ; }
 $99A9 LD DE,$AF0E   ; {"<object> appears."
 $99AC CALL $9A28    ; }
*$99AF OR $01        ; {Return with Z reset: the action worked
*$99B1 POP IX        ;
 $99B3 RET           ; }

; Choose a behaviour at random
;
; Picks a random entry (#R$9BF4) from the character's reaction table (the address at offset 4 of its table entry) and makes it the character's current behaviour
; program. The range is the smaller of byte 1 of the instruction and byte 1 of the character's table entry. The entry at $99C3 selects entry E instead.
c$99B4 LD A,(IX+$01) ; A = the range given in the instruction...
 $99B7 CP (IY+$01)   ; {...but no more than the character's own limit
 $99BA JR C,$99BF    ;
 $99BC LD A,(IY+$01) ; }
*$99BF CALL $9BF4    ; {Pick a random entry number
 $99C2 LD E,A        ; }
; This entry point is used by the routine at #R$976C.
*$99C3 LD A,(IY+$01) ; {(Entry point with E already set) Make sure it is within the limit
 $99C6 CP E          ;
 $99C7 JR NC,$99CA   ;
 $99C9 LD E,A        ; }
*$99CA LD L,(IY+$04) ; {HL = the reaction table
 $99CD LD H,(IY+$05) ;
 $99D0 LD D,$00      ; }
 $99D2 ADD HL,DE     ; {Three bytes per entry
 $99D3 ADD HL,DE     ;
 $99D4 ADD HL,DE     ; }
 $99D5 INC HL        ; Skip the action byte
 $99D6 LD E,(HL)     ; {DE = the program address
 $99D7 INC HL        ;
 $99D8 LD D,(HL)     ; }
 $99D9 LD (IY+$02),E ; {Make it the character's program
 $99DC LD (IY+$03),D ;
 $99DF RET           ; }

; Find a character's table entry
;
; Searches the character table #R$C9BA for character A and returns IY pointing at its entry (or at the $FF end marker, with A=$FF, if it is not there).
;
;  Input:A Character
; Output:IY Table entry
c$99E0 PUSH DE       ; {Save DE and BC
 $99E1 PUSH BC       ; }
 $99E2 LD B,A        ; B = the character being searched for
 $99E3 LD HL,$C9BA   ; {HL = the start of the character table
 $99E6 LD DE,$0007   ; }
*$99E9 LD A,(HL)     ; A = this entry's own character number
 $99EA CP B          ; {Is it the one we want?
 $99EB JR Z,$99F5    ; }
 $99ED CP $FF        ; {Is this the end of the table?
 $99EF JR Z,$99F5    ; }
 $99F1 ADD HL,DE     ; {Neither: move on to the next entry
 $99F2 JP $99E9      ; }
*$99F5 POP BC        ; {Found it (or reached the end): restore BC and DE
 $99F6 POP DE        ; }
 $99F7 PUSH HL       ; {IY = the entry (or the end marker)
 $99F8 POP IY        ;
 $99FA RET           ; }

; Change a character's behaviour
;
; Looks for action B in the reaction table of character A (a list of 3-byte entries: action and program address). If found, the character's current program is
; switched to that address. This is how characters respond to what happens to them: for example the reaction to ATTACK is to fight back.
;
; Input:A Character
;       B Action
c$99FB PUSH IY       ;
 $99FD PUSH IX       ;
 $99FF CALL $99E0    ; IY = the character's table entry
 $9A02 CP $FF        ; Is it a character?
 $9A04 JR Z,$9A23    ; No: nothing to do
 $9A06 LD L,(IY+$04) ; {IX = its reaction table
 $9A09 LD H,(IY+$05) ;
 $9A0C PUSH HL       ;
 $9A0D POP IX        ; }
 $9A0F LD A,B        ; A = the action that was done to it
 $9A10 CALL $9D12    ; {Is there a reaction to it?
 $9A13 CP $FF        ; }
 $9A15 JR Z,$9A23    ; No: carry on as before
 $9A17 LD L,(IX+$01) ; {Yes: switch its program to the reaction
 $9A1A LD H,(IX+$02) ;
 $9A1D LD (IY+$02),L ;
 $9A20 LD (IY+$03),H ;
*$9A23 POP IX        ;
 $9A25 POP IY        ;
 $9A27 RET           ; }

; Report that a character has arrived
;
; Prints the message at DE (for example 'thorin enters.' or 'X appears.') with the object's name, if object A has just arrived in the room where Bilbo is
; ($B5E6), was not there before ((HL)), and Bilbo is not in the dark.
c$9A28 CP $FF        ; Is there actually no object at all?
 $9A2A RET Z         ; If so, there is nothing to report
 $9A2B AND A         ; Is it object 0 (Bilbo himself)?
 $9A2C RET Z         ; If so, do not announce his own arrival
 $9A2D LD B,A        ; B = the object
 $9A2E LD A,($976A)  ; {Is Bilbo in the dark?
 $9A31 CP $02        ; }
 $9A33 RET Z         ; Yes: he would not see this anyway
 $9A34 LD A,B        ; A = the object again
 $9A35 CALL $9ECB    ; {A = its own room
 $9A38 LD C,A        ; }
 $9A39 CP (HL)       ; Was it already in that room before this turn?
 $9A3A RET Z         ; Yes: nothing has changed, no need to announce it
 $9A3B LD A,($B5E6)  ; {Is that room the one Bilbo is actually in right now?
 $9A3E CP C          ; }
 $9A3F RET NZ        ; No: he would not see it arrive
 $9A40 LD A,($9B37)  ; {Was Bilbo himself just moved along with it (e.g. carried in a barrel)?
 $9A43 AND A         ; }
 $9A44 RET Z         ; No: report it as usual, below
 $9A45 LD A,$01      ; {Yes: switch output on, since this is happening right in front of him
 $9A47 LD ($B5F3),A  ; }
 $9A4A PUSH DE       ; {HL = whichever "enters"/"appears" message the caller is using
 $9A4B POP HL        ; }
 $9A4C LD A,B        ; {IX = the object's own record
 $9A4D CALL $9B25    ; }
 $9A50 PUSH DE       ; Save DE
 $9A51 LD DE,$0008   ; {IX = the object's own words
 $9A54 ADD IX,DE     ; }
 $9A56 POP DE        ; Restore DE
 $9A57 PUSH IX       ; Push the object's name as the message parameter
 $9A59 CALL $72D4    ; {Print the message
 $9A5C RET           ; }

; Prepare for the characters' turn
;
; Notes the room Bilbo is in ($B5E6, #R$9ECB) and whether it is dark there ($976A). It is also the default handler for action 0 in #R$C61F, which makes it a
; harmless 'do nothing special' routine.
c$9A5D LD A,$00      ; A = 0 (Bilbo)
 $9A5F CALL $9ECB    ; A = Bilbo's own room
 $9A62 LD ($B5E6),A  ; Remember it, for #R$9A28 and the character loop to compare against
 $9A65 CALL $954D    ; Is it too dark for Bilbo to see?
 $9A68 LD A,$00      ; {Assume not
 $9A6A JR NC,$9A6D   ; }
 $9A6C INC A         ; It is dark
*$9A6D LD ($976A),A  ; {Remember whether Bilbo is in the dark, for the rest of this turn
 $9A70 RET           ; }

; A character tries to get out of something
;
; Called when a character is being held by an object (for example shut in a barrel or a cell). If the holder is dead or alive (i.e. another character is
; carrying this one), nothing special happens. If it is a closed object, the character does nothing this turn. If it is open, the character tries action 55,
; CLIMB OUT OF.
c$9A71 LD A,$FF       ; {No instrument for this
 $9A73 LD ($B5DA),A   ; }
 $9A76 LD A,(IX+$01)  ; A = whoever (or whatever) is holding the character
 $9A79 LD ($B5D9),A   ; That becomes the target
 $9A7C CALL $9B25     ; IX = the holder's own record
 $9A7F BIT 3,(IX+$07) ; Is the holder dead (e.g. another character just killed)?
 $9A83 JP NZ,$97CB    ; Yes: the character can simply act as normal, as if not held at all
 $9A86 BIT 6,(IX+$07) ; Is the holder actually alive (another character carrying this one)?
 $9A8A JP NZ,$97CB    ; Yes: likewise, act as normal
 $9A8D BIT 5,(IX+$07) ; Otherwise it is a container: is it open?
 $9A91 JP Z,$985C     ; No: stuck for this turn - move on to the next character
 $9A94 LD A,$37       ; {Yes: try to climb out (action 55)
 $9A96 LD ($B5D8),A   ; }
 $9A99 CALL $9921     ; Try it
 $9A9C JP $985C       ; Then move on to the next character regardless

; Is the action sensible?
;
; Returns with Z set if the action cannot make sense: the target is the actor, or the instrument is the target, or the instrument is the actor. A missing target
; ($FF) is always fine.
;
; Output:F Z set if the objects are not sensible
c$9A9F LD A,($B5D9)  ; {Is there actually no target at all?
 $9AA2 INC A         ;
 $9AA3 JR NZ,$9AA7   ; }
 $9AA5 INC A         ; {If so, that always makes sense: A becomes non-zero (Z reset)
 $9AA6 RET           ; }
*$9AA7 LD A,($B5EF)  ; {Is the target actually a room (rather than an object)?
 $9AAA AND A         ; }
 $9AAB JR NZ,$9ABA   ; Yes: a room can never be "the same as the actor", so skip that check
 $9AAD LD HL,$B5D9   ; {No: is the target the same as the actor?
 $9AB0 LD A,($B5DB)  ;
 $9AB3 CP (HL)       ; }
 $9AB4 RET Z         ; Yes: that makes no sense (Z set)
 $9AB5 LD A,($B5DA)  ; {Is the instrument the same as the target?
 $9AB8 CP (HL)       ; }
 $9AB9 RET Z         ; Yes: that makes no sense either
*$9ABA LD A,($B5F0)  ; {Is the instrument actually a room too?
 $9ABD AND A         ; }
 $9ABE RET NZ        ; Yes: skip the last check
 $9ABF LD A,($B5DA)  ; {No: is the instrument the same as the actor?
 $9AC2 LD HL,$B5DB   ;
 $9AC5 CP (HL)       ; }
 $9AC6 RET           ; Z set means it is, and so makes no sense

; Call the routine at HL (if HL is not 0)
;
; A general dispatcher used throughout the game for tables of routine addresses (the room-entry handlers, the timer table, the character table). All registers
; except AF are preserved, and a zero address means 'no routine', so tables can leave entries empty. The actual call is made by the JP (HL) at #R$9ADB.
;
; Input:HL Routine address, or 0
c$9AC7 PUSH IX       ; {Save every register the routine we are about to call might disturb...
 $9AC9 PUSH IY       ;
 $9ACB PUSH DE       ;
 $9ACC PUSH BC       ; }
 $9ACD PUSH HL       ; ...including HL itself, which holds the address to call
 $9ACE LD A,L        ; {Is that address 0, meaning "there is nothing to call"?
 $9ACF OR H          ; }
 $9AD0 CALL NZ,$9ADB ; If it is not 0, make the call
 $9AD3 POP HL        ; {Restore the registers, in the same order they were saved...
 $9AD4 POP BC        ;
 $9AD5 POP DE        ;
 $9AD6 POP IY        ;
 $9AD8 POP IX        ;
 $9ADA RET           ; }

; Jump to HL
;
; The JP (HL) used by #R$9AC7.
c$9ADB JP (HL)       ; Jump to the routine at HL

; Find an object's handler for an action
;
; Searches the list of action handlers at the end of the object record at IX (after the header, the four word slots and its location bytes; see #R$C00B) for
; action A, using #R$9D12. As with #R$9D12, the found/not-found sense is NZ/carry set = found, Z set = not found - the opposite of what the names Z and 'zero'
; suggest. Returns IX at the matching entry (or the list's $FF terminator).
;
;  Input:A Action
;        IX Object record
; Output:F NZ or carry set if the object has its own handler for the action; Z set if not
c$9ADC PUSH DE       ; Save DE for the caller
 $9ADD LD D,A        ; D = the action we are looking for a handler for
 $9ADE LD A,(IX+$00) ; A = the number of locations this object has (1 for most things, 2 for a door)...
 $9AE1 ADD A,$10     ; ...plus 16, the size of the record's fixed part: this gives the offset, from the start of the record, to where its own list of action
                     ; handlers begins
 $9AE3 LD E,A        ; E = that offset
 $9AE4 LD A,D        ; {D = the action again...
 $9AE5 LD D,$00      ; }
 $9AE7 ADD IX,DE     ; IX = the start of this object's own list of handlers
 $9AE9 CALL $9D12    ; Search that list for the action (see #R$9D12: NZ or carry set means found)
 $9AEC POP DE        ; {Restore the caller's DE
 $9AED RET           ; }

; Get the next entry of a 3-byte table
;
; Moves IX on to the next 3-byte entry of a table such as the object index (#R$BF53), returning the key in A and the address it holds in IY. Returns with Z set
; at the end of the table ($FF). The alternate registers are used so that BC, DE and HL are preserved.
c$9AEE EXX           ; Switch to the alternate registers, so this does not disturb the caller's own BC, DE and HL
 $9AEF LD DE,$0003   ; DE = 3, the size of one entry
 $9AF2 ADD IX,DE     ; Move IX on to the next entry
 $9AF4 LD D,(IX+$02) ; {DE = the 16-bit value stored in this entry (e.g. a record address)...
 $9AF7 LD E,(IX+$01) ; }
 $9AFA PUSH DE       ; {...moved into IY for the caller to use
 $9AFB POP IY        ; }
 $9AFD LD A,(IX+$00) ; A = this entry's own key
 $9B00 CP $FF        ; Is it the table's $FF terminator?
 $9B02 EXX           ; Switch back to the caller's own registers
 $9B03 RET           ; Z set means the terminator was reached; NZ means a genuine entry was found

; Get the next object
;
; As #R$9AEE, but preserving B.
c$9B04 PUSH BC       ; {Save the caller's own B (and pass the incoming A through it)
 $9B05 LD B,A        ; }
 $9B06 CALL $9AEE    ; Step to the next entry, exactly as #R$9AEE
 $9B09 LD A,B        ; Restore A to what it was before the call (so the caller's own "target" or "actor" number survives)
 $9B0A POP BC        ; {Restore the caller's B
 $9B0B RET           ; }

; Get the address of a room record
;
; Returns the address of the record for room number A (0-79) from the room pointer table at #R$B8D0. Numbers of $50 (80) and above are not rooms; for those, A
; is set to 0 and the routine returns with the Z flag set.
;
;  Input:A Room number
; Output:IX Room record
c$9B0C CP $50        ; Is the room number 80 or higher (not a real room)?
 $9B0E JR C,$9B12    ; No, it is a real room: go and find its record
 $9B10 XOR A         ; {Not a real room: return 0, with Z set, so the caller knows there is no such room
 $9B11 RET           ; }
*$9B12 PUSH DE       ; Save DE for the caller
 $9B13 LD DE,$B8D0   ; HL will point into the room pointer table, which starts here
 $9B16 PUSH HL       ; Save HL for the caller
 $9B17 LD L,A        ; {HL = the room number...
 $9B18 LD H,$00      ; }
 $9B1A ADD HL,HL     ; ...doubled, because each room has a 2-byte entry in the table
 $9B1B ADD HL,DE     ; HL = the address of this room's entry in the pointer table
 $9B1C LD E,(HL)     ; {DE = the room's record address, read from the table (low byte)...
 $9B1D INC HL        ; }
 $9B1E LD D,(HL)     ; ...then the high byte
 $9B1F PUSH DE       ; Move that address onto the stack for a moment...
 $9B20 POP IX        ; ...so it can be popped straight into IX, the register the rest of the game expects a room record in
 $9B22 POP HL        ; Restore the caller's HL
 $9B23 POP DE        ; {Restore the caller's DE
 $9B24 RET           ; }

; Get the address of an object record
;
; Looks up object number A in the object index table at #R$BF53 (using #R$9D12) and returns the address of its record in IX. Everything that can be manipulated
; - Bilbo himself (object 0), the other characters, doors, food, weapons, keys - is an 'object' with a record in #R$C00B.
;
;  Input:A Object number
; Output:IX Object record
c$9B25 LD IX,$BF53   ; IX = the start of the object index, the master list of every object and its record address
 $9B29 CALL $9D12    ; Search the index for object A
 $9B2C PUSH HL       ; Save HL for a moment
 $9B2D LD L,(IX+$01) ; HL = the object's record address, read from the matching entry (low byte)...
 $9B30 LD H,(IX+$02) ; ...then the high byte
 $9B33 EX (SP),HL    ; Swap it onto the stack in place of the saved HL, so the address can be...
 $9B34 POP IX        ; {...popped straight into IX, the register the rest of the game expects an object record in
 $9B36 RET           ; }

; Bilbo-moved flag
;
; Cleared by #R$9B6C when Bilbo is among the things moved along with an object, so that #R$9B38 knows to describe his new surroundings.
b$9B37 DEFB $28

; Move an object and everything it holds
;
; Moves everything held by object A (and everything they hold, recursively, #R$9B6C) to room B. If Bilbo was among the things moved (for example he was inside
; the barrel when it floated away, or was carried off), the room he has arrived in is entered and described (the entry at $8DC1 in #R$8D19).
;
; Input:A Object
;       B Room
c$9B38 LD HL,$9B37   ; {Assume, for now, that Bilbo is among the things being moved
 $9B3B LD (HL),$01   ; }
 $9B3D CALL $9B6C    ; Move everything object A holds into room B (this clears the flag above if Bilbo is not actually among them)
 $9B40 LD A,(HL)     ; {Was Bilbo actually moved?
 $9B41 AND A         ; }
 $9B42 RET NZ        ; No: nothing more to do
 $9B43 PUSH HL       ; Yes: save the flag's own address
 $9B44 LD A,($B5DB)  ; {Save the current actor...
 $9B47 PUSH AF       ; }
 $9B48 LD HL,($B5FC) ; {...and the current actor's record
 $9B4B PUSH HL       ; }
 $9B4C LD HL,$C00B   ; {Make Bilbo the actor for a moment...
 $9B4F LD ($B5FC),HL ;
 $9B52 XOR A         ;
 $9B53 LD ($B5DB),A  ; }
 $9B56 LD A,B        ; {...and pretend he has just moved in direction B (used only to set the "destination room" variable read below)
 $9B57 LD ($8D17),A  ; }
 $9B5A CALL $8DC1    ; Enter the new room and describe it, exactly as an ordinary move does
 $9B5D CALL $9A5D    ; Update where Bilbo is, for the rest of this turn
 $9B60 POP HL        ; {Restore the real actor's record...
 $9B61 LD ($B5FC),HL ; }
 $9B64 POP AF        ; {...and the real actor
 $9B65 LD ($B5DB),A  ; }
 $9B68 POP HL        ; Restore the flag's address
 $9B69 XOR A         ; {Clear it, ready for next time
 $9B6A LD (HL),A     ;
 $9B6B RET           ; }

; Move the contents of an object
;
; Sets the location of every object held by object A to room B, and does the same for their contents. Clears $9B37 if Bilbo (object 0) is one of them.
c$9B6C PUSH IY       ; {Save IY and IX
 $9B6E PUSH IX       ; }
 $9B70 LD IX,$BF50   ; IX = just before the start of the object index
*$9B74 CALL $9B04    ; Look at the next object; IY = its own record
 $9B77 JR Z,$9B91    ; No more objects: finished
 $9B79 CP (IY+$01)   ; Is it held by the object we are moving?
 $9B7C JR NZ,$9B74   ; No: try the next one
 $9B7E LD (IY+$10),B ; Yes: its own location becomes room B too
 $9B81 PUSH AF       ; Save this object's number
 $9B82 LD A,(IX+$00) ; {Is this object Bilbo himself?
 $9B85 AND A         ;
 $9B86 JR NZ,$9B8B   ; }
 $9B88 LD ($9B37),A  ; If so, clear the "Bilbo moved" flag: he has now genuinely been placed in the new room
*$9B8B CALL $9B6C    ; Recursively move whatever THIS object holds too
 $9B8E POP AF        ; Restore the object's number
 $9B8F JR $9B74      ; Look for more things held by the original object
*$9B91 POP IX        ; {Restore IX and IY
 $9B93 POP IY        ;
 $9B95 RET           ; }

; How much room is left in a room?
;
; Returns in A the free space in room A: byte 1 of the room record is the room's capacity, from which the size (byte 2) of every ordinary object there is
; subtracted. Returns 0 if the room is overfull.
;
;  Input:A Room
; Output:A Free space
c$9B96 PUSH IX       ; {Save IX, IY and BC
 $9B98 PUSH IY       ;
 $9B9A PUSH BC       ; }
 $9B9B LD B,A        ; B = the room being asked about
 $9B9C CALL $9B0C    ; IX = its own record
 $9B9F LD A,(IX+$01) ; {C = its own total capacity
 $9BA2 LD C,A        ; }
 $9BA3 LD IX,$BF50   ; Search every object in the game...
*$9BA7 CALL $9AEE    ; Look at the next one; IY = its own record
 $9BAA JR Z,$9BC2    ; No more objects: finished (below)
 $9BAC LD A,(IY+$00) ; {Is it an ordinary, single-place object?
 $9BAF CP $01        ; }
 $9BB1 JR NZ,$9BA7   ; No (e.g. a door): does not count towards the room's capacity
 $9BB3 LD A,B        ; {Is it actually in the room we are asking about?
 $9BB4 CP (IY+$10)   ; }
 $9BB7 JR NZ,$9BA7   ; No: skip it
 $9BB9 LD A,C        ; {Yes: subtract its own size from the space left
 $9BBA SUB (IY+$02)  ; }
 $9BBD JR C,$9BC9    ; Already overfull: give up with 0 space left
 $9BBF LD C,A        ; Otherwise keep the smaller total
 $9BC0 JR $9BA7      ; Look for more objects
*$9BC2 LD A,C        ; A = the space left
 $9BC3 POP BC        ; {Restore BC, IY and IX
 $9BC4 POP IY        ;
 $9BC6 POP IX        ;
 $9BC8 RET           ; }
*$9BC9 LD C,$00      ; {Overfull: 0 space left
 $9BCB JR $9BC2      ; }

; Is the actor holding the target?
;
; Returns with carry set if the target ($B5D9) is held by the actor, directly or inside something the actor holds. The entry at $9BD0 does the same for object
; A. An object of $FF counts as held.
;
; Output:F Carry set if held
c$9BCD LD A,($B5D9)  ; A = the target of the current command
; This entry point is used by the routines at #R$8FE0, #R$946F and #R$9686.
*$9BD0 LD HL,$B5DB   ; HL = the address holding the current actor's number
; This entry point is used by the routine at #R$8C75.
*$9BD3 CP $FF        ; Is there no target at all ($FF)?
 $9BD5 SCF           ; {If so, treat that as "yes, held" (set the carry flag), since there is nothing to fail the test
 $9BD6 RET Z         ; }
 $9BD7 PUSH IX       ; Save the caller's IX
 $9BD9 CALL $9BDF    ; Is the target held, directly or indirectly, by whichever object's number is stored at HL?
 $9BDC POP IX        ; {Restore the caller's IX
 $9BDE RET           ; }

; Is object A inside the holder at (HL)?
;
; Follows the chain of holders of object A upwards; returns with carry set if (HL) is one of them.
c$9BDF CALL $9B25    ; IX = object A's own record
 $9BE2 PUSH AF       ; Save the object's number for later
 $9BE3 LD A,(IX+$01) ; A = whoever (or whatever) is holding it
 $9BE6 CP $FF        ; Is it held by nobody at all?
 $9BE8 JR Z,$9BF1    ; Yes: it cannot be inside the thing we are looking for
 $9BEA POP IX        ; No: throw away the saved object number from the stack (using IX only because it is a spare place to put it; A itself, still holding the
                     ; holder's number, is untouched)
 $9BEC CP (HL)       ; Is that holder the very thing we are testing against (the byte stored at HL)?
 $9BED JR NZ,$9BDF   ; Not yet: look inside the holder in turn, in case the object is nested more than one level deep
 $9BEF SCF           ; {Found it: set the carry flag to say so
 $9BF0 RET           ; }
*$9BF1 POP AF        ; Not held by anybody: restore the stack (the AF we saved earlier)
 $9BF2 AND A         ; {Clear the carry flag: not inside
 $9BF3 RET           ; }

; Random number from 0 to A
;
; Returns the absolute value of a random number from -A to A (#R$9BFD). Because of the way #R$9BFD squeezes its random byte into range, the results are not all
; equally likely: for A=4, 0 and 4 come up half as often as 1, 2 and 3; for A=3 the four results are equally likely; for A=9 the higher numbers are favoured.
;
;  Input:A Range
; Output:A Random number
c$9BF4 CALL $9BFD    ; Get a random number from -A to +A
 $9BF7 BIT 7,A       ; Is it negative (bit 7 set)?
 $9BF9 RET Z         ; No: a positive result is fine as it is
 $9BFA NEG           ; {Yes: make it positive, since this routine only ever wants a number from 0 upwards
 $9BFC RET           ; }

; Random number in a range
;
; Returns a random number in A in the range -C to +C (signed). The random byte is produced from the seed at $B5FE (set from the R register in #R$6C27), the
; counter at $B602 and a byte fetched from memory.
; .
; The random bytes come from memory itself. A 16-bit counter at $B602 is increased on every call and used as an address; the byte found there (and one a little
; further on) is mixed with the previous result. So the program code, the tables and even the ROM serve as the game's random number table, and the R register
; seed from the start of the game (#R$6C27) decides where the sequence begins. A result equal to the previous one is thrown away.
; .
; The way it narrows the random byte down to the range is unusual: B is set to 2*C, and then the random byte is halved (SRL A) until it is no more than B.
; Finally C is subtracted. Because 0-255 has to be halved several times, the upper half of the range gets far more than its share: with C=10, values 0-10 of the
; byte (results -10 to 0) mostly come only from the original byte being 0-10 directly, while 11-20 are hit by many different starting values. For C=10 the
; results come out approximately: each of -10 to -1: 1/256; 0: 16/256; +1 to +5: 31/256 each; +6 to +10: 15/256 each.
;
;  Input:C Range
; Output:A Random value from -C to +C
c$9BFD PUSH IX        ;
 $9BFF PUSH BC        ;
 $9C00 LD C,A         ; C = the range
 $9C01 SLA A          ; {B = twice the range...
 $9C03 JR NC,$9C07    ; }
 $9C05 LD A,$FF       ; {...capped at 255
*$9C07 LD B,A         ; }
*$9C08 LD IX,$B602    ; {Advance the 16-bit counter at $B602-$B603
 $9C0C INC (IX+$01)   ;
 $9C0F JR NZ,$9C14    ;
 $9C11 INC (IX+$00)   ; }
*$9C14 LD IX,($B602)  ; IX = the counter, used as an ADDRESS: it points somewhere in memory
 $9C18 LD A,($B5FE)   ; A = the seed...
 $9C1B ADC A,(IX+$00) ; ...plus the byte at that address...
 $9C1E ADD IX,DE      ; (move on by DE, whatever it happens to hold)
 $9C20 XOR (IX+$01)   ; {...exclusive-ORed with the byte after
 $9C23 PUSH HL        ;
 $9C24 LD HL,$B5FE    ; }
 $9C27 CP (HL)        ; {The same as the previous random number?
 $9C28 POP HL         ; }
 $9C29 JR Z,$9C08     ; Yes: try again
 $9C2B LD ($B5FE),A   ; Save it as the new seed
*$9C2E CP B           ; {Is it within 0 to 2 x range?
 $9C2F JR C,$9C38     ;
 $9C31 JR Z,$9C38     ; }
 $9C33 SRL A          ; {No: halve it and try again (this is what skews the results)
 $9C35 JP $9C2E       ; }
*$9C38 SUB C          ; {Subtract the range to give -range to +range
 $9C39 POP BC         ;
 $9C3A POP IX         ;
 $9C3C RET            ; }

; Total size of an object's contents
;
; As #R$9C42, but adding up the objects' sizes (byte 2) instead of their weights.
c$9C3D PUSH BC       ; TOTAL SIZE: save the caller's BC
 $9C3E LD B,$01      ; B=1 tells the shared routine below to add up sizes rather than weights
 $9C40 JR $9C45      ; Join the weight routine, which does the actual work

; Total weight of an object's contents
;
; Returns in A the total weight (byte 3) of everything held by object A, including the contents of containers, found by #R$9C55. The result is $FF if it
; overflows.
;
;  Input:A Object
; Output:A Weight
c$9C42 PUSH BC       ; TOTAL WEIGHT: save the caller's BC
 $9C43 LD B,$00      ; B=0 tells the shared routine below to add up weights
; This entry point is used by the routine at #R$9C3D.
*$9C45 PUSH IX       ; {Save the caller's IX and IY, which the search below will use
 $9C47 PUSH IY       ; }
 $9C49 LD C,$00      ; C will be the running total, starting at 0
 $9C4B CALL $9C55    ; Add up everything object A holds
 $9C4E LD A,C        ; A = the finished total
 $9C4F POP IY        ; {Restore the caller's IY and IX
 $9C51 POP IX        ; }
 $9C53 POP BC        ; {Restore the caller's BC
 $9C54 RET           ; }

; Add up the contents of an object
;
; Recursive worker for #R$9C42 and #R$9C3D: for each object held by object A, adds its weight (or size, if B=1) to C, and for weights also the weight of its
; contents. The overflow test uses JP PE.
c$9C55 PUSH IX        ; Save the caller's IX
 $9C57 LD IX,$BF53    ; IX = the start of the object index, ready to look at every object in the game in turn
*$9C5B CALL $9B04     ; Look at the next object: IY = its own record
 $9C5E JR Z,$9C84     ; Have we run out of objects (reached the index's terminator)?
 $9C60 CP (IY+$01)    ; No: is THIS object held by the one whose contents we are adding up?
 $9C63 JR NZ,$9C5B    ; It is not: move on and look at the next object
 $9C65 PUSH AF        ; It is: save the object we are adding up for a moment (it is not disturbed by anything above)
 $9C66 SUB A          ; {Are we totalling weight (B=0) or size (B=1)?
 $9C67 CP B           ; }
 $9C68 LD A,C         ; A = the running total so far
 $9C69 JR Z,$9C74     ; Weight wanted: add this object's own weight instead (skip down)
 $9C6B ADD A,(IY+$02) ; Size wanted: add this object's own size (byte 2 of its record)
 $9C6E JP PE,$9C87    ; Did that go past 255? Then the whole total is unknowable - give up
 $9C71 LD C,A         ; Otherwise keep the new, larger running total
 $9C72 JR $9C81       ; ...and go on to look inside this object too, in case it holds anything itself
*$9C74 ADD A,(IY+$03) ; Weight wanted: add this object's own weight (byte 3 of its record)
 $9C77 JP PE,$9C87    ; Did that go past 255? Then the whole total is unknowable - give up
 $9C7A LD C,A         ; Otherwise keep the new, larger running total
 $9C7B LD A,(IX+$00)  ; A = the object we just added in, so we can look inside it as well
 $9C7E CALL $9C55     ; Recursively add up whatever THAT object holds, in case it is itself a container
*$9C81 POP AF         ; Restore the object we are totalling up (saved earlier)
 $9C82 JR $9C5B       ; Go back and look for more objects held by it
*$9C84 POP IX         ; {No more objects anywhere: restore the caller's IX
 $9C86 RET            ; }
*$9C87 POP AF         ; OVERFLOW: throw away the object number we had saved
 $9C88 LD C,$FF       ; The total becomes $FF, meaning "too big to say exactly"
 $9C8A JR $9C84       ; Finish as normal

; Get the actor's room record
;
; Returns IX pointing at the record of the room the actor is in. AF is preserved.
c$9C8C PUSH AF       ; Save AF, so this can be used freely without upsetting the caller's flags
 $9C8D LD IX,($B5FC) ; IX = the current actor's own record
 $9C91 LD A,(IX+$10) ; A = the actor's location (the first location byte of their record)
 $9C94 CALL $9B0C    ; IX = that room's own record
 $9C97 POP AF        ; {Restore AF
 $9C98 RET           ; }

; Check for a dry run
;
; The command routines are run more than once: first as a 'dry run' to find out whether a command is possible (for example while the parser is choosing between
; two objects that fit the same noun), and then for real. The flag at $B5EB is 1 when the action should really happen. If it is not, this routine sets $B5EC to
; record that the action would have succeeded, discards its own return address and returns to the caller's caller, so the rest of the command routine is
; skipped. That is why the fight routine calls this after rolling the attack value but before doing anything that has a visible effect.
c$9C99 LD A,($B5EB)  ; {Is this action really happening, or is it only being tried out to see if it would work?
 $9C9C CP $01        ; }
 $9C9E RET Z         ; Really happening: carry on with the rest of the routine as normal
 $9C9F INC A         ; {Only a trial: record that it would succeed...
 $9CA0 LD ($B5EC),A  ; }
 $9CA3 POP BC        ; {...then throw away the return address of whoever called us, so control passes back one level further, skipping the part of the routine
 $9CA4 RET           ; that would actually change anything}

; Drop everything the target holds
;
; Loads the target and continues into #R$9CA8. Used when a container is emptied or broken.
c$9CA5 LD A,($B5D9)  ; A = the target of the current command (falls straight into #R$9CA8, which drops everything object A holds)

; Drop everything an object holds
;
; Makes everything held by object A the property of A's own holder (so things a dead character carried stay where it was). Things that evaporate (bit 1 of their
; flags) vanish instead, with 'X evaporates.'
c$9CA8 PUSH IY         ;
 $9CAA PUSH IX         ;
 $9CAC PUSH HL         ;
 $9CAD CALL $9B25      ; IX = the object's record
 $9CB0 LD B,(IX+$01)   ; B = its holder: its things will belong to that
 $9CB3 LD IX,$BF50     ; Go through every object
*$9CB7 CALL $9B04      ; Next object
 $9CBA JR Z,$9CE6      ; End of the list
 $9CBC CP (IY+$01)     ; Is it held by this object?
 $9CBF JR NZ,$9CB7     ; No: next
 $9CC1 BIT 1,(IY+$07)  ; Does it evaporate (bit 1)?
 $9CC5 JR Z,$9CE0      ; {No: pass it on
 $9CC7 PUSH AF         ; }
 $9CC8 LD (IY+$10),$00 ; Yes: it goes nowhere...
 $9CCC LD (IY+$01),$FF ; ...belongs to nobody...
 $9CD0 RES 7,(IY+$07)  ; ...and is invisible
 $9CD4 CALL $9E10      ; Print its name
 $9CD7 LD HL,$B035     ; {"evaporates."
 $9CDA CALL $72D4      ;
 $9CDD POP AF          ; }
 $9CDE JR $9CB7        ; Next
*$9CE0 LD (IY+$01),B   ; Give it to the object's own holder
 $9CE3 JP $9CB7        ; {Next
*$9CE6 POP HL          ;
 $9CE7 POP IX          ;
 $9CE9 POP IY          ;
 $9CEB RET             ; }

; Count the visible things an object holds
;
; Returns in A the number of visible objects (bit 7 of their flags set) held directly by object A.
;
;  Input:A Object
; Output:A Count
c$9CEC PUSH IX        ; {Save the caller's IX, IY and BC
 $9CEE PUSH IY        ;
 $9CF0 PUSH BC        ; }
 $9CF1 LD B,$00       ; B will be the running count, starting at 0
 $9CF3 LD IX,$BF50    ; IX = just before the start of the object index, so the first search below lands on its very first entry
*$9CF7 CALL $9B04     ; Look at the next object; IY = its own record
 $9CFA JR Z,$9D0B     ; Have we run out of objects?
 $9CFC CP (IY+$01)    ; No: is this object held by the one whose contents we are counting?
 $9CFF JR NZ,$9CF7    ; It is not: try the next one
 $9D01 BIT 7,(IY+$07) ; It is: is it visible (not, say, a locked-away thing nobody can see)?
 $9D05 JR Z,$9CF7     ; No: do not count it
 $9D07 INC B          ; Yes: one more to the count
 $9D08 JP $9CF7       ; Look for more
*$9D0B LD A,B         ; A = the final count
 $9D0C POP BC         ; Restore the caller's IY and BC
 $9D0D POP IY         ; Restore IY
 $9D0F POP IX         ; {Restore the caller's IX
 $9D11 RET            ; }

; Search a table of 3-byte entries
;
; Searches a table at IX made of 3-byte entries, each a one-byte key followed by a two-byte value, for the key in A. The table ends with $FF. Returns with IX
; pointing at the matching entry if found, or at the terminating $FF entry if not. The flags are set by a final CP $FF on the entry's own key: Z is SET when
; that key is $FF, so Z RESET (NZ) means the search succeeded and Z SET means it ran off the end without a match; equivalently, the carry flag is SET when the
; entry was found. This is easy to get backwards, so callers are shown branching on NZ/carry for success and Z for failure throughout this disassembly. Used for
; the object index (#R$BF53), the room-entry handlers (#R$C67D) and several other tables.
;
;  Input:A Key
;        IX Table
; Output:IX Matching entry, or the $FF terminator
;        F Z SET if not found (end of table); NZ or carry set if found
c$9D12 EXX           ; Switch to the alternate registers, so this search does not disturb the caller's own BC, DE and HL
 $9D13 PUSH IX       ; {HL = the table to search, taken from IX
 $9D15 POP HL        ; }
 $9D16 LD B,A        ; B = the key being searched for
 $9D17 LD E,$03      ; {DE = 3: the size of one entry, ready for stepping through the table
 $9D19 LD D,$00      ; }
*$9D1B LD A,(HL)     ; A = this entry's key
 $9D1C CP B          ; Does it match what we are looking for?
 $9D1D JR Z,$9D27    ; Yes: stop here, with this entry found
 $9D1F CP $FF        ; No: is this the table's $FF terminator, meaning there are no more entries?
 $9D21 JR Z,$9D27    ; Yes: stop here too, empty-handed
 $9D23 ADD HL,DE     ; Neither: move on to the next entry
 $9D24 JP $9D1B      ; ...and keep looking
*$9D27 PUSH HL       ; Whichever way we stopped, move the address we ended up at into IX...
 $9D28 POP IX        ; ...for the caller to use
 $9D2A CP $FF        ; Was that the $FF terminator (not found), or a genuine entry (found)? Z ends up SET when NOT found, so the caller should test NZ, or the
                     ; carry flag, for success
 $9D2C EXX           ; {Switch back to the caller's own registers
 $9D2D RET           ; }

; Find the next object that fits some words
;
; Continues a search of the object index (from IX) for an object whose words match the noun and adjectives at HL (#R$71EA). The object must also match the
; filter in $B600: 0 for things that are not characters, 1 for characters, 2 for anything. Unless $B5FF says reach does not matter, the object must also be in
; the same place as the actor (#R$9D86). Returns the object in A, or $FF when there are no more.
c$9D2E PUSH BC       ; {Save the caller's BC, DE and IY
 $9D2F PUSH DE       ;
 $9D30 PUSH IY       ; }
 $9D32 LD IY,($B5FC) ; IY = the current actor's own record
 $9D36 LD D,(IY+$10) ; D = the actor's room, in case the object must be close by to count
 $9D39 LD A,($B600)  ; A = the filter the caller wants: 0 things that are not characters, 1 characters, 2 anything at all
 $9D3C LD E,A        ; E = that filter, kept for the tests below
*$9D3D CALL $9AEE    ; Look at the next entry of the object index; A = its object number, Z set once we run out
 $9D40 JR Z,$9D6F    ; No more objects: give up (A is left holding $FF)
 $9D42 LD A,$02      ; {Does the caller want absolutely anything (filter 2)?
 $9D44 CP E          ; }
 $9D45 JR Z,$9D56    ; Yes: skip the character/object test below entirely
 $9D47 LD A,(IY+$07) ; No: A = this object's flags
 $9D4A AND $48       ; Keep only whether it is alive and whether it is dead
 $9D4C CP $40        ; Is it alive and NOT dead, i.e. a proper living character?
 $9D4E LD A,$00      ; Assume it is not a character (0)...
 $9D50 JR NZ,$9D53   ; ...unless it just proved to be alive and undead, in which case...
 $9D52 INC A         ; ...it counts as a character (1)
*$9D53 CP E          ; Does that match what the caller asked for?
 $9D54 JR NZ,$9D3D   ; No: try the next object
*$9D56 LD BC,$0008   ; BC = 8: the offset, from the start of an object's record, to its own four word slots
 $9D59 PUSH IY       ; Save IY (the object's record) for a moment
 $9D5B ADD IY,BC     ; IY = the object's word slots
 $9D5D CALL $71EA    ; Do the noun and adjectives at HL match this object's own words?
 $9D60 POP IY        ; Restore IY, the object's record
 $9D62 JR NZ,$9D3D   ; No match: try the next object
 $9D64 LD A,($B5FF)  ; {A match on words. Does this particular action not care whether the object is within reach?
 $9D67 AND A         ; }
 $9D68 JR NZ,$9D6F   ; It does not care: accept this object regardless of where it is
 $9D6A CALL $9D86    ; It does care: is the object near the actor?
 $9D6D JR Z,$9D3D    ; No: try the next object
*$9D6F LD A,(IX+$00) ; A = the object we settled on (or $FF if we ran right out)
 $9D72 POP IY        ; {Restore the caller's IY, DE and BC
 $9D74 POP DE        ;
 $9D75 POP BC        ;
 $9D76 RET           ; }

; Can the object at IY be seen from IX?
;
; Swaps IX and IY around a call to #R$9D92.
c$9D77 CALL $9D7D    ; Swap IX and IY over, so that whichever object was "the one being looked at" (IY) becomes "the one doing the looking" (IX), and vice versa
 $9D7A CALL $9D92    ; Now test whether the two are in the same place, with them the right way round for that test
*$9D7D PUSH IX       ; {(This same code, reused: falling in here after the test above swaps IX and IY straight back again, and its own RET then returns from
 $9D7F PUSH IY       ; this whole routine)
 $9D81 POP IX        ;
 $9D83 POP IY        ;
 $9D85 RET           ; }

; Is the object near the actor?
;
; Calls #R$9D92 with IX = the actor's record: returns with Z reset if the object at IY is in the same place as the actor.
c$9D86 PUSH IX       ; Save the caller's IX
 $9D88 LD IX,($B5FC) ; IX = the current actor's own record
 $9D8C CALL $9D92    ; Is the object at IY in the same place as the actor?
 $9D8F POP IX        ; {Restore the caller's IX
 $9D91 RET           ; }

; Are two objects in the same place?
;
; Returns with Z reset if the object at IY is visible (bit 7 of its flags) and is in the same place as the object at IX.
; .
; Each object's outermost holder is found with #R$9DC8, which returns $FF for an object lying loose in a room and 0 for one that is shut inside something (or
; held by a living character). If the results differ, the objects are not together. If both are loose, IX's room must be one of IY's locations. If both are 0,
; the room comparison is skipped and they count as together - see the bug note.
c$9D92 BIT 7,(IY+$07) ; Is the IY object visible at all?
 $9D96 RET Z          ; {No: return with Z set
 $9D97 PUSH IY        ;
 $9D99 PUSH IX        ;
 $9D9B PUSH BC        ; }
 $9D9C LD C,(IX+$10)  ; {C = the IX object's room
 $9D9F PUSH IY        ; }
 $9DA1 CALL $9DC8     ; {Where is the IY object ultimately?
 $9DA4 LD B,A         ;
 $9DA5 POP IX         ; }
 $9DA7 CALL $9DC8     ; Where is the IX object ultimately?
 $9DAA CP B           ; The same answer?
 $9DAB JR NZ,$9DBD    ; No: not together
 $9DAD INC A          ; Both shut inside something ($00)?
 $9DAE JR NZ,$9DC0    ; Then count them as together
 $9DB0 LD B,(IY+$00)  ; {Both loose: is the IX object's room one of the IY object's locations?
 $9DB3 LD A,C         ;
*$9DB4 CP (IY+$10)    ; }
 $9DB7 JR Z,$9DC0     ; {Yes: together
 $9DB9 INC IY         ;
 $9DBB DJNZ $9DB4     ; }
*$9DBD XOR A          ; {Not together: Z set
 $9DBE JR $9DC2       ; }
*$9DC0 OR $01         ; {Together: Z reset
*$9DC2 POP BC         ;
 $9DC3 POP IX         ;
 $9DC5 POP IY         ;
 $9DC7 RET            ; }

; Find the outermost holder
;
; Follows the chain of holders of the object at IX upwards, as long as each holder is open (bit 5) or dead (bit 3): you can see into an open box or a dead
; character's pockets. Returns $FF if the chain ends with the object (or an open container holding it) loose in a room, and 0 if it ends at a closed container
; or a living character.
c$9DC8 PUSH IX       ;
*$9DCA LD A,(IX+$01) ; A = the holder
 $9DCD CP $FF        ; Nobody?
 $9DCF JR Z,$9DDB    ; Then the object is loose: return $FF
 $9DD1 CALL $9B25    ; IX = the holder's record
 $9DD4 LD A,(IX+$07) ; {Is the holder open or dead?
 $9DD7 AND $28       ; }
 $9DD9 JR NZ,$9DCA   ; Yes: see through it and look at its holder
*$9DDB POP IX        ; {No: return 0 (shut in)
 $9DDD RET           ; }

; Get the actor's room's exits
;
; Returns IX pointing seven bytes into the actor's room record, so that #R$9AEE, which adds 3, arrives at the first exit.
c$9DDE PUSH DE       ; Save the caller's DE
 $9DDF CALL $9C8C    ; IX = the current actor's room's own record
 $9DE2 LD DE,$0007   ; {A room's list of exits starts 7 bytes into its record
 $9DE5 ADD IX,DE     ; }
 $9DE7 POP DE        ; {Restore the caller's DE
 $9DE8 RET           ; }

; Find the next room that fits some words
;
; Searches the exits of the actor's room for one whose destination room has the words at HL, so that rooms can be named as targets ('go into the tunnel').
; Returns the room number in A, or $FF.
c$9DE9 PUSH IY       ; {Save the caller's IY and DE
 $9DEB PUSH DE       ; }
 $9DEC LD DE,$0002   ; DE = 2: the offset, from the start of a room's record, to its own name words
*$9DEF CALL $9AEE    ; Look at the next exit of the actor's room; A = its direction, Z set once there are no more
 $9DF2 JR Z,$9E0C    ; No more exits to try: give up
 $9DF4 LD A,(IX+$02) ; A = this exit's destination room
 $9DF7 PUSH IX       ; Save the exit-table pointer for a moment
 $9DF9 CALL $9B0C    ; IX = the destination room's own record
 $9DFC PUSH IX       ; {Copy that into IY as well...
 $9DFE POP IY        ; }
 $9E00 POP IX        ; ...then restore IX, back to the exit we are examining
 $9E02 ADD IY,DE     ; IY = the destination room's name words
 $9E04 CALL $71EA    ; Do the noun and adjectives at HL match that room's name?
 $9E07 JR NZ,$9DEF   ; No: try the next exit
 $9E09 LD A,(IX+$02) ; Yes: A = this exit's destination room, the answer we want
*$9E0C POP DE        ; {Restore the caller's DE and IY
 $9E0D POP IY        ;
 $9E0F RET           ; }

; Print an object's name
;
; Prints the words of the object whose record is at IY (#R$9E1F on its word slots).
c$9E10 PUSH IY       ; {Save the caller's IY and DE
 $9E12 PUSH DE       ; }
 $9E13 LD DE,$0008   ; {An object's own word slots start 8 bytes into its record
 $9E16 ADD IY,DE     ; }
 $9E18 CALL $9E1F    ; Print the noun and its adjectives
 $9E1B POP DE        ; {Restore the caller's DE and IY
 $9E1C POP IY        ;
 $9E1E RET           ; }

; Print a noun with its adjectives
;
; IY points to a word list: noun, then up to two adjectives. The article is printed first (#R$7436, unless $B5F4 is set), then the adjectives, and then the noun
; (with an article if $B5F4 is set). So 'curious map' comes out as 'a curious map'.
c$9E1F PUSH AF       ; {Save AF and DE
 $9E20 PUSH DE       ; }
 $9E21 LD A,($B5F4)  ; {Does the caller want an article before the whole phrase (rather than before each adjective)?
 $9E24 CP $00        ; }
 $9E26 JR NZ,$9E43   ; Yes: skip straight to printing the noun with its article
 $9E28 LD D,(IY+$01) ; {No: DE = the first adjective, if there is one
 $9E2B LD E,(IY+$00) ; }
 $9E2E CALL $7436    ; Print its article ("a curious ...")
 $9E31 LD E,(IY+$02) ; {DE = the first adjective word itself
 $9E34 LD D,(IY+$03) ; }
 $9E37 CALL $74B8    ; Print it
 $9E3A LD E,(IY+$04) ; {DE = the second adjective, if there is one
 $9E3D LD D,(IY+$05) ; }
 $9E40 CALL $74B8    ; Print it (an empty slot simply prints nothing)
*$9E43 LD E,(IY+$00) ; {DE = the noun
 $9E46 LD D,(IY+$01) ; }
 $9E49 LD A,D        ; {Is there actually a noun here at all?
 $9E4A OR E          ; }
 $9E4B CALL NZ,$746F ; If so, print it (with an article too, if the caller asked for one before the whole phrase)
 $9E4E POP DE        ; {Restore DE and AF
 $9E4F POP AF        ;
 $9E50 RET           ; }

; Find a usable exit in a direction
;
; Searches the exits of the actor's room for one in direction A that has a destination. Returns the direction in A, or $FF (Z set) if there is none.
c$9E51 PUSH BC       ; {Save the caller's BC and IY
 $9E52 PUSH IY       ; }
 $9E54 LD B,A        ; B = the direction we are looking for
 $9E55 CALL $9DDE    ; IX = the start of the actor's room's exits
*$9E58 CALL $9AEE    ; Look at the next exit; A = its direction, Z set once there are no more
 $9E5B JR Z,$9E6A    ; No more exits: give up (A is left holding $FF)
 $9E5D LD A,(IX+$02) ; {Does this exit actually lead anywhere?
 $9E60 AND A         ; }
 $9E61 JR Z,$9E58    ; No destination (a dead end): skip it and keep looking
 $9E63 LD A,(IX+$00) ; A = this exit's direction
 $9E66 CP B          ; Is it the one we want?
 $9E67 JP NZ,$9E58   ; No: try the next exit
*$9E6A POP IY        ; {Found it (or ran out): restore the caller's IY and BC
 $9E6C POP BC        ;
 $9E6D RET           ; }

; Find the exit through the target
;
; Loads the target and continues into #R$9E71: finds the exit of the actor's room that goes through the target (a door, a window, a river).
c$9E6E LD A,($B5D9)  ; A = the target of the current command (a door, window or river; falls into #R$9E71, which finds the room's exit through it)

; Find the exit through a given door
;
; Searches the actor's room for an exit whose door (byte 1) is object A. This routine and #R$9E76 are one routine: they write 1 or 2 into the offset of the LD
; A,(IX+n) instruction at $9E89 to choose which byte of each exit is compared.
c$9E71 PUSH AF       ; FIND EXIT THROUGH A DOOR: save AF
 $9E72 LD A,$01      ; 1 picks out an exit's DOOR byte for the shared code below
 $9E74 JR $9E79      ; Join it

; Find the exit that leads to a room
;
; Searches the actor's room for an exit whose destination (byte 2) is room A; see #R$9E71.
c$9E76 PUSH AF       ; FIND EXIT TO A ROOM: save AF
 $9E77 LD A,$02      ; 2 picks out an exit's DESTINATION byte instead
; This entry point is used by the routine at #R$9E71.
*$9E79 LD ($9E8B),A  ; Poke that choice into the instruction below, so the very same code can compare either byte depending on which entry point was used
 $9E7C POP AF        ; Restore AF
 $9E7D PUSH BC       ; {Save the caller's BC and IY
 $9E7E PUSH IY       ; }
 $9E80 LD B,A        ; B = the door (or destination room) we are looking for
 $9E81 CALL $9DDE    ; IX = the start of the actor's room's exits
*$9E84 CALL $9AEE    ; Look at the next exit; Z set once there are no more
 $9E87 JR Z,$9E8F    ; No more exits: give up
 $9E89 LD A,(IX+$02) ; A = this exit's door, or its destination, whichever this call was asked to check
 $9E8C CP B          ; Does it match?
 $9E8D JR NZ,$9E84   ; No: try the next exit
*$9E8F POP IY        ; {Found it (or ran out): restore the caller's IY and BC
 $9E91 POP BC        ;
 $9E92 RET           ; }

; Run a handler with target and instrument swapped
;
; Exchanges the target and the instrument (their numbers and record addresses), calls the handler at HL, and swaps them back. This lets one handler serve two
; ways of saying the same thing: FILL THE BOTTLE WITH WATER becomes PUT THE WATER IN THE BOTTLE (#R$8ED3), and THROW THE SWORD AT THORIN becomes ATTACK THORIN
; WITH THE SWORD (#R$8F5F).
c$9E93 LD DE,($B5F8) ; DE = the target's own record address
 $9E97 LD IY,($B5FA) ; IY = the instrument's own record address
 $9E9B LD ($B5F8),IY ; The instrument's record becomes the new "target"...
 $9E9F LD ($B5FA),DE ; ...and the target's record becomes the new "instrument"
 $9EA3 LD BC,($B5D9) ; BC = the current target and instrument object numbers (C=target, B=instrument)
 $9EA7 LD A,B        ; A = the instrument's number...
 $9EA8 LD ($B5D9),A  ; ...which becomes the new target
 $9EAB LD A,C        ; A = the (old) target's number...
 $9EAC LD ($B5DA),A  ; ...which becomes the new instrument
 $9EAF CALL $9AC7    ; Run the handler, with the two swapped over as far as it can tell
 $9EB2 LD ($B5D9),BC ; Put the target and instrument numbers back exactly as they were
 $9EB6 LD ($B5F8),DE ; {Put the target and instrument records back too
 $9EBA LD ($B5FA),IY ;
 $9EBE RET           ; }

; Report failure
;
; During a dry run, sets $B5EC to 0 (the action would not work). When the action is really being done, reports it instead (#R$7122), so the player sees 'you
; cannot ...'.
c$9EBF LD A,($B5EB)  ; {Is this action really happening (not just being tried out)?
 $9EC2 DEC A         ; }
 $9EC3 JP Z,$7122    ; Yes: report it as an outright failure ("you cannot ...")
 $9EC6 SUB A         ; {Only a trial: just note that it would not have worked, without printing anything
 $9EC7 LD ($B5EC),A  ;
 $9ECA RET           ; }

; Get an object's room
;
; Returns the room of object A (its first location byte), or $FF if it is a door or other multi-place object, or if A is $FF.
;
;  Input:A Object
; Output:A Room
c$9ECB CP $FF        ; Is there no object at all ($FF)?
 $9ECD RET Z         ; If so, there is no room to report either
 $9ECE CALL $9B25    ; IX = the object's own record
 $9ED1 LD A,$01      ; {Does it occupy just one place (an ordinary object, not a door or the like)?
 $9ED3 CP (IX+$00)   ; }
 $9ED6 LD A,$FF      ; {Assume not: return $FF, meaning "no single room"
 $9ED8 RET NZ        ; }
 $9ED9 LD A,(IX+$10) ; {It does: A = its one location, the answer
 $9EDC RET           ; }

; List what can be seen in the room
;
; Prints 'you see :' and the objects and characters lying loose in the actor's room (#R$9EF8), or '      nothing'.
c$9EDD PUSH IY       ; {Save the caller's IY, AF and BC
 $9EDF PUSH AF       ;
 $9EE0 PUSH BC       ; }
 $9EE1 LD HL,$AEF5   ; {"you see :"
 $9EE4 CALL $72D4    ; }
 $9EE7 LD A,$FF      ; A = $FF, meaning "held by nobody", i.e. lying loose in the room
 $9EE9 LD IY,($B5FC) ; IY = the actor's own record
 $9EED LD B,(IY+$10) ; B = the actor's room
 $9EF0 CALL $9EF8    ; List everything lying loose there
 $9EF3 POP BC        ; {Restore the caller's BC, AF and IY
 $9EF4 POP AF        ;
 $9EF5 POP IY        ;
 $9EF7 RET           ; }

; List the objects held by A in room B
;
; Lists the objects (#R$9F10) and prints '      nothing' if there were none.
c$9EF8 PUSH IY       ; {Save the caller's IY, DE and BC
 $9EFA PUSH DE       ;
 $9EFB PUSH BC       ; }
 $9EFC LD C,$00      ; C will count how many things get printed
 $9EFE LD D,$04      ; D = 4, meaning "no indent yet", since this is a fresh list rather than something nested inside another
 $9F00 CALL $9F10    ; List the objects, updating the count in C as it goes
 $9F03 SUB A         ; {Was anything at all printed?
 $9F04 CP C          ; }
 $9F05 LD HL,$B22D   ; "      nothing"
 $9F08 CALL Z,$72D4  ; If nothing was printed, say so
 $9F0B POP BC        ; {Restore the caller's BC, DE and IY
 $9F0C POP DE        ;
 $9F0D POP IY        ;
 $9F0F RET           ; }

; List objects, with their contents
;
; Prints each visible object held by A (A=$FF for loose objects) that is in room B, one per line, each followed by a full stop. After each one, its contents are
; listed by a recursive call, indented two more characters (D, stored at $7692 for #R$7694), with a heading from #R$9F89 such as 'gandalf is carrying' or 'in
; the chest there is'. The actor's own possessions are not listed when looking round the room. C counts the objects printed.
c$9F10 PUSH HL       ; Save the caller's HL
 $9F11 LD L,A        ; L = the holder we are listing the contents of (or $FF for "lying loose")
 $9F12 LD A,($7692)  ; A = whatever indent is currently in use, from an earlier, outer call to this same routine
 $9F15 LD H,A        ; H = that old indent, kept alongside the holder in L for a moment
 $9F16 LD A,D        ; A = the new indent this call should use
 $9F17 LD ($7692),A  ; Set it as the printer's current indent
 $9F1A LD A,L        ; A = the holder again
 $9F1B EX (SP),HL    ; Swap: put (old indent, holder) safely on the stack, and get the real, original HL back
 $9F1C PUSH IX       ; Save the caller's IX
 $9F1E LD IX,$BF50   ; IX = just before the start of the object index, so the search below starts at its very first entry
*$9F22 CALL $9B04    ; Look at the next object; IY = its own record
 $9F25 JR Z,$9F7F    ; Have we run out of objects?
 $9F27 CP (IY+$01)   ; No: is this object held by the one we are listing the contents of?
 $9F2A JR NZ,$9F22   ; It is not: try the next object
 $9F2C PUSH AF       ; It is: save this object's number for a moment
 $9F2D LD A,$01      ; {Does it occupy only a single place (not a door or the like)?
 $9F2F CP (IY+$00)   ; }
 $9F32 JR NZ,$9F76   ; No: doors and similar things are never listed as "contents"
 $9F34 LD A,(IY+$10) ; A = this object's own room
 $9F37 CP B          ; Is it really in the room we are listing (rather than, say, tucked inside something else there)?
 $9F38 JR NZ,$9F76   ; No: skip it
 $9F3A LD A,($B5DB)  ; {Is the current actor the very object whose contents we are printing...
 $9F3D CP (IX+$00)   ; }
 $9F40 JR NZ,$9F47   ; ...(if not, always list it - this next check is only about the actor's own belongings)
 $9F42 LD A,$04      ; {...and is this the outermost call, not one nested inside a container?
 $9F44 CP D          ; }
 $9F45 JR Z,$9F76    ; Both true: this is the actor's own possession, and the room listing should not repeat it - skip it
*$9F47 CALL $9D86    ; Otherwise: can the actor actually see this object (is it close enough)?
 $9F4A JR Z,$9F76    ; No: skip it
 $9F4C INC C         ; Yes: count it
 $9F4D SUB A         ; {No forced capital letter for this printing...
 $9F4E LD ($B5F5),A  ; }
 $9F51 LD ($B5F4),A  ; ...and no article added before the whole name
 $9F54 CALL $9E10    ; Print the object's name
 $9F57 LD A,($B5DB)  ; {Are we listing what the CURRENT ACTOR is carrying (rather than something else)?
 $9F5A CP (IX+$00)   ; }
 $9F5D JR Z,$9F7A    ; If so, no full stop is wanted here - the actor's own heading handles that separately
 $9F5F LD A,$2E      ; {Otherwise print a full stop...
 $9F61 CALL $7580    ; }
 $9F64 LD A,(IX+$00) ; A = the object just printed
 $9F67 CALL $9F89    ; Print the heading for whatever IT holds ("X is carrying", "in the Y there is") - and find out whether it has anything worth listing
 $9F6A JR C,$9F76    ; Nothing to list inside it (or it is closed): do not recurse
 $9F6C LD A,(IX+$00) ; A = the object again
 $9F6F PUSH DE       ; Save the indent (D) for a moment
 $9F70 INC D         ; {Indent two spaces further in, for its own contents...
 $9F71 INC D         ; }
 $9F72 CALL $9F10    ; ...and list them, calling this same routine again
 $9F75 POP DE        ; Restore the indent
*$9F76 POP AF        ; Restore the object's number
 $9F77 JP $9F22      ; Try the next object in the index
*$9F7A CALL $7578    ; {(Top-level listing: just a new line, with no full stop)
 $9F7D JR $9F76      ; }
*$9F7F POP IX        ; Out of objects: restore the caller's IX
 $9F81 EX (SP),HL    ; Recover the (old indent, holder) pair saved earlier, putting the real HL safely back on the stack
 $9F82 LD A,H        ; {Restore the caller's own indent...
 $9F83 LD ($7692),A  ; }
 $9F86 LD A,L        ; ...(A is left holding the holder, though nothing further uses it)
 $9F87 POP HL        ; {Restore the caller's real HL
 $9F88 RET           ; }

; Print the heading for a list of contents
;
; For object A: if it is closed and not dead (bits 3 and 5 of the flags clear), or holds nothing visible, a new line is printed and the routine returns with
; carry set. Otherwise, for a character, 'X is carrying'; for anything else a heading chosen by the low four bits of byte 4 of the object's record, from the
; message at $AEBD: IN (0), ON (1), BEHIND (2), UNDER (3) or TIED TO (4), followed by 'there is' or 'there are' - so 'behind the heavy curtain there is a wall'
; and 'under the trap door there is the goblins cache'.
c$9F89 PUSH IX        ; {Save the caller's IX, BC and DE
 $9F8B PUSH BC        ;
 $9F8C PUSH DE        ; }
 $9F8D LD C,A         ; C = the object whose contents we are about to introduce
 $9F8E CALL $9B25     ; IX = its own record
 $9F91 LD A,(IX+$07)  ; A = its flags
 $9F94 AND $28        ; Keep only whether it is closed and whether it is dead
 $9F96 JR Z,$9FD8     ; Neither closed-and-alive nor dead: nothing worth a heading (an ordinary open container falls through here fine; this only stops things
                      ; that are shut away)
 $9F98 LD A,C         ; A = the object again
 $9F99 CALL $9CEC     ; {How many visible things does it hold?
 $9F9C CP $00         ; }
 $9F9E JR Z,$9FD8     ; None at all: no heading needed either
 $9FA0 BIT 6,(IX+$07) ; Is it a living character?
 $9FA4 JR Z,$9FAD     ; No: use the ordinary IN/ON/BEHIND/UNDER/TIED-TO wording instead
 $9FA6 LD A,C         ; {Yes: push its own number as the message parameter...
 $9FA7 PUSH AF        ; }
 $9FA8 LD HL,$ACEC    ; ..."X is carrying"
 $9FAB JR $9FCF       ; Skip the ordinary wording below
*$9FAD LD HL,$039F    ; "is"
 $9FB0 DEC A          ; {Is there only a single thing inside (so "is" is right rather than "are")?
 $9FB1 JR Z,$9FB6     ; }
 $9FB3 LD HL,$0065    ; More than one: "are" instead
*$9FB6 PUSH HL        ; Push IS or ARE as a message parameter
 $9FB7 LD L,(IX+$08)  ; {HL = the object's own words (so the heading can name it: "in the chest")...
 $9FBA LD A,(IX+$09)  ;
 $9FBD AND $0F        ;
 $9FBF LD H,A         ; }
 $9FC0 PUSH HL        ; ...pushed as another message parameter
 $9FC1 LD HL,$AEBD    ; HL = the shared IN/ON/BEHIND/UNDER/TIED-TO message
 $9FC4 LD A,(IX+$04)  ; A = the object's attribute byte, whose low bits say how its contents should be introduced
 $9FC7 RLCA           ; {Shift that containment word up...
 $9FC8 RLCA           ; }
 $9FC9 AND $3C        ; {...into an index, since each choice of wording is 4 bytes further into the message
 $9FCB LD E,A         ;
 $9FCC LD D,$00       ; }
 $9FCE ADD HL,DE      ; HL = the exact wording for this object's own containment style
*$9FCF CALL $72D4     ; Print the whole heading
 $9FD2 AND A          ; Clear the carry flag: there is something to list after all
*$9FD3 POP DE         ; {Restore the caller's DE, BC and IX
 $9FD4 POP BC         ;
 $9FD5 POP IX         ;
 $9FD7 RET            ; }
*$9FD8 CALL $7578     ; Nothing worth a heading: just move to a new line
 $9FDB SCF            ; Set the carry flag: there is nothing to list
 $9FDC JR $9FD3       ; Join the shared ending above

; Get the start of a room's exits
;
; Returns IX pointing seven bytes into room A's record and BC=3, ready for stepping through its exits.
c$9FDE CALL $9B0C    ; IX = room A's own record
 $9FE1 LD BC,$0007   ; {A room's exits start 7 bytes into its record
 $9FE4 ADD IX,BC     ; }
 $9FE6 LD BC,$0003   ; {BC = 3: the size of one exit, ready for the caller to step through them
 $9FE9 RET           ; }

; Get the word for a direction
;
; Returns in DE the word for direction A, from the table at $A13E (NORTH, SOUTH, EAST, WEST, NORTHEAST ... UP, DOWN). The entry at $9FED looks up another table
; at HL.
;
;  Input:A Direction
; Output:DE Word
c$9FEA LD HL,$A13E   ; HL = the table of direction words
; This entry point is used by the routine at #R$A09C.
*$9FED LD E,A        ; E = the direction (1-10)...
 $9FEE RES 7,E       ; {...with any stray extra bit cleared
 $9FF0 LD D,$00      ; }
 $9FF2 ADD HL,DE     ; HL = this direction's own entry...
 $9FF3 ADD HL,DE     ; ...doubled, since each word reference is 2 bytes
 $9FF4 LD E,(HL)     ; {DE = the word, read from the table (low byte)...
 $9FF5 INC HL        ; }
 $9FF6 LD D,(HL)     ; {...then the high byte
 $9FF7 RET           ; }

; Describe the doors of a room
;
; For each exit of room A that has a visible door, prints 'to the east there is the round green door' (or 'above'/'below' for up and down).
c$9FF8 PUSH BC        ; {Save the caller's BC, DE, IY and IX
 $9FF9 PUSH DE        ;
 $9FFA PUSH IY        ;
 $9FFC PUSH IX        ; }
 $9FFE CALL $9FDE     ; IX = the start of room A's exits, BC = 3 (the size of each one)
 $A001 ADD IX,BC      ; Step back one exit's width, so the loop below lands on the very first exit the first time round
 $A003 PUSH IX        ; {IY will be the loop's own pointer, a copy of IX
 $A005 POP IY         ; }
*$A007 SUB A          ; {Is this the very first exit (guards against a room with no exits at all)?
 $A008 CP (IY+$01)    ; }
 $A00B JR Z,$A043     ; It is: there is nothing to describe yet, so skip straight to moving on
 $A00D LD A,(IY+$01)  ; A = this exit's door object
 $A010 CALL $9B25     ; IX = the door's own record
 $A013 BIT 7,(IX+$07) ; Is the door visible?
 $A017 JR Z,$A043     ; No: say nothing about it and move on
 $A019 LD DE,$0008    ; DE = 8: the offset, from the start of a record, to an object's own words
 $A01C ADD IX,DE      ; IX = the door's own words
 $A01E PUSH IX        ; Save that for a moment
 $A020 LD A,(IY+$00)  ; A = this exit's direction
 $A023 CALL $9FEA     ; DE = the word for that direction
 $A026 CP $09         ; Is the direction UP or DOWN (9 or 10)?
 $A028 JR C,$A034     ; No: use the ordinary "to the <direction> there is" wording
 $A02A LD DE,$07B9    ; "above"
 $A02D JR Z,$A03A     ; It was UP: use that word
 $A02F LD DE,$082F    ; "below"
 $A032 JR $A03A       ; It was DOWN: use that word instead
*$A034 LD HL,$AD0A    ; {"to the <direction> there is"
 $A037 CALL $72D4     ; }
*$A03A CALL $74B8     ; Print the direction word (or "above"/"below")
 $A03D LD HL,$AF05    ; "the <door>."
 $A040 CALL $72D4     ; Print it, naming the door
*$A043 ADD IY,BC      ; Move on to the next exit
 $A045 LD A,$FF       ; {Have we reached the end of the exits?
 $A047 CP (IY+$00)    ; }
 $A04A JP NZ,$A007    ; Not yet: look at this next one
 $A04D POP IX         ; {Finished: restore the caller's IX, IY, DE and BC
 $A04F POP IY         ;
 $A051 POP DE         ;
 $A052 POP BC         ;
 $A053 RET            ; }

; Find the next visible exit
;
; Steps IX to the next exit that has a direction and no door. Returns with Z set at the end of the exits.
c$A054 ADD IX,BC     ; Move on to the next exit
 $A056 LD A,$FF      ; {Have we reached the end of the exits?
 $A058 CP (IX+$00)   ; }
 $A05B RET Z         ; Yes: give up
 $A05C XOR A         ; {Does this exit have a door?
 $A05D CP (IX+$01)   ; }
 $A060 JR NZ,$A054   ; It does: it is not a "visible" exit in the sense wanted here, so skip it
 $A062 CP (IX+$00)   ; Does it even have a direction at all?
 $A065 JR Z,$A054    ; No direction (an unused slot): skip that too
 $A067 RET           ; Found a plain, doorless exit

; List the visible exits
;
; Prints 'visible exits are :' followed by the direction of every exit that has no door (#R$A054), or nothing at all if there are none.
c$A068 PUSH IX       ;
 $A06A PUSH IY       ;
 $A06C PUSH DE       ;
 $A06D PUSH BC       ;
 $A06E CALL $9FDE    ; IX = the room's exits
 $A071 CALL $A054    ; Find the first exit without a door
 $A074 JR Z,$A08D    ; None: print nothing
 $A076 LD HL,$AF12   ; {"visible exits are :"
 $A079 CALL $72D4    ; }
*$A07C LD A,(IX+$00) ; A = the exit's direction
 $A07F CALL $9FEA    ; DE = its word
 $A082 CALL $74B8    ; Print it
 $A085 CALL $A054    ; Next exit without a door
 $A088 JR NZ,$A07C   ; Loop
 $A08A CALL $7578    ; {New line
*$A08D POP BC        ;
 $A08E POP DE        ;
 $A08F POP IY        ;
 $A091 POP IX        ;
 $A093 RET           ; }

; "The X is Y" (instrument)
;
; As #R$A09C, for the object at IY.
c$A094 LD L,(IY+$08) ; {INSTRUMENT VERSION: HL = the instrument's own words...
 $A097 LD H,(IY+$09) ; }
 $A09A JR $A0A2      ; Join the shared code below

; "The X is Y"
;
; Explains why an action failed by describing the state of the object at IX: 'the door is locked.', 'the chest is closed.', 'the bottle is empty.' The low bits
; of A choose the flag bit that was wrong, and bit 7 whether it was set or clear; the word comes from the tables at $A154 (UNLOCKED, EMPTY, OFF, CLOSED, DEAD)
; and $A164 (LOCKED, FULL, BROKEN, ON, OPEN, ALIVE).
;
; Input:A State
;       IX Object record
c$A09C LD L,(IX+$08) ; {TARGET VERSION: HL = the target's own words...
 $A09F LD H,(IX+$09) ; }
; This entry point is used by the routine at #R$A094.
*$A0A2 PUSH DE       ; Save the caller's DE
 $A0A3 PUSH HL       ; Push the object's own words, so the message below can name it
 $A0A4 LD HL,$A154   ; HL = the wording for a CLEAR flag (unlocked, empty, off, closed, dead)...
 $A0A7 BIT 7,A       ; {...unless the state we were given says the flag is actually SET...
 $A0A9 JR Z,$A0AE    ; }
 $A0AB LD HL,$A164   ; ...in which case use the SET wording instead (locked, full, broken, on, open, alive)
*$A0AE CALL $9FED    ; DE = the exact word for this particular state
 $A0B1 POP HL        ; Recover the object's own words for a moment...
 $A0B2 PUSH DE       ; ...push the state word first...
 $A0B3 PUSH HL       ; ...then the object's words back on top of it, in the order the message needs them
 $A0B4 LD HL,$AEAE   ; "the X is Y."
 $A0B7 CALL $72D4    ; Print it
 $A0BA POP DE        ; {Restore the caller's DE
 $A0BB RET           ; }

; Mark an object as dead or broken
;
; Changes the adjectives of object A: the second adjective is removed and the first becomes DEAD for a character (bit 6 of its flags) or BROKEN for anything
; else. So after a fight, 'thorin' becomes 'the dead thorin'.
c$A0BC PUSH IX         ;
 $A0BE CALL $9B25      ; IX = the object's record
 $A0C1 LD (IX+$0C),$00 ; {Remove the second adjective
 $A0C5 LD (IX+$0D),$00 ; }
 $A0C9 LD DE,$00CD     ; The first adjective becomes BROKEN...
 $A0CC BIT 6,(IX+$07)  ; {...unless it is a living thing (bit 6)...
 $A0D0 JR Z,$A0D5      ; }
 $A0D2 LD DE,$0192     ; {...which becomes DEAD
*$A0D5 LD (IX+$0A),E   ;
 $A0D8 LD (IX+$0B),D   ;
 $A0DB POP IX          ;
 $A0DD RET             ; }

; Look up the holder of an object (unused)
;
; Searches the object index for the holder of the object at IY and returns its number. Nothing in the game calls this routine.
c$A0DE PUSH IY       ; {Save IY and IX
 $A0E0 PUSH IX       ; }
 $A0E2 LD IX,$BF50   ; {Search every object in the game...
*$A0E6 CALL $9B04    ; }
 $A0E9 JR Z,$A0F0    ; No more objects: give up (below)
 $A0EB CP (IY+$01)   ; Is it held by the object whose holder we want?
 $A0EE JR NZ,$A0E6   ; No: try the next one
*$A0F0 LD A,(IX+$00) ; A = the object that holds it (or $FF if none was found)
 $A0F3 POP IX        ; {Restore IX and IY
 $A0F5 POP IY        ;
 $A0F7 RET           ; }

; Is the object alive?
;
; Returns with Z set if the object at IX is a living thing (bit 6 of its flags set) and not dead (bit 3 clear). Used by SHOOT (#R$8FE0).
c$A0F8 LD A,(IX+$07) ; A = the object's own flags
 $A0FB AND $48       ; Keep just "alive" and "dead"
 $A0FD CP $40        ; Alive and not dead?
 $A0FF RET           ; Z reflects the answer

; Should the instrument's handlers be used?
;
; Returns with Z set if the current action is one of the five listed at $A13B: DROP IN, PUT IN, PUT ON, TAKE OUT OF and THROW THROUGH. For these it is the
; instrument (the container, or the window) that knows what to do, so #R$946F uses its handlers.
c$A100 PUSH HL       ; {Save the caller's HL and BC
 $A101 PUSH BC       ; }
 $A102 LD B,$05      ; Five actions to check against
 $A104 LD HL,$A13B   ; HL = the list of actions that use the instrument's own handlers, rather than the target's
 $A107 LD A,($B5D8)  ; A = the action being carried out right now
*$A10A CP (HL)       ; Is it one of these five?
 $A10B JR Z,$A110    ; Yes: stop here, with it found
 $A10D INC HL        ; {No: look at the next one in the list
 $A10E DJNZ $A10A    ; }
*$A110 POP BC        ; {Restore the caller's BC and HL
 $A111 POP HL        ;
 $A112 RET           ; }

; A character speaks
;
; Prints '<actor> says "<message at HL>".'. Used by the character routines for Thorin's 'hurry up', Gollum's riddles and so on.
;
; Input:HL Message
c$A113 PUSH HL       ; Save the caller's HL
 $A114 LD HL,$AEFB   ; {'<actor> says "'
 $A117 CALL $72D4    ; }
 $A11A POP HL        ; Restore HL: the message to be spoken
 $A11B LD A,$01      ; {Force a capital letter, as if this were starting a fresh sentence
 $A11D LD ($B5F5),A  ; }
 $A120 CALL $72D4    ; Print what is being said
 $A123 LD HL,$AF01   ; {'"' (the closing quote and a full stop)
 $A126 JP $72D4      ; }

; Is the target locked or open?
;
; Tests the target's flags: returns Z reset and A=$80 if it is locked; otherwise tests bit 5 and returns A=$85, so Z reset means it is open. The codes in A are
; for #R$A09C. The entry at $A134 does only the second test.
c$A129 LD IX,($B5F8)  ; IX = the target's own record
 $A12D BIT 0,(IX+$07) ; Is it locked?
 $A131 LD A,$80       ; A = the state code for LOCKED/UNLOCKED, in case the caller needs to report it
 $A133 RET NZ         ; Locked: return with Z reset, telling the caller it cannot be used yet
; This entry point is used by the routine at #R$93ED.
*$A134 BIT 5,(IX+$07) ; Not locked: is it open?
 $A138 LD A,$85       ; A = the state code for OPEN/CLOSED, in case the caller needs to report it
 $A13A RET            ; Z reflects whether it is open

; Action and word tables
;
; #LIST
; { $A13B: the five actions for which the instrument's handlers are used rather than the target's (#R$A100): DROP IN, PUT IN, PUT ON, TAKE OUT OF, THROW
; THROUGH. }
; { $A140: the words for the ten directions (#R$9FEA): NORTH, SOUTH, EAST, WEST, NORTHEAST, NORTHWEST, SOUTHEAST, SOUTHWEST, UP, DOWN. }
; { $A154: the words for an object's flags when they are clear (#R$A09C): UNLOCKED, -, EMPTY, -, OFF, CLOSED, DEAD, -. }
; { $A164: the same when set: LOCKED, -, FULL, BROKEN, ON, OPEN, ALIVE, -. }
; LIST#
b$A13B DEFB $0E,$11,$12,$14,$2C ; Actions
 $A140 DEFW $0484               ; {Directions 1-10
 $A142 DEFW $060B               ;
 $A144 DEFW $0202               ;
 $A146 DEFW $077D               ;
 $A148 DEFW $0489               ;
 $A14A DEFW $0492               ;
 $A14C DEFW $0610               ;
 $A14E DEFW $0619               ;
 $A150 DEFW $0729               ;
 $A152 DEFW $01C8               ; }
 $A154 DEFW $071C               ; {Flag words (clear)
 $A156 DEFW $0000               ;
 $A158 DEFW $022C               ;
 $A15A DEFW $0000               ;
 $A15C DEFW $04A3               ;
 $A15E DEFW $0139               ;
 $A160 DEFW $0192               ;
 $A162 DEFW $0000               ; }
 $A164 DEFW $03FA               ; {Flag words (set)
 $A166 DEFW $0000               ;
 $A168 DEFW $02BD               ;
 $A16A DEFW $00CD               ;
 $A16C DEFW $04AE               ;
 $A16E DEFW $04B8               ;
 $A170 DEFW $07D8               ;
 $A172 DEFW $0000               ; }

; Handler for the water: DRINK
;
; Drinking ordinary water (object 23) always works and has no effect.
c$A174 CALL $9C99    ; {Dry run? Then stop here: drinking plain water always works, and has no other effect
 $A177 RET           ; }

; TIE TO
;
; Only the rope can be tied: TIE THE ROPE TO X is turned round into TIE X TO THE ROPE ($A1DE, #R$9E93). The thing tied must not be something that pours, must be
; empty ('the rope is already tied'), and must not be a living character (a dead one is fine). It then becomes held by the rope.
; .
; If the actor could pick the thing up, the rope stays in the actor's hands with the thing hanging from it; otherwise the rope is left lying, tied to it. Taking
; or dropping the rope takes or drops whatever is tied to it (#R$8CC8, #R$8C45).
c$A178 LD A,($B5D9)    ; {Is the TARGET actually the rope (object 18)?
 $A17B CP $12          ; }
 $A17D JR Z,$A1DE      ; Yes: "TIE THE ROPE TO X" - turn it round into "TIE X TO THE ROPE" (below)
 $A17F LD A,($B5DA)    ; {No: is the INSTRUMENT the rope instead?
 $A182 CP $12          ; }
 $A184 JP NZ,$9EBF     ; Neither: fail with the usual message - only the rope can be tied
 $A187 LD IX,($B5F8)   ; IX = the target's own record (the thing being tied)
 $A18B BIT 1,(IX+$07)  ; Does it pour (is it a liquid)?
 $A18F JP NZ,$9EBF     ; Yes: cannot tie up a liquid
 $A192 CALL $9CEC      ; {Does it already hold anything visible?
 $A195 CP $00          ; }
 $A197 LD HL,$AF6F     ; "the X is already tied."
 $A19A JP NZ,$72D4     ; Already holding something (i.e. already tied to something): say so and stop
 $A19D BIT 3,(IX+$07)  ; Is it dead (a corpse)?
 $A1A1 JR NZ,$A1AA     ; Yes: a dead character may still be tied up
 $A1A3 BIT 6,(IX+$07)  ; No: is it a LIVING character?
 $A1A7 JP NZ,$9EBF     ; Yes: cannot tie up someone alive
*$A1AA CALL $9C99      ; Dry run? Then stop here: it would work
 $A1AD LD IY,($B5FA)   ; IY = the rope's own record
 $A1B1 CALL $9BCD      ; Is the actor already holding the thing being tied?
 $A1B4 LD A,($B5DA)    ; {It becomes held by the rope, either way...
 $A1B7 LD (IX+$01),A   ; }
 $A1BA JR C,$A1D2      ; If the actor already held it, skip straight to deciding who holds the rope itself
 $A1BC SUB A           ; {Otherwise: try to pick it up first (as an ordinary TAKE), but only as a trial for now
 $A1BD LD ($B5EB),A    ;
 $A1C0 CALL $8CC8      ; }
 $A1C3 LD A,($B5EC)    ; {Did the actor manage to pick it up?
 $A1C6 CP $00          ; }
 $A1C8 LD A,$01        ; {Either way, this really is happening now
 $A1CA LD ($B5EB),A    ;
 $A1CD LD ($B5EC),A    ; }
 $A1D0 JR Z,$A1D9      ; Could not pick it up: leave the rope where it is, below
*$A1D2 LD A,($B5DB)    ; {Could pick it up: the rope stays in the actor's own hands
 $A1D5 LD (IY+$01),A   ;
 $A1D8 RET             ; }
*$A1D9 LD (IY+$01),$FF ; {Left lying: the rope is held by nobody, tied to whatever is too heavy to lift
 $A1DD RET             ; }
*$A1DE LD HL,$A178     ; "TIE THE ROPE TO X": run this same handler again...
 $A1E1 JP $9E93        ; ...with target and instrument swapped, so it becomes "TIE X TO THE ROPE"

; UNTIE
;
; The target must be tied to the rope ('the X is not tied'). It then goes to whoever holds the rope.
c$A1E4 LD IX,($B5F8) ; IX = the target's own record
 $A1E8 LD A,(IX+$01) ; {Is it actually held by the rope (object 18)?
 $A1EB CP $12        ; }
 $A1ED LD HL,$AF84   ; "the X is not tied."
 $A1F0 JP NZ,$72D4   ; No: say so and stop
 $A1F3 CALL $9C99    ; Dry run? Then stop here: it would work
 $A1F6 LD A,($C256)  ; A = whoever holds the rope itself
 $A1F9 LD (IX+$01),A ; {The target now belongs to them too
 $A1FC RET           ; }

; Handler for the fast river: SWIM
;
; Swimming across the fast river: the exit through the river is found (#R$9E6E); if it leads anywhere, the river is opened for a moment and the actor goes
; through it with an ordinary move (#R$8D19, at $8D27), then the river is closed again. The entry at $A20C is the handler used by many doors and containers for
; their OPEN action when they are chained to a movement.
c$A1FD CALL $9E6E     ; Find the exit that passes through the river
 $A200 LD A,(IX+$02)  ; {Does it lead anywhere?
 $A203 CP $00         ; }
 $A205 JR NZ,$A20B    ; Yes: swim across, below
 $A207 CALL $9C99     ; No: dry run? Then stop here: the attempt itself is possible
 $A20A RET            ; (falls through to failing normally otherwise)
*$A20B LD A,(IX+$00)  ; A = the exit's own direction
 $A20E LD HL,($B5D8)  ; {Save the current action for a moment...
 $A211 PUSH HL        ; }
 $A212 LD ($B5D8),A   ; ...and use the direction as the movement action instead
 $A215 LD IX,($B5F8)  ; IX = the river's own record
 $A219 SET 5,(IX+$07) ; {Open it, just long enough to move through it
 $A21D PUSH IX        ; }
 $A21F LD A,$FF       ; {No specific target - just moving
 $A221 LD ($B5D9),A   ; }
 $A224 CALL $8D27     ; Carry out the move
 $A227 POP IX         ; Restore the river's own record
 $A229 RES 5,(IX+$07) ; Close it again
 $A22D POP HL         ; {Restore the original action
 $A22E LD ($B5D8),HL  ;
 $A231 RET            ; }

; BURN
;
; Only the dragon (object 60) can burn anything; for anyone else it fails. When the dragon does it, the target is killed (#R$96DA).
c$A232 LD A,($B5DB)  ; {Is the current actor the dragon (object 60)?
 $A235 CP $3C        ; }
 $A237 JP NZ,$9EBF   ; No: fail with the usual message - nobody else can burn things
 $A23A CALL $9C99    ; Dry run? Then stop here: it would work
 $A23D JP $96DA      ; Kill the target

; Handler for the fast black river: SWIM
;
; The enchanted river from the book: 'as soon as you touch the river you fall asleep and gently float away.' For Bilbo this is followed by 'time passes...', and
; the swimmer dies (#R$96DD).
c$A240 CALL $9C99    ; Dry run? Then stop here: it would work
 $A243 LD HL,$AFA6   ; {"as soon as X touches the river X falls asleep and gently floats away."
; This entry point is used by the routine at #R$A258.
*$A246 CALL $72D4    ; }
 $A249 LD A,($B5DB)  ; {Is the swimmer Bilbo himself?
 $A24C PUSH AF       ;
 $A24D AND A         ; }
 $A24E LD HL,$AC9D   ; "time passes..."
 $A251 CALL Z,$72D4  ; If it is Bilbo, add that too
 $A254 POP AF        ; Restore A
 $A255 JP $96DD      ; The swimmer dies

; Handler for the black water: DRINK
;
; Drinking the black water: 'you fall asleep.', and then as #R$A240: 'time passes...', and death.
c$A258 CALL $9C99    ; Dry run? Then stop here: it would work
 $A25B LD HL,$AFEA   ; "X falls asleep."
 $A25E JR $A246      ; Join the enchanted-river code above, which adds "time passes..." for Bilbo and kills the drinker

; Handler for the side door: UNLOCK
;
; The small curious key (object 2) fits the side door of the Lonely Mountain. Jumps to #R$A26A.
c$A260 LD B,$02      ; The small curious key (object 2) is the one that fits the side door
 $A262 JR $A26A      ; Join the shared LOCK/UNLOCK code

; Handler for the red door: LOCK and UNLOCK
;
; The red door's LOCK and UNLOCK handler: only object 15 fits it (the entry at #R$A26A with B=15).
c$A264 LD B,$0F      ; {The red key (object 15) is the one that fits the red door
 $A266 JR $A26A      ; }

; Handler for the heavy rock door: LOCK and UNLOCK
;
; The large key (object 4) fits the heavy rock door (the trolls' cave). Continues into #R$A26A.
c$A268 LD B,$04      ; The large key (object 4) is the one that fits the trolls' cave (falls into #R$A26A)

; Does this key fit?
;
; Shared by the LOCK and UNLOCK handlers of the locked doors; on entry B is the object number of the key that fits (for example 15, the red key, from #R$A264).
; .
; If the instrument is that key, the door is locked or unlocked (#R$93CD, #R$93ED). If the instrument is one of the game's other keys - object 2 (the small
; curious key), object 4 (the large key) or object 15 (the red key) - the game says 'the key does not fit this lock.' Anything else, such as trying to unlock a
; door with the sword, gets 'I cannot do that.'
;
; Input:B The key that fits
c$A26A LD A,($B5DA)  ; A = the object being used as the key
 $A26D CP B          ; Is it the key that fits this door?
 $A26E JR NZ,$A27B   ; No: see what it is
 $A270 LD A,($B5D8)  ; {Yes. Is the action LOCK (action 37)?
 $A273 CP $25        ; }
 $A275 JP Z,$93CD    ; Yes: lock the door
 $A278 JP $93ED      ; No: unlock it
*$A27B CP $02        ; {Is the object the small curious key (object 2)...
 $A27D JR Z,$A288    ; }
 $A27F CP $04        ; {...the large key (object 4)...
 $A281 JR Z,$A288    ; }
 $A283 CP $0F        ; ...or the red key (object 15)?
 $A285 JP NZ,$72C5   ; None of these: "I cannot do that."
*$A288 LD HL,$AF1F   ; {A key, but the wrong one: "the key does not fit this lock."
 $A28B JP $72D4      ; }

; Handler for the side door: OPEN
;
; Chained after the side door's other handlers: when it really happens, opens the door (at $9081 in #R$9078).
c$A28E CALL $975D    ; Only if this is really happening (not just a trial)
 $A291 LD IX,($B5F8) ; IX = the target's (the door's) own record
 $A295 JP $9081      ; Open it, as if by the ordinary OPEN handler

; Handler for the crack: OPEN
;
; The small insignificant crack can only be opened from room 15; there it opens like a door (#R$9078).
c$A298 LD IX,($B5FC) ; IX = the actor's own record
 $A29C LD A,(IX+$10) ; {Is the actor in room 15 (the only place the crack can be opened from)?
 $A29F CP $0F        ; }
 $A2A1 JP NZ,$9EBF   ; No: fail with the usual message
 $A2A4 JP $9078      ; Yes: open it as usual

; Handler for the spider web: it has been broken
;
; Chained after the spider web's handler for breaking it (the web is object 7). If the web really is broken now (bit 3 of its flags), it is opened (bit 5), so
; the way through is clear, and timer 1 is started (count 2): 'some spiders start mending the broken web.' Two turns later #R$A950 closes it again.
c$A2A7 LD IX,($B5F8)  ; IX = the web's record
 $A2AB BIT 3,(IX+$07) ; Is it broken?
 $A2AF RET Z          ; No: nothing to do
 $A2B0 SET 5,(IX+$07) ; Yes: it no longer blocks the way
 $A2B4 LD A,($C97A)   ; {Start timer 1 (count 2)
 $A2B7 LD ($C97B),A   ; }
 $A2BA LD HL,$AF8B    ; {"some spiders start mending the broken web."
 $A2BD JP $72D4       ; }

; Handler for the ring: WEAR
;
; Putting the golden ring on makes the wearer invisible (bit 7 of their flags cleared) - but also divides their strength by 4. The ring itself becomes invisible
; and held by the wearer, and timer 6 is started with a random count of 2 to 10 (#R$9BF4), after which the ring comes off by itself (#R$A9D4).
c$A2C0 CALL $9C99     ; Dry run? Then stop: it would work
 $A2C3 LD IY,($B5FC)  ; IY = the wearer's record
 $A2C7 LD IX,$C209    ; IX = the ring's record
 $A2CB RES 7,(IY+$07) ; The wearer becomes invisible...
 $A2CF SRL (IY+$05)   ; {...and a quarter as strong
 $A2D3 SRL (IY+$05)   ; }
 $A2D7 RES 7,(IX+$07) ; The ring vanishes from view...
 $A2DB LD A,($B5DB)   ; {...into the wearer's hand
 $A2DE LD (IX+$01),A  ; }
 $A2E1 LD A,$08       ; {Pick a random number from 0 to 8...
 $A2E3 CALL $9BF4     ; }
 $A2E6 ADD A,$02      ; ...plus 2...
 $A2E8 LD ($C99E),A   ; {...and start timer 6 with it
 $A2EB RET            ; }

; Handler for the ring: TAKE OFF
;
; Taking the ring off (also done automatically when timer 6 runs out, #R$A9D4). If the ring is visible it is not being worn: '<actor> is not wearing the ring.'
; Otherwise the ring and its wearer become visible again, the wearer's strength is multiplied by 4, and timer 6 is stopped.
; .
; Because putting the ring on divided the strength by 4 with SRL and taking it off multiplies it by 4 with SLA, the two lowest bits are lost each time: a
; strength of 74, for example, comes back as 72. Each use of the ring can cost Bilbo up to 3 points of strength.
c$A2EC LD IX,($B5FC)  ; IX = the wearer's record
 $A2F0 LD IY,$C209    ; IY = the ring's record
 $A2F4 BIT 7,(IY+$07) ; Is the ring visible (not being worn)?
 $A2F8 LD HL,$AF66    ; "you are not wearing the ring."
 $A2FB JP NZ,$72D4    ; Yes: say so
 $A2FE CALL $9C99     ; Dry run? Then stop: it would work
 $A301 SET 7,(IY+$07) ; The ring can be seen again...
 $A305 SET 7,(IX+$07) ; ...and so can the wearer...
 $A309 SLA (IX+$05)   ; {...whose strength is multiplied by 4 (the bottom two bits lost on the way in are gone)
 $A30D SLA (IX+$05)   ; }
 $A311 SUB A          ; {Stop timer 6
 $A312 LD ($C99E),A   ;
 $A315 RET            ; }

; CAPTURE
;
; One character captures another. The target must be alive, and not on the same side as the actor (bits 4-6 of byte 4 of their records must have nothing in
; common, so goblins do not capture goblins). The captive is taken to a dungeon: room 31 if the captor is the wood elf or the butler (objects 64 and 66), room
; 13 otherwise. If the captive is Bilbo, the new room is described.
c$A316 LD IX,($B5F8)   ; IX = the captive's record
 $A31A LD A,(IX+$04)   ; {A = the captive's side (bits 4-6 of its attributes)
 $A31D AND $70         ;
 $A31F PUSH IX         ; }
 $A321 LD IX,($B5FC)   ; IX = the captor's record
 $A325 AND (IX+$04)    ; {Are they on the same side?
 $A328 POP IX          ; }
 $A32A JP NZ,$9EBF     ; Yes: allies do not capture each other
 $A32D BIT 6,(IX+$07)  ; Is the captive alive?
 $A331 JP Z,$9EBF      ; No: you cannot capture a corpse or an object
 $A334 LD A,($B5DB)    ; Who is the captor?
 $A337 LD B,$1F        ; Room 31 (the dark dungeon)...
 $A339 CP $40          ; {...for the wood elf...
 $A33B JR Z,$A343      ; }
 $A33D CP $42          ; {...or the butler
 $A33F JR Z,$A343      ; }
 $A341 LD B,$0D        ; Anyone else: room 13 (the goblins' dungeon)
*$A343 CALL $9C99      ; Dry run? Then stop: the capture would work
 $A346 LD IX,($B5F8)   ; IX = the captive's record
 $A34A LD (IX+$10),B   ; Put the captive in the dungeon...
 $A34D LD (IX+$01),$FF ; {...free of anything holding it
 $A351 LD A,($B5D9)    ; }
 $A354 CALL $9B38      ; ...and move everything it carries there too
 $A357 LD A,($B5D9)    ; {Was the captive Bilbo?
 $A35A CP $00          ; }
 $A35C RET NZ          ; No: done
 $A35D LD ($B5DB),A    ; {Yes: he becomes the actor...
 $A360 LD A,B          ;
 $A361 LD HL,$C00B     ;
 $A364 LD ($B5FC),HL   ; }
 $A367 JP $958E        ; ...and the dungeon is described

; A dead goblin comes back
;
; Chained after the normal ATTACK handler in each goblin's object record (action 15 runs #R$90DB, then this). If the attack killed the goblin, it comes straight
; back: the dead flag is cleared, its number is written back into its slot in the character table (so it acts again), it is moved to another room and given a
; new adjective, all from its 6-byte entry in the table at $A3C3. The game prints 'the goblin falls down a hole and vanishes.'
; .
; It then means to announce '- another goblin' if the goblin's new room is Bilbo's, but compares Bilbo's room with register B, which this routine never sets; B
; holds whatever the attack routine left there (the attack value), so the announcement depends on chance.
c$A36A LD IX,($B5F8)  ; IX = the goblin's record
 $A36E BIT 3,(IX+$07) ; Did the attack kill it?
 $A372 RET Z          ; No: nothing to do
 $A373 RES 3,(IX+$07) ; Bring it back to life
 $A377 LD DE,$0006    ; {Find its entry in the table at $A3C3 (6 bytes each)
 $A37A LD IY,$A3C3    ;
 $A37E LD A,($B5D9)   ;
*$A381 CP (IY+$00)    ;
 $A384 JR Z,$A38A     ;
 $A386 ADD IY,DE      ;
 $A388 JR $A381       ; }
*$A38A PUSH IY        ; {HL = the entry
 $A38C POP HL         ; }
 $A38D INC HL         ; {DE = its slot in the character table
 $A38E LD E,(HL)      ;
 $A38F INC HL         ;
 $A390 LD D,(HL)      ; }
 $A391 LD (DE),A      ; Put the goblin back in the slot: it will act again
 $A392 INC HL         ; {Move it to its new room
 $A393 LD A,(HL)      ;
 $A394 LD (IX+$10),A  ; }
 $A397 INC HL         ; {Give it a new adjective
 $A398 LD A,(HL)      ;
 $A399 LD (IX+$0A),A  ;
 $A39C INC HL         ;
 $A39D LD A,(HL)      ;
 $A39E LD (IX+$0B),A  ; }
 $A3A1 LD HL,$AF5A    ; {"the goblin falls down a hole and vanishes."
 $A3A4 CALL $72D4     ; }
 $A3A7 LD A,($C01B)   ; {Is Bilbo in the room it went to? (B is never set here: see above)
 $A3AA CP B           ; }
 $A3AB RET NZ         ; No
 $A3AC LD A,$2D       ; {Print "-"...
 $A3AE CALL $7580     ; }
 $A3B1 LD DE,$005E    ; {...ANOTHER...
 $A3B4 CALL $74B8     ; }
 $A3B7 LD DE,$02E6    ; {...GOBLIN...
 $A3BA CALL $74B8     ; }
 $A3BD LD HL,$AF0B    ; {...and the rest of the sentence
 $A3C0 JP $72D4       ; }

; Goblin reincarnation table
;
; Six 6-byte entries used by #R$A36A when a goblin is killed: the goblin, the address of its slot in the character table, the room it reappears in, and its new
; adjective.
b$A3C3 DEFB $3D,$07,$CA,$0F,$6E,$04
 $A3C9 DEFB $45,$0E,$CA,$3A,$3B,$03
 $A3CF DEFB $49,$1C,$CA,$12,$65,$03
 $A3D5 DEFB $4A,$23,$CA,$38,$38,$04
 $A3DB DEFB $4B,$15,$CA,$40,$45,$07
 $A3E1 DEFB $4C,$2A,$CA,$10,$B6,$01

; Handler for the goblins' door: OPEN
;
; The goblins' door (object 17) can only be opened by someone in the goblins' big cavern (room 16), in other words from the inside; from anywhere else the
; attempt fails (#R$9EBF). It is then opened as usual (#R$9078) and timer 3 is started, so two turns later it shuts itself (#R$A400).
c$A3E7 LD IX,($B5FC) ; IX = the actor's record
 $A3EB LD A,(IX+$10) ; {Is the actor in the goblins' big cavern (room 16)?
 $A3EE CP $10        ; }
 $A3F0 JP NZ,$9EBF   ; No: it cannot be opened from this side
 $A3F3 CALL $9078    ; Open it
 $A3F6 CALL $975D    ; Only if it really happened...
 $A3F9 LD A,($C988)  ; {...start timer 3 (count 2)
 $A3FC LD ($C989),A  ;
 $A3FF RET           ; }

; Timer 3 expires: the goblins' door closes
;
; Two turns after it was opened (#R$A3E7), the goblins' door closes itself.
c$A400 LD HL,$C23A   ; HL = the goblins' door's flags
 $A403 RES 5,(HL)    ; {Close it
 $A405 RET           ; }

; Character routine: react to being given something
;
; Says, at random, either 'thank you' or 'what do you expect me to do with this?'
c$A406 CALL $9C99    ; Dry run? Then stop here: it always works
 $A409 LD A,$0A      ; {Pick a random number from 0 to 10
 $A40B CALL $9BF4    ; }
 $A40E LD HL,$AF98   ; "what do you expect me to do with this?"
 $A411 CP $08        ; 8 or more?
 $A413 JP NC,$A113   ; Yes: say that
 $A416 LD HL,$AF39   ; "thank you"
 $A419 JP $A113      ; Otherwise: say that instead

; Character routine: "what's this?"
;
; Says 'what's this?'
c$A41C CALL $9C99    ; Dry run? Then stop here: it always works
 $A41F LD HL,$AF3D   ; "what's this?"
 $A422 JP $A113      ; Say it

; Character routine: small talk
;
; Says one of 'you are doing a great job', 'hurry up' or 'hello', chosen at random.
c$A425 CALL $9C99    ; Dry run? Then stop here: it always works
 $A428 LD A,$02      ; {Pick a random number from 0 to 2
 $A42A CALL $9BF4    ; }
 $A42D LD HL,$AF44   ; "you are doing a great job"
 $A430 CP $00        ; 0?
 $A432 JP Z,$A113    ; Say that
 $A435 LD HL,$AF4D   ; "hurry up"
 $A438 CP $01        ; 1?
 $A43A JP Z,$A113    ; Say that instead
 $A43D LD HL,$AF51   ; "hello"
 $A440 JP $A113      ; Otherwise say that

; Character routine: "this was thrains key"
;
; Thorin says 'this was thrains key' (used once, after he has picked up the small curious key).
c$A443 CALL $9C99    ; Dry run? Then stop here: it always works
 $A446 LD HL,$AF53   ; "this was thrains key"
 $A449 JP $A113      ; Say it

; Character routine: greet Bilbo
;
; If the character is in the same room as Bilbo, says 'hello'.
c$A44C LD A,($B5E7)  ; A = the room the character started this turn in
 $A44F LD HL,$B5E6   ; {Is that the room Bilbo is in?
 $A452 CP (HL)       ; }
 $A453 RET NZ        ; No: say nothing
 $A454 CALL $9C99    ; Dry run? Then stop here: it always works
 $A457 LD HL,$AF51   ; "hello"
 $A45A JP $A113      ; Say it

; Handler for the magic door: OPEN
;
; Only the wood elf (object 64) can open the magic door; anyone else fails.
c$A45D LD A,($B5DB)  ; {Is the current actor the wood elf (object 64)?
 $A460 CP $40        ; }
 $A462 JP NZ,$9EBF   ; No: fail with the usual message - only the wood elf can open it
 $A465 JP $9078      ; Yes: open it as usual

; CLIMB OUT OF
;
; The default handler for CLIMB OUT OF. The actor must be inside the target, which must be open ('the barrel is closed'). The actor's holder is cleared: he is
; out.
c$A468 LD IY,($B5FC)   ; IY = the actor's own record
 $A46C LD A,($B5D9)    ; {Is the actor actually inside the target?
 $A46F CP (IY+$01)     ; }
 $A472 JP NZ,$9EBF     ; No: fail with the usual message
 $A475 CALL $9B25      ; IX = the target's own record
 $A478 CALL $A4C3      ; Is it open?
 $A47B JP Z,$A09C      ; No: say so and stop
 $A47E CALL $9C99      ; Dry run? Then stop here: it would work
 $A481 LD (IY+$01),$FF ; {The actor is held by nobody now: they are out
 $A485 RET             ; }

; CLIMB INTO (the barrel, the chest or the boat)
;
; The actor must not already be inside. The container must be open, and big enough: unless its size is $FF (unlimited), it must be larger than the actor plus
; everything the actor carries (#R$9C3D), or 'you are too big'. Then the container becomes the actor's holder, and the actor goes wherever it goes (#R$9B38) -
; which is how Bilbo escapes in the barrel (#R$A4F4).
c$A486 LD IY,($B5FC)  ; IY = the actor's own record
 $A48A LD A,($B5D9)   ; {Is the actor already inside the target?
 $A48D CP (IY+$01)    ; }
 $A490 JP Z,$9EBF     ; Yes: fail with the usual message
 $A493 LD A,($B5DB)   ; A = how much the actor can carry...
 $A496 CALL $9C3D     ; {...plus how much the actor is already carrying
 $A499 ADD A,(IY+$02) ; }
 $A49C JR C,$A4A0     ; {Overflowed past 255? Then treat the actor as unmeasurably big
 $A49E LD A,$FF       ; }
*$A4A0 LD B,A         ; B = the actor's own total size, for the check below
 $A4A1 LD IX,($B5F8)  ; IX = the target's (the container's) own record
 $A4A5 CALL $A4C3     ; Is it open?
 $A4A8 JP Z,$A09C     ; No: say so and stop
 $A4AB LD A,(IX+$02)  ; A = the container's own capacity
 $A4AE CP $FF         ; Is it unlimited?
 $A4B0 JR Z,$A4B9     ; Yes: skip the size check
 $A4B2 SUB B          ; No: is the actor too big to fit?
 $A4B3 LD HL,$B030    ; "you are too big."
 $A4B6 JP NC,$72D4    ; Too big: say so and stop
*$A4B9 CALL $9C99     ; Dry run? Then stop here: it would work
 $A4BC LD A,($B5D9)   ; The actor becomes held by the target...
 $A4BF LD (IY+$01),A  ; {...so wherever the target goes, the actor goes too
 $A4C2 RET            ; }

; Is the object open?
;
; Tests bit 5 of the flags of the object at IX (Z reset if open) and returns A=5, the state code for #R$A09C.
c$A4C3 BIT 5,(IX+$07) ; Is it open?
 $A4C7 LD A,$05       ; A = the state code for OPEN/CLOSED, in case the caller needs to report it
 $A4C9 RET            ; Z reflects the answer

; Character routine: the warg
;
; If the warg (whose location is at $C341) is in Bilbo's room: 'the vicious warg runs around you and howls.'
c$A4CA CALL $9C99    ; Dry run? Then stop here: it always works
 $A4CD LD HL,$C341   ; HL = the warg's own location
 $A4D0 LD A,($C01B)  ; {Is Bilbo in the same room?
 $A4D3 CP (HL)       ; }
 $A4D4 RET NZ        ; No: say nothing
 $A4D5 LD HL,$AF77   ; "the vicious warg runs around you and howls."
 $A4D8 JP $9752      ; Say it

; Handler for the trap door: the barrel escape
;
; When the large trap door is opened and the barrel (object 19) is the target and is in room 33, timer 0 (#R$C973) is set to 2. Two turns later #R$A4F4 floats
; the barrel away.
c$A4DB LD A,($B5D9)  ; {Is the target the barrel (object 19)?
 $A4DE CP $13        ; }
 $A4E0 RET NZ        ; No: this handler does nothing
 $A4E1 CALL $975D    ; Only if this is really happening (opening the trap door)
 $A4E4 LD IX,$C2DD   ; IX = the barrel's own record
 $A4E8 LD A,(IX+$10) ; {Is it in room 33 (the cellar)?
 $A4EB CP $21        ; }
 $A4ED RET NZ        ; No: nothing happens
 $A4EE LD A,$02      ; {Yes: start timer 0 with a count of 2
 $A4F0 LD ($C974),A  ;
 $A4F3 RET           ; }

; Timer 0: the barrel floats down the river
;
; The expiry routine of timer 0, two turns after the trap door is opened with the barrel in the cellar (#R$A4DB). If Bilbo is in the barrel he reads 'you are
; thrown onto the bank of the long lake.' Everything in the barrel is moved to room 34 on the long lake (#R$9B38) and tipped out there (#R$9CA8), silently. The
; barrel itself goes back to the cellar (room 32), closed and full, and the wine (object 20) is put back in it. This is the book's escape from the Elvenking's
; halls, and the game resets it so the barrel is ready again.
c$A4F4 SUB A           ; {Let other timers expire this turn too
 $A4F5 LD ($B5E1),A    ; }
 $A4F8 LD A,($C00C)    ; {Is Bilbo in the barrel (object 19)?
 $A4FB CP $13          ; }
 $A4FD LD HL,$B21E     ; "you are thrown onto the bank of the long lake."
 $A500 CALL Z,$72D4    ; If so, say so
 $A503 LD A,$22        ; {Put the barrel in room 34, the long lake...
 $A505 LD ($C2ED),A    ;
 $A508 LD B,A          ; }
 $A509 LD A,$13        ; {...and take everything in it along
 $A50B CALL $9B38      ; }
 $A50E LD IX,$C2DD     ; IX = the barrel's record
 $A512 LD (IX+$10),$20 ; Put the barrel back in the cellar (room 32)
 $A516 RES 5,(IX+$07)  ; Closed...
 $A51A SET 2,(IX+$07)  ; ...and full
 $A51E SUB A           ; {Quietly...
 $A51F LD ($B5F3),A    ; }
 $A522 LD A,$13        ; {...tip its contents out on the lake bank
 $A524 CALL $9CA8      ; }
 $A527 LD A,$01        ; {Output back on
 $A529 LD ($B5F3),A    ; }
 $A52C LD IY,$C307     ; IY = the wine's record
 $A530 LD (IY+$10),$20 ; The wine is in the cellar...
 $A534 LD (IY+$01),$13 ; {...inside the barrel
 $A538 RET             ; }

; Character routine: "where's the thief?"
;
; If the character is in Bilbo's room but Bilbo cannot be seen (his visibility bit is clear), says 'where's the thief?'.
c$A539 LD A,($B5E7)  ; A = the room the character started this turn in
 $A53C LD HL,$B5E6   ; {Is Bilbo in that same room?
 $A53F CP (HL)       ; }
 $A540 RET NZ        ; No: say nothing
 $A541 LD A,($C012)  ; {Yes - is Bilbo actually visible?
 $A544 BIT 7,A       ; }
 $A546 RET NZ        ; He is: no need to ask
 $A547 CALL $9C99    ; Invisible: dry run? Then stop here: it always works
 $A54A LD HL,$AFBD   ; "where's the thief?"
 $A54D JP $A113      ; Say it

; Character routine: Thorin
;
; Thorin's idle behaviour. A random number from 0 to 8 (#R$9BF4) decides: 5 or more, nothing; 3 or 4, 'thorin waits.'; 0, 'thorin sits down and starts singing
; about gold.'; 1 or 2, he says 'hurry up'.
; .
; A fourth line, 'get us out of this one, thief!', is set up at $A563 but can never be printed: the JP Z that would print it tests the flags from CP 3, and Z
; can only be set there if A was 3, which the JP NC before it has already taken care of.
c$A550 CALL $9C99    ; Dry run? Then stop: this always works
 $A553 LD A,$08      ; {Pick a random number from 0 to 8
 $A555 CALL $9BF4    ; }
 $A558 CP $05        ; 5 or more...
 $A55A RET NC        ; ...do nothing
 $A55B CP $03        ; 3 or 4...
 $A55D LD HL,$AFE6   ; {"thorin waits."
 $A560 JP NC,$9752   ; }
 $A563 LD HL,$AFC7   ; {"get us out of this one, thief!" (never reached: see the bug note)
 $A566 JP Z,$A113    ; }
 $A569 LD HL,$AFD7   ; "thorin sits down and starts singing about gold."
 $A56C CP $00        ; {0?
 $A56E JP Z,$9752    ; }
 $A571 LD HL,$AF4D   ; {1 or 2: he says "hurry up"
 $A574 JP $A113      ; }

; Handler for the trap door: OPEN and CLOSE
;
; The trap door can only be opened or closed from room 32; elsewhere 'you cannot reach the trap door'.
c$A577 LD IX,($B5FC) ; IX = the actor's own record
 $A57B LD A,(IX+$10) ; {Is the actor in room 32 (the only place the trap door can be worked from)?
 $A57E CP $20        ; }
 $A580 LD HL,$B00D   ; "you cannot reach the trap door."
 $A583 JP NZ,$72D4   ; No: say so and stop
 $A586 LD A,($B5D8)  ; {Yes - is this actually CLOSE (action 12)?
 $A589 CP $0C        ; }
 $A58B JP Z,$90A2    ; Yes: close it as usual
 $A58E JP $9078      ; Otherwise (OPEN): open it as usual

; Character routine: the dragon comes for Bilbo
;
; If Bilbo is in room 39, 41 or 44 (the dragon's domain) and the dragon (object 60, location at $C033) is somewhere else, the dragon moves to Bilbo's room and
; 'the dragon enters.'
c$A591 LD A,($C01B)  ; {Is Bilbo in room 39 (the front gate)...
 $A594 CP $27        ;
 $A596 JR Z,$A59F    ; }
 $A598 CP $2C        ; {...room 44...
 $A59A JR Z,$A59F    ; }
 $A59C CP $29        ; ...or room 41 (the lower halls)?
 $A59E RET NZ        ; No: nothing happens
*$A59F CALL $9C99    ; Dry run? Then stop: this would work
 $A5A2 LD A,($C01B)  ; {Is the dragon already there?
 $A5A5 LD HL,$C033   ;
 $A5A8 CP (HL)       ; }
 $A5A9 RET Z         ; Yes: nothing to do
 $A5AA LD (HL),A     ; No: the dragon flies to Bilbo's room
 $A5AB LD A,$01      ; {Make sure Bilbo sees it
 $A5AD LD ($B5F3),A  ; }
 $A5B0 LD HL,$C02B   ; {Push the dragon's name as the message parameter
 $A5B3 PUSH HL       ; }
 $A5B4 LD HL,$AF09   ; "the dragon enters."
; This entry point is used by the routines at #R$A5BB and #R$A5D5.
*$A5B7 CALL $72D4    ; {Print it
 $A5BA RET           ; }

; Character routine: the dragon speaks
;
; If the dragon and Bilbo are in the same room: 'well thief your cunning has failed you this time. prepare to die', or, if Bilbo is invisible (he is wearing the
; ring: bit 7 of his flags at $C012 is clear), 'I may not be able to see you thief but I can still burn you. prepare to die'. The dragon's next instruction is
; BURN.
c$A5BB LD A,($C01B)  ; {Is Bilbo in the room where the dragon started its turn?
 $A5BE LD HL,$B5E7   ;
 $A5C1 CP (HL)       ; }
 $A5C2 RET NZ        ; No: nothing to say
 $A5C3 CALL $9C99    ; Dry run? Then stop: this would work
 $A5C6 LD A,($C012)  ; {Is Bilbo visible (bit 7 of his flags; clear while he wears the ring)?
 $A5C9 AND $80       ; }
 $A5CB LD HL,$B070   ; "I may not be able to see you thief but I can still burn you. prepare to die"
 $A5CE JR Z,$A5D3    ; Invisible: say that
 $A5D0 LD HL,$B04F   ; "well thief your cunning has failed you this time. prepare to die"
*$A5D3 JR $A5B7      ; Print it

; Character routine: the dragon wakes
;
; Does nothing while the valuable treasure (location at $C4CC) is still in room 41. Once it has been moved, and if the dragon's current room is lit, a random
; number from 0 to 100 (#R$9BF4) decides: below 80, 'in the distance you see the shape of a monstrous dragon flying after you.'; otherwise 'the dragon descends
; and in a terrific spout of flames burns you to a crisp.' and Bilbo dies. Because of the skew in the random numbers (#R$9BFD), the fatal result comes up about
; 16% of the time, every turn, for as long as the dragon lives.
c$A5D5 LD A,($C4CC)   ; {Is the treasure still in room 41?
 $A5D8 CP $29         ; }
 $A5DA RET Z          ; Yes: the dragon sleeps on
 $A5DB CALL $9C99     ; Dry run? Then stop: this would work
 $A5DE LD A,$01       ; {Make sure Bilbo sees what follows
 $A5E0 LD ($B5F3),A   ; }
 $A5E3 CALL $9C8C     ; IX = the room the dragon (the actor) is in
 $A5E6 BIT 7,(IX+$00) ; Is it lit?
 $A5EA RET Z          ; No: nothing happens
 $A5EB LD HL,$B098    ; "in the distance you see the shape of a monstrous dragon flying after you."
 $A5EE LD A,$64       ; {Pick a random number from 0 to 100
 $A5F0 CALL $9BF4     ; }
 $A5F3 CP $50         ; Below 80?
 $A5F5 JR C,$A5B7     ; Yes: the dragon is just a shape in the distance
 $A5F7 LD HL,$B0AC    ; {Otherwise: "the dragon descends and in a terrific spout of flames burns you to a crisp."
 $A5FA CALL $72D4     ; }
 $A5FD JP $903C       ; Bilbo is dead

; Handler for the wooden boat
;
; Finds an exit of the actor's room by way of the variant search at $9E6E and, if there is one, removes it by clearing its three bytes.
c$A600 CALL $9E6E      ; Find the exit that passes through the boat
 $A603 CP $FF          ; Is there no such exit?
 $A605 RET Z           ; If so, there is nothing to do
 $A606 SUB A           ; {Clear the exit's three bytes - the way through the boat is removed
 $A607 LD (IX+$00),$00 ;
 $A60B LD (IX+$01),$00 ;
 $A60F LD (IX+$02),$00 ;
 $A613 RET             ; }

; Handler for the magic door
;
; When the magic door is examined: if the actor can see it clearly (bit 7 of its flags), 'you see nothing special'. Otherwise timer 5 is started (by copying its
; reload value) and 'the magic door warns of elves approaching.'
c$A614 CALL $9C99     ; Dry run? Then stop here: it would work
 $A617 LD IX,($B5FC)  ; IX = the actor's own record
 $A61B BIT 7,(IX+$07) ; Is the actor visible?
 $A61F LD HL,$AEE6    ; "X sees nothing special."
 $A622 JP NZ,$72D4    ; Visible: nothing more happens - just an ordinary EXAMINE
 $A625 LD A,($C996)   ; {Invisible (wearing the ring): start timer 5 (copy its reload value into its count)
 $A628 LD ($C997),A   ; }
 $A62B LD HL,$B19C    ; {"the magic door warns of elves approaching."
 $A62E JP $72D4       ; }

; Handler for Thorin: the small curious key shatters
;
; Attached to Thorin's record. When Thorin is dead (bit 3 of his flags at $C2A8), the small curious key (record at $C091) is marked broken (#R$A0BC) and, if
; Bilbo can see it, 'the small curious key shatters.'
c$A631 LD HL,$C2A8    ; HL = Thorin's own flags
 $A634 BIT 3,(HL)     ; Is he dead?
 $A636 RET Z          ; No: nothing happens
 $A637 CALL $975D     ; Only if this is really happening
 $A63A LD IX,$C09D    ; IX = the small curious key's own record
 $A63E SET 3,(IX+$07) ; Mark it broken
 $A642 LD A,$02       ; {Remove its second adjective, leaving just BROKEN
 $A644 CALL $A0BC     ; }
 $A647 LD IY,$C00B    ; {Can Bilbo actually see the key (is it near enough)?
 $A64B CALL $9D77     ; }
 $A64E RET Z          ; No: say nothing
 $A64F LD HL,$AFFB    ; {"the small curious key shatters."
 $A652 JP $72D4       ; }

; Handler for the window: OPEN and CLOSE
;
; Bilbo cannot reach the window if he is not being held up (byte 1 of his record is $FF): 'you cannot reach the window'. Characters can open and close it
; normally.
c$A655 LD A,($B5DB)  ; {Is the actor Bilbo?
 $A658 CP $00        ; }
 $A65A JR NZ,$A66A   ; No (a character): they can always reach the window, below
 $A65C LD A,($C00C)  ; Yes - is Bilbo currently being held up by something?
 $A65F LD HL,$B00D   ; {"you cannot reach the window."
 $A662 CP $FF        ; }
 $A664 JP Z,$72D4    ; Held by nobody: he cannot reach it - say so and stop
 $A667 JP $9EBF      ; Held by something, but the action still failed some other way: fail normally
*$A66A LD A,($B5D8)  ; {Is this CLOSE (action 12)?
 $A66D CP $0C        ; }
 $A66F JP Z,$90A2    ; Yes: close it as usual
 $A672 CP $10        ; Is it OPEN (action 16)?
 $A674 JP Z,$9078    ; Yes: open it as usual
 $A677 RET           ; Anything else: do nothing further here

; Handler for the window
;
; Bilbo cannot reach the window unless something (or someone) is holding him up: if nothing holds him, 'you cannot reach the window.' Characters, and a Bilbo
; who is being carried, are passed on to the normal handlers for going through it (#R$8E9D), breaking it (#R$9257) or looking through it (#R$8E4E). The HELP
; message in the goblins' dungeon hints at this: 'a window should be no obstacle to a thief with friends'.
c$A678 LD A,($B5DB)  ; {Is the actor Bilbo?
 $A67B CP $00        ; }
 $A67D JP NZ,$A68B   ; No: characters can always reach it, below
 $A680 LD A,($C00C)  ; {Yes - is Bilbo currently being held up by something?
 $A683 CP $FF        ; }
 $A685 LD HL,$B00D   ; "you cannot reach the window."
 $A688 JP Z,$72D4    ; Held by nobody: he cannot reach it - say so and stop
*$A68B LD A,($B5D8)  ; A = the current action
 $A68E CP $1E        ; Is it GO THROUGH?
 $A690 JP Z,$8E9D    ; Yes: go through it as usual
 $A693 CP $0B        ; Is it STRIKE (breaking it)?
 $A695 JP Z,$9257    ; Yes: break it as usual
 $A698 CP $18        ; Is it LOOK THROUGH?
 $A69A JP Z,$8E4E    ; Yes: look through it as usual
 $A69D RET           ; Anything else: do nothing further here

; Timer 4: sinking into the bog
;
; Both the tick and the expire routine of timer 4 (#R$C6A8). If Bilbo is in the deep bog (room 29) the timer is stopped (count 0). Then '<actor> is slowly
; sinking into the bog.' is printed, and if the count is now 0, Bilbo dies.
; .
; In practice the tick runs at the end of the turn Bilbo entered the bog, while he is still there, so it always kills him. The other path - printing the message
; but surviving because the count is still 1 - would only be taken if he had somehow left within the same turn. (The message is printed even then, although he
; is no longer in the bog.)
c$A69E LD A,($C01B)  ; {Is Bilbo in the deep bog (room 29)?
 $A6A1 CP $1D        ; }
 $A6A3 JR NZ,$A6A9   ; No: just print the message
 $A6A5 SUB A         ; {Yes: stop the timer (count 0)
 $A6A6 LD ($C990),A  ; }
*$A6A9 LD HL,$B045   ; {"you are slowly sinking into the bog."
 $A6AC CALL $72D4    ; }
 $A6AF LD A,($C990)  ; {Is the count 0?
 $A6B2 CP $00        ; }
 $A6B4 RET NZ        ; No: he survives this turn
 $A6B5 JP $903C      ; Yes: Bilbo is dead

; Handler for the curious map: Elrond reads it
;
; When anyone other than Elrond (object 65) examines the curious map, it is an ordinary EXAMINE (#R$9344). When Elrond does (because the player gave it to him
; and asked him to read it), the hidden route chosen at the start of the game (#R$970B) is revealed: the three bytes of the exit that were blanked out are
; restored from the table at #R$C6F7 (the address of the entry was written into the LD IY instruction at $A6C3), and Elrond says 'go <direction> from <room> to
; get to <room>'. $B5E2 records that it has been done.
c$A6B8 LD A,($B5DB)  ; Pick up the number of the character doing the examining
 $A6BB CP $41        ; Is it Elrond (object 65)?
 $A6BD JP NZ,$9344   ; No: treat it as an ordinary EXAMINE (you see the curious map)
 $A6C0 CALL $9C99    ; Elrond: during a dry run, record that this would work and stop here
 $A6C3 LD IY,$0000   ; IY = the hidden-route entry chosen at the start of the game (this operand is written by #R$970B)
 $A6C7 LD L,(IY+$01) ; HL = the address of the blanked-out exit in the room record...
 $A6CA LD H,(IY+$02) ; ...(bytes 1 and 2 of the entry)
 $A6CD LD A,($B5E2)  ; {Has the map already been read?
 $A6D0 CP $00        ; }
 $A6D2 JR NZ,$A6E3   ; Yes: the exit is already open, so skip straight to what Elrond says
 $A6D4 LD B,$03      ; Three bytes to restore: direction, door and destination
*$A6D6 LD A,(IY+$03) ; Fetch one byte of the exit from the entry (bytes 3-5)...
 $A6D9 LD (HL),A     ; ...and put it back into the room record
 $A6DA INC HL        ; Next byte of the room record
 $A6DB INC IY        ; Next byte of the entry
 $A6DD DJNZ $A6D6    ; Repeat for all three bytes: the hidden way is now open
 $A6DF LD IY,($A6C5) ; Point IY back at the start of the entry (the INCs moved it on)
*$A6E3 LD A,(IY+$05) ; A = the destination room (byte 5 of the entry)
 $A6E6 CALL $9B0C    ; IX = its room record
 $A6E9 INC IX        ; Skip the two flag bytes...
 $A6EB INC IX        ; ...to reach the room's name words
 $A6ED PUSH IX       ; Push them as the third parameter of the message ("...to get to <room>")
 $A6EF LD A,(IY+$00) ; A = the room that has the exit (byte 0 of the entry)
 $A6F2 CALL $9B0C    ; IX = its room record
 $A6F5 INC IX        ; Skip the two flag bytes...
 $A6F7 INC IX        ; ...to reach the room's name words
 $A6F9 PUSH IX       ; Push them as the second parameter ("...from <room>...")
 $A6FB LD A,(IY+$03) ; A = the direction of the exit (byte 3 of the entry)
 $A6FE CALL $9FEA    ; DE = the word for that direction (NORTH, EAST...)
 $A701 PUSH DE       ; Push it as the first parameter ("go <direction>...")
 $A702 LD HL,$B0C2   ; HL = the message "go <direction> from <room> to get to <room>"
 $A705 JP $A113      ; Elrond says it: 'elrond says "go north from beorns house to get to the great river".'

; Handler for the rope: THROW ACROSS (the river)
;
; Throwing the rope across a river: the exit through the river must lead somewhere. 'it sails across and ...'. Then chance takes over (#R$A762: evens). If the
; wooden boat (object 41, location at $C51A) is moored on the far side, the rope may land in the boat, which is then tied to it ('lands in the boat'), or fall
; short; if the boat is not there, the rope may land on the other side (and is moved there) or fall just short of it and come back.
c$A708 LD A,($B5DA)    ; A = the instrument (the river)
 $A70B CALL $9E71      ; {Find the exit that passes through it
 $A70E CP $FF          ; }
 $A710 JP Z,$9EBF      ; No such exit: fail with the usual message
 $A713 CALL $9C99      ; Dry run? Then stop here: it would work
 $A716 LD HL,$AE59     ; {"it sails across and"
 $A719 CALL $72D4      ; }
 $A71C LD A,($C51A)    ; A = wherever the wooden boat currently is
 $A71F CP (IX+$02)     ; Is the boat moored on the far side of this exit?
 $A722 JR NZ,$A740     ; No: try the other outcome, below
 $A724 CALL $A762      ; Yes: an even chance - does the rope land well?
 $A727 JR C,$A736      ; No: it falls short or slides out (below)
 $A729 LD HL,$AE69     ; "falls just short of the other side."
 $A72C CALL $A762      ; Another even chance - does it end up IN the boat, or just miss?
 $A72F JR C,$A75F      ; It just misses: print the "falls short" message and finish
 $A731 LD HL,$AE75     ; {"lands in the boat. but slides out again."
 $A734 JR $A75F        ; }
*$A736 LD A,$12        ; {It landed well: mark the boat as now tied to the rope, for #R$A76A to use
 $A738 LD ($C50B),A    ; }
 $A73B LD HL,$AE7E     ; {"lands in the boat."
 $A73E JR $A75F        ; }
*$A740 LD HL,$AE69     ; {The boat is not over there: another even chance - does the rope reach the far bank anyway?
 $A743 CALL $A762      ; }
 $A746 JR C,$A75F      ; No: print "falls just short" and finish
 $A748 LD A,(IX+$02)   ; Yes: A = the far bank
 $A74B LD IX,($B5F8)   ; IX = the rope's own record
 $A74F LD (IX+$10),A   ; It moves to that bank...
 $A752 LD (IX+$01),$FF ; ...held by nobody
 $A756 LD A,($B5D9)    ; {Move it there, and report it if Bilbo can see
 $A759 CALL $9B38      ; }
 $A75C LD HL,$AE60     ; {"lands on the other side."
*$A75F JP $72D4        ; }

; Evens
;
; Returns with carry set if a random number from 0 to 100 (#R$9BF4) is below 50.
c$A762 LD A,$64      ; A = 100
 $A764 CALL $9BF4    ; Pick a random number from 0 to 100
 $A767 CP $32        ; Below 50?
 $A769 RET           ; Carry reflects the answer

; Handler for the rope: PULL
;
; If the boat is tied to the rope, pulling it brings it over: 'the boat glides across the river and lands on this side.' The boat moves between room 66 and room
; 67 (the east bank), is untied, and takes whatever is in it along (#R$9B38). This is the way across the enchanted river - the HELP message at the river is
; 'boats can help. look carefully.'
c$A76A CALL $9C99    ; Dry run? Then stop here: it would work
 $A76D LD A,($C50B)  ; {Is the boat actually tied to the rope (the flag set by #R$A708)?
 $A770 CP $12        ; }
 $A772 RET NZ        ; No: nothing to pull
 $A773 LD HL,$AE85   ; {"the boat glides across the river and lands on this side."
; This entry point is used by the routine at #R$A792.
*$A776 CALL $72D4    ; }
 $A779 LD A,($C51A)  ; A = where the boat currently is
 $A77C CP $42        ; {Is it on this side already (room 66)?
 $A77E LD A,$42      ; }
 $A780 JR NZ,$A784   ; No: it will end up on this side (room 66)
 $A782 LD A,$43      ; Yes (an odd case): send it to the OTHER side instead (room 67)
*$A784 LD ($C51A),A  ; The boat moves there
 $A787 LD B,A        ; B = that room
 $A788 LD A,$FF      ; {The rope is no longer tied to it
 $A78A LD ($C50B),A  ; }
 $A78D LD A,$29      ; A = the boat's own object number
 $A78F JP $9B38      ; Move it (and anything in it) there, reporting it if seen

; Handler for the boat: it crosses by itself
;
; Chained after one of the boat's handlers: when Bilbo really does it, 'with a lurch the boat glides across the river', and the boat crosses as for #R$A76A.
c$A792 CALL $975D    ; Only if this is really happening
 $A795 LD A,($B5DB)  ; {Is the actor Bilbo?
 $A798 AND A         ; }
 $A799 RET NZ        ; No: nothing happens (this only triggers for Bilbo's own actions on the boat)
 $A79A LD HL,$AE97   ; "with a lurch the boat glides across the river and lands on the other side."
 $A79D JR $A776      ; Join the PULL code above, which actually moves it

; Character routine: Bard remembers his orders
;
; If Bard has been given an order (#R$8907), it is checked and then written into Bard's own behaviour program: the action ($B5D7), target and instrument ($B5D9,
; $B5DA) are stored at $C8D2-$C8D4, and the first byte at $C8D1 is set to $42 (an action instruction that cannot be interrupted by orders). From then on Bard
; carries out that order every turn. So 'say to bard "shoot the dragon"' keeps him shooting until it works.
; .
; SAVE and LOAD (#R$8284, #R$8209) preserve the three bytes at $C8D1-$C8D3, because the behaviour programs are not otherwise saved; the instrument at $C8D4 is
; not included.
c$A79F LD A,($B5E5)  ; {Has the player given Bard an order?
 $A7A2 CP $01        ; }
 $A7A4 RET NZ        ; No: nothing to do
 $A7A5 SUB A         ; {It is dealt with now
 $A7A6 LD ($B5E5),A  ;
 $A7A9 INC A         ; }
 $A7AA CALL $8907    ; Take the order and match it to an action and objects
 $A7AD RET Z         ; It makes no sense: ignore it
 $A7AE SUB A         ; {Do not carry it out now
 $A7AF LD ($B5EC),A  ; }
 $A7B2 LD A,($B5D7)  ; Write the action...
 $A7B5 LD ($C8D2),A  ; ...into Bard's next instruction at $C8D1...
 $A7B8 LD BC,($B5D9) ; {...with its target and instrument...
 $A7BC LD ($C8D3),BC ; }
 $A7C0 LD A,$42      ; {...and make it an action instruction that orders cannot interrupt ($42)
 $A7C2 LD ($C8D1),A  ; }
 $A7C5 RET           ; From now on Bard repeats it every turn

; Character routine: Gollum asks his riddle
;
; If Gollum (whose location is at $C3B0) is in Bilbo's room and Bilbo is visible, he asks the riddle chosen at the start of the game (#R$970B, #R$C6EB), and
; $B5EA is set to show he is waiting for an answer.
c$A7C6 LD A,($C3B0)  ; A = Gollum's own location
 $A7C9 LD HL,$B5E6   ; {Is Bilbo in the same room?
 $A7CC CP (HL)       ; }
 $A7CD RET NZ        ; No: say nothing
 $A7CE LD HL,$C012   ; {Is Bilbo actually visible?
 $A7D1 BIT 7,(HL)    ; }
 $A7D3 RET Z         ; No (he is wearing the ring): Gollum cannot see him to ask
 $A7D4 CALL $9C99    ; Dry run? Then stop here: it always works
 $A7D7 LD HL,($B5DF) ; HL = the riddle chosen at the start of the game...
 $A7DA INC HL        ; {...moved on 2 bytes, to the riddle's own text
 $A7DB INC HL        ; }
 $A7DC LD E,(HL)     ; {DE = the riddle's address
 $A7DD INC HL        ;
 $A7DE LD D,(HL)     ; }
 $A7DF PUSH DE       ; {HL = that address
 $A7E0 POP HL        ; }
 $A7E1 CALL $A113    ; Gollum asks it
 $A7E4 LD A,$01      ; {Remember that he is now waiting for the answer
 $A7E6 LD ($B5EA),A  ;
 $A7E9 RET           ; }

; Character routine: Gollum waits for the answer
;
; Next time, Gollum looks for an order given to him by the player (#R$8907): the answer must be said to him, as in SAY TO GOLLUM "NIGHT". The words of the order
; are searched for the answer word stored in the riddle's entry (the CPIR loop). If the answer is there, all is well. If not, or if the player said nothing:
; 'someone strangles you from behind.', and Bilbo is dead (#R$903C).
c$A7EA CALL $9C99    ; Dry run? Then just record that this would work, and return
 $A7ED SUB A         ; {Gollum is no longer waiting for an answer...
 $A7EE LD ($B5EA),A  ; }
 $A7F1 CALL $8907    ; Take the order the player gave Gollum (SAY TO GOLLUM "...") off the orders buffer; HL points at it
 $A7F4 JR Z,$A809    ; Nothing was said to him: Bilbo is strangled
 $A7F6 LD BC,$0018   ; Search the 24 bytes of the order...
 $A7F9 LD DE,($B5DF) ; DE = the riddle entry chosen at the start of the game
 $A7FD LD A,(DE)     ; A = the low byte of the answer word (NIGHT or MAN)
*$A7FE CPIR          ; Look for it in the order
 $A800 JR NZ,$A809   ; Not there: Bilbo is strangled
 $A802 INC DE        ; {Found: now check the high byte of the word
 $A803 LD A,(DE)     ;
 $A804 DEC DE        ; }
 $A805 CP (HL)       ; Does the next byte of the order match it?
 $A806 JR NZ,$A7FE   ; No: keep searching the rest of the order
 $A808 RET           ; Yes: the answer was right, and Bilbo lives
*$A809 CALL $9C99    ; Dry run? Then stop
 $A80C LD A,$01      ; {Make sure the player sees the message
 $A80E LD ($B5F3),A  ; }
 $A811 LD HL,$B0CD   ; {"someone strangles you from behind."
 $A814 CALL $72D4    ; }
 $A817 JP $903C      ; Bilbo is dead

; Character routine: Gollum mutters
;
; If Gollum is in Bilbo's room: usually, if Gollum still has the golden ring (object 16), 'my birthday present, how did we lose it. my precious'; otherwise
; 'what has it got in its pocketses?'. The test at $A82A only rarely (a random 8) says the pocketses line regardless.
c$A81A LD A,($C3B0)  ; A = Gollum's own location
 $A81D LD HL,$B5E6   ; {Is Bilbo in the same room?
 $A820 CP (HL)       ; }
 $A821 RET NZ        ; No: say nothing
 $A822 CALL $9C99    ; Dry run? Then stop here: it always works
 $A825 LD HL,$B1CB   ; "what has it got in its pocketses?"
 $A828 LD A,$08      ; {Pick a random number from 0 to 8
 $A82A CALL $9BF4    ; }
 $A82D JP NC,$A113   ; Is it negative (the rare, skewed case)? If so, say that regardless
 $A830 LD IX,$C209   ; Otherwise: IX = the golden ring's own record
 $A834 LD A,$44      ; {Does Gollum (object 68) still hold it?
 $A836 CP (IX+$01)   ; }
 $A839 JP Z,$A113    ; Yes: say the "pocketses" line anyway
 $A83C LD HL,$B1D9   ; "my birthday present, how did we lose it. my precious"
 $A83F JP $A113      ; No (he has lost it): say that instead

; Character routine: a character eats Bilbo
;
; If the character is in Bilbo's room, it 'eats' him: the EAT action is reported with Bilbo as the target (#R$9EBF), the food code is run (#R$921F) and Bilbo
; dies (#R$903C).
c$A842 LD A,($B5E7)  ; A = the room the character started this turn in
 $A845 LD HL,$B5E6   ; {Is Bilbo in that same room?
 $A848 CP (HL)       ; }
 $A849 RET NZ        ; No: nothing happens
 $A84A CALL $9C99    ; Dry run? Then stop here: it always works
 $A84D LD A,$1B      ; {A = the EAT action
 $A84F LD ($B5D8),A  ; }
 $A852 LD A,$00      ; {The target is Bilbo (object 0)
 $A854 LD ($B5D9),A  ; }
 $A857 LD A,$FF      ; {No instrument
 $A859 LD ($B5DA),A  ; }
 $A85C CALL $9EBF    ; Report it in words ("the hideous troll eats you.")
 $A85F CALL $921F    ; Run the ordinary eating code (for its side effects)
 $A862 JP $903C      ; Bilbo dies

; Character routine: dawn in the trolls' clearing
;
; The trolls turn to stone at dawn. Both trolls (objects 71 and 72) are killed (#R$96DD) and made invisible, and whatever they carried - including the large key
; - is left behind (#R$9CA8). The trolls' clearing (room 5) gets a new description script, 'in a clearing with two stone trolls', and the game announces 'day
; dawns.'
; .
; The first two bytes of the room 5 picture (the border and paper colours, see #R$8BE9) are set to 5 and $28: cyan. At the start of a game (#R$6C27) they are
; set to 0, so the clearing is drawn in black until dawn, and in daylight colours afterwards.
c$A865 CALL $9C99    ; Dry run? Then stop here: it always works
 $A868 LD A,$47      ; {Kill the hideous troll (object 71)...
 $A86A CALL $96DD    ; }
 $A86D LD A,$48      ; {...and the vicious troll (object 72) too
 $A86F CALL $96DD    ; }
 $A872 LD HL,$C535   ; {The hideous troll becomes invisible...
 $A875 RES 7,(HL)    ; }
 $A877 LD HL,$C547   ; {...and so does the vicious troll
 $A87A RES 7,(HL)    ; }
 $A87C LD HL,$B154   ; "in a clearing with two stone trolls"
 $A87F LD ($B9B4),HL ; This becomes the clearing's new description script
 $A882 LD HL,$B9AC   ; The clearing's "visited" flag is cleared...
 $A885 RES 6,(HL)    ; ...so it will be described in full again, with the new text
 $A887 LD A,$47      ; {Everything the hideous troll was carrying is left behind...
 $A889 CALL $9CA8    ; }
 $A88C LD A,$48      ; {...and likewise for the vicious troll
 $A88E CALL $9CA8    ; }
 $A891 LD HL,$B1FD   ; "day dawns."
 $A894 LD A,$01      ; {Make sure Bilbo sees this, wherever he is
 $A896 LD ($B5F3),A  ;
 $A899 CALL $72D4    ; }
 $A89C LD IX,$CC00   ; {Find the clearing's own picture...
 $A8A0 LD A,$05      ;
 $A8A2 CALL $9D12    ; }
 $A8A5 LD L,(IX+$01) ; {HL = its address
 $A8A8 LD H,(IX+$02) ; }
 $A8AB LD (HL),$05   ; {Its border colour becomes cyan...
 $A8AD INC HL        ; }
 $A8AE LD (HL),$28   ; {...and so does its background, so it is drawn in daylight from now on
 $A8B0 RET           ; }

; Character routine: the trolls talk
;
; In the trolls' clearing, the hideous troll (object 71) says 'blimey, look at this! can yer cook 'em?' and the other troll 'yer can try, but he wouldn't make
; above a mouthful'.
c$A8B1 LD A,($B5E6)  ; {Is Bilbo in the trolls' clearing (room 5)?
 $A8B4 CP $05        ; }
 $A8B6 RET NZ        ; No: say nothing
 $A8B7 CALL $9C99    ; Dry run? Then stop here: it always works
 $A8BA LD A,($B5DB)  ; {Is the speaker the hideous troll (object 71)?
 $A8BD LD HL,$B12A   ;
 $A8C0 CP $47        ; }
 $A8C2 JR Z,$A8C7    ; Yes: "blimey, look at this! can yer cook 'em?"
 $A8C4 LD HL,$B13E   ; {No (the vicious troll): "yer can try, but he wouldn't make above a mouthful"
*$A8C7 JP $A113      ; }

; Has the game been won?
;
; Called at the end of every turn (from #R$9611). If the valuable treasure (object 35) is in the wooden chest (object 37, back at Bilbo's home), the game is
; won: 'a cheering crowd of dwarves, hobbits and elves appear. led by gandalf they carry you off into the sunset, proclaiming you hero of heroes and master
; adventurer!!!' The score is then printed and the game ends ($9049).
c$A8CA LD A,($C4BD)  ; A = the treasure's holder
 $A8CD CP $25        ; Is it the wooden chest (object 37)?
 $A8CF RET NZ        ; No: the game goes on
 $A8D0 LD HL,$B2CB   ; {"a cheering crowd of dwarves, hobbits and elves appear..."
 $A8D3 CALL $72D4    ; }
 $A8D6 JP $9049      ; Print the score and end the game

; Character routine: Elrond gives Bilbo lunch
;
; If Elrond is in Bilbo's room and object 38 (lunch) has not yet been handed over, it is placed with Elrond and he gives it to Bilbo (#R$9308).
c$A8D9 LD A,($B5E7)    ; A = the room the character started this turn in
 $A8DC LD HL,$B5E6     ; {Is Bilbo in that same room?
 $A8DF CP (HL)         ; }
 $A8E0 RET NZ          ; No: nothing happens
 $A8E1 LD IX,$C552     ; IX = the lunch's own record
 $A8E5 LD A,(IX+$10)   ; {Has it already been placed anywhere (i.e. already given)?
 $A8E8 CP $00          ; }
 $A8EA JR Z,$A8F2      ; No (still nowhere): give it now, below
 $A8EC LD A,$41        ; {Yes - is it still held by Elrond himself?
 $A8EE CP (IX+$01)     ; }
 $A8F1 RET NZ          ; No (already handed over): nothing more to do
*$A8F2 CALL $9C99      ; Dry run? Then stop here: it always works
 $A8F5 LD A,($B5E7)    ; {The lunch appears in this room...
 $A8F8 LD (IX+$10),A   ; }
 $A8FB LD (IX+$01),$41 ; ...held by Elrond
 $A8FF LD BC,$0026     ; {The lunch (object 38) is the target...
 $A902 LD ($B5D9),BC   ; }
 $A906 LD A,$1D        ; {The action is GIVE TO
 $A908 LD ($B5D8),A    ; }
 $A90B LD ($B5F8),IX   ; IX = the lunch's own record, for GIVE TO to use
 $A90F LD HL,$C00B     ; {Bilbo (object 0) is the instrument (the receiver)
 $A912 LD ($B5FA),HL   ; }
 $A915 CALL $9EBF      ; Report it in words
 $A918 JP $9308        ; Actually carry out the GIVE TO

; Handler for the barrel: JUMP ONTO / CLIMB INTO
;
; An actor can get into the barrel only from a room with an exit leading to where the barrel is, and only if that exit goes down (direction 10). Otherwise 'you
; cannot jump onto the barrel from here.' The actor then becomes held by the barrel (and so moves with it, #R$9B38).
c$A91B LD IY,($B5F8) ; IY = the barrel's own record
 $A91F LD A,(IY+$10) ; {B = the room the barrel is in
 $A922 LD B,A        ; }
 $A923 CALL $9E76    ; {Find an exit from the actor's own room that leads there
 $A926 CP $FF        ; }
 $A928 LD HL,$B1F3   ; "you cannot jump onto the barrel from here."
 $A92B JP Z,$72D4    ; No such exit: say so and stop
 $A92E LD A,(IX+$00) ; A = that exit's own direction
 $A931 CP $0A        ; Is it DOWN?
 $A933 JP NZ,$B1F3   ; No: jump to the message text itself, rather than through the printer - see the bug note
 $A936 CALL $9C99    ; Dry run? Then stop here: it would work
 $A939 LD A,($B5D9)  ; {The actor becomes held by the barrel...
 $A93C LD IX,($B5FC) ;
 $A940 LD (IX+$01),A ; }
 $A943 CALL $9B38    ; ...and moves wherever the barrel goes
 $A946 LD A,($B5DB)  ; {Is the actor Bilbo?
 $A949 CP $00        ; }
 $A94B RET NZ        ; No: nothing more to do
 $A94C LD A,B        ; {Yes: describe the room the barrel is now in
 $A94D JP $958E      ; }

; Timer 1 expires: the web is mended
;
; Two turns after the spider web was broken (#R$A2A7) the spiders have mended it: it is no longer broken, it is closed again (blocking the way), its strength is
; doubled, and its first adjective is set back to SPIDER (it had become BROKEN, #R$A0BC).
; .
; Doubling uses SLA, which drops the top bit: the web starts with strength 64, so the first mending makes it 128, and the second makes it 0.
c$A950 LD IX,$C0F5    ; IX = the spider web's record
 $A954 RES 3,(IX+$07) ; Not broken any more
 $A958 RES 5,(IX+$07) ; Closed again
 $A95C SLA (IX+$05)   ; Twice as strong (64, then 128, then 0)
 $A960 LD DE,$0627    ; Its adjective is SPIDER again...
 $A963 LD ($C0FF),DE  ; {...instead of BROKEN
 $A967 RET            ; }

; Timer 9 expires: the side door vanishes
;
; The expiry routine of timer 9 (#R$C9B2). If the side door of the Lonely Mountain (object 11, flags at $C1AB) has been opened, nothing happens and the timer
; stops: the door stays. Otherwise the timer is restarted at its reload value (5), the door is made invisible, and if Bilbo is at the side door (room 42) he
; reads 'the hole vanishes.'
c$A968 LD HL,$C1AB   ; HL = the side door's flags
 $A96B BIT 5,(HL)    ; Has it been opened?
 $A96D RET NZ        ; Yes: it stays open and visible; the timer stops
 $A96E LD A,($C9B2)  ; {No: restart the timer (count = 5)
 $A971 LD ($C9B3),A  ;
 $A974 LD HL,$C1AB   ; }
 $A977 RES 7,(HL)    ; Make the door invisible
 $A979 LD A,($C01B)  ; {Is Bilbo at the side door (room 42)?
 $A97C CP $2A        ; }
 $A97E RET NZ        ; No: done
; This entry point is used by the routine at #R$A996.
*$A97F LD HL,$B196   ; {"the hole vanishes."
 $A982 JP $72D4      ; }

; Timer 9 tick: the side door appears
;
; The tick routine of timer 9, run when its count is down to 1. The side door is made visible, and if Bilbo is in room 42 he reads 'there is a loud crack and a
; hole appears about three feet from the ground. you are standing in front of the side door to the lonely mountain.' Next turn the timer expires (#R$A968), and
; unless Bilbo has opened the door by then, it vanishes again.
c$A985 LD HL,$C1AB   ; HL = the side door's flags
 $A988 SET 7,(HL)    ; Make it visible
 $A98A LD A,($C01B)  ; {Is Bilbo at the side door (room 42)?
 $A98D CP $2A        ; }
 $A98F RET NZ        ; No: done
 $A990 LD HL,$B169   ; {"there is a loud crack and a hole appears about three feet from the ground..."
 $A993 JP $72D4      ; }

; Handler for the side door: closing it
;
; Chained after the normal CLOSE handler in the side door's record. When the door is really closed, it is locked again (bit 0), made invisible, and timer 9 is
; restarted with a count of 6; 'the hole vanishes.' is printed (via #R$A97F). So closing the side door puts it back into its appear-and-vanish cycle.
c$A996 CALL $975D    ; Only if the door is really being closed
 $A999 LD A,$06      ; {Restart timer 9 with a count of 6
 $A99B LD ($C9B3),A  ; }
 $A99E LD HL,$C1AB   ; HL = the side door's flags
 $A9A1 SET 0,(HL)    ; Lock it
 $A9A3 RES 7,(HL)    ; Hide it
 $A9A5 JR $A97F      ; "the hole vanishes."

; Timer 5 tick: the magic door opens and an elf sweeps past
;
; Timer 5 is started when an invisible Bilbo examines the magic door (#R$A614: 'the magic door warns of elves approaching'). When its count reaches 1, the magic
; door (object 13) opens, and if Bilbo is in room 28 or 30 he sees 'the magic door opens.' and 'an elf sweeps past.' Then the ring check of timer 6 is run
; (#R$A9D4), which takes the ring off anyone wearing it.
c$A9A7 LD HL,$C277   ; HL = the magic door's flags
 $A9AA SET 5,(HL)    ; Open it
 $A9AC LD HL,$AF29   ; "the magic door opens."
 $A9AF CALL $A9BB    ; Print it if Bilbo is nearby
 $A9B2 LD HL,$B005   ; {"an elf sweeps past."
 $A9B5 CALL $A9BB    ; }
 $A9B8 JP $A9D4      ; Take the ring off whoever is wearing it

; Print a message if Bilbo is near the magic door
;
; Prints the message at HL if Bilbo is in room 30 or room 28, the rooms on either side of the magic door.
c$A9BB LD A,($C01B)  ; {Is Bilbo in room 30...
 $A9BE CP $1E        ; }
 $A9C0 JP Z,$72D4    ; ...then print it
 $A9C3 CP $1C        ; ...or room 28?
 $A9C5 JP Z,$72D4    ; ...then print it
 $A9C8 RET           ; Otherwise say nothing

; Timer 5 expires: the magic door closes
;
; The turn after the elf has swept past, the magic door closes again ('the magic door closes.', if Bilbo is near).
c$A9C9 LD HL,$C277   ; HL = the magic door's flags
 $A9CC RES 5,(HL)    ; Close it
 $A9CE LD HL,$AF31   ; "the magic door closes."
 $A9D1 JP $A9BB      ; Print it if Bilbo is nearby

; Timer 6 expires: the ring comes off
;
; When timer 6 (started by #R$A2C0) runs out, whoever holds the golden ring becomes the actor and, if the ring is still being worn (it is invisible), it is
; taken off (#R$A2EC). If nobody holds the ring, nothing happens.
c$A9D4 LD IX,$C209    ; IX = the ring's record
 $A9D8 LD A,(IX+$01)  ; {Who holds it?
 $A9DB CP $FF         ; }
 $A9DD RET Z          ; Nobody: nothing to do
 $A9DE CALL $9B25     ; IX = the holder's record...
 $A9E1 LD ($B5FC),IX  ; ...who becomes the actor
 $A9E5 BIT 7,(IX+$07) ; Is the ring being worn (invisible)?
 $A9E9 JP Z,$A2EC     ; {Yes: take it off
 $A9EC RET            ; }

; Handler for the wine: Bilbo gets drunk
;
; Attached to the wine's DRINK handler. If the drinker is Bilbo, the flag at $B5F1 is set and timer 7 started, so that for five turns every S he sees is
; followed by an H (#R$7580).
c$A9ED LD A,($B5DB)  ; {Is the drinker Bilbo?
 $A9F0 CP $00        ; }
 $A9F2 RET NZ        ; No (a character): nothing happens
 $A9F3 LD A,$01      ; {Yes: set the "drunk" flag...
 $A9F5 LD ($B5F1),A  ; }
 $A9F8 LD A,($C9A4)  ; {...and start timer 7 (copy its reload value into its count)
 $A9FB LD ($C9A5),A  ;
 $A9FE RET           ; }

; Timer routine
;
; Clears the flag at $B5F1.
c$A9FF SUB A         ; {Clear the "drunk" flag: Bilbo has sobered up
 $AA00 LD ($B5F1),A  ;
 $AA03 RET           ; }

; Timer 2 expires: smothered by the spiders
;
; The expiry routine of timer 2 (count 5), started when Bilbo enters the place of black spiders (#R$C6A1). The count drops to 4 at the end of the turn he
; enters, so it reaches 0 at the end of his fourth turn after that: if he is still in room 26, 'the spider web is slowly smothering you', and he dies. In the
; emulator, entering and waiting three times, then leaving, is safe; waiting a fourth time is fatal.
c$AA04 LD A,($C01B)  ; {Is Bilbo still in the spiders' place (room 26)?
 $AA07 CP $1A        ; }
 $AA09 RET NZ        ; No: he got away
 $AA0A LD HL,$AFEF   ; {"the spider web is slowly smothering you"
 $AA0D CALL $72D4    ; }
 $AA10 JP $903C      ; Bilbo is dead

; Pale bulbous eyes: tick routine
;
; Called by #R$9611 on each turn that the eyes timer (entry at #R$C9AB) is counting down and at or below its threshold of 3. It prints 'you see some pale
; bulbous eyes staring at you' (#R$B203).
; .
; It then checks whether Bilbo has moved. $C01B is Bilbo's location (the first location byte of object 0, see #R$C00B) and $B5E4 is the room he was in when the
; timer was started. If he is still in the same room, all is well. If he has moved to the other 'eyes' room (from 2 to 3 or from 3 to 2), all is also well.
; Otherwise he has left too early: execution falls into #R$AA3E, which prints 'some thing drops from above and stings' (#R$B211) and kills him (#R$903C).
; .
; In practice the room-2/room-3 exception is never needed, because entering either room restarts the timer anyway (see #R$C6CC).
c$AA13 LD HL,$B203   ; Print the eyes message
 $AA16 CALL $72D4    ; Print the message at HL
 $AA19 LD A,($C01B)  ; C = Bilbo's current room
 $AA1C LD C,A        ; C = A
 $AA1D LD HL,$B5E4   ; HL = the address of the room where the eyes timer started
 $AA20 CP (HL)       ; Still in the same room: fine
 $AA21 RET Z         ; Return if yes
 $AA22 LD B,(HL)     ; B = (HL)
 $AA23 LD A,$02      ; A = the other eyes room
 $AA25 CP B          ; Compare with B
 $AA26 JR NZ,$AA2A   ; If no, go to #R$AA2A
 $AA28 LD A,$03      ; A = 3
*$AA2A CP C          ; Moved to the other eyes room: fine
 $AA2B RET Z         ; Return if yes
 $AA2C JR $AA3E      ; Otherwise: stung to death

; Pale bulbous eyes: expire routine
;
; Called by #R$9611 when the eyes timer reaches 0. If Bilbo is still in room 2 (the forest road) or room 3 (the forest), he has stayed too long: the eyes are
; shown, the thing drops from above and stings, and Bilbo dies. If he is anywhere else, nothing happens.
; .
; Together with #R$AA13 and #R$C6CC, this produces the well-known rule: on entering the forest, wait twice and move on the third turn. The timer is set to 4 on
; entry; the turn of entry leaves it at 3, the two waits take it to 2 and then 1 (the tick routine is happy each time because Bilbo is still there), and the
; move takes it to 0 with Bilbo already out of the forest. Wait a third time and the timer expires with Bilbo still there; move sooner and the tick routine sees
; him gone while the timer is still running.
c$AA2E LD A,($C01B)  ; Is Bilbo in room 2 or room 3?
 $AA31 CP $02        ; Is it room 2?
 $AA33 JR Z,$AA38    ; If yes, go to #R$AA38
 $AA35 CP $03        ; Is it room 3?
 $AA37 RET NZ        ; Return if no
*$AA38 LD HL,$B203   ; Yes: eyes...
 $AA3B CALL $72D4    ; Print the message at HL
; This entry point is used by the routine at #R$AA13.
*$AA3E LD HL,$B211   ; ...sting...
 $AA41 CALL $72D4    ; Print the message at HL
 $AA44 JP $903C      ; ...and death

; Action table
;
; The 59 actions the game knows, 8 bytes each, numbered from 1 (#R$70DF works out the address). Each entry is four word references, low byte first: the verb, a
; particle, a preposition, and a fourth word (GO for the ten movement actions). The parser's command is matched against these by #R$858F, so an action is really
; a verb plus the little words that go with it: TAKE, TAKE OUT OF, TAKE FROM and TAKE OFF are four different actions.
; .
; The top nibble of each word's high byte holds flags (collected by #R$70EA and decoded by #R$8569): whether a target and an instrument are needed, whether they
; can be rooms, whether the action can be done in the dark, and how it is reported.
; .
; Only the verbs appearing here do anything. Any other verb in the dictionary (WAIT, JUMP, SING...) just produces 'you wait. time passes...' (#R$858F).
b$AA47 DEFB $84,$04,$00,$00,$00,$00,$E2,$02 ; Action 1: north go
 $AA4F DEFB $0B,$06,$00,$00,$00,$00,$E2,$02 ; Action 2: south go
 $AA57 DEFB $02,$02,$00,$00,$00,$00,$E2,$02 ; Action 3: east go
 $AA5F DEFB $7D,$07,$00,$00,$00,$00,$E2,$02 ; Action 4: west go
 $AA67 DEFB $89,$04,$00,$00,$00,$00,$E2,$02 ; Action 5: northeast go
 $AA6F DEFB $92,$04,$00,$00,$00,$00,$E2,$02 ; Action 6: northwest go
 $AA77 DEFB $10,$06,$00,$00,$00,$00,$E2,$02 ; Action 7: southeast go
 $AA7F DEFB $19,$06,$00,$00,$00,$00,$E2,$02 ; Action 8: southwest go
 $AA87 DEFB $29,$07,$00,$00,$00,$00,$E2,$02 ; Action 9: up go
 $AA8F DEFB $C8,$01,$00,$00,$00,$00,$E2,$02 ; Action 10: down go
 $AA97 DEFB $5C,$E6,$00,$00,$9A,$07,$00,$40 ; Action 11: strike with
 $AA9F DEFB $34,$81,$00,$00,$00,$00,$00,$40 ; Action 12: close
 $AAA7 DEFB $EC,$81,$00,$00,$00,$80,$00,$00 ; Action 13: drop
 $AAAF DEFB $EC,$C1,$00,$00,$7C,$03,$00,$40 ; Action 14: drop in
 $AAB7 DEFB $73,$E0,$00,$00,$9A,$47,$00,$40 ; Action 15: attack with
 $AABF DEFB $B8,$84,$00,$00,$00,$00,$00,$40 ; Action 16: open
 $AAC7 DEFB $0C,$C5,$00,$00,$7C,$03,$00,$40 ; Action 17: put in
 $AACF DEFB $0C,$C5,$00,$00,$AE,$04,$00,$40 ; Action 18: put on
 $AAD7 DEFB $90,$86,$00,$00,$00,$00,$00,$40 ; Action 19: take
 $AADF DEFB $90,$C6,$C3,$04,$A0,$04,$00,$40 ; Action 20: take out of
 $AAE7 DEFB $90,$C6,$B9,$02,$00,$00,$00,$40 ; Action 21: take from
 $AAEF DEFB $90,$96,$A3,$24,$00,$00,$00,$40 ; Action 22: take off
 $AAF7 DEFB $17,$04,$00,$10,$00,$00,$00,$40 ; Action 23: look
 $AAFF DEFB $17,$84,$C5,$26,$00,$00,$00,$00 ; Action 24: look through
 $AB07 DEFB $17,$84,$43,$20,$00,$00,$00,$00 ; Action 25: look across
 $AB0F DEFB $96,$03,$00,$10,$00,$00,$00,$40 ; Action 26: inventory
 $AB17 DEFB $06,$82,$00,$00,$00,$00,$00,$00 ; Action 27: eat
 $AB1F DEFB $42,$82,$00,$00,$00,$00,$00,$40 ; Action 28: examine
 $AB27 DEFB $D8,$C2,$D5,$06,$00,$10,$00,$60 ; Action 29: give to
 $AB2F DEFB $E2,$82,$C5,$26,$00,$00,$00,$00 ; Action 30: go through
 $AB37 DEFB $31,$82,$00,$80,$00,$00,$00,$00 ; Action 31: enter
 $AB3F DEFB $E2,$82,$92,$A3,$00,$00,$00,$00 ; Action 32: go into
 $AB47 DEFB $E7,$81,$00,$00,$00,$00,$00,$00 ; Action 33: drink
 $AB4F DEFB $2C,$82,$00,$00,$00,$00,$00,$00 ; Action 34: empty
 $AB57 DEFB $65,$C2,$00,$00,$9A,$07,$00,$40 ; Action 35: fill with
 $AB5F DEFB $70,$05,$00,$00,$00,$00,$00,$00 ; Action 36: run
 $AB67 DEFB $F6,$C3,$00,$00,$9A,$07,$00,$40 ; Action 37: lock with
 $AB6F DEFB $16,$C7,$00,$00,$9A,$07,$00,$40 ; Action 38: unlock with
 $AB77 DEFB $89,$92,$00,$00,$00,$40,$00,$00 ; Action 39: follow
 $AB7F DEFB $76,$87,$00,$00,$00,$00,$00,$00 ; Action 40: wear
 $AB87 DEFB $CC,$86,$00,$00,$00,$00,$00,$00 ; Action 41: throw
 $AB8F DEFB $CC,$C6,$00,$00,$70,$20,$00,$00 ; Action 42: throw at
 $AB97 DEFB $CC,$C6,$00,$00,$43,$00,$00,$40 ; Action 43: throw across
 $AB9F DEFB $CC,$C6,$00,$00,$C5,$06,$00,$40 ; Action 44: throw through
 $ABA7 DEFB $D3,$80,$00,$00,$00,$40,$00,$00 ; Action 45: burn
 $ABAF DEFB $D1,$C6,$00,$00,$D5,$06,$00,$40 ; Action 46: tie to
 $ABB7 DEFB $78,$81,$00,$00,$00,$00,$00,$00 ; Action 47: cut
 $ABBF DEFB $F4,$80,$00,$00,$00,$40,$00,$00 ; Action 48: capture
 $ABC7 DEFB $04,$85,$00,$00,$00,$00,$00,$00 ; Action 49: pull
 $ABCF DEFB $80,$86,$00,$00,$00,$00,$00,$40 ; Action 50: swim
 $ABD7 DEFB $24,$87,$00,$00,$00,$00,$00,$40 ; Action 51: untie
 $ABDF DEFB $2F,$81,$00,$00,$00,$00,$00,$40 ; Action 52: climb
 $ABE7 DEFB $94,$86,$D5,$26,$00,$40,$00,$40 ; Action 53: talk to
 $ABEF DEFB $2F,$81,$92,$23,$00,$00,$00,$40 ; Action 54: climb into
 $ABF7 DEFB $2F,$81,$C3,$24,$A0,$04,$00,$80 ; Action 55: climb out of
 $ABFF DEFB $A5,$93,$B4,$24,$00,$00,$00,$00 ; Action 56: jump onto
 $AC07 DEFB $A9,$81,$00,$00,$00,$00,$00,$40 ; Action 57: dig
 $AC0F DEFB $98,$85,$00,$00,$00,$40,$00,$40 ; Action 58: shoot
 $AC17 DEFB $0D,$81,$00,$00,$00,$80,$00,$40 ; Action 59: carry

; Articles
;
; #R$7436 uses these to put an article in front of a noun. The first two bytes are unused. At $AC21: THE, A, AN, SOME (chosen by flag bits in the noun's
; reference); at $AC29: THE, THE, THE, SOME (used when a definite article is wanted).
b$AC1F DEFB $00,$00
 $AC21 DEFW $06A3    ; {THE, A, AN, SOME
 $AC23 DEFW $0040    ;
 $AC25 DEFW $0058    ;
 $AC27 DEFW $0607    ; }
 $AC29 DEFW $06A3    ; {THE, THE, THE, SOME
 $AC2B DEFW $06A3    ;
 $AC2D DEFW $06A3    ;
 $AC2F DEFW $0607    ; }

; Abbreviated words
;
; The 32 most frequent words in messages, referenced by single bytes $60-$7F (see #R$748A). Each entry is a dictionary reference with $50 subtracted from its
; high byte. Using one byte instead of two for words such as 'the', 'you', 'is' and 'and' saves a lot of space across all the game's messages.
w$AC31 DEFW $0040    ; {Words for codes $60-$7F
 $AC33 DEFW $005B    ;
 $AC35 DEFW $0065    ;
 $AC37 DEFW $0070    ;
 $AC39 DEFW $0826    ;
 $AC3B DEFW $00AF    ;
 $AC3D DEFW $00D7    ;
 $AC3F DEFW $00EE    ;
 $AC41 DEFW $0862    ;
 $AC43 DEFW $01C0    ;
 $AC45 DEFW $01C4    ;
 $AC47 DEFW $01CC    ;
 $AC49 DEFW $0253    ;
 $AC4B DEFW $02B9    ;
 $AC4D DEFW $0989    ;
 $AC4F DEFW $0377    ;
 $AC51 DEFW $037C    ;
 $AC53 DEFW $039F    ;
 $AC55 DEFW $03A2    ;
 $AC57 DEFW $0A5A    ;
 $AC59 DEFW $04A0    ;
 $AC5B DEFW $04AE    ;
 $AC5D DEFW $0AAF    ;
 $AC5F DEFW $0607    ;
 $AC61 DEFW $06A3    ;
 $AC63 DEFW $0B61    ;
 $AC65 DEFW $0B6B    ;
 $AC67 DEFW $06D5    ;
 $AC69 DEFW $06D8    ;
 $AC6B DEFW $0BC8    ;
 $AC6D DEFW $079A    ;
 $AC6F DEFW $07AC    ; }

; Messages and scripts
;
; The game's messages, in the bytecode format interpreted by #R$72D4. Each message below is labelled with its text, obtained by running the game's own message
; printer on it in an emulator. In the labels, 'you' stands for the actor, 'the thing' for the target of the command, 'the other' for the instrument, and 'word'
; for a word or object passed as a parameter; the real text changes with who is acting and on what ('you cleave his skull' / 'thorin cleaves your skull').
; .
; There are about 180 messages. Almost every byte of this area belongs to a message that the program uses; the one exception is at $B4EF, a fuller description
; of the bewitched gloomy place ('a bewitched gloomy place surrounded by thick trees') that nothing refers to - room 25 is described by its name words instead.
b$AC71 DEFB $66,$6C,$61,$83,$4B,$8B,$EA,$20,$48,$45,$41,$44,$15             ; "but fall and hit your HEAD."
 $AC7E DEFB $66,$6C,$61,$85,$EA,$8B,$EA,$B5,$C2                             ; "but fall and smash your skull."
 $AC87 DEFB $6F,$69,$73,$89,$C5,$78,$8B,$DE,$20,$22,$20,$16                 ; "i do not know the word ""
 $AC93 DEFB $7D,$20,$3F,$14                                                 ; "what ?"
