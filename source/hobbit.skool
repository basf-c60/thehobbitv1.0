 $B9B4 DEFB $00,$00,$08,$00,$04,$07,$00,$09                         ;
 $B9BC DEFB $01,$00,$06,$FF                                         ; }
 $B9C0 DEFB $84,$FF,$D8,$04,$01,$07,$00,$00                         ; {Room 6: trolls path. lit, "in". Exits: S to 5, N to 7 through object 1
 $B9C8 DEFB $7D,$B4,$02,$00,$05,$01,$01,$07                         ;
 $B9D0 DEFB $FF                                                     ; }
